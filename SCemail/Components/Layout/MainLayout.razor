@inherits LayoutComponentBase
@using MudBlazor

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Color="Color.Primary" Dense="true">
        <MudIcon Icon="@Icons.Material.Filled.MarkEmailUnread" Style="width:32px;height:32px;" class="mr-2" />
        <MudText Typo="Typo.h6">GS · MAIL</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Outlined" Color="Color.Inherit" OnClick="Refresh">Aggiorna</MudButton>
    </MudAppBar>

    <MudMainContent Class="p-4" Style="background:#f7f9fc; min-height:100vh;">
        @Body
    </MudMainContent>
</MudLayout>
<script src="../wwwroot/js/site.js"></script>
@code {
    [Inject] NavigationManager Nav { get; set; } = default!;
    private void Refresh() => Nav.NavigateTo(Nav.Uri, forceLoad: true);
}
