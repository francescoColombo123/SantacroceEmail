@using MudBlazor
@using SCemail.Components.Data

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-2">@Title</MudText>

        <MudSelect T="string"
                   Label="Assegna a"
                   @bind-Value="_user"
                   Dense="true"
                   Required="true"
                   Class="mt-2">
            @foreach (var u in Users)
            {
                <MudSelectItem Value="@u">@u</MudSelectItem>
            }
        </MudSelect>

        <MudTextField @bind-Value="_comment"
                      Label="Commento"
                      Placeholder="Scrivi un commento…"
                      Lines="3"
                      Variant="Variant.Outlined"
                      Class="mt-3"
                      Required="@RequireComment"
                      RequiredError="Commento obbligatorio" />

        @if (RequireComment)
        {
            <MudText Typo="Typo.caption" Class="mt-1" Style="color: var(--mud-palette-text-secondary);">
                Il commento è obbligatorio per l’assegnazione (utente non admin).
            </MudText>
        }
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Annulla</MudButton>
        <MudSpacer />
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="OkAssign"
                   Disabled="@IsConfirmDisabled">
            Assegna
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public List<string> Users { get; set; } = new();
    [Parameter] public bool RequireComment { get; set; } = false;
    [Parameter] public string Title { get; set; } = "Assegna internamente";

    private string? _user;
    private string? _comment;

    public sealed class ForwardResult
    {
        public string User { get; init; } = default!;
        public string? Comment { get; init; }
        public bool SoloInvio { get; init; } // lasciato per compatibilità, ma non usato
    }

    private bool IsConfirmDisabled =>
        string.IsNullOrWhiteSpace(_user) ||
        (RequireComment && string.IsNullOrWhiteSpace(_comment));

    void Cancel() => MudDialog.Cancel();

    void OkAssign()
    {
        var result = new ForwardResult
        {
            User = _user!,
            Comment = _comment,
            SoloInvio = false // ✅ sempre interno
        };

        MudDialog.Close(DialogResult.Ok(result));
    }
}
