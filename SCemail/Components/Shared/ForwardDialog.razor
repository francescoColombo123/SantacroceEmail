@using MudBlazor
@using SCemail.Components.Data

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-2">Inoltra email</MudText>

        <MudSelect T="string" Label="Destinatario" @bind-Value="_user" Dense="true" Required="true" Class="mt-2">
            @foreach (var u in Users)
            {
                <MudSelectItem Value="@u">@u</MudSelectItem>
            }
        </MudSelect>

        <MudTextField @bind-Value="_comment"
                      Label="Commento (opzionale)"
                      Lines="3"
                      Variant="Variant.Outlined"
                      Class="mt-3" />
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Annulla</MudButton>
        <MudSpacer />
        <MudButton Color="Color.Secondary"
                   Variant="Variant.Outlined"
                   OnClick="() => Ok(false)"
                   Disabled="@string.IsNullOrWhiteSpace(_user)">
            Tieni traccia
        </MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="() => Ok(true)"
                   Disabled="@string.IsNullOrWhiteSpace(_user)">
            Inoltra
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public List<string> Users { get; set; } = new();

    private string? _user;
    private string? _comment;

    public sealed class ForwardResult
    {
        public string User { get; init; } = default!;
        public string? Comment { get; init; }
        public bool SoloInvio { get; init; } // true = invia, false = tieni traccia
    }

    void Cancel() => MudDialog.Cancel();

    void Ok(bool soloInvio)
    {
        var result = new ForwardResult
        {
            User = _user!,
            Comment = _comment,
            SoloInvio = soloInvio
        };

        MudDialog.Close(DialogResult.Ok(result));
    }
}
