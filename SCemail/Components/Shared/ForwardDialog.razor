@using Microsoft.JSInterop
@using MudBlazor
@using SCemail.Components.Data
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Components.Web
@inject AccessiService AccessiService
@inject IJSRuntime JS
<MudDialog>
    <DialogContent>
        <MudSelect T="string"
                   Label="Assegna a"
                   @bind-Value="_user"
                   Dense="true"
                   Required="true"
                   Class="mt-2">
            @foreach (var u in Users)
            {
                <MudSelectItem Value="@u">@u</MudSelectItem>
            }
        </MudSelect>

        <MudTextField @bind-Value="_assignedComment"
                      Label="Commento per utente assegnato"
                      Placeholder="Scrivi un commento per l’assegnato…"
                      Lines="3"
                      Variant="Variant.Outlined"
                      Class="mt-3"
                      Required="@RequireComment"
                      RequiredError="Commento obbligatorio" />

        @if (RequireComment)
        {
            <MudText Typo="Typo.caption"
                     Class="mt-1"
                     Style="color: var(--mud-palette-text-secondary);">
                Il commento è obbligatorio per l’assegnazione.
            </MudText>
        }

        <div class="mention-wrap">
            <MudTextField T="string"
                          InputId="mentionBox"
                          Label="Altri commenti e menzioni"
                          Placeholder=@("Scrivi un commento. Per menzionare qualcuno digita @ e scegli un utente…")
                          Value="_mentionsComment"
                          ValueChanged="OnMentionsChanged"
                          OnKeyDown="HandleMentionKeyDownMud"
                          OnKeyDown:preventDefault="@_preventMentionKey"
                          Lines="4"
                          Variant="Variant.Outlined"
                          Class="mt-3 mention-textarea"
                          Immediate="true" />
            @if (_loadingUsers)
            {
                <MudText Typo="Typo.caption" Class="mt-1">
                    Caricamento utenti…
                </MudText>
            }
            @if (_mentionOpen && _mentionSuggestions.Any())
            {
                <MudPaper Class="mention-popup" Outlined="true" Elevation="8">
                    @for (int i = 0; i < _mentionSuggestions.Count; i++)
                    {
                        var u = _mentionSuggestions[i];
                        var activeClass = i == _selectedMentionIndex ? "mention-item active" : "mention-item";

                        <div id="@($"mention-item-{i}")"
                             data-active="@(i == _selectedMentionIndex ? "true" : "false")"
                             class="@activeClass"
                             @onclick="() => SelectMention(u)">
                            <div class="mention-avatar">@u.Substring(0, 1).ToUpper()</div>
                            <div class="mention-name">@u</div>
                        </div>
                    }
                </MudPaper>
            }
        </div>

        @if (_mentionedUsers.Any())
        {
            <div class="mentioned-users mt-2">
                @foreach (var u in _mentionedUsers)
                {
                    <MudChip T="string"
                             Size="Size.Small"
                             Variant="Variant.Outlined"
                             Color="Color.Primary">
                        @u
                    </MudChip>
                }
            </div>
        }
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Annulla</MudButton>
        <MudSpacer />

        <MudButton Color="Color.Primary"
                   Variant="Variant.Outlined"
                   OnClick="OkAssign"
                   Disabled="@IsConfirmDisabled">
            Assegna
        </MudButton>

        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="OkAssignAndFollow"
                   Disabled="@IsConfirmDisabled">
            Assegna e segui
        </MudButton>
    </DialogActions>
</MudDialog>

<style>
    .mention-wrap {
        position: relative;
        margin-top: 16px;
    }

    .mention-item.active {
        background: #eef3ff;
    }

    .mention-popup {
        position: absolute;
        left: 0;
        right: 0;
        bottom: calc(100% + 6px);
        z-index: 9999;
        max-height: 190px;
        overflow-y: auto;
        border-radius: 12px;
        background: white;
        border: 1px solid #d8def5;
        box-shadow: 0 10px 24px rgba(0,0,0,0.18);
        padding: 6px;
    }
    .mention-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 12px;
        border-radius: 8px;
        cursor: pointer;
        transition: background .15s ease;
    }

        .mention-item:hover {
            background: #f5f7ff;
        }

    .mention-avatar {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: #e8eeff;
        color: #355ad8;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 12px;
        flex: 0 0 28px;
    }

    .mention-name {
        font-size: 14px;
        font-weight: 500;
    }

    .mentioned-users {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }
</style>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public List<string> Users { get; set; } = new();
    [Parameter] public bool RequireComment { get; set; } = false;
    [Parameter] public string Title { get; set; } = "Assegna internamente";

    private string? _user;
    private string? _assignedComment;
    private string? _mentionsComment;

    private bool _mentionOpen;
    private bool _loadingUsers;
    private List<string> _mentionSuggestions = new();
    private List<string> _allUsers = new();
    private List<string> _mentionedUsers = new();
    private int _selectedMentionIndex = -1;
    private bool _preventMentionKey;
    public sealed class ForwardResult
    {
        public string User { get; init; } = default!;
        public string? AssignedComment { get; init; }
        public string? MentionsComment { get; init; }
        public List<string> MentionedUsers { get; init; } = new();
        public bool FollowMe { get; init; } 
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("mentionsInterop.bindMentionKeys", "mentionBox");
        }

        await JS.InvokeVoidAsync("mentionsInterop.setMentionOpen", _mentionOpen);
    }
    protected override async Task OnInitializedAsync()
    {
        _loadingUsers = true;

        try
        {
            if (Users is { Count: > 0 })
                _allUsers = NormalizeUsers(Users);
            else
                _allUsers = NormalizeUsers(await AccessiService.GetUserListAsync());
        }
        finally
        {
            _loadingUsers = false;
        }
    }

    private static List<string> NormalizeUsers(IEnumerable<string> users)
    {
        return users
            .Where(u => !string.IsNullOrWhiteSpace(u))
            .Select(u => u.Trim().ToLowerInvariant())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(u => u)
            .ToList();
    }

    private bool IsConfirmDisabled =>
        string.IsNullOrWhiteSpace(_user) ||
        (RequireComment && string.IsNullOrWhiteSpace(_assignedComment));

    private void Cancel() => MudDialog.Cancel();

    private Task OnMentionsChanged(string value)
    {
        _mentionsComment = value ?? string.Empty;

        UpdateMentionSuggestions(_mentionsComment);
        ExtractMentionedUsers();

        return Task.CompletedTask;
    }
    
    private void UpdateMentionSuggestions(string text)
    {
        _mentionSuggestions.Clear();
        _mentionOpen = false;
        _selectedMentionIndex = -1;

        if (string.IsNullOrWhiteSpace(text) || !_allUsers.Any())
            return;

        var match = Regex.Match(text, @"(?:^|\s)@([a-zA-Z0-9._-]*)$");
        if (!match.Success)
            return;

        var query = match.Groups[1].Value;

        if (string.IsNullOrEmpty(query))
        {
            _mentionSuggestions = _allUsers.ToList();
        }
        else
        {
            _mentionSuggestions = _allUsers
                .Where(u => u.Contains(query, StringComparison.OrdinalIgnoreCase))
                .ToList(); 
        }

        _mentionOpen = _mentionSuggestions.Count > 0;
        _selectedMentionIndex = _mentionOpen ? 0 : -1;
    }

    private async Task HandleMentionKeyDownMud(KeyboardEventArgs e)
    {
        _preventMentionKey =
            _mentionOpen &&
            _mentionSuggestions.Any() &&
            (e.Key == "Enter" || e.Key == "Tab" || e.Key == "ArrowDown" || e.Key == "ArrowUp");

        if (!_mentionOpen || !_mentionSuggestions.Any())
            return;

        switch (e.Key)
        {
            case "ArrowDown":
                _selectedMentionIndex++;
                if (_selectedMentionIndex >= _mentionSuggestions.Count)
                    _selectedMentionIndex = 0;

                StateHasChanged();
                await JS.InvokeVoidAsync("mentionsInterop.scrollActiveIntoView");
                break;

            case "ArrowUp":
                _selectedMentionIndex--;
                if (_selectedMentionIndex < 0)
                    _selectedMentionIndex = _mentionSuggestions.Count - 1;

                StateHasChanged();
                await JS.InvokeVoidAsync("mentionsInterop.scrollActiveIntoView");
                break;

            case "Enter":
            case "Tab":
                if (_selectedMentionIndex >= 0 && _selectedMentionIndex < _mentionSuggestions.Count)
                    await SelectMention(_mentionSuggestions[_selectedMentionIndex]);
                break;

            case "Escape":
                _mentionOpen = false;
                _mentionSuggestions.Clear();
                _selectedMentionIndex = -1;
                StateHasChanged();
                break;
        }
    }

    private async Task SelectMention(string selectedUser)
{
    var current = _mentionsComment ?? "";

    _mentionsComment = string.IsNullOrWhiteSpace(current)
        ? $"@{selectedUser} "
        : Regex.Replace(
            current,
            @"(?:^|\s)@([a-zA-Z0-9._-]*)$",
            m => $"{(m.Value.StartsWith(" ") ? " " : "")}@{selectedUser} "
        );

    _mentionOpen = false;
    _mentionSuggestions.Clear();
    _selectedMentionIndex = -1;
    _preventMentionKey = false;

    ExtractMentionedUsers();

    await JS.InvokeVoidAsync("mentionsInterop.setValue", "mentionBox", _mentionsComment);

    await InvokeAsync(StateHasChanged);
}
  
    private void ExtractMentionedUsers()
    {
        if (string.IsNullOrWhiteSpace(_mentionsComment))
        {
            _mentionedUsers.Clear();
            return;
        }

        _mentionedUsers = Regex.Matches(
                _mentionsComment,
                @"(?<![a-zA-Z0-9._-])@([a-zA-Z0-9._-]+)",
                RegexOptions.IgnoreCase)
            .Select(m => m.Groups[1].Value.Trim().ToLowerInvariant())
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

   

    private void OkAssign()
    {
        var result = new ForwardResult
        {
            User = _user!,
            AssignedComment = _assignedComment,
            MentionsComment = _mentionsComment,
            MentionedUsers = _mentionedUsers.ToList(),
            FollowMe = false
        };

        MudDialog.Close(DialogResult.Ok(result));
    }

    private void OkAssignAndFollow()
    {
        var result = new ForwardResult
        {
            User = _user!,
            AssignedComment = _assignedComment,
            MentionsComment = _mentionsComment,
            MentionedUsers = _mentionedUsers.ToList(),
            FollowMe = true
        };

        MudDialog.Close(DialogResult.Ok(result));
    }
}