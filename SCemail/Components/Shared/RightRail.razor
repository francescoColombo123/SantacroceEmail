@using Microsoft.AspNetCore.Components
@inject NavigationManager Nav

<div class="rail"
     @onmouseenter="(() => _open = true)"
     @onmouseleave="(() => _open = false)">
    <button class="rail-pin" title="@(_pinned ? "Sblocca" : "Blocca")" @onclick="TogglePin" aria-pressed="@_pinned">
        📌
    </button>

    <div class="rail-inner @( _open || _pinned ? "open" : "" )" role="navigation" aria-label="Azioni rapide">
        <button class="rail-btn" @onclick="GoMail">
            <span class="ico" aria-hidden="true">📧</span>
            <span class="lbl">Mail</span>
        </button>
        <button class="rail-btn" @onclick="GoTasks">
            <span class="ico" aria-hidden="true">📝</span>
            <span class="lbl">Task</span>
        </button>
    </div>
    <div class="rail-hoverzone" aria-hidden="true"></div>
</div>

<style>
    /* dimensioni */
    :root {
        --rail-collapsed: 52px;
        --rail-expanded: 220px;
    }

    body:has(.rail-inner.open) .page,
    body:has(.rail:hover) .page {
        padding-left: var(--rail-expanded);
    }
    /* rail fissa a sinistra */
    .rail {
        position: fixed;
        left: 0;
        top: 64px;
        bottom: 24px;
        width: var(--rail-collapsed);
        z-index: 50;
    }

    .rail-inner {
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: var(--rail-collapsed);
        background: #E3EEFB;
        border-right: 1px solid #D6E2FF;
        padding: 8px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        border-top-right-radius: 12px;
        border-bottom-right-radius: 12px;
        transition: width .18s ease, box-shadow .18s ease;
        overflow: hidden;
    }

        .rail-inner.open {
            width: var(--rail-expanded);
            box-shadow: 6px 8px 18px rgba(0,0,0,.08);
        }

    .rail-btn {
        display: grid;
        grid-template-columns: 28px 1fr;
        gap: 8px;
        padding: 10px 12px;
        border-radius: 12px;
        border: 1px solid #D6E2FF;
        background: #fff;
        font: 500 14px system-ui,sans-serif;
        color: #003482;
        cursor: pointer;
    }

    .rail .lbl {
        opacity: 0;
        transition: opacity .16s ease;
        white-space: nowrap;
    }

    .rail-inner.open .lbl {
        opacity: 1;
    }

    .rail .ico {
        font-size: 18px;
        text-align: center;
    }

    /* 👉 Sposta la pagina: base = rail chiusa, su hover = rail aperta */
    .page {
        padding-left: var(--rail-collapsed);
        transition: padding-left .18s ease;
    }



    /* fallback, se sposti markup */

</style>

@code {
    private bool _open;
    private bool _pinned;
    [Parameter] public string? Username { get; set; }

    private void TogglePin() => _pinned = !_pinned;

    private void GoMail() =>
        Nav.NavigateTo(string.IsNullOrWhiteSpace(Username) ? "/mail" : $"/mail?username={Uri.EscapeDataString(Username)}");

    private void GoTasks() =>
        Nav.NavigateTo(string.IsNullOrWhiteSpace(Username) ? "/tasks" : $"/tasks?username={Uri.EscapeDataString(Username)}");
}