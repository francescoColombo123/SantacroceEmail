@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6">Modifica Password</MudText>
        <MudTextField @bind-Value="NuovaPassword"
                      Label="Nuova password"
                      InputType="InputType.Password"
                      Required="true"
                      Margin="Margin.Dense" />
    </DialogContent>

    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="Conferma" Variant="Variant.Filled">Conferma</MudButton>
        <MudButton Color="Color.Default" OnClick="Annulla" Variant="Variant.Outlined">Annulla</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    public string NuovaPassword { get; set; } = "";

    private void Conferma()
    {
        if (!string.IsNullOrWhiteSpace(NuovaPassword))
            MudDialog.Close(DialogResult.Ok(NuovaPassword));
    }

    private void Annulla() => MudDialog.Cancel();
}
