@page "/"
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject NavigationManager Nav
@inject SCemail.Components.Data.AccessiService AccessiSrv
@using Microsoft.AspNetCore.WebUtilities
@using SCemail.Components.Data
@inject IDbContextFactory<MailDbContext> DbFactory
@inject ISnackbar Snackbar

@code {
    private string? _cp;
    private string? _utente;
    private bool _hasCasella;
    private int _mentionsCount = 0;
    private bool _showMentionsAlert = false;
    private List<EmailMenzione> _mentions = new();
    private List<string> _caselleErrore = new();
    private bool _showCaselleAlert = false;
    protected override async Task OnInitializedAsync()
    {
        var q = QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        _cp = q.TryGetValue("cp", out var v) && !string.IsNullOrWhiteSpace(v)
            ? v.ToString()
            : null;

        _utente = await AccessiSrv.GetUtenteFromCpAsync(_cp);

        if (string.IsNullOrWhiteSpace(_utente))
            return;

        await using var db = await DbFactory.CreateDbContextAsync();

        _hasCasella = await db.CasellaAbilitazioni.CountAsync(a => a.Username == _utente) > 0;

        _mentions = await db.emailMenzionis
            .AsNoTracking()
            .Where(m => m.Utente == _utente && m.Visto == "N")
            .OrderByDescending(m => m.DataMenzione)
            .ToListAsync();

        _mentionsCount = _mentions.Count;
        _caselleErrore = await db.CasellePosta
    .AsNoTracking()
    .Where(c => c.StatoConn != "OK")
    .Select(c => c.Email)
    .ToListAsync();

        _showCaselleAlert = _caselleErrore.Any();
    }

    private string AdminDashboardHref =>
    string.IsNullOrWhiteSpace(_cp)
        ? "/admin-dashboard"
        : $"/admin-dashboard?cp={Uri.EscapeDataString(_cp)}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || string.IsNullOrWhiteSpace(_utente))
            return;

        if (firstRender && _mentionsCount > 0)
        {
            // Snackbar compatibile (solo testo)
            Snackbar.Add(
                $"Hai {_mentionsCount} nuove menzioni!",
                Severity.Warning,
                options =>
                {
                    options.ShowCloseIcon = true;
                    options.RequireInteraction = false;
                });

            // Mostra l’alert cliccabile nella pagina
            _showMentionsAlert = true;
            StateHasChanged();
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            _hasCasella = await db.CasellaAbilitazioni.CountAsync(a => a.Username == _utente) > 0;

            _mentionsCount = await db.emailMenzionis
                .AsNoTracking()
                .IgnoreAutoIncludes()
                .Where(m => m.Utente == _utente && m.Visto == "N")
                .CountAsync();


            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Errore durante il controllo casella: " + ex.Message);
            _hasCasella = false;
        }
    }
    private async void NavigateToMention()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        // 1️⃣ Se c’è solo UNA menzione non vista → apri direttamente quel messaggio
        if (_mentionsCount == 1)
        {
            var mention = await db.emailMenzionis
                .AsNoTracking()
                .Where(m => m.Utente == _utente && m.Visto == "N")
                .OrderBy(m => m.Id)
                .FirstOrDefaultAsync();

            if (mention != null)
            {
                Nav.NavigateTo($"/mail-detail/{mention.EmailId}/{_cp}");
                return;
            }
        }

        // 2️⃣ Altrimenti → apri la cartella “Menzioni”
        Nav.NavigateTo($"/mail-new?cp={_cp}&folder=mentions");
    }

    private string MailHref => string.IsNullOrWhiteSpace(_cp) ? "/mail" : $"/mail-new?cp={Uri.EscapeDataString(_cp)}";
    private string TaskHref => string.IsNullOrWhiteSpace(_cp) ? "/tasks" : $"/tasks-new?cp={Uri.EscapeDataString(_cp)}";
    private string AbilitazioniHref => string.IsNullOrWhiteSpace(_cp) ? "/abilitazioni" : $"/abilitazioni?cp={Uri.EscapeDataString(_cp)}";
    private string ConfigurazioneHref => string.IsNullOrWhiteSpace(_cp)
    ? "/configurazione"
    : $"/configurazione?cp={Uri.EscapeDataString(_cp)}";
    private string RegoleHref =>
    string.IsNullOrWhiteSpace(_cp)
        ? "/regole"
        : $"/regole?cp={Uri.EscapeDataString(_cp)}";
    private string RubricaHref =>
string.IsNullOrWhiteSpace(_cp)
    ? "/rubrica"
    : $"/rubrica?cp={Uri.EscapeDataString(_cp)}";

    private static readonly HashSet<string> AdminUsers = new(StringComparer.OrdinalIgnoreCase)
    {
        "admin",
        "c.diiorio",
        "b.demilio"
    };

    private bool IsAdmin => AdminUsers.Contains(_utente);
}

<PageTitle>GS – Workspace</PageTitle>

<div class="page">
    <div class="welcome">
        <div class="hero">
            <h1>Benvenuto in <span>GS – WORKSPACE</span></h1>
            <p>Gestisci <b>Mail</b> e <b>Task</b> nella stessa interfaccia.</p>
            <div class="cta">
                <MudButton Color="Color.Primary" Variant="Variant.Filled" Href="@MailHref" StartIcon="@Icons.Material.Filled.Mail">
                    Apri Mail
                   

                </MudButton>
                <MudButton Color="Color.Secondary" Variant="Variant.Outlined" Href="@TaskHref" StartIcon="@Icons.Material.Filled.TaskAlt">
                    Vai ai Task
                </MudButton>

                @if (IsAdmin)
                {
                    <MudButton Color="Color.Info" Variant="Variant.Outlined" Href="@AbilitazioniHref" StartIcon="@Icons.Material.Filled.PersonAdd">
                        Abilitazioni
                    </MudButton>
                    <MudButton Color="Color.Warning" Variant="Variant.Outlined" Href="@ConfigurazioneHref" StartIcon="@Icons.Material.Filled.Settings">
                        Configurazione
                    </MudButton>
                    <MudButton Color="Color.Success" Variant="Variant.Outlined" Href="@RegoleHref" StartIcon="@Icons.Material.Filled.Rule">
                        Regole
                    </MudButton>
                    <MudButton Color="Color.Primary"
                               Variant="Variant.Filled"
                               Href="@AdminDashboardHref"
                               StartIcon="@Icons.Material.Filled.Dashboard">
                        Dashboard Amministrazione
                    </MudButton>
                    <MudButton Color="Color.Info"
                               Variant="Variant.Outlined"
                               Href="@RubricaHref"
                               StartIcon="@Icons.Material.Filled.Contacts">
                        Rubrica
                    </MudButton>
                }
            </div>
            @if (_mentions.Any())
            {
                <div class="mentions-panel">
                    <div class="mentions-title">
                        🔔 Attività nelle chat che segui
                    </div>

                    @foreach (var m in _mentions.Take(3))
                    {
                        <div class="mention-row"
                             @onclick="@(() => Nav.NavigateTo($"/mail-detail/{m.EmailId}/{_cp}"))">

                            <span class="badge @(m.TipoEvento == "MENTION" ? "mention" : "update")">
                                @(m.TipoEvento == "MENTION" ? "@ menzione" : "💬 nuovo messaggio")
                            </span>

                            <span class="text">
                                Email #@m.EmailId
                            </span>
                        </div>
                    }

                    @if (_mentions.Count > 3)
                    {
                        <div class="mention-more"
                             @onclick="@(() => Nav.NavigateTo($"/mail-new?cp={_cp}&folder=mentions"))">
                            Vedi tutte (@_mentions.Count)
                        </div>
                    }
                </div>
            }
            @if (_showCaselleAlert)
            {
                <div class="mentions-panel" style="background:#fdecea; border:1px solid #f5c6cb;">
                    <div class="mentions-title" style="color:#721c24;">
                        🔐 Attenzione: password email non valida
                    </div>

                    @foreach (var mail in _caselleErrore)
                    {
                        <div class="mention-row"
                             @onclick="@(() => Nav.NavigateTo(ConfigurazioneHref))">

                            <span class="badge mention">ERRORE</span>

                            <span class="text">
                                È necessario aggiornare la <b>password per l’app</b> della casella
                                <b>@mail</b>
                            </span>
                        </div>
                    }
                </div>
            }
    </div>


    </div>
</div>

<style>
    .welcome {
        padding: 8px;
    }

    .hero {
        background: #E3EEFB;
        border: 2px ridge #166AEE;
        border-radius: 10px;
        padding: 22px;
    }

    .mention-badge {
        background: #d32f2f;
        color: white;
        padding: 2px 8px;
        border-radius: 12px;
        margin-left: 6px;
        font-size: 12px;
    }

        .hero h1 {
            margin: 0 0 6px;
            font: 700 24px system-ui, sans-serif;
            color: #003482;
        }

            .hero h1 span {
                color: #166AEE;
            }

        .hero p {
            margin: 0 0 12px;
            color: #405069;
        }

        .mentions-panel {
            margin-top: 20px;
            background: #fff3cd;
            border: 1px solid #ffe69c;
            border-radius: 10px;
            padding: 14px;
        }

        .mentions-title {
            font-weight: 700;
            margin-bottom: 10px;
            color: #856404;
        }

        .mention-row {
            display: flex;
            gap: 10px;
            padding: 8px;
            border-radius: 6px;
            cursor: pointer;
        }

            .mention-row:hover {
                background: #fff8e1;
            }

        .badge {
            font-size: 12px;
            padding: 2px 6px;
            border-radius: 6px;
            font-weight: 600;
        }

            .badge.mention {
                background: #dc3545;
                color: white;
            }

            .badge.update {
                background: #0d6efd;
                color: white;
            }

        .mention-more {
            margin-top: 10px;
            font-size: 13px;
            color: #0d6efd;
            cursor: pointer;
        }

    .cta {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }
    .mentions-bar {
    margin-top: 16px;
    background: #0F47A1;
    border: 1px solid #0A3780;
    color: white;
    padding: 12px 16px;
    border-radius: 8px;
    font-size: 15px;
    cursor: pointer;
    user-select: none;
    transition: background .25s ease, transform .15s ease;
    display: flex;
    align-items: center;
    gap: 8px;
}

.mentions-bar:hover {
    background: #0C3A8A;
    transform: translateY(-1px);
}

</style>
