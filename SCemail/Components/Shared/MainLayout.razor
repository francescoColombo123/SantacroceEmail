@inherits LayoutComponentBase
@using MudBlazor

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<div class="content">
    <main class="content-frame">
        @Body
    </main>
</div>

<style>
    :root {
        --bg-page: #F0F4FF;
        --brand: #003482;
        --border: #CCCCCC;
    }

    .content {
        padding-left: 0;
        display: grid;
        grid-template-rows: 1fr;
        min-height: 100dvh;
        background: var(--bg-page);
    }

    .content-frame {
        padding: 16px;
        overflow: auto;
        height: 100%;
    }
</style>

@code {
    private string _today = DateTime.Now.ToString("dddd dd MMMM yyyy HH:mm");
}
