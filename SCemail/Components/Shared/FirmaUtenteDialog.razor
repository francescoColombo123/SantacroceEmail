@using MudBlazor
@using SCemail.Components.Data

<MudDialog>
    <DialogContent>

        <MudText Typo="Typo.h6" Class="mb-2">
            @Title
        </MudText>

        <MudTextField @bind-Value="Nome"
                      Label="Nome (obbligatorio)"
                      Required="true"
                      Margin="Margin.Dense"
                      Class="mb-2" />

        <MudTextField @bind-Value="Titolo"
                      Label="Titolo"
                      Margin="Margin.Dense"
                      Class="mb-2" />

        <MudTextField @bind-Value="Recapito"
                      Label="Recapito"
                      Margin="Margin.Dense"
                      Class="mb-2" />

        <MudCheckBox @bind-Value="IsAdmin"
                     T="bool"
                     Label="Rendi questo utente amministratore della casella"
                     Color="Color.Primary"
                     Class="mt-2" />

    </DialogContent>

    <DialogActions>
        <MudButton Color="Color.Error" Variant="Variant.Text" OnClick="Cancel">
            Annulla
        </MudButton>

        <MudButton Color="Color.Primary" OnClick="Save" Disabled="@string.IsNullOrWhiteSpace(Nome)">
            Conferma
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }

    [Parameter] public string Title { get; set; } = "Dati firma utente";

    [Parameter] public string? Nome { get; set; }
    [Parameter] public string? Titolo { get; set; }
    [Parameter] public string? Recapito { get; set; }

    public bool IsAdmin { get; set; } = false;

    public class FirmaUtenteResult
    {
        public string Nome { get; set; }
        public string? Titolo { get; set; }
        public string? Recapito { get; set; }
        public bool IsAdmin { get; set; }
    }

    void Save()
    {
        MudDialog.Close(DialogResult.Ok(new FirmaUtenteResult
        {
            Nome = Nome!,
            Titolo = Titolo,
            Recapito = Recapito,
            IsAdmin = IsAdmin
        }));
    }

    void Cancel() => MudDialog.Cancel();
}
