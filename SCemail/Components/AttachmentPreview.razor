@using MudBlazor

<MudDialog>
    <TitleContent>
        Anteprima allegato
    </TitleContent>

    <DialogContent>
        <MudPaper Class="p-3">
            <img src="@FileUrl" alt="@FileName" class="img-fluid" />
        </MudPaper>
    </DialogContent>

    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Chiudi">Chiudi</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IDialogReference MudDialog { get; set; } = default!;
    [Parameter] public string FileUrl { get; set; } = string.Empty;
    [Parameter] public string FileName { get; set; } = string.Empty;

    private void Chiudi() => MudDialog.Close(DialogResult.Ok(true));
}
