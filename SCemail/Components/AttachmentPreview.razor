@using MudBlazor

<MudDialog>
    <MudDialogTitle>@Title</MudDialogTitle>

    <MudDialogContent>
        @if (IsImage)
        {
            <img src="@Url" alt="@Title"
                 style="max-width:100%; max-height:70vh; display:block; margin:auto;" />
        }
        else
        {
            <iframe src="@Url" title="@Title"
                    style="width:100%; height:70vh; border:0;"></iframe>
        }
    </MudDialogContent>

    <MudDialogActions>
        <MudButton OnClick="Close">Chiudi</MudButton>
        <MudButton Color="Color.Primary" Href="@DownloadUrl" Target="_blank">
            Scarica
        </MudButton>
    </MudDialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IDialogReference DialogRef { get; set; } = default!;

    [Parameter] public string Url { get; set; } = string.Empty;          // inline
    [Parameter] public string DownloadUrl { get; set; } = string.Empty;  // endpoint di download
    [Parameter] public string Title { get; set; } = string.Empty;

    private static readonly string[] ImageExt = [ ".png", ".jpg", ".jpeg", ".gif", ".webp", ".bmp" ];

    private bool IsImage
    {
        get
        {
            var ext = System.IO.Path.GetExtension(Url).ToLowerInvariant();
            if (string.IsNullOrEmpty(ext))
                ext = System.IO.Path.GetExtension(Title).ToLowerInvariant(); // fallback se l'URL è /inline
            return ImageExt.Contains(ext);
        }
    }

    private void Close() => DialogRef.Close();
}
