@page "/rubrica"

@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Primitives
@using Microsoft.JSInterop
@using SCemail.Components.Data
@using CsvHelper
@using CsvHelper.Configuration
@using System.Globalization

@inject RubricaImportService ImportService
@inject IDbContextFactory<MailDbContext> DbFactory
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject IJSRuntime JS


<MudPaper Class="pa-4 mx-auto rubrica-paper" Elevation="3">

    @* =========================================================
       HEADER
       ========================================================= *@

    <MudStack Direction="Row"
              Justify="Justify.SpaceBetween"
              AlignItems="AlignItems.Center">

        <MudText Typo="Typo.h5">
            📒 Rubrica Contatti
        </MudText>

        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Home"
                   OnClick="GoHome">
            Home
        </MudButton>

    </MudStack>


    <MudDivider Class="my-3" />


    @* =========================================================
       IMPORT CSV
       ========================================================= *@

    <InputFile id="rubricaFile"
               OnChange="HandleFile"
               accept=".csv"
               class="offscreen-input" />


    <div id="rubricaDropZone"
         class="drop-zone mt-3 @(_dragOver ? "dragover" : "")"
         @onclick="OpenFilePicker"
         @ondragover="OnDragOver"
         @ondragleave="OnDragLeave">

        <MudIcon Icon="@Icons.Material.Filled.UploadFile"
                 Size="Size.Large"
                 Color="Color.Primary" />

        <div class="mt-2">
            Trascina qui il CSV o clicca per selezionarlo
        </div>

        <div class="mt-1">
            Poi premi “Importa”
        </div>

    </div>


    @if (_csvFileName != null)
    {
        <MudStack Direction="Row"
                  Spacing="2"
                  AlignItems="AlignItems.Center"
                  Class="mt-2">

            <MudText Typo="Typo.caption">
                📄 @_csvFileName
            </MudText>

            <MudButton Color="Color.Success"
                       Variant="Variant.Filled"
                       Disabled="_isImporting"
                       OnClick="ImportCsv">
                Importa
            </MudButton>

            <MudButton Variant="Variant.Outlined"
                       Disabled="_isImporting"
                       OnClick="ClearSelectedFile">
                Rimuovi
            </MudButton>

        </MudStack>
    }


    @if (_isImporting)
    {
        <MudAlert Severity="Severity.Info"
                  Class="mt-2">

            ⏳ Importazione in corso:
            @_processed / @_total

        </MudAlert>
    }


    <MudDivider Class="my-4" />


    @* =========================================================
       TABELLA RUBRICA
       ========================================================= *@

    <MudTable T="RubricaContatto"
              ServerData="LoadServerData"
              Dense
              Hover
              Bordered
              RowsPerPage="30"
              RowsPerPageOptions="new int[] { 20, 30 }"
              Loading="_loading"
              Class="rubrica-table"
              @ref="_table">


        @* =========================
           RICERCA
           ========================= *@

        <ToolBarContent>

            <MudTextField T="string"
                          Value="_search"
                          ValueChanged="OnSearchChanged"
                          Placeholder="Cerca nome, cognome, azienda, email, telefono o codice cliente..."
                          Immediate="true"
                          DebounceInterval="250"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          FullWidth="true" />

        </ToolBarContent>


        @* =========================
           INTESTAZIONI
           ========================= *@

       <HeaderContent>

    <MudTh>
        <MudTableSortLabel SortLabel="codice"
                           T="RubricaContatto">
            Cod. Cliente
        </MudTableSortLabel>
    </MudTh>

    <MudTh>
        <MudTableSortLabel SortLabel="nome"
                           T="RubricaContatto">
            Nome
        </MudTableSortLabel>
    </MudTh>

    <MudTh>
        <MudTableSortLabel SortLabel="cognome"
                           T="RubricaContatto">
            Cognome
        </MudTableSortLabel>
    </MudTh>

    <MudTh>
        <MudTableSortLabel SortLabel="azienda"
                           T="RubricaContatto">
            Azienda
        </MudTableSortLabel>
    </MudTh>

    <MudTh>
        <MudTableSortLabel SortLabel="email"
                           T="RubricaContatto">
            Email
        </MudTableSortLabel>
    </MudTh>

    <MudTh>
        <MudTableSortLabel SortLabel="ufficio"
                           T="RubricaContatto">
            Tel. Ufficio
        </MudTableSortLabel>
    </MudTh>

    <MudTh>
        <MudTableSortLabel SortLabel="cellulare"
                           T="RubricaContatto">
            Cellulare
        </MudTableSortLabel>
    </MudTh>

    <MudTh>
        <MudTableSortLabel SortLabel="privato"
                           T="RubricaContatto">
            Tel. Privato
        </MudTableSortLabel>
    </MudTh>

    <MudTh Align="Align.Center">
        Azioni
    </MudTh>

</HeaderContent>


        @* =========================
           RIGHE
           ========================= *@

        <RowTemplate>

            @* CODICE CLIENTE *@

            <MudTd DataLabel="Cod. Cliente">

                @if (context.CodiceCliente.HasValue)
                {
                    @context.CodiceCliente
                }
                else
                {
                    <span class="empty-value">-</span>
                }

            </MudTd>


            @* NOME + TITOLO + SECONDO NOME *@

            <MudTd DataLabel="Nome">

                <div class="contact-name">

                    @if (!string.IsNullOrWhiteSpace(context.Titolo))
                    {
                        <span class="contact-title">
                            @context.Titolo
                        </span>
                    }

                    @if (!string.IsNullOrWhiteSpace(context.FirstName))
                    {
                        <span>
                            @context.FirstName
                        </span>
                    }
                    else
                    {
                        <span class="empty-value">-</span>
                    }

                    @if (!string.IsNullOrWhiteSpace(context.MiddleName))
                    {
                        <span>
                            @context.MiddleName
                        </span>
                    }

                </div>

            </MudTd>


            @* COGNOME *@

            <MudTd DataLabel="Cognome">

                @if (!string.IsNullOrWhiteSpace(context.LastName))
                {
                    @context.LastName
                }
                else
                {
                    <span class="empty-value">-</span>
                }

            </MudTd>


            @* AZIENDA *@

            <MudTd DataLabel="Azienda">

                @if (!string.IsNullOrWhiteSpace(context.Azienda))
                {
                    @context.Azienda
                }
                else
                {
                    <span class="empty-value">-</span>
                }

            </MudTd>


            @* EMAIL *@

            <MudTd DataLabel="Email">

                @if (!string.IsNullOrWhiteSpace(context.Email))
                {
                    @context.Email
                }
                else
                {
                    <span class="empty-value">-</span>
                }

            </MudTd>


            @* TELEFONO UFFICIO *@

            <MudTd DataLabel="Tel. Ufficio">

                @if (!string.IsNullOrWhiteSpace(context.TelefonoUfficio))
                {
                    @context.TelefonoUfficio
                }
                else
                {
                    <span class="empty-value">-</span>
                }

            </MudTd>


            @* CELLULARE *@

            <MudTd DataLabel="Cellulare">

                @if (!string.IsNullOrWhiteSpace(context.TelefonoCellulare))
                {
                    @context.TelefonoCellulare
                }
                else
                {
                    <span class="empty-value">-</span>
                }

            </MudTd>


            @* TELEFONO PRIVATO *@

            <MudTd DataLabel="Tel. Privato">

                @if (!string.IsNullOrWhiteSpace(context.TelefonoPrivato))
                {
                    @context.TelefonoPrivato
                }
                else
                {
                    <span class="empty-value">-</span>
                }

            </MudTd>


            @* AZIONI *@

            <MudTd DataLabel="Azioni"
                   Align="Align.Center">

                <MudStack Direction="Row"
                          Spacing="0"
                          Justify="Justify.Center"
                          AlignItems="AlignItems.Center">

                    <MudTooltip Text="Modifica contatto">

                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="@(async () => await OpenEdit(context))" />

                    </MudTooltip>


                    <MudTooltip Text="Elimina contatto">

                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="@(async () => await Delete(context))" />

                    </MudTooltip>

                </MudStack>

            </MudTd>

        </RowTemplate>


        @* =========================
           PAGINAZIONE
           ========================= *@

        <PagerContent>
            <MudTablePager />
        </PagerContent>

    </MudTable>

</MudPaper>


<style>

    /* =========================================================
           CONTENITORE PRINCIPALE
           ========================================================= */

    .rubrica-paper {
        width: 96vw;
        max-width: 1800px;
        margin-top: 8px;
        margin-bottom: 20px;
    }


    /* =========================================================
           TABELLA
           ========================================================= */

    .rubrica-table {
        width: 100%;
    }

        .rubrica-table .mud-table-container {
            width: 100%;
            overflow-x: auto;
        }

        .rubrica-table table {
            width: 100%;
            white-space: nowrap;
        }

        .rubrica-table th {
            font-size: 12px;
            font-weight: 700;
            padding: 8px 10px !important;
            vertical-align: middle;
        }

        .rubrica-table td {
            font-size: 12px;
            padding: 6px 10px !important;
            vertical-align: middle;
        }


    /* =========================================================
           NOME CONTATTO
           ========================================================= */

    .contact-name {
        display: flex;
        align-items: center;
        gap: 4px;
        white-space: nowrap;
    }

    .contact-title {
        font-weight: 600;
    }


    /* =========================================================
           CAMPI VUOTI
           ========================================================= */

    .empty-value {
        color: #9ca3af;
    }


    /* =========================================================
           DROP ZONE CSV
           ========================================================= */

    .drop-zone {
        display: block;
        border: 2px dashed #1976d2;
        padding: 18px;
        border-radius: 10px;
        background: #f5faff;
        cursor: pointer;
        transition: background-color .15s ease, border-color .15s ease;
    }

        .drop-zone:hover {
            background: #e3f2fd;
        }

        .drop-zone.dragover {
            background: #e3f2fd;
            border-color: #0d47a1;
        }


    /* =========================================================
           INPUT FILE NASCOSTO
           ========================================================= */

    .offscreen-input {
        position: absolute;
        left: -10000px;
        top: auto;
        width: 1px;
        height: 1px;
        opacity: 0;
    }


    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 1200px) {

        .rubrica-paper {
            width: 98vw;
        }

        .rubrica-table table {
            min-width: 1300px;
        }
    }
</style>


@code {

    /* =========================================================
       COSTANTI
       ========================================================= */

    private const int BATCH_SIZE = 200;
    private const int EMAIL1_INDEX = 18;


    /* =========================================================
       STATO RUBRICA
       ========================================================= */

    private List<RubricaContatto> _contatti = new();

    private MudTable<RubricaContatto>? _table;

    private bool _loading;

    private string _search = "";

    private string? _cp;


    /* =========================================================
       IMPORT CSV
       ========================================================= */

    private IBrowserFile? _file;

    private byte[]? _csvBytes;

    private string? _csvFileName;

    private bool _isImporting;

    private int _total;

    private int _processed;

    private int _added;

    private int _skipped;

    private bool _dragOver;


    /* =========================================================
       JS
       ========================================================= */

    private DotNetObjectReference<Rubrica>? _dotNetRef;


    /* =========================================================
       INIZIALIZZAZIONE
       ========================================================= */

    protected override Task OnInitializedAsync()
    {
        var q = QueryHelpers.ParseQuery(
            new Uri(Nav.Uri).Query
        );

        _cp =
            q.TryGetValue("cp", out var v) &&
            !StringValues.IsNullOrEmpty(v)
                ? v.ToString()
                : null;

        return Task.CompletedTask;
    }


    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender)
            return;

        _dotNetRef =
            DotNetObjectReference.Create(this);

        await JS.InvokeVoidAsync(
            "rubricaDrop.init",
            "rubricaDropZone",
            _dotNetRef
        );
    }


    public void Dispose()
    {
        _dotNetRef?.Dispose();
    }


    /* =========================================================
       DRAG & DROP
       ========================================================= */

    private void OnDragOver(DragEventArgs e)
    {
        _dragOver = true;
    }


    private void OnDragLeave(DragEventArgs e)
    {
        _dragOver = false;
    }


    [JSInvokable]
    public async Task OnFileDropped(
        string name,
        string base64)
    {
        _dragOver = false;

        _csvFileName = name;

        _csvBytes =
            Convert.FromBase64String(base64);

        _file = null;

        Snackbar.Add(
            $"📄 CSV caricato via drop: {_csvFileName}",
            Severity.Info
        );

        await InvokeAsync(StateHasChanged);
    }


    private async Task OpenFilePicker()
    {
        await JS.InvokeVoidAsync(
            "rubricaDrop.openPicker",
            "rubricaFile"
        );
    }


    private void ClearSelectedFile()
    {
        _file = null;
        _csvBytes = null;
        _csvFileName = null;

        _ = JS.InvokeVoidAsync(
            "rubricaDrop.clearInput",
            "rubricaFile"
        );
    }


    private Task HandleFile(
        InputFileChangeEventArgs e)
    {
        _file = e.File;

        _csvBytes = null;

        _csvFileName = e.File.Name;

        Snackbar.Add(
            $"📄 CSV caricato: {_csvFileName}",
            Severity.Info
        );

        return Task.CompletedTask;
    }


    /* =========================================================
       CARICAMENTO TABELLA
       ========================================================= */

    private async Task<TableData<RubricaContatto>>
        LoadServerData(
            TableState state,
            CancellationToken ct)
    {
        _loading = true;

        try
        {
            await using var db =
                DbFactory.CreateDbContext();

            var q =
                db.RubricaContatti
                    .AsNoTracking();


            /* =============================================
               RICERCA
               ============================================= */

            if (!string.IsNullOrWhiteSpace(_search))
            {
                var search = _search.Trim();

                q = q.Where(c =>

                    (c.FirstName ?? "")
                        .Contains(search) ||

                    (c.MiddleName ?? "")
                        .Contains(search) ||

                    (c.LastName ?? "")
                        .Contains(search) ||

                    (c.Email ?? "")
                        .Contains(search) ||

                    (c.Azienda ?? "")
                        .Contains(search) ||

                    (c.TelefonoUfficio ?? "")
                        .Contains(search) ||

                    (c.TelefonoCellulare ?? "")
                        .Contains(search) ||

                    (c.TelefonoPrivato ?? "")
                        .Contains(search) ||

                    (
                        c.CodiceCliente.HasValue &&
                        c.CodiceCliente.Value
                            .ToString()
                            .Contains(search)
                    )
                );
            }


            /* =============================================
               ORDINAMENTO
               ============================================= */

            /* =============================================
   ORDINAMENTO
   ============================================= */

            var descending =
                state.SortDirection == SortDirection.Descending;

            q = state.SortLabel switch
            {
                "codice" => descending
                    ? q.OrderByDescending(c => c.CodiceCliente)
                    : q.OrderBy(c => c.CodiceCliente),

                "nome" => descending
                    ? q.OrderByDescending(c => c.FirstName)
                         .ThenByDescending(c => c.LastName)
                    : q.OrderBy(c => c.FirstName)
                         .ThenBy(c => c.LastName),

                "cognome" => descending
                    ? q.OrderByDescending(c => c.LastName)
                         .ThenByDescending(c => c.FirstName)
                    : q.OrderBy(c => c.LastName)
                         .ThenBy(c => c.FirstName),

                "azienda" => descending
                    ? q.OrderByDescending(c => c.Azienda)
                         .ThenByDescending(c => c.LastName)
                    : q.OrderBy(c => c.Azienda)
                         .ThenBy(c => c.LastName),

                "email" => descending
                    ? q.OrderByDescending(c => c.Email)
                    : q.OrderBy(c => c.Email),

                "ufficio" => descending
                    ? q.OrderByDescending(c => c.TelefonoUfficio)
                    : q.OrderBy(c => c.TelefonoUfficio),

                "cellulare" => descending
                    ? q.OrderByDescending(c => c.TelefonoCellulare)
                    : q.OrderBy(c => c.TelefonoCellulare),

                "privato" => descending
                    ? q.OrderByDescending(c => c.TelefonoPrivato)
                    : q.OrderBy(c => c.TelefonoPrivato),

                // Ordinamento iniziale della rubrica
                _ => q.OrderBy(c => c.LastName)
                      .ThenBy(c => c.FirstName)
            };


            /* =============================================
               PAGINAZIONE
               ============================================= */

            var total =
                await q.CountAsync(ct);

            var items =
                await q
                    .Skip(
                        state.Page *
                        state.PageSize
                    )
                    .Take(state.PageSize)
                    .ToListAsync(ct);


            return new TableData<RubricaContatto>
            {
                TotalItems = total,
                Items = items
            };
        }
        finally
        {
            _loading = false;
        }
    }


    private async Task OnSearchChanged(
        string? value)
    {
        _search = value ?? "";

        if (_table != null)
        {
            await _table.ReloadServerData();
        }
    }


    /* =========================================================
       MODIFICA CONTATTO
       ========================================================= */

    private async Task OpenEdit(
        RubricaContatto c)
    {
        var parameters =
            new DialogParameters
            {
                ["Model"] =
                    new RubricaContatto
                    {
                        Id = c.Id,

                        CodiceCliente =
                            c.CodiceCliente,

                        Titolo =
                            c.Titolo,

                        FirstName =
                            c.FirstName,

                        MiddleName =
                            c.MiddleName,

                        LastName =
                            c.LastName,

                        Azienda =
                            c.Azienda,

                        Email =
                            c.Email,

                        TelefonoUfficio =
                            c.TelefonoUfficio,

                        TelefonoCellulare =
                            c.TelefonoCellulare,

                        TelefonoPrivato =
                            c.TelefonoPrivato,

                        CreatedAt =
                            c.CreatedAt
                    }
            };


        var options =
            new DialogOptions
            {
                CloseButton = true,
                MaxWidth = MaxWidth.Medium,
                FullWidth = true
            };


        var dialog =
            DialogService.Show<RubricaEditDialog>(
                "Modifica contatto",
                parameters,
                options
            );


        var result =
            await dialog.Result;


        if (!result.Canceled)
        {
            if (_table != null)
            {
                await _table.ReloadServerData();
            }
        }
    }


    /* =========================================================
       ELIMINAZIONE CONTATTO
       ========================================================= */

    private async Task Delete(
        RubricaContatto c)
    {
        try
        {
            await using var db =
                DbFactory.CreateDbContext();

            /*
             * La tabella usa AsNoTracking,
             * quindi recuperiamo l'entità dal DB.
             */
            var entity =
                await db.RubricaContatti
                    .FirstOrDefaultAsync(
                        x => x.Id == c.Id
                    );

            if (entity == null)
            {
                Snackbar.Add(
                    "Contatto non trovato.",
                    Severity.Warning
                );

                return;
            }


            db.RubricaContatti.Remove(entity);

            await db.SaveChangesAsync();


            Snackbar.Add(
                "🗑️ Contatto eliminato",
                Severity.Success
            );


            if (_table != null)
            {
                await _table.ReloadServerData();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Errore durante l'eliminazione: {ex.Message}",
                Severity.Error
            );
        }
    }


    /* =========================================================
       IMPORT CSV
       ========================================================= */
    private async Task ImportCsv()
    {
        if (_file == null && _csvBytes == null)
        {
            Snackbar.Add(
                "❌ Seleziona o trascina un CSV prima di importare.",
                Severity.Warning
            );

            return;
        }

        _isImporting = true;

        _processed = 0;
        _added = 0;
        _skipped = 0;

        try
        {
            await using var db =
                DbFactory.CreateDbContext();

            var cfg =
                new CsvConfiguration(
                    CultureInfo.InvariantCulture
                )
                {
                    HasHeaderRecord = true,
                    DetectDelimiter = true,
                    BadDataFound = null,
                    MissingFieldFound = null,
                    HeaderValidated = null,
                    TrimOptions = TrimOptions.Trim
                };

            Stream stream;

            if (_csvBytes != null)
            {
                stream =
                    new MemoryStream(_csvBytes);
            }
            else
            {
                stream =
                    _file!.OpenReadStream(
                        50_000_000
                    );
            }

            await using (stream)
            using (var reader =
                   new StreamReader(stream))
            using (var csv =
                   new CsvReader(reader, cfg))
            {
                /*
                 * ==============================
                 * HEADER
                 * ==============================
                 */

                if (!await csv.ReadAsync())
                {
                    throw new Exception(
                        "Il CSV è vuoto."
                    );
                }

                csv.ReadHeader();

                var buffer =
                    new List<RubricaContatto>(
                        BATCH_SIZE
                    );


                /*
                 * ==============================
                 * LETTURA CONTATTI
                 * ==============================
                 */

                while (await csv.ReadAsync())
                {
                    _processed++;


                    // --------------------------
                    // NOMI
                    // --------------------------

                    var firstName =
                        GetCsvField(
                            csv,
                            "First Name"
                        );

                    var middleName =
                        GetCsvField(
                            csv,
                            "Middle Name"
                        );

                    var lastName =
                        GetCsvField(
                            csv,
                            "Last Name"
                        );


                    // --------------------------
                    // TITOLO
                    // --------------------------

                    var prefix =
                        GetCsvField(
                            csv,
                            "Name Prefix"
                        );

                    var titolo =
                        NormalizeTitle(prefix);


                    /*
                     * Alcuni contatti hanno ad esempio:
                     *
                     * Aldo,Dott,D'Aloia
                     *
                     * quindi Google ha messo Dott
                     * dentro Middle Name.
                     */

                    if (string.IsNullOrWhiteSpace(titolo))
                    {
                        var middleTitle =
                            NormalizeTitle(
                                middleName
                            );

                        if (!string.IsNullOrWhiteSpace(
                                middleTitle))
                        {
                            titolo = middleTitle;
                            middleName = null;
                        }
                    }


                    // --------------------------
                    // AZIENDA
                    // --------------------------

                    var azienda =
                        GetCsvField(
                            csv,
                            "Organization Name"
                        );

                    var department =
                        GetCsvField(
                            csv,
                            "Organization Department"
                        );


                    /*
                     * Se Organization Name è vuoto
                     * ma abbiamo il reparto,
                     * conserviamo almeno quello.
                     */

                    if (string.IsNullOrWhiteSpace(
                            azienda) &&
                        !string.IsNullOrWhiteSpace(
                            department))
                    {
                        azienda = department;
                    }


                    // --------------------------
                    // EMAIL
                    // --------------------------

                    var email =
                        FirstNotEmpty(
                            GetCsvField(
                                csv,
                                "E-mail 1 - Value"
                            ),
                            GetCsvField(
                                csv,
                                "Email 1 - Value"
                            ),
                            GetCsvField(
                                csv,
                                "E-mail 2 - Value"
                            ),
                            GetCsvField(
                                csv,
                                "Email 2 - Value"
                            ),
                            GetCsvField(
                                csv,
                                "E-mail 3 - Value"
                            ),
                            GetCsvField(
                                csv,
                                "Email 3 - Value"
                            ),
                            GetCsvField(
                                csv,
                                "E-mail 4 - Value"
                            ),
                            GetCsvField(
                                csv,
                                "Email 4 - Value"
                            )
                        );

                    email =
                        NormalizeEmailNullable(
                            email
                        );


                    // --------------------------
                    // TELEFONI
                    // --------------------------

                    string? telefonoUfficio = null;
                    string? telefonoCellulare = null;
                    string? telefonoPrivato = null;


                    ProcessPhone(
                        GetCsvField(
                            csv,
                            "Phone 1 - Label"
                        ),
                        GetCsvField(
                            csv,
                            "Phone 1 - Value"
                        ),
                        ref telefonoUfficio,
                        ref telefonoCellulare,
                        ref telefonoPrivato
                    );


                    ProcessPhone(
                        GetCsvField(
                            csv,
                            "Phone 2 - Label"
                        ),
                        GetCsvField(
                            csv,
                            "Phone 2 - Value"
                        ),
                        ref telefonoUfficio,
                        ref telefonoCellulare,
                        ref telefonoPrivato
                    );


                    ProcessPhone(
                        GetCsvField(
                            csv,
                            "Phone 3 - Label"
                        ),
                        GetCsvField(
                            csv,
                            "Phone 3 - Value"
                        ),
                        ref telefonoUfficio,
                        ref telefonoCellulare,
                        ref telefonoPrivato
                    );


                    // --------------------------
                    // NORMALIZZAZIONE TESTI
                    // --------------------------

                    firstName =
                        NormalizeOptionalWords(
                            firstName
                        );

                    middleName =
                        NormalizeOptionalWords(
                            middleName
                        );

                    lastName =
                        NormalizeOptionalWords(
                            lastName
                        );

                    azienda =
                        NormalizeOptionalWords(
                            azienda
                        );


                    // --------------------------
                    // RIGA COMPLETAMENTE VUOTA?
                    // --------------------------

                    var hasUsefulData =
                        !string.IsNullOrWhiteSpace(
                            firstName) ||

                        !string.IsNullOrWhiteSpace(
                            middleName) ||

                        !string.IsNullOrWhiteSpace(
                            lastName) ||

                        !string.IsNullOrWhiteSpace(
                            azienda) ||

                        !string.IsNullOrWhiteSpace(
                            email) ||

                        !string.IsNullOrWhiteSpace(
                            telefonoUfficio) ||

                        !string.IsNullOrWhiteSpace(
                            telefonoCellulare) ||

                        !string.IsNullOrWhiteSpace(
                            telefonoPrivato);


                    if (!hasUsefulData)
                    {
                        _skipped++;
                        continue;
                    }


                    // --------------------------
                    // CREAZIONE CONTATTO
                    // --------------------------

                    var contact =
                        new RubricaContatto
                        {
                            CodiceCliente = null,

                            Titolo =
                                titolo ?? "",

                            FirstName =
                                firstName,

                            MiddleName =
                                middleName,

                            LastName =
                                lastName,

                            Azienda =
                                azienda,

                            Email =
                                email,

                            TelefonoUfficio =
                                telefonoUfficio,

                            TelefonoCellulare =
                                telefonoCellulare,

                            TelefonoPrivato =
                                telefonoPrivato,

                            CreatedAt =
                                DateTime.Now
                        };


                    buffer.Add(contact);

                    _added++;


                    // --------------------------
                    // SALVATAGGIO BATCH
                    // --------------------------

                    if (buffer.Count >= BATCH_SIZE)
                    {
                        db.RubricaContatti
                            .AddRange(buffer);

                        await db.SaveChangesAsync();

                        buffer.Clear();

                        db.ChangeTracker.Clear();

                        await InvokeAsync(
                            StateHasChanged
                        );
                    }
                }


                /*
                 * ==============================
                 * ULTIMO BATCH
                 * ==============================
                 */

                if (buffer.Count > 0)
                {
                    db.RubricaContatti
                        .AddRange(buffer);

                    await db.SaveChangesAsync();

                    buffer.Clear();

                    db.ChangeTracker.Clear();
                }
            }


            Snackbar.Add(
                $"✅ Import completato — " +
                $"Letti: {_processed}, " +
                $"Inseriti: {_added}, " +
                $"Scartati: {_skipped}",
                Severity.Success
            );


            if (_table != null)
            {
                await _table
                    .ReloadServerData();
            }
        }
        catch (DbUpdateException ex)
        {
            Snackbar.Add(
                $"❌ Errore DB: " +
                $"{ex.GetBaseException().Message}",
                Severity.Error
            );
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"❌ Import fallito: " +
                $"{ex.Message}",
                Severity.Error
            );
        }
        finally
        {
            _isImporting = false;

            _file = null;
            _csvBytes = null;
            _csvFileName = null;
        }
    }
    private static string? GetCsvField(
    CsvReader csv,
    string columnName)
    {
        try
        {
            if (csv.TryGetField<string>(
                    columnName,
                    out var value))
            {
                return string.IsNullOrWhiteSpace(value)
                    ? null
                    : value.Trim();
            }
        }
        catch
        {
            // Colonna non presente
        }

        return null;
    }


    private static string? FirstNotEmpty(
        params string?[] values)
    {
        return values.FirstOrDefault(
            x => !string.IsNullOrWhiteSpace(x)
        );
    }
    private static string? NormalizeTitle(
    string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return null;

        var normalized =
            value
                .Trim()
                .ToLowerInvariant()
                .Replace(".", "");


        return normalized switch
        {
            "dott" => "Dott.",

            "dr" => "Dott.",

            "dottore" => "Dott.",

            "dottssa" => "Dott.ssa",

            "dottoressa" => "Dott.ssa",

            "avv" => "Avv.",

            "avvocato" => "Avv.",

            _ => null
        };
    }

    private static string? NormalizeOptionalWords(
    string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return null;

        var textInfo =
            CultureInfo
                .GetCultureInfo("it-IT")
                .TextInfo;

        return textInfo.ToTitleCase(
            value
                .Trim()
                .ToLowerInvariant()
        );
    }
    
    /* =========================================================
       NORMALIZZAZIONE EMAIL
       ========================================================= */

    private static string? NormalizeEmailNullable(
     string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return null;

        return value
            .Trim()
            .Trim('"')
            .ToLowerInvariant();
    }
    private static void ProcessPhone(
    string? label,
    string? value,
    ref string? telefonoUfficio,
    ref string? telefonoCellulare,
    ref string? telefonoPrivato)
    {
        if (string.IsNullOrWhiteSpace(value))
            return;


        /*
         * Google in alcuni casi esporta:
         *
         * +393398388496 ::: +393289719984
         *
         * Per ora prendiamo il primo numero valido,
         * perché il nostro DB ha un solo campo
         * per ciascuna categoria.
         */

        var rawPhone =
            value
                .Split(
                    ":::",
                    StringSplitOptions.RemoveEmptyEntries
                )
                .FirstOrDefault();


        var phone =
            NormalizePhone(rawPhone);


        if (string.IsNullOrWhiteSpace(phone))
            return;


        var normalizedLabel =
            (label ?? "")
                .Trim()
                .ToLowerInvariant();


        /*
         * ==============================
         * CELLULARE
         * ==============================
         */

        if (normalizedLabel.Contains("mobile") ||
            normalizedLabel.Contains("cellulare") ||
            normalizedLabel.Contains("cell"))
        {
            telefonoCellulare ??= phone;
            return;
        }


        /*
         * ==============================
         * PRIVATO
         * ==============================
         */

        if (normalizedLabel.Contains("home") ||
            normalizedLabel.Contains("casa") ||
            normalizedLabel.Contains("private") ||
            normalizedLabel.Contains("privato"))
        {
            telefonoPrivato ??= phone;
            return;
        }


        /*
         * ==============================
         * UFFICIO
         * ==============================
         */

        if (normalizedLabel.Contains("work") ||
            normalizedLabel.Contains("lavoro") ||
            normalizedLabel.Contains("office") ||
            normalizedLabel.Contains("ufficio"))
        {
            telefonoUfficio ??= phone;
            return;
        }


        /*
         * Label sconosciuta:
         *
         * non buttiamo via il numero.
         */

        if (telefonoCellulare == null)
        {
            telefonoCellulare = phone;
        }
        else if (telefonoUfficio == null)
        {
            telefonoUfficio = phone;
        }
        else if (telefonoPrivato == null)
        {
            telefonoPrivato = phone;
        }
    }
    private static string? NormalizePhone(
    string? phone)
    {
        if (string.IsNullOrWhiteSpace(phone))
            return null;


        phone = phone.Trim();


        /*
         * Rimuove:
         *
         * spazi
         * trattini
         * parentesi
         * punti
         */

        phone = System.Text.RegularExpressions.Regex.Replace(
            phone,
            @"[\s\-\(\)\.]",
            ""
        );


        if (string.IsNullOrWhiteSpace(phone))
            return null;


        /*
         * Valori palesemente inutili.
         *
         * Nel tuo CSV abbiamo anche "00".
         */

        if (phone == "00" ||
            phone == "+" ||
            phone.Length < 5)
        {
            return null;
        }


        /*
         * Già internazionale:
         *
         * +39333...
         * +30...
         */

        if (phone.StartsWith("+"))
            return phone;


        /*
         * 0039... -> +39...
         * 0030... -> +30...
         */

        if (phone.StartsWith("00"))
            return "+" + phone[2..];


        /*
         * Nessun prefisso:
         * assumiamo Italia.
         */

        return "+39" + phone;
    }
