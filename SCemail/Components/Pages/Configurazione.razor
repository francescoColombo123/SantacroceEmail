@page "/configurazione"
@using MailKit.Net.Imap
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using SCemail.Components.Data
@inject IDbContextFactory<MailDbContext> DbFactory
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="container my-5">
    <!-- Card Configurazione -->
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">⚙️ Configurazione Caselle Email</h5>

            <div class="d-flex gap-2">
                <button type="button" class="btn btn-light btn-sm"
                        @onclick="ApriModalNuovaCasella">
                    ➕ Nuova Casella
                </button>

                <button type="button" class="btn btn-light btn-sm"
                        @onclick="TornaHome">
                    ⬅️ Torna alla Home
                </button>
            </div>
        </div>

        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-6">
                    <label class="form-label">Cerca casella email</label>
                    <input class="form-control"
                           placeholder="Es. euroc"
                           @bind="searchText"
                           @bind:event="oninput" />
                </div>
                <div class="col-md-6 text-md-end">
                    <small class="text-muted">
                        Totale: @CaselleFiltrate.Count() caselle
                    </small>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabella Caselle -->
    <div class="card shadow-sm mt-4">
        <div class="card-header bg-secondary text-white">
            <h6 class="mb-0">📧 Caselle configurate</h6>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Email</th>
                        <th>Provider</th>
                        <th>IMAP</th>
                        <th>Password</th>
                        <th class="text-center">Stato</th>
                        <th class="text-center">Azioni</th>
                    </tr>
                </thead>
                <tbody>
                    @if (CaselleFiltrate.Any())
                    {
                        @foreach (var c in CaselleFiltrate)
                        {
                            var statoClasse = c.Stato switch
                            {
                                StatoConnessione.Ok => "btn btn-sm btn-success",
                                StatoConnessione.Errore => "btn btn-sm btn-danger",
                                _ => "btn btn-sm btn-secondary"
                            };

                            <tr title="@c.LastError">
                                <td>@c.Email</td>
                                <td>@c.Provider</td>
                                <td>@c.ImapHost:@c.ImapPort (SSL: @c.UseSsl)</td>
                                <td style="width: 250px;">
                                    <input type="text"
                                           class="form-control form-control-sm"
                                           value="@c.Password"
                                           @onchange="(e => AggiornaPasswordDiretta(c, e))" />
                                </td>
                                <td class="text-center">
                                    @if (c.InTest)
                                    {
                                        <div class="spinner-border text-info spinner-border-sm" role="status">
                                            <span class="visually-hidden">Verifica...</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <button class="@statoClasse" disabled
                                                title="@(c.Stato == StatoConnessione.Ok
                                                                                                    ? "Connessione OK"
                                                                                                    : c.LastError ?? "Errore di connessione")">
                                            @(c.Stato == StatoConnessione.Ok ? "🟢" :
                                                                            c.Stato == StatoConnessione.Errore ? "🔴" : "⚪")
                            </button>
                                                        }
                                </td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary"
                                                @onclick="() => ApriModalModificaCasella(c)">
                                            ✏️ Modifica
                                        </button>

                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger"
                                                @onclick="() => RimuoviCasella(c)">
                                            🗑 Rimuovi
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                Nessuna casella trovata.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (showAddModal)
{
    <div class="custom-modal-backdrop" @onclick="ChiudiModalNuovaCasella"></div>

    <div class="custom-modal-wrapper">
        <div class="custom-modal card shadow">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">@(isEditMode ? "✏️ Modifica Casella Email" : "➕ Nuova Casella Email")</h5>
                <button type="button" class="btn btn-light btn-sm" @onclick="ChiudiModalNuovaCasella">✖</button>
            </div>

            <div class="card-body">
                <EditForm Model="@form" OnValidSubmit="@SalvaCasella">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="row g-3">
                        <div class="col-md-12">
                            <label class="form-label">Email</label>
                            <InputText class="form-control" @bind-Value="form.Email" />
                        </div>

                        <div class="col-md-12">
                            <label class="form-label">Password</label>
                            <div class="input-group">
                                <InputText class="form-control"
                                           @bind-Value="form.Password"
                                           type="@(showPwd ? "text" : "password")" />
                                <button type="button"
                                        class="btn btn-outline-secondary"
                                        @onclick="TogglePwd">
                                    @(showPwd ? "🙈 Nascondi" : "👁 Mostra")
                                </button>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label">Provider</label>
                            <select class="form-select" @onchange="OnProviderChanged">
                                <option value="Gmail" selected="@("Gmail" == form.Provider)">Gmail</option>
                                <option value="Aruba" selected="@("Aruba" == form.Provider)">Aruba</option>
                            </select>
                        </div>

                        <div class="col-12 d-flex justify-content-end gap-2 mt-3">
                            <button type="button" class="btn btn-secondary" @onclick="ChiudiModalNuovaCasella">
                                Annulla
                            </button>

                            <button type="submit" class="btn btn-success">
                                @(isEditMode ? "Salva modifiche" : "Salva Casella")
                            </button>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<style>
    .table td, .table th {
        vertical-align: middle;
    }

    .table-hover tbody tr:hover {
        background-color: #f9fafc;
    }

    .custom-modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.45);
        z-index: 1040;
    }

    .custom-modal-wrapper {
        position: fixed;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1050;
        padding: 1rem;
    }

    .custom-modal {
        width: 100%;
        max-width: 700px;
        border-radius: 12px;
        overflow: hidden;
    }
</style>

@code {
    private bool showPwd = false;
    private bool showAddModal = false;
    private bool isEditMode = false;
    private int? editingId = null;

    private string searchText = "";
    private string? _cp;
    private System.Threading.Timer? _refreshTimer;

    private ConfigForm form = new();
    private List<CasellaPosta> _caselle = new();

    private void TogglePwd() => showPwd = !showPwd;

    private void ApriModalNuovaCasella()
    {
        form = new ConfigForm();
        editingId = null;
        isEditMode = false;
        showPwd = false;
        showAddModal = true;
    }

    private void ApriModalModificaCasella(CasellaPosta c)
    {
        form = new ConfigForm
        {
            Email = c.Email ?? "",
            Password = c.Password ?? "",
            Provider = c.Provider ?? "Gmail"
        };

        editingId = c.Id;
        isEditMode = true;
        showPwd = false;
        showAddModal = true;
    }

    private void ChiudiModalNuovaCasella()
    {
        showAddModal = false;
        showPwd = false;
        isEditMode = false;
        editingId = null;
    }

    private IEnumerable<CasellaPosta> CaselleFiltrate =>
        _caselle.Where(c =>
            string.IsNullOrWhiteSpace(searchText) ||
            (!string.IsNullOrWhiteSpace(c.Email) &&
             c.Email.Contains(searchText, StringComparison.OrdinalIgnoreCase)));

    protected override void OnInitialized()
    {
        var uri = new Uri(Nav.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("cp", out var cp))
            _cp = cp;
    }

    protected override async Task OnInitializedAsync()
    {
        await using var db = DbFactory.CreateDbContext();
        _caselle = await db.CasellePosta
            .AsNoTracking()
            .OrderBy(c => c.Email)
            .ToListAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var tasks = _caselle.Select(c => TestConnessione(c));
            await Task.WhenAll(tasks);

            _refreshTimer = new System.Threading.Timer(async _ =>
            {
                try
                {
                    await InvokeAsync(async () =>
                    {
                        var tasks = _caselle.Select(c => TestConnessione(c));
                        await Task.WhenAll(tasks);
                        StateHasChanged();
                    });
                }
                catch { }
            }, null, TimeSpan.FromSeconds(15), TimeSpan.FromSeconds(15));
        }
    }

    private async Task AggiornaPasswordDiretta(CasellaPosta c, ChangeEventArgs e)
    {
        try
        {
            var nuovaPwd = e.Value?.ToString() ?? "";
            if (string.IsNullOrWhiteSpace(nuovaPwd) || nuovaPwd == c.Password)
                return;

            c.Password = nuovaPwd;

            await using var db = DbFactory.CreateDbContext();
            var existing = await db.CasellePosta.FirstOrDefaultAsync(x => x.Id == c.Id);
            if (existing is null) return;

            existing.Password = c.Password;
            await db.SaveChangesAsync();

            Snackbar.Add($"🔐 Password aggiornata per {c.Email}", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"❌ Errore aggiornando password: {ex.Message}", Severity.Error);
        }
    }

    private void TornaHome()
    {
        if (!string.IsNullOrEmpty(_cp))
            Nav.NavigateTo($"/?cp={_cp}");
        else
            Nav.NavigateTo("/");
    }

    private class ConfigForm
    {
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
        public string Provider { get; set; } = "Gmail";
        public string Nome { get; set; } = "";
        public string Titolo { get; set; } = "";
        public string Recapito { get; set; } = "";
    }

    private void OnProviderChanged(ChangeEventArgs e)
    {
        form.Provider = e.Value?.ToString() ?? "Gmail";
    }

    private async Task SalvaCasella()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(form.Email) || string.IsNullOrWhiteSpace(form.Password))
            {
                Snackbar.Add("Compila tutti i campi obbligatori.", Severity.Warning);
                return;
            }

            await using var db = DbFactory.CreateDbContext();

            if (isEditMode && editingId.HasValue)
            {
                var existing = await db.CasellePosta.FirstOrDefaultAsync(c => c.Id == editingId.Value);
                if (existing is null)
                {
                    Snackbar.Add("Casella non trovata.", Severity.Error);
                    return;
                }

                bool duplicateEmail = await db.CasellePosta
                    .AsNoTracking()
                    .AnyAsync(c => c.Id != editingId.Value &&
                                   c.Email.ToUpper() == form.Email.ToUpper());

                if (duplicateEmail)
                {
                    Snackbar.Add($"Esiste già una casella con email '{form.Email}'.", Severity.Warning);
                    return;
                }

                existing.Email = form.Email;
                existing.Password = form.Password;
                existing.Provider = form.Provider;
                existing.ImapHost = form.Provider.Equals("Aruba", StringComparison.OrdinalIgnoreCase)
                    ? (form.Email.Contains("pec", StringComparison.OrdinalIgnoreCase)
                        ? "imaps.pec.aruba.it"
                        : "imap.aruba.it")
                    : "imap.gmail.com";
                existing.ImapPort = 993;
                existing.UseSsl = "Y";

                await db.SaveChangesAsync();

                var local = _caselle.FirstOrDefault(x => x.Id == existing.Id);
                if (local is not null)
                {
                    local.Email = existing.Email;
                    local.Password = existing.Password;
                    local.Provider = existing.Provider;
                    local.ImapHost = existing.ImapHost;
                    local.ImapPort = existing.ImapPort;
                    local.UseSsl = existing.UseSsl;
                }

                _caselle = _caselle.OrderBy(c => c.Email).ToList();

                ChiudiModalNuovaCasella();
                Snackbar.Add("✅ Casella email modificata correttamente.", Severity.Success);

                _ = Task.Run(async () =>
                {
                    await InvokeAsync(async () =>
                    {
                        await TestConnessione(local ?? existing);
                        StateHasChanged();
                    });
                });

                return;
            }

            bool exists = await db.CasellePosta
                .AsNoTracking()
                .AnyAsync(c => c.Email.ToUpper() == form.Email.ToUpper());

            if (exists)
            {
                Snackbar.Add($"La casella '{form.Email}' esiste già.", Severity.Warning);
                return;
            }

            var entity = new CasellaPosta
            {
                Email = form.Email,
                Password = form.Password,
                Provider = form.Provider,
                ImapHost = form.Provider.Equals("Aruba", StringComparison.OrdinalIgnoreCase)
                    ? (form.Email.Contains("pec", StringComparison.OrdinalIgnoreCase)
                        ? "imaps.pec.aruba.it"
                        : "imap.aruba.it")
                    : "imap.gmail.com",
                ImapPort = 993,
                UseSsl = "Y",
                CreatedAt = DateTime.Now
            };

            db.CasellePosta.Add(entity);
            await db.SaveChangesAsync();

            _caselle.Add(entity);
            _caselle = _caselle.OrderBy(c => c.Email).ToList();

            ChiudiModalNuovaCasella();

            Snackbar.Add("✅ Casella email aggiunta correttamente.", Severity.Success);

            _ = Task.Run(async () =>
            {
                await InvokeAsync(async () =>
                {
                    await TestConnessione(entity);
                    StateHasChanged();
                });
            });
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore durante il salvataggio: {ex.Message}", Severity.Error);
        }
    }

    private async Task RimuoviCasella(CasellaPosta c)
    {
        try
        {
            var conferma = await JS.InvokeAsync<bool>("confirm",
                $"Vuoi davvero rimuovere la casella '{c.Email}'?");

            if (!conferma)
                return;

            await using var db = DbFactory.CreateDbContext();
            var existing = await db.CasellePosta.FirstOrDefaultAsync(x => x.Id == c.Id);

            if (existing is null)
            {
                Snackbar.Add("Casella non trovata.", Severity.Warning);
                return;
            }

            db.CasellePosta.Remove(existing);
            await db.SaveChangesAsync();

            _caselle.RemoveAll(x => x.Id == c.Id);

            Snackbar.Add($"🗑 Casella '{c.Email}' rimossa correttamente.", Severity.Success);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"❌ Errore durante la rimozione: {ex.Message}", Severity.Error);
        }
    }

    private async Task AggiornaPassword(CasellaPosta casella)
    {
        try
        {
            await using var db = DbFactory.CreateDbContext();
            var existing = await db.CasellePosta.FirstOrDefaultAsync(c => c.Id == casella.Id);
            if (existing is null) return;

            existing.Password = casella.Password;
            await db.SaveChangesAsync();
            Snackbar.Add($"🔐 Password aggiornata per {casella.Email}", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore aggiornando password: {ex.Message}", Severity.Error);
        }
    }

    private async Task TestConnessione(CasellaPosta c)
    {
        try
        {
            c.InTest = true;
            await InvokeAsync(StateHasChanged);

            using var client = new ImapClient();
            client.ServerCertificateValidationCallback = (s, c1, h, e) => true;

            await client.ConnectAsync(c.ImapHost, c.ImapPort, c.UseSsl == "Y");
            await client.AuthenticateAsync(c.Email, c.Password);

            c.Stato = StatoConnessione.Ok;
            c.LastError = null;
            await client.DisconnectAsync(true);
        }
        catch (Exception ex)
        {
            c.Stato = StatoConnessione.Errore;
            c.LastError = ex.Message;
        }
        finally
        {
            c.InTest = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }
}