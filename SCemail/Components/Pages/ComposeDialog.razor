            );
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Errore caricamento firma");
            _firmaHtml = "";
        }
    }

    private async Task StartUndoableAction(
     PendingActionKind kind,
     string label,
     Func<CancellationToken, Task> executeAsync,
     int seconds = 10,
     bool closeOnExecute = true)
    {
        await CancelPendingInternal();

        _pending = new PendingAction
        {
            Kind = kind,
            Label = label,
            SecondsLeft = seconds,
            ExecuteAsync = executeAsync,
            CloseOnExecute = closeOnExecute
        };

        await InvokeAsync(StateHasChanged);

        try
        {
            while (_pending is not null && _pending.SecondsLeft > 0)
            {
                await Task.Delay(1000, _pending.Cts.Token);
                if (_pending is null) return;

                _pending.SecondsLeft--;
                await InvokeAsync(StateHasChanged);
            }

            if (_pending is not null && !_pending.Cts.IsCancellationRequested)
                await ExecutePendingInternal();
        }
        catch (TaskCanceledException) { }
    }

    private async Task UndoPending()
    {
        await CancelPendingInternal();
        Snackbar.Add("Operazione annullata ✅", Severity.Info);
    }

    private async Task ConfirmAndExit()
    {
        await ExecutePendingInternal(forceClose: true);
    }
    private async Task SendNow()
    {
        await ExecutePendingInternal(forceClose: false);
    }
    private async Task CancelPendingInternal()
    {
        if (_pending is null) return;

        try { _pending.Cts.Cancel(); } catch { /* ignore */ }
        _pending.Cts.Dispose();
        _pending = null;

        await InvokeAsync(StateHasChanged);
    }

    private async Task ExecutePendingInternal(bool forceClose = false)
    {
        if (_pending is null) return;

        var p = _pending;
        _pending = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            await p.ExecuteAsync(p.Cts.Token);

            if (forceClose || p.CloseOnExecute)
                MudDialog.Close(DialogResult.Ok("sent"));
        }
        catch (OperationCanceledException)
        {
            // annullata durante l’esecuzione (raro)
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Errore durante pending action");
            Snackbar.Add("Errore durante l’operazione ❌", Severity.Error);
        }
        finally
        {
            try { p.Cts.Dispose(); } catch { }
        }
    }
