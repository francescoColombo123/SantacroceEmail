    private static string CleanBeforeSend(string? html)
    {
        if (string.IsNullOrWhiteSpace(html))
            return "";

        var s = html.Trim();

        s = Regex.Replace(s, @"(<br\s*/?>\s*){3,}", "<br><br>", RegexOptions.IgnoreCase);
        s = Regex.Replace(s, @"(<p><br></p>\s*){2,}", "<p><br></p>", RegexOptions.IgnoreCase);
        s = Regex.Replace(s, @"\s{3,}", " ");

        return s.Trim();
    }
    private static string NormalizeEmailValue(string? value)
    {
        return (value ?? "").Trim();
    }

    private async Task<string?> ResolveInitialFromAddressAsync()
    {
        var requested = NormalizeEmailValue(CasellaMittente);

        if (!string.IsNullOrWhiteSpace(requested))
            return requested;

        var fallback = await MailSvc.GetEmailAddressByUsernameAsync(Utente);
        return NormalizeEmailValue(fallback);
    }

    private void EnsureFromAddressAvailable(string? fromAddress)
    {
        var normalized = NormalizeEmailValue(fromAddress);
        if (string.IsNullOrWhiteSpace(normalized))
            return;

        if (!_caselleDisponibili.Any(x =>
            string.Equals(NormalizeEmailValue(x), normalized, StringComparison.OrdinalIgnoreCase)))
        {
            _caselleDisponibili.Insert(0, normalized);
        }

        _caselleDisponibili = _caselleDisponibili
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }


