    private void SplitDraftBody(string html)
    {
        html ??= "";

        var m = Regex.Match(
            html,
            @"(?is)<hr[^>]*>\s*<div>\s*<(b|strong)>\s*Messaggio precedente:\s*</\1>\s*</div>\s*<blockquote[^>]*>(?<quote>[\s\S]*?)</blockquote>"
        );

        if (!m.Success)
        {
            m = Regex.Match(
                html,
                @"(?is)Messaggio precedente:\s*(?<quote>[\s\S]*)"
            );
        }

        if (m.Success)
        {
            var quoteStart = m.Index;
            var beforeQuote = html[..quoteStart];
            var quotePart = m.Groups["quote"].Value;

            _quoteHtml = quotePart.Trim();

            var firmaMatch = Regex.Match(
                beforeQuote,
                @"(?is)(<br\s*/?>\s*){0,3}Cordiali\s+saluti[\s\S]*$"
            );

            if (firmaMatch.Success)
            {
                var onlyBody = beforeQuote[..firmaMatch.Index].Trim();
                _bodyHtml = string.IsNullOrWhiteSpace(HtmlToPlain(onlyBody))
                    ? ExtractBodyBeforeSignature(beforeQuote)
                    : onlyBody;
            }
            else
            {
                _bodyHtml = beforeQuote.Trim();
            }
        }
        else
        {
            _bodyHtml = html;
            _quoteHtml = "";
        }
        _bodyHtml = RemoveTrailingSignatures(_bodyHtml);
        _showQuoteDetails = false;
    }

    private static string HtmlToPlain(string? html)
    {
        if (string.IsNullOrWhiteSpace(html))
            return "";

        var s = WebUtility.HtmlDecode(html);
        s = Regex.Replace(s, @"<\s*br\s*/?\s*>", "\n", RegexOptions.IgnoreCase);
        s = Regex.Replace(s, @"</\s*p\s*>", "\n", RegexOptions.IgnoreCase);
        s = Regex.Replace(s, @"<[^>]+>", "");
        return s.Trim();
    }

    private static string ExtractBodyBeforeSignature(string html)
    {
        if (string.IsNullOrWhiteSpace(html))
            return "";

        var idx = html.IndexOf("Cordiali saluti", StringComparison.OrdinalIgnoreCase);

        if (idx > 0)
            return html[..idx].Trim();

        return html.Trim();
    }
    private async Task OnCasellaChanged(string? value)
    {
        value = value?.Trim();

        if (_isSwitchingCasella || _isSavingDraft || _isDisposed)
            return;

        if (string.Equals(_selectedCasella, value, StringComparison.OrdinalIgnoreCase))
            return;

        _isSwitchingCasella = true;

        try
        {
            _selectedCasella = value;

            await LoadFirmaAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Errore cambio casella/firma");
            Snackbar.Add("Errore durante il cambio casella ❌", Severity.Error);
        }
        finally
        {
            _isSwitchingCasella = false;
        }
    }
    private async Task LoadFirmaAsync()
