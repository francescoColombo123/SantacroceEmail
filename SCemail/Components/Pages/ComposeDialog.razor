    private static string FormatFileSize(long bytes)
    {
        if (bytes >= 1024 * 1024)
            return $"{bytes / 1024d / 1024d:0.##} MB";

        if (bytes >= 1024)
            return $"{bytes / 1024d:0.##} KB";

        return $"{bytes} B";
    }

    private string GetAttachmentIcon(string? name)
    {
        var s = (name ?? "").ToLowerInvariant();

        if (s.EndsWith(".pdf")) return Icons.Material.Filled.PictureAsPdf;
        if (s.EndsWith(".jpg") || s.EndsWith(".jpeg") || s.EndsWith(".png") || s.EndsWith(".gif") || s.EndsWith(".webp"))
            return Icons.Material.Filled.Image;
        if (s.EndsWith(".doc") || s.EndsWith(".docx")) return Icons.Material.Filled.Description;
        if (s.EndsWith(".xls") || s.EndsWith(".xlsx") || s.EndsWith(".csv")) return Icons.Material.Filled.TableChart;
        if (s.EndsWith(".zip") || s.EndsWith(".rar") || s.EndsWith(".7z")) return Icons.Material.Filled.FolderZip;
        return Icons.Material.Filled.AttachFile;
    }


    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var files = e.GetMultipleFiles().ToList();
        if (!files.Any())
            return;

        _uploadingAttachments = true;
        _uploadingTotal = files.Count;
        _uploadingDone = 0;
        StateHasChanged();

        try
        {
            foreach (var file in files)
            {
                if (_attachments.Any(a => a.Name.Equals(file.Name, StringComparison.OrdinalIgnoreCase)))
                {
                    _uploadingDone++;
                    StateHasChanged();
                    continue;
                }

                if (file.Size > MaxFileSizeBytes)
                {
                    Snackbar.Add(
                        $"Il file '{file.Name}' supera il limite di {FormatFileSize(MaxFileSizeBytes)}.",
                        Severity.Warning
                    );

                    _uploadingDone++;
                    StateHasChanged();
                    continue;
                }

                using var ms = new MemoryStream();
                await file.OpenReadStream(maxAllowedSize: MaxFileSizeBytes).CopyToAsync(ms);

                _attachments.Add(file);

                _outgoing.Add(new MailService_NEW.OutgoingAttachment_NEW(
                    file.Name,
                    file.ContentType,
                    ms.ToArray()
                ));

                _uploadingDone++;
                StateHasChanged();
            }

            Snackbar.Add("Allegati caricati ✅", Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Errore durante il caricamento allegati");
            Snackbar.Add("Errore durante il caricamento degli allegati ❌", Severity.Error);
        }
        finally
        {
            _uploadingAttachments = false;
            StateHasChanged();
        }
    }

