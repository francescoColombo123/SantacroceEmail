    private async Task<IEnumerable<RecipientChip>> SearchRecipientsHybrid(string value, CancellationToken token)
    {
        var query = (value ?? "").Trim();
        if (string.IsNullOrEmpty(query))
            return _allRecipients.Take(10);

        // 1) prendi match locali SENZA escludere
        var locali = _allRecipients
            .Where(c => c.Email.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                        (c.NameOrEmail?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false))
            .ToList();

        // 2) ordina: prima username tipo a.b, poi gli altri
        locali = locali
            .OrderByDescending(c => UsernamePattern.IsMatch(c.Email.Split('@')[0]))
            .ThenBy(c => c.Email)
            .Take(10)
            .ToList();

        if (locali.Count >= 5)
            return locali;

        // 3) integra da DB
        var found = await MailSvc.SearchRecipientsAsync(Utente, query, 10, token) ?? new List<string>();
        var nuovi = found
            .Select(ParseAddressToChip)
            .DistinctBy(c => c.Email, StringComparer.OrdinalIgnoreCase)
            .ToList();

        _allRecipients.AddRange(nuovi);
        _allRecipients = _allRecipients
            .GroupBy(c => c.Email, StringComparer.OrdinalIgnoreCase)
            .Select(g => g.First())
            .ToList();

        return locali.Concat(nuovi)
                     .DistinctBy(c => c.Email, StringComparer.OrdinalIgnoreCase)
                     .Take(10);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("initFileDropZone", _dropZoneRef);

            _dotnetRef ??= DotNetObjectReference.Create(this);

            await JSRuntime.InvokeVoidAsync(
                "registerComposeAutoSaveClose",
                _dotnetRef
            );
        }

        if (!_pendingQuillInit)
            return;

        if (DraftId.HasValue && string.IsNullOrWhiteSpace(_bodyHtml))
        {
            SplitDraftBody(CorpoIniziale ?? "");

            Logger.LogWarning(
                "PRE INIT SPLIT - Body=[{Body}] QuoteLen={QuoteLen}",
                _bodyHtml,
                _quoteHtml?.Length ?? 0
            );
        }

        var bodyNow = DraftId.HasValue
            ? (_bodyHtml ?? "")
            : "<p><br></p>";

        var quoteNow = _quoteHtml ?? "";
        await LoadFirmaAsync();
        var firmaText = _firmaHtml ?? "";
        Logger.LogWarning(
            "INIT QUILL DEBUG - BodyLen={BodyLen}, FirmaLen={FirmaLen}, QuoteLen={QuoteLen}, Firma=[{Firma}]",
            bodyNow?.Length ?? 0,
            firmaText?.Length ?? 0,
            quoteNow?.Length ?? 0,
            firmaText
        );

        _dotnetRef ??= DotNetObjectReference.Create(this);

        await JSRuntime.InvokeVoidAsync(
            "initQuill",
            "editor",
            _dotnetRef,
            bodyNow,
            firmaText,
            quoteNow
        );

        _lastInitBody = bodyNow;
        _lastInitQuote = quoteNow;
        _lastInitFirma = firmaText;

        _quillInitialized = true;
        _pendingQuillInit = false;
    }
    
    private static string NormalizeFirmaHtml(string? html)
    {
        if (string.IsNullOrWhiteSpace(html))
            return "";

        var s = html.Trim();

        s = WebUtility.HtmlDecode(s)
            .Replace("\r\n", "\n")
            .Replace("\r", "\n")
            .Replace("&nbsp;", " ");

        s = Regex.Replace(s, @"<\s*br\s*/?\s*>", "\n", RegexOptions.IgnoreCase);
        s = Regex.Replace(s, @"</\s*p\s*>", "\n", RegexOptions.IgnoreCase);
        s = Regex.Replace(s, @"</\s*div\s*>", "\n", RegexOptions.IgnoreCase);
        s = Regex.Replace(s, @"<\s*hr[^>]*>", "\n------------------------------\n", RegexOptions.IgnoreCase);

        s = Regex.Replace(s, @"<\s*p[^>]*>", "", RegexOptions.IgnoreCase);
        s = Regex.Replace(s, @"<\s*div[^>]*>", "", RegexOptions.IgnoreCase);
        s = Regex.Replace(s, @"<\s*/?\s*small[^>]*>", "", RegexOptions.IgnoreCase);
        s = Regex.Replace(s, @"<[^>]+>", "");

        s = Regex.Replace(s, @"[ \t]+", " ");
        s = Regex.Replace(s, @" *\n *", "\n");
        s = Regex.Replace(s, @"\n{3,}", "\n\n");
        s = s.Trim();

        var safe = WebUtility.HtmlEncode(s)
            .Replace("\n\n", "<br><br>")
            .Replace("\n", "<br>");

        safe = Regex.Replace(
            safe,
            @"\b(GRUPPO\s+SANTACROCE|EUROCEREALI\s+SRL)\b",
            @"<span class=""firma-brand"">$1</span>",
            RegexOptions.IgnoreCase
        );

        return safe;
    }

