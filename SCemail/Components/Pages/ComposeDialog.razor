    private static string FormatForwardQuoteHtml(string? input)
    {
        if (string.IsNullOrWhiteSpace(input))
            return "";

        var s = WebUtility.HtmlDecode(input)
            .Replace("\r\n", "\n")
            .Replace("\r", "\n")
            .Replace("&nbsp;", " ");

        s = Regex.Replace(s, @"<\s*br\s*/?\s*>", "\n", RegexOptions.IgnoreCase);
        s = Regex.Replace(s, @"</\s*p\s*>", "\n", RegexOptions.IgnoreCase);
        s = Regex.Replace(s, @"</\s*div\s*>", "\n", RegexOptions.IgnoreCase);
        s = Regex.Replace(s, @"<style[\s\S]*?</style>", "", RegexOptions.IgnoreCase);
        s = Regex.Replace(s, @"<script[\s\S]*?</script>", "", RegexOptions.IgnoreCase);
        s = Regex.Replace(s, @"<!--[\s\S]*?-->", "", RegexOptions.IgnoreCase);
        s = Regex.Replace(s, @"<[^>]+>", "");

        s = Regex.Replace(
            s,
            @"[-]{5,}\s*Messaggio inoltrato\s*[-]{5,}",
            "---------- Messaggio inoltrato ----------",
            RegexOptions.IgnoreCase
        );

        s = Regex.Replace(s, @"(?i)(?<!\p{L})(Da|Data|Oggetto|A|Cc)\s*:", "\n$1: ");

        s = Regex.Replace(s, @"[ \t]+", " ");
        s = Regex.Replace(s, @" *\n *", "\n");
        s = Regex.Replace(s, @"\n{3,}", "\n\n");

        return WebUtility.HtmlEncode(s.Trim())
            .Replace("\n\n", "<br><br>")
            .Replace("\n", "<br>");
    }
    private void RemoveRecipient(List<RecipientChip> list, RecipientChip chip)
    {
        if (list.Contains(chip))
        {
            list.Remove(chip);
            StateHasChanged();
        }
