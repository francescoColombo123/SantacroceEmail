    private async Task StartUndoableAction(
     PendingActionKind kind,
     string label,
     Func<CancellationToken, Task> executeAsync,
     int seconds = 10,
     bool closeOnExecute = true)
    {
        await CancelPendingInternal();

        _pending = new PendingAction
        {
            Kind = kind,
            Label = label,
            SecondsLeft = seconds,
            ExecuteAsync = executeAsync,
            CloseOnExecute = closeOnExecute
        };

        await InvokeAsync(StateHasChanged);

        try
        {
            while (_pending is not null && _pending.SecondsLeft > 0)
            {
                await Task.Delay(1000, _pending.Cts.Token);
                if (_pending is null) return;

                _pending.SecondsLeft--;
                await InvokeAsync(StateHasChanged);
            }

            if (_pending is not null && !_pending.Cts.IsCancellationRequested)
                await ExecutePendingInternal();
        }
        catch (TaskCanceledException) { }
    }

    private async Task UndoPending()
    {
        await CancelPendingInternal();
        Snackbar.Add("Operazione annullata ✅", Severity.Info);
    }

    private async Task ConfirmAndExit()
    {
        await ExecutePendingInternal(forceClose: true);
    }
    private async Task SendNow()
    {
        await ExecutePendingInternal(forceClose: false);
    }
    private async Task CancelPendingInternal()
    {
        if (_pending is null) return;

        try { _pending.Cts.Cancel(); } catch { /* ignore */ }
        _pending.Cts.Dispose();
        _pending = null;

        await InvokeAsync(StateHasChanged);
    }

    private async Task ExecutePendingInternal(bool forceClose = false)
    {
        if (_pending is null) return;

        var p = _pending;
        _pending = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            await p.ExecuteAsync(p.Cts.Token);

            if (forceClose || p.CloseOnExecute)
                MudDialog.Close(DialogResult.Ok(true));
        }
        catch (OperationCanceledException)
        {
            // annullata durante l’esecuzione (raro)
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Errore durante pending action");
            Snackbar.Add("Errore durante l’operazione ❌", Severity.Error);
        }
        finally
        {
            try { p.Cts.Dispose(); } catch { }
        }
    }
    private async Task<IEnumerable<RecipientChip>> SearchRecipientsHybrid(string value, CancellationToken token)
    {
        var query = (value ?? "").Trim();
        if (string.IsNullOrEmpty(query))
            return _allRecipients.Take(10);

        // 1) prendi match locali SENZA escludere
        var locali = _allRecipients
            .Where(c => c.Email.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                        (c.NameOrEmail?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false))
            .ToList();

        // 2) ordina: prima username tipo a.b, poi gli altri
        locali = locali
            .OrderByDescending(c => UsernamePattern.IsMatch(c.Email.Split('@')[0]))
            .ThenBy(c => c.Email)
            .Take(10)
            .ToList();

        if (locali.Count >= 5)
            return locali;

        // 3) integra da DB
        var found = await MailSvc.SearchRecipientsAsync(Utente, query, 10, token) ?? new List<string>();
        var nuovi = found
            .Select(ParseAddressToChip)
            .DistinctBy(c => c.Email, StringComparer.OrdinalIgnoreCase)
            .ToList();

        _allRecipients.AddRange(nuovi);
        _allRecipients = _allRecipients
            .GroupBy(c => c.Email, StringComparer.OrdinalIgnoreCase)
            .Select(g => g.First())
            .ToList();

        return locali.Concat(nuovi)
                     .DistinctBy(c => c.Email, StringComparer.OrdinalIgnoreCase)
                     .Take(10);
    }


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JSRuntime.InvokeVoidAsync("initFileDropZone", _dropZoneRef);

        if (!_pendingQuillInit)
            return;

        var bodyNow = _bodyHtml ?? "";
        var quoteNow = _quoteHtml ?? "";

        // ✅ NON saltare l’inizializzazione la prima volta
        if (_quillInitialized && bodyNow == _lastInitBody && quoteNow == _lastInitQuote)
        {
            _pendingQuillInit = false;
            return;
        }

        _dotnetRef ??= DotNetObjectReference.Create(this);

        await JSRuntime.InvokeVoidAsync("initQuill", "editor", _dotnetRef, bodyNow, quoteNow);

        _lastInitBody = bodyNow;
        _lastInitQuote = quoteNow;
        _quillInitialized = true;      // ✅ segnalo che ormai esiste
        _pendingQuillInit = false;
    }


