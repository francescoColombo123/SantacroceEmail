    private string BuildBodyForSend()
    {
        var body = CleanBeforeSend(_bodyHtml);
        var firma = NormalizeFirmaHtml(_firmaHtml);
        var quote = _quoteHtml ?? "";

        var result = body;

        if (!string.IsNullOrWhiteSpace(firma))
            result += "<br><br>" + firma;

        if (!string.IsNullOrWhiteSpace(quote))
            result += "<br><br><hr><div><b>Messaggio precedente:</b></div><blockquote style='border-left:2px solid #ccc;margin-left:8px;padding-left:12px;'>" + quote + "</blockquote>";

        return result;
    }
    private static string RemoveQuoteGarbage(string? input)

    {

        if (string.IsNullOrWhiteSpace(input))

            return "";



        var s = WebUtility.HtmlDecode(input)

            .Replace("\r\n", "\n")

            .Replace("\r", "\n")

            .Replace("&nbsp;", " ");



        // tag che diventano righe

        s = Regex.Replace(s, @"<\s*br\s*/?\s*>", "\n", RegexOptions.IgnoreCase);

        s = Regex.Replace(s, @"</\s*p\s*>", "\n", RegexOptions.IgnoreCase);

        s = Regex.Replace(s, @"</\s*div\s*>", "\n", RegexOptions.IgnoreCase);



        // elimina blocchi tecnici

        s = Regex.Replace(s, @"<style[\s\S]*?</style>", "", RegexOptions.IgnoreCase);

        s = Regex.Replace(s, @"<script[\s\S]*?</script>", "", RegexOptions.IgnoreCase);

        s = Regex.Replace(s, @"<!--[\s\S]*?-->", "", RegexOptions.IgnoreCase);

        s = Regex.Replace(s, @"<img\b[^>]*>", "", RegexOptions.IgnoreCase);



        // elimina tutti i tag rimasti

        s = Regex.Replace(s, @"<[^>]+>", "");



        // elimina CSS Outlook/Word visibile

        s = Regex.Replace(s, @"(?im)^\s*v\\?:\*\s*\{[^}]*\}\s*$", "");

        s = Regex.Replace(s, @"(?im)^\s*o\\?:\*\s*\{[^}]*\}\s*$", "");

        s = Regex.Replace(s, @"(?im)^\s*w\\?:\*\s*\{[^}]*\}\s*$", "");

        s = Regex.Replace(s, @"(?im)^\s*\.shape\s*\{[^}]*\}\s*$", "");



        // elimina descrizioni automatiche e residui

        s = Regex.Replace(s, @"(?i)Immagine che contiene.*", "");

        s = Regex.Replace(s, @"(?i)Descrizione generata automaticamente.*", "");

        s = s.Replace("\">", "");



        // pulizia spazi

        s = Regex.Replace(s, @"[ \t]+", " ");

        s = Regex.Replace(s, @" *\n *", "\n");

        s = Regex.Replace(s, @"\n{3,}", "\n\n");



        s = s.Trim();



        // ricrea HTML pulito

        return WebUtility.HtmlEncode(s)

            .Replace("\n\n", "<br><br>")

            .Replace("\n", "<br>");

    }
    private static string FixFirmaHtml(string html)
    {
        if (string.IsNullOrWhiteSpace(html))
            return html;

        return Regex.Replace(
            html,
            @"\b(GRUPPO\s+SANTACROCE|EUROCEREALI\s+SRL)\b",
            @"<span style=""color:#003366;font-weight:700;font-style:italic;"">$1</span>",
            RegexOptions.IgnoreCase
        );
    }

