    private void InitReplyRecipients()
    {
        var myAddr = NormalizeEmailValue(_selectedCasella).ToLowerInvariant();

        var to = SplitAddresses(Destinatari)
            .Select(ParseAddressToChip)
            .Where(c => !string.IsNullOrWhiteSpace(c.Email))
            .Where(c => !c.Email.Equals(myAddr, StringComparison.OrdinalIgnoreCase))
            .DistinctBy(c => c.Email, StringComparer.OrdinalIgnoreCase)
            .ToList();

        var cc = SplitAddresses(Cc)
            .Select(ParseAddressToChip)
            .Where(c => !string.IsNullOrWhiteSpace(c.Email))
            .Where(c => !c.Email.Equals(myAddr, StringComparison.OrdinalIgnoreCase))
            .Where(c => !to.Any(t => t.Email.Equals(c.Email, StringComparison.OrdinalIgnoreCase)))
            .DistinctBy(c => c.Email, StringComparer.OrdinalIgnoreCase)
            .ToList();

        var bcc = SplitAddresses(Bcc)
            .Select(ParseAddressToChip)
            .Where(c => !string.IsNullOrWhiteSpace(c.Email))
            .Where(c => !c.Email.Equals(myAddr, StringComparison.OrdinalIgnoreCase))
            .Where(c => !to.Any(t => t.Email.Equals(c.Email, StringComparison.OrdinalIgnoreCase)))
            .Where(c => !cc.Any(t => t.Email.Equals(c.Email, StringComparison.OrdinalIgnoreCase)))
            .DistinctBy(c => c.Email, StringComparer.OrdinalIgnoreCase)
            .ToList();

        _toList = to;
        _ccList = cc;
        _bccList = bcc;
    }

}
