@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string Utente { get; set; } = default!;
    [Parameter] public string? Destinatari { get; set; }
    [Parameter] public string? Oggetto { get; set; }
    [Parameter] public string? CorpoIniziale { get; set; }
    [Parameter] public string? ReplyToMessageId { get; set; }
    [Parameter] public string? CasellaMittente { get; set; }
    [Parameter] public string? References { get; set; }
    [Parameter] public string? ThreadKey { get; set; }
    [Parameter] public string? Cc { get; set; }
    [Parameter] public string? Bcc { get; set; }
    [Parameter] public long? DraftId { get; set; }   // ✅ ID bozza se esistente
    private bool _showCc;
    private bool _showBcc;
    private async Task FocusBackToField(string id)
    {
        // Chiamata diretta JS: focus su un input specifico
        await JSRuntime.InvokeVoidAsync("focusElementById", id);
    }
    private static readonly Regex UsernamePattern =
        new(@"^[a-z]\.[a-z]+$", RegexOptions.IgnoreCase);
    private List<RecipientChip> _toList = new();
    private List<RecipientChip> _ccList = new();
    private List<RecipientChip> _bccList = new();
    private List<RecipientChip> _allRecipients = new();
    private CancellationTokenSource? _ctsTo, _ctsCc, _ctsBcc;
    private bool _pendingQuillInit = true;
    private bool _quillInitialized = false;
    private const long MaxFileSizeBytes = 25 * 1024 * 1024; // 25 MB per file
    private string _lastInitBody = "";
    private string? _lastInitQuote = "";
    private string? _composeSubject;
    private string? _firmaHtml;
    private string _bodyHtml = "";
    private string _quoteHtml = "";

    private readonly List<IBrowserFile> _attachments = new();
    private readonly List<MailService_NEW.OutgoingAttachment_NEW> _outgoing = new();

    private ElementReference _dropZoneRef;
    private DotNetObjectReference<ComposeDialog>? _dotnetRef;
    private bool _uploadingAttachments = false;
    private int _uploadingTotal = 0;
    private int _uploadingDone = 0;

    private bool IsBusy => _uploadingAttachments || _pending is not null;
    private List<string> _caselleDisponibili = new();
    private string? _selectedCasella;
    private bool _fromLocked = false;
    private PendingAction? _pending;
    private enum PendingActionKind { Send, SaveDraft, Other }

    private sealed class PendingAction
    {
        public PendingActionKind Kind { get; init; } = PendingActionKind.Other;
        public string Label { get; init; } = "";
        public int SecondsLeft { get; set; }
        public Func<CancellationToken, Task> ExecuteAsync { get; init; } = _ => Task.CompletedTask;
        public CancellationTokenSource Cts { get; } = new();
        public bool CloseOnExecute { get; init; } = true;
    }
    
    protected override async Task OnInitializedAsync()
    {
        _draftId = DraftId;

        var ids = await AccessiSrv.GetCaselleAbilitateAsync(Utente);
        _caselleDisponibili = await MailSvc.GetEmailAddressesByIdsAsync(ids) ?? new List<string>();

        // pulizia lista
        _caselleDisponibili = _caselleDisponibili
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        var initialFrom = await ResolveInitialFromAddressAsync();

        if (!string.IsNullOrWhiteSpace(initialFrom))
        {
            // aggiunge la casella originale anche se non è nelle abilitazioni
            EnsureFromAddressAvailable(initialFrom);

            _selectedCasella = _caselleDisponibili
                .FirstOrDefault(x => x.Equals(initialFrom, StringComparison.OrdinalIgnoreCase))
                ?? _caselleDisponibili.FirstOrDefault();
        }
        else if (_caselleDisponibili.Any())
        {
            _selectedCasella = _caselleDisponibili.First();
        }

        // mai bloccare il campo: l’utente può cambiare verso una delle sue caselle
        _fromLocked = false;
        InitReplyRecipients();
        _showCc = _ccList.Any();
        _showBcc = _bccList.Any();
        _composeSubject = Oggetto ?? string.Empty;

        if (!string.IsNullOrWhiteSpace(_selectedCasella))
        {
            try
            {
                _firmaHtml = await MailSvc.GetFirmaUtenteAsync(Utente, _selectedCasella);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Errore caricamento firma iniziale per {Utente} e casella {Casella}", Utente, _selectedCasella);
                _firmaHtml = null;
            }
        }
        else
        {
            _firmaHtml = null;
        }

        _quoteHtml = RemoveQuoteGarbage(CorpoIniziale ?? "");

        var recenti = await MailSvc.GetRecentRecipientsAsync(10);
        _allRecipients = (recenti ?? new List<string>())
            .Select(ParseAddressToChip)
