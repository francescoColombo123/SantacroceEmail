    private static string FormatFileSize(long bytes)
    {
        if (bytes >= 1024 * 1024)
            return $"{bytes / 1024d / 1024d:0.##} MB";

        if (bytes >= 1024)
            return $"{bytes / 1024d:0.##} KB";

        return $"{bytes} B";
    }

    private string GetAttachmentIcon(string? name)
    {
        var s = (name ?? "").ToLowerInvariant();

        if (s.EndsWith(".pdf")) return Icons.Material.Filled.PictureAsPdf;
        if (s.EndsWith(".jpg") || s.EndsWith(".jpeg") || s.EndsWith(".png") || s.EndsWith(".gif") || s.EndsWith(".webp"))
            return Icons.Material.Filled.Image;
        if (s.EndsWith(".doc") || s.EndsWith(".docx")) return Icons.Material.Filled.Description;
        if (s.EndsWith(".xls") || s.EndsWith(".xlsx") || s.EndsWith(".csv")) return Icons.Material.Filled.TableChart;
        if (s.EndsWith(".zip") || s.EndsWith(".rar") || s.EndsWith(".7z")) return Icons.Material.Filled.FolderZip;
        return Icons.Material.Filled.AttachFile;
    }


    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var files = e.GetMultipleFiles().ToList();
        if (!files.Any())
            return;

        _uploadingAttachments = true;
        _uploadingTotal = files.Count;
        _uploadingDone = 0;
        StateHasChanged();

        try
        {
            foreach (var file in files)
            {
                if (_attachments.Any(a => a.Name.Equals(file.Name, StringComparison.OrdinalIgnoreCase)))
                {
                    _uploadingDone++;
                    StateHasChanged();
                    continue;
                }

                if (file.Size > MaxFileSizeBytes)
                {
                    Snackbar.Add(
                        $"Il file '{file.Name}' supera il limite di {FormatFileSize(MaxFileSizeBytes)}.",
                        Severity.Warning
                    );

                    _uploadingDone++;
                    StateHasChanged();
                    continue;
                }

                using var ms = new MemoryStream();
                await file.OpenReadStream(maxAllowedSize: MaxFileSizeBytes).CopyToAsync(ms);

                _attachments.Add(file);

                _outgoing.Add(new MailService_NEW.OutgoingAttachment_NEW(
                    file.Name,
                    file.ContentType,
                    ms.ToArray()
                ));

                _uploadingDone++;
                StateHasChanged();
            }

            Snackbar.Add("Allegati caricati ✅", Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Errore durante il caricamento allegati");
            Snackbar.Add("Errore durante il caricamento degli allegati ❌", Severity.Error);
        }
        finally
        {
            _uploadingAttachments = false;
            StateHasChanged();
        }
    }

    private void RemoveAttachment(IBrowserFile file)
    {
        _attachments.Remove(file);

        // ✅ rimuovi anche dalla lista effettivamente inviata
        _outgoing.RemoveAll(x =>
            string.Equals(x.FileName, file.Name, StringComparison.OrdinalIgnoreCase));

        Snackbar.Add($"Rimosso {file.Name}", Severity.Info);
        StateHasChanged();
    }

    private void RemoveForwardedAttachment(MailService_NEW.OutgoingAttachment_NEW file)
    {
        _forwardedAttachments.Remove(file);

        _outgoing.RemoveAll(x =>
            string.Equals(x.FileName, file.FileName, StringComparison.OrdinalIgnoreCase));

        Snackbar.Add($"Rimosso {file.FileName}", Severity.Info);
        StateHasChanged();
    }
    public record RecipientChip(string Email, string? Name)
    {
        public string NameOrEmail => string.IsNullOrWhiteSpace(Name) ? Email : Name;
        public string Display => string.IsNullOrWhiteSpace(Name) ? Email : $"{Name} <{Email}>";
    }

    private static RecipientChip ParseAddressToChip(string raw)
    {
        var m = System.Text.RegularExpressions.Regex.Match(raw, @"^(?<name>.+?)\s*<(?<mail>[^>]+)>\s*$");
        return m.Success
            ? new RecipientChip(m.Groups["mail"].Value.Trim(), m.Groups["name"].Value.Trim())
            : new RecipientChip(raw.Trim(), null);
    }

    private static List<string> SplitAddresses(string? s)
        => string.IsNullOrWhiteSpace(s)
            ? new()
            : System.Text.RegularExpressions.Regex
                .Split(s, @"[;,]+")
                .Select(x => x.Trim())
                .Where(x => x.Length > 0)
                .ToList();

    private static IEnumerable<string> ChipsToEmails(IEnumerable<RecipientChip> chips)
        => chips.Select(c => c.Email).Distinct(StringComparer.OrdinalIgnoreCase);

    private static bool EmailComparer(RecipientChip? x, RecipientChip? y)
        => string.Equals(x?.Email, y?.Email, StringComparison.OrdinalIgnoreCase);

    private async Task OnRecipientInput(string? value, RecipientField field)
    {
        var query = (value ?? "").Trim();

        if (string.IsNullOrEmpty(query))
        {
            HideSuggestions(field);
            return;
        }

        CancellationTokenSource cts;
        switch (field)
        {
            case RecipientField.To:
                _ctsTo?.Cancel();
                _ctsTo = new CancellationTokenSource();
                cts = _ctsTo;
                break;
            case RecipientField.Cc:
                _ctsCc?.Cancel();
                _ctsCc = new CancellationTokenSource();
                cts = _ctsCc;
                break;
            default:
                _ctsBcc?.Cancel();
                _ctsBcc = new CancellationTokenSource();
                cts = _ctsBcc;
                break;
        }

        try
        {
            await Task.Delay(250, cts.Token); // debounce

            var results = (await SearchRecipientsHybrid(query, cts.Token)).ToList();

            switch (field)
            {
                case RecipientField.To:
                    _suggestionsTo = results;
                    _showSuggestionsTo = results.Any();
                    break;
                case RecipientField.Cc:
                    _suggestionsCc = results;
                    _showSuggestionsCc = results.Any();
                    break;
                case RecipientField.Bcc:
                    _suggestionsBcc = results;
                    _showSuggestionsBcc = results.Any();
                    break;
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException)
        {
            // utente sta scrivendo → ignora
        }
    }


    private void SelectSuggestion(RecipientChip chip, List<RecipientChip> targetList, RecipientField field)
    {
        if (!targetList.Any(c => string.Equals(c.Email, chip.Email, StringComparison.OrdinalIgnoreCase)))
            targetList.Add(chip);

        switch (field)
        {
            case RecipientField.To:
                _showSuggestionsTo = false;
                _toInput = string.Empty;
                break;
            case RecipientField.Cc:
                _showSuggestionsCc = false;
                _ccInput = string.Empty;
                break;
            case RecipientField.Bcc:
                _showSuggestionsBcc = false;
                _bccInput = string.Empty;
                break;
        }

        StateHasChanged();
    }



    private void HideSuggestions(RecipientField field)
    {
        switch (field)
        {
            case RecipientField.To:
                _showSuggestionsTo = false;
                break;
            case RecipientField.Cc:
                _showSuggestionsCc = false;
                break;
            case RecipientField.Bcc:
                _showSuggestionsBcc = false;
                break;
        }
    }
    private async Task HandleRecipientKey(
        KeyboardEventArgs e,
        List<RecipientChip> list,
        string? inputValue,
        Action<string?> updateValue,
        RecipientField field)
    {
        var text = (inputValue ?? "").Trim();

        // 🔹 1️⃣ Ogni volta che scrivi (non solo Enter), aggiorna i suggerimenti
        if (e.Key.Length == 1 || e.Key == "Backspace")
        {
            // Se cancella tutto → nascondi suggerimenti
            if (string.IsNullOrWhiteSpace(text))
            {
                HideSuggestions(field);
                await InvokeAsync(StateHasChanged);
                return;
            }

            try
            {
                using var cts = new CancellationTokenSource();
                var results = (await SearchRecipientsHybrid(text, cts.Token)).ToList();

                switch (field)
                {
                    case RecipientField.To:
                        _suggestionsTo = results;
                        _showSuggestionsTo = results.Any();
                        break;
                    case RecipientField.Cc:
                        _suggestionsCc = results;
                        _showSuggestionsCc = results.Any();
                        break;
                    case RecipientField.Bcc:
                        _suggestionsBcc = results;
                        _showSuggestionsBcc = results.Any();
                        break;
                }

                await InvokeAsync(StateHasChanged);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Errore ricerca destinatari ({Text})", text);
            }

            return; // 👈 non aggiungere ancora, solo suggerisci
        }

        // 🔹 2️⃣ Gestisci solo i tasti “commit”
        if (e.Key is not ("Enter" or "," or ";"))
            return;

        // Se ci sono suggerimenti visibili, lascia scegliere
        bool hasSuggestions = field switch
        {
            RecipientField.To => _showSuggestionsTo,
            RecipientField.Cc => _showSuggestionsCc,
            RecipientField.Bcc => _showSuggestionsBcc,
            _ => false
        };
        if (hasSuggestions)
            return;

        if (string.IsNullOrEmpty(text))
            return;

        // 🔹 3️⃣ Controllo email valida
        if (!text.Contains("@"))
        {
            Snackbar.Add("⚠️ Inserisci un indirizzo email valido", Severity.Warning);
            updateValue("");
            return;
        }

        // 🔹 4️⃣ Crea e aggiungi chip
        var chip = CreateRecipientFromText(text);
        if (!list.Any(c => c.Email.Equals(chip.Email, StringComparison.OrdinalIgnoreCase)))
        {
            list.Add(chip);
            try
            {
                await MailSvc.AddRecipientIfNotExistsAsync(chip.Email, chip.Name);
                Logger.LogInformation("📬 Aggiunto nuovo destinatario: {Email}", chip.Email);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Errore salvataggio destinatario {Email}", chip.Email);
            }
        }

        // 🔹 5️⃣ Pulisci input e aggiorna UI
        updateValue("");
        HideSuggestions(field);
        await InvokeAsync(StateHasChanged);
    }
