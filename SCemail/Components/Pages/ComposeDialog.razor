    private void InitReplyRecipients()
    {
        var myAddr = NormalizeEmailValue(_selectedCasella).ToLowerInvariant();

        var to = SplitAddresses(Destinatari)
            .Select(ParseAddressToChip)
            .Where(c => !string.IsNullOrWhiteSpace(c.Email))
            .Where(c => !c.Email.Equals(myAddr, StringComparison.OrdinalIgnoreCase))
            .DistinctBy(c => c.Email, StringComparer.OrdinalIgnoreCase)
            .ToList();

        var cc = SplitAddresses(Cc)
            .Select(ParseAddressToChip)
            .Where(c => !string.IsNullOrWhiteSpace(c.Email))
            .Where(c => !c.Email.Equals(myAddr, StringComparison.OrdinalIgnoreCase))
            .Where(c => !to.Any(t => t.Email.Equals(c.Email, StringComparison.OrdinalIgnoreCase)))
            .DistinctBy(c => c.Email, StringComparer.OrdinalIgnoreCase)
            .ToList();

        var bcc = SplitAddresses(Bcc)
            .Select(ParseAddressToChip)
            .Where(c => !string.IsNullOrWhiteSpace(c.Email))
            .Where(c => !c.Email.Equals(myAddr, StringComparison.OrdinalIgnoreCase))
            .Where(c => !to.Any(t => t.Email.Equals(c.Email, StringComparison.OrdinalIgnoreCase)))
            .Where(c => !cc.Any(t => t.Email.Equals(c.Email, StringComparison.OrdinalIgnoreCase)))
            .DistinctBy(c => c.Email, StringComparer.OrdinalIgnoreCase)
            .ToList();

        _toList = to;
        _ccList = cc;
        _bccList = bcc;
    }

    private bool HasDraftContent()
    {
        var cleanHtml = _bodyHtml ?? "";

        cleanHtml = Regex.Replace(
            cleanHtml,
            @"<[^>]*data-sc-signature=""1""[^>]*>[\s\S]*?</[^>]+>",
            "",
            RegexOptions.IgnoreCase);

        cleanHtml = Regex.Replace(
            cleanHtml,
            @"<blockquote[^>]*data-sc-quote=""1""[^>]*>[\s\S]*?</blockquote>",
            "",
            RegexOptions.IgnoreCase);

        var bodyPlain = Regex.Replace(cleanHtml, "<.*?>", " ")
            .Replace("&nbsp;", " ")
            .Trim();

        bodyPlain = Regex.Replace(bodyPlain, @"\s+", " ");

        return !string.IsNullOrWhiteSpace(bodyPlain)
               || _outgoing.Any();
    }

    private static string PrepareQuoteForEditor(string? html)
    {
        if (string.IsNullOrWhiteSpace(html))
            return "";

        var s = html.Trim();

        s = Regex.Replace(s, @"<script[\s\S]*?</script>", "", RegexOptions.IgnoreCase);
        s = Regex.Replace(s, @"<style[\s\S]*?</style>", "", RegexOptions.IgnoreCase);
        s = Regex.Replace(s, @"<!--[\s\S]*?-->", "", RegexOptions.IgnoreCase);

        return s;
    }

