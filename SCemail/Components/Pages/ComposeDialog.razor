    protected override async Task OnInitializedAsync()
    {
        _draftId = DraftId;

        var ids = await AccessiSrv.GetCaselleAbilitateAsync(Utente);
        _caselleDisponibili = await MailSvc.GetEmailAddressesByIdsAsync(ids) ?? new List<string>();

        // pulizia lista
        _caselleDisponibili = _caselleDisponibili
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        var initialFrom = await ResolveInitialFromAddressAsync();

        if (!string.IsNullOrWhiteSpace(initialFrom))
        {
            // aggiunge la casella originale anche se non è nelle abilitazioni
            EnsureFromAddressAvailable(initialFrom);

            _selectedCasella = _caselleDisponibili
                .FirstOrDefault(x => x.Equals(initialFrom, StringComparison.OrdinalIgnoreCase))
                ?? _caselleDisponibili.FirstOrDefault();
        }
        else if (_caselleDisponibili.Any())
        {
            _selectedCasella = _caselleDisponibili.First();
        }

        // mai bloccare il campo: l’utente può cambiare verso una delle sue caselle
        _fromLocked = false;
        InitReplyRecipients();
        _showCc = _ccList.Any();
        _showBcc = _bccList.Any();
        _composeSubject = Oggetto ?? string.Empty;

        await LoadFirmaAsync();
        _pendingQuillInit = true;
        _quillInitialized = false;
        if (IsForward && ForwardAttachments is not null && ForwardAttachments.Any())
        {
            foreach (var a in ForwardAttachments)
            {
                if (!_outgoing.Any(x => x.FileName.Equals(a.FileName, StringComparison.OrdinalIgnoreCase)))
                {
                    _outgoing.Add(a);
                    _forwardedAttachments.Add(a);
                }
            }
        }
        if (DraftId.HasValue)
        {
            SplitDraftBody(CorpoIniziale ?? "");
        }
        else
        {
            _bodyHtml = "";
            _quoteHtml = PrepareQuoteForEditor(CorpoIniziale);
        }
        var recenti = await MailSvc.GetRecentRecipientsAsync(10);
        _allRecipients = (recenti ?? new List<string>())
            .Select(ParseAddressToChip)
            .DistinctBy(c => c.Email, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }


