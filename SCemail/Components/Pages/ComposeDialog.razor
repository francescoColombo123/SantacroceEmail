@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string Utente { get; set; } = default!;
    [Parameter] public string? Destinatari { get; set; }
    [Parameter] public string? Oggetto { get; set; }
    [Parameter] public string? CorpoIniziale { get; set; }
    [Parameter] public string? ReplyToMessageId { get; set; }
    [Parameter] public string? CasellaMittente { get; set; }
    [Parameter] public string? References { get; set; }
    [Parameter] public string? ThreadKey { get; set; }
    [Parameter] public string? Cc { get; set; }
    [Parameter] public string? Bcc { get; set; }
    [Parameter] public long? DraftId { get; set; }   // ✅ ID bozza se esistente

    private async Task FocusBackToField(string id)
    {
        // Chiamata diretta JS: focus su un input specifico
        await JSRuntime.InvokeVoidAsync("focusElementById", id);
    }
    private static readonly Regex UsernamePattern =
        new(@"^[a-z]\.[a-z]+$", RegexOptions.IgnoreCase);
    private List<RecipientChip> _toList = new();
    private List<RecipientChip> _ccList = new();
    private List<RecipientChip> _bccList = new();
    private List<RecipientChip> _allRecipients = new();
    private CancellationTokenSource? _ctsTo, _ctsCc, _ctsBcc;
    private bool _pendingQuillInit = true;
    private bool _quillInitialized = false;

    private string _lastInitBody = "";
    private string? _lastInitQuote = "";
    private string? _composeSubject;
    private string? _firmaHtml;
    private string _bodyHtml = "";
    private string _quoteHtml = "";

    private readonly List<IBrowserFile> _attachments = new();
    private readonly List<MailService_NEW.OutgoingAttachment_NEW> _outgoing = new();

    private ElementReference _dropZoneRef;
    private DotNetObjectReference<ComposeDialog>? _dotnetRef;

    private List<string> _caselleDisponibili = new();
    private string? _selectedCasella;
    private bool _fromLocked = false;

    protected override async Task OnInitializedAsync()
    {
        _draftId = DraftId;
        var ids = await AccessiSrv.GetCaselleAbilitateAsync(Utente);
        _caselleDisponibili = await MailSvc.GetEmailAddressesByIdsAsync(ids);

        if (!string.IsNullOrEmpty(CasellaMittente) && _caselleDisponibili.Contains(CasellaMittente))
            (_selectedCasella, _fromLocked) = (CasellaMittente, true);
        else if (_caselleDisponibili.Any())
            _selectedCasella = _caselleDisponibili.First();

        if (!string.IsNullOrWhiteSpace(Destinatari))
            _toList = SplitAddresses(Destinatari)
                      .Select(ParseAddressToChip)
                      .DistinctBy(c => c.Email, StringComparer.OrdinalIgnoreCase)
                      .ToList();

        if (!string.IsNullOrWhiteSpace(Cc))
        {
            _ccList = SplitAddresses(Cc)
                .Select(ParseAddressToChip)
                .DistinctBy(c => c.Email, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }

        if (!string.IsNullOrWhiteSpace(Bcc))
        {
            _bccList = SplitAddresses(Bcc)
                .Select(ParseAddressToChip)
                .DistinctBy(c => c.Email, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        _composeSubject = Oggetto ?? string.Empty;
        _firmaHtml = await MailSvc.GetFirmaUtenteAsync(Utente);
        _bodyHtml = ""; // oppure contenuto bozza se la carichi
        _quoteHtml = RemoveQuoteGarbage(CorpoIniziale ?? "");
        // Precarica i 10 più recenti
        var recenti = await MailSvc.GetRecentRecipientsAsync(10);
        _allRecipients = recenti
            .Select(ParseAddressToChip)
            .DistinctBy(c => c.Email, StringComparer.OrdinalIgnoreCase)
            .ToList();

        Logger.LogInformation("✅ ComposeDialog inizializzato. Destinatari recenti: {count}", _allRecipients.Count);
    }

    private string? _toInput;
    private string? _ccInput;
    private string? _bccInput;

    private void RemoveRecipient(List<RecipientChip> list, RecipientChip chip)
    {
        if (list.Contains(chip))
        {
            list.Remove(chip);
            StateHasChanged();
        }
    }

    private async Task<IEnumerable<RecipientChip>> SearchRecipientsHybrid(string value, CancellationToken token)
    {
        var query = (value ?? "").Trim();
        if (string.IsNullOrEmpty(query))
            return _allRecipients.Take(10);

        // 1) prendi match locali SENZA escludere
        var locali = _allRecipients
            .Where(c => c.Email.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                        (c.NameOrEmail?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false))
            .ToList();

        // 2) ordina: prima username tipo a.b, poi gli altri
        locali = locali
            .OrderByDescending(c => UsernamePattern.IsMatch(c.Email.Split('@')[0]))
            .ThenBy(c => c.Email)
            .Take(10)
            .ToList();

        if (locali.Count >= 5)
            return locali;

        // 3) integra da DB
        var found = await MailSvc.SearchRecipientsAsync(Utente, query, 10, token) ?? new List<string>();
        var nuovi = found
            .Select(ParseAddressToChip)
            .DistinctBy(c => c.Email, StringComparer.OrdinalIgnoreCase)
            .ToList();

        _allRecipients.AddRange(nuovi);
        _allRecipients = _allRecipients
            .GroupBy(c => c.Email, StringComparer.OrdinalIgnoreCase)
            .Select(g => g.First())
            .ToList();

        return locali.Concat(nuovi)
                     .DistinctBy(c => c.Email, StringComparer.OrdinalIgnoreCase)
                     .Take(10);
    }


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JSRuntime.InvokeVoidAsync("initFileDropZone", _dropZoneRef);

        if (!_pendingQuillInit)
            return;

        var bodyNow = _bodyHtml ?? "";
        var quoteNow = _quoteHtml ?? "";

        // ✅ NON saltare l’inizializzazione la prima volta
        if (_quillInitialized && bodyNow == _lastInitBody && quoteNow == _lastInitQuote)
        {
            _pendingQuillInit = false;
            return;
        }

        _dotnetRef ??= DotNetObjectReference.Create(this);

        await JSRuntime.InvokeVoidAsync("initQuill", "editor", _dotnetRef, bodyNow, quoteNow);

        _lastInitBody = bodyNow;
        _lastInitQuote = quoteNow;
        _quillInitialized = true;      // ✅ segnalo che ormai esiste
        _pendingQuillInit = false;
    }


    [JSInvokable]
    public void UpdateBodyHtml(string html) => _bodyHtml = html;
    [JSInvokable]
    public void CreateRecipientFromJs(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return;

        var chip = ParseAddressToChip(value);

        // 🔹 Decide in quale campo aggiungere (di solito "A", ma puoi estendere con tag ID)
        if (value.Contains("@")) // aggiungi solo se email valida
        {
            if (!_toList.Any(c => string.Equals(c.Email, chip.Email, StringComparison.OrdinalIgnoreCase)))
            {
                _toList.Add(chip);
                StateHasChanged();
            }
        }
    }
    private enum RecipientField { To, Cc, Bcc }

    private ElementReference _toBoxRef, _ccBoxRef, _bccBoxRef;


    // Suggerimenti per ciascun campo
    private bool _showSuggestionsTo, _showSuggestionsCc, _showSuggestionsBcc;
    private List<RecipientChip> _suggestionsTo = new();
    private List<RecipientChip> _suggestionsCc = new();
    private List<RecipientChip> _suggestionsBcc = new();
    private async Task Cancel()
    {
        await SafeDestroyEditor();
        MudDialog.Cancel();
    }

    private async Task SafeDestroyEditor()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("destroyQuill", "editor");
        }
        catch { /* ignore */ }
    }

    private async Task SendCompose()
    {
        if (!_toList.Any())
        {
            Snackbar.Add("⚠️ Inserisci almeno un destinatario", Severity.Warning);
            return;
        }

        var fromAddress = _selectedCasella ?? await MailSvc.GetEmailAddressByUsernameAsync(Utente);

        var userHtml = _bodyHtml ?? "";

        // Firma fuori quill (non editabile)
        var firmaPart = string.IsNullOrWhiteSpace(_firmaHtml)
            ? ""
            : $@"<br><br><div style=""font-family:'Courier New',Courier,monospace;"">{_firmaHtml}</div>";

        var corpoHtml = $@"
<div style=""background:#ffffff;color:#222;
            font-family:'Courier New',Courier,monospace;
            font-size:14px;line-height:1.5;"">
  {userHtml}
  {firmaPart}
</div>";

        await MailSvc.SendEmailAsync(
            usernameOrEmail: Utente,
            to: string.Join(";", ChipsToEmails(_toList)),
            cc: string.Join(";", ChipsToEmails(_ccList)),
            bcc: string.Join(";", ChipsToEmails(_bccList)),
            subject: _composeSubject ?? "(nessun oggetto)",
            bodyHtml: corpoHtml,
            attachments: _outgoing,
            fromAddressOverride: fromAddress,
            inReplyTo: ReplyToMessageId,
            referencesHdr: References
        );

        MudDialog.Close(DialogResult.Ok(true));
    }


    private RecipientChip CreateRecipientFromText(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
            return new RecipientChip("", null);

        raw = raw.Trim().TrimEnd(';', ',');
        return ParseAddressToChip(raw);
    }
    private long? _draftId;
    private static string RemoveQuoteGarbage(string? input)
    {
        if (string.IsNullOrWhiteSpace(input)) return "";

        // 1) decode HTML entities (&lt;div&gt; ecc)
        var s = WebUtility.HtmlDecode(input);

        // 2) normalizza newline
        s = s.Replace("\r\n", "\n");

        // 3) se è testo “plain”, trasformalo in html leggibile
        // (se già contiene tag html, non tocchiamo troppo)
        bool looksHtml = Regex.IsMatch(s, @"</?\w+[^>]*>", RegexOptions.IgnoreCase);
        if (!looksHtml)
            s = WebUtility.HtmlEncode(s).Replace("\n", "<br>");

        // 4) elimina wrapper div style brutto (se presenti)
        s = Regex.Replace(s, @"<div\s+style\s*=\s*""[\s\S]*?""\s*>", "", RegexOptions.IgnoreCase);
        s = Regex.Replace(s, @"</div\s*>", "", RegexOptions.IgnoreCase);

        // 5) taglia eventuale “doppione” incollato (capita quando ci sono quote ripetute)
        //    se trovi un secondo "Il giorno ... ha scritto:" troppo avanti, taglia.
        var m = Regex.Match(s, @"Il giorno[\s\S]{0,400}?ha scritto:", RegexOptions.IgnoreCase);
        if (m.Success)
        {
            // se ne trovi un'altra dopo, taglia dalla seconda in poi
            var m2 = Regex.Match(s.Substring(m.Index + m.Length), @"Il giorno[\s\S]{0,400}?ha scritto:", RegexOptions.IgnoreCase);
            if (m2.Success)
            {
                var cutIndex = m.Index + m.Length + m2.Index;
                s = s.Substring(0, cutIndex).Trim();
            }
        }

        return s.Trim();
    }


    private async Task SaveDraft()
    {
        var to = string.Join(";", ChipsToEmails(_toList));
        var cc = string.Join(";", ChipsToEmails(_ccList));
        var ccn = string.Join(";", ChipsToEmails(_bccList)); // CCN

        _draftId = await MailSvc.SaveDraftAsync(
                     utente: Utente,
                     to: to,
                     cc: cc,
                     ccn: ccn,
                     subject: _composeSubject,
                     bodyHtml: _bodyHtml,
                     draftId: _draftId
                 );

        Snackbar.Add("💾 Bozza salvata!", Severity.Info);

        MudDialog.Close(DialogResult.Ok(false));
        
    }


    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        foreach (var file in e.GetMultipleFiles())
        {
            // evita doppioni per nome
            if (_attachments.Any(a => a.Name.Equals(file.Name, StringComparison.OrdinalIgnoreCase)))
                continue;

            _attachments.Add(file);

            using var ms = new MemoryStream();
            await file.OpenReadStream().CopyToAsync(ms);

            _outgoing.Add(new MailService_NEW.OutgoingAttachment_NEW(
                file.Name, file.ContentType, ms.ToArray()));
        }

        Snackbar.Add($"{_attachments.Count} file allegato/i ✅", Severity.Info);
    }


    private void RemoveAttachment(IBrowserFile file)
    {
        _attachments.Remove(file);

        // ✅ rimuovi anche dalla lista effettivamente inviata
        _outgoing.RemoveAll(x =>
            string.Equals(x.FileName, file.Name, StringComparison.OrdinalIgnoreCase));

        Snackbar.Add($"Rimosso {file.Name}", Severity.Info);
        StateHasChanged();
    }

    public record RecipientChip(string Email, string? Name)
    {
        public string NameOrEmail => string.IsNullOrWhiteSpace(Name) ? Email : Name;
        public string Display => string.IsNullOrWhiteSpace(Name) ? Email : $"{Name} <{Email}>";
    }

    private static RecipientChip ParseAddressToChip(string raw)
    {
        var m = System.Text.RegularExpressions.Regex.Match(raw, @"^(?<name>.+?)\s*<(?<mail>[^>]+)>\s*$");
        return m.Success
            ? new RecipientChip(m.Groups["mail"].Value.Trim(), m.Groups["name"].Value.Trim())
            : new RecipientChip(raw.Trim(), null);
    }

    private static List<string> SplitAddresses(string? s)
        => string.IsNullOrWhiteSpace(s)
            ? new()
            : System.Text.RegularExpressions.Regex
                .Split(s, @"[;,]+")
                .Select(x => x.Trim())
                .Where(x => x.Length > 0)
                .ToList();

    private static IEnumerable<string> ChipsToEmails(IEnumerable<RecipientChip> chips)
        => chips.Select(c => c.Email).Distinct(StringComparer.OrdinalIgnoreCase);

    private static bool EmailComparer(RecipientChip? x, RecipientChip? y)
        => string.Equals(x?.Email, y?.Email, StringComparison.OrdinalIgnoreCase);

    private async Task OnRecipientInput(string? value, RecipientField field)
    {
        var query = (value ?? "").Trim();

        if (string.IsNullOrEmpty(query))
        {
            HideSuggestions(field);
            return;
        }

        CancellationTokenSource cts;
        switch (field)
        {
            case RecipientField.To:
                _ctsTo?.Cancel();
                _ctsTo = new CancellationTokenSource();
                cts = _ctsTo;
                break;
            case RecipientField.Cc:
                _ctsCc?.Cancel();
                _ctsCc = new CancellationTokenSource();
                cts = _ctsCc;
                break;
            default:
                _ctsBcc?.Cancel();
                _ctsBcc = new CancellationTokenSource();
                cts = _ctsBcc;
                break;
        }

        try
        {
            await Task.Delay(250, cts.Token); // debounce

            var results = (await SearchRecipientsHybrid(query, cts.Token)).ToList();

            switch (field)
            {
                case RecipientField.To:
                    _suggestionsTo = results;
                    _showSuggestionsTo = results.Any();
                    break;
                case RecipientField.Cc:
                    _suggestionsCc = results;
                    _showSuggestionsCc = results.Any();
                    break;
                case RecipientField.Bcc:
                    _suggestionsBcc = results;
                    _showSuggestionsBcc = results.Any();
                    break;
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException)
        {
            // utente sta scrivendo → ignora
        }
    }


    private void SelectSuggestion(RecipientChip chip, List<RecipientChip> targetList, RecipientField field)
    {
        if (!targetList.Any(c => string.Equals(c.Email, chip.Email, StringComparison.OrdinalIgnoreCase)))
            targetList.Add(chip);

        switch (field)
        {
            case RecipientField.To:
                _showSuggestionsTo = false;
                _toInput = string.Empty;
                break;
            case RecipientField.Cc:
                _showSuggestionsCc = false;
                _ccInput = string.Empty;
                break;
            case RecipientField.Bcc:
                _showSuggestionsBcc = false;
                _bccInput = string.Empty;
                break;
        }

        StateHasChanged();
    }



    private void HideSuggestions(RecipientField field)
    {
        switch (field)
        {
            case RecipientField.To:
                _showSuggestionsTo = false;
                break;
            case RecipientField.Cc:
                _showSuggestionsCc = false;
                break;
            case RecipientField.Bcc:
                _showSuggestionsBcc = false;
                break;
        }
    }
    private async Task HandleRecipientKey(
        KeyboardEventArgs e,
        List<RecipientChip> list,
        string? inputValue,
        Action<string?> updateValue,
        RecipientField field)
    {
        var text = (inputValue ?? "").Trim();

        // 🔹 1️⃣ Ogni volta che scrivi (non solo Enter), aggiorna i suggerimenti
        if (e.Key.Length == 1 || e.Key == "Backspace")
        {
            // Se cancella tutto → nascondi suggerimenti
            if (string.IsNullOrWhiteSpace(text))
            {
                HideSuggestions(field);
                await InvokeAsync(StateHasChanged);
                return;
            }

            try
            {
                using var cts = new CancellationTokenSource();
                var results = (await SearchRecipientsHybrid(text, cts.Token)).ToList();

                switch (field)
                {
                    case RecipientField.To:
                        _suggestionsTo = results;
                        _showSuggestionsTo = results.Any();
                        break;
                    case RecipientField.Cc:
                        _suggestionsCc = results;
                        _showSuggestionsCc = results.Any();
                        break;
                    case RecipientField.Bcc:
                        _suggestionsBcc = results;
                        _showSuggestionsBcc = results.Any();
                        break;
                }

                await InvokeAsync(StateHasChanged);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Errore ricerca destinatari ({Text})", text);
            }

            return; // 👈 non aggiungere ancora, solo suggerisci
        }

        // 🔹 2️⃣ Gestisci solo i tasti “commit”
        if (e.Key is not ("Enter" or "," or ";"))
            return;

        // Se ci sono suggerimenti visibili, lascia scegliere
        bool hasSuggestions = field switch
        {
            RecipientField.To => _showSuggestionsTo,
            RecipientField.Cc => _showSuggestionsCc,
            RecipientField.Bcc => _showSuggestionsBcc,
            _ => false
        };
        if (hasSuggestions)
            return;

        if (string.IsNullOrEmpty(text))
            return;

        // 🔹 3️⃣ Controllo email valida
        if (!text.Contains("@"))
        {
            Snackbar.Add("⚠️ Inserisci un indirizzo email valido", Severity.Warning);
            updateValue("");
            return;
        }

        // 🔹 4️⃣ Crea e aggiungi chip
        var chip = CreateRecipientFromText(text);
        if (!list.Any(c => c.Email.Equals(chip.Email, StringComparison.OrdinalIgnoreCase)))
        {
            list.Add(chip);
            try
            {
                await MailSvc.AddRecipientIfNotExistsAsync(chip.Email, chip.Name);
                Logger.LogInformation("📬 Aggiunto nuovo destinatario: {Email}", chip.Email);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Errore salvataggio destinatario {Email}", chip.Email);
            }
        }

        // 🔹 5️⃣ Pulisci input e aggiorna UI
        updateValue("");
        HideSuggestions(field);
        await InvokeAsync(StateHasChanged);
    }
    public async ValueTask DisposeAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("destroyQuill", "editor");
        }
        catch { /* ignoriamo */ }

        _dotnetRef?.Dispose();
    }
    private static string RemoveLeakedDivStyleLine(string? htmlOrText)
    {
        if (string.IsNullOrWhiteSpace(htmlOrText))
            return htmlOrText ?? "";

        // normalizza newline (Windows -> \n)
        var s = htmlOrText.Replace("\r\n", "\n");

        // 1) RAW: <div style="....">  (anche multi-line)
        s = Regex.Replace(
            s,
            @"<div\s+style\s*=\s*""[\s\S]*?""\s*>",
            "",
            RegexOptions.IgnoreCase
        );

        // 2) RAW: </div>
        s = Regex.Replace(
            s,
            @"</div\s*>",
            "",
            RegexOptions.IgnoreCase
        );

        // 3) ESCAPED: &lt;div style="..."&gt;
        s = Regex.Replace(
            s,
            @"&lt;div\s+style\s*=\s*&quot;[\s\S]*?&quot;\s*&gt;",
            "",
            RegexOptions.IgnoreCase
        );

        // 4) ESCAPED: &lt;/div&gt;
        s = Regex.Replace(
            s,
            @"&lt;/div\s*&gt;",
            "",
            RegexOptions.IgnoreCase
        );

        return s;
    }
