    private async Task SendCompose()
    {
        if (_uploadingAttachments)
        {
            Snackbar.Add("Attendi il completamento del caricamento allegati.", Severity.Warning);
            return;
        }
        if (!_toList.Any())
        {
            Snackbar.Add("⚠️ Inserisci almeno un destinatario", Severity.Warning);
            return;
        }

        // Qui NON inviare subito: prepara l’azione e fai partire il countdown
        await StartUndoableAction(
        kind: PendingActionKind.Send,
        label: "Invio programmato…",
        executeAsync: async (ct) =>
            {
                // (puoi ricontrollare ct se vuoi)
                ct.ThrowIfCancellationRequested();

                var fromAddress = _selectedCasella ?? await MailSvc.GetEmailAddressByUsernameAsync(Utente);

                var corpoHtml = _bodyHtml ?? "";
                await MailSvc.SendEmailAsync(
     usernameOrEmail: Utente,
     to: string.Join(";", ChipsToEmails(_toList)),
     cc: string.Join(";", ChipsToEmails(_ccList)),
     bcc: string.Join(";", ChipsToEmails(_bccList)),
     subject: _composeSubject ?? "(nessun oggetto)",
        bodyHtml: BuildBodyForSend(),
        attachments: _outgoing,
     fromAddressOverride: fromAddress,
     inReplyTo: ReplyToMessageId,
     referencesHdr: References,
     threadKey: ThreadKey
 );
                Snackbar.Add("Email inviata ✅", Severity.Success);
            },
            seconds: 10,
            closeOnExecute: true
        );
    }

    private bool _isClosing;
    private string BuildBodyForDraft()
    {
        var body = CleanBeforeSend(_bodyHtml);
        body = RemoveTrailingSignatures(body);

        var quote = _quoteHtml ?? "";
        var result = body;

        if (!string.IsNullOrWhiteSpace(quote))
        {
            result += "<br><br><hr><div><b>Messaggio precedente:</b></div>" +
                      "<blockquote style='border-left:2px solid #ccc;margin-left:8px;padding-left:12px;'>" +
                      quote +
                      "</blockquote>";
        }
        _showQuoteDetails = false;
        return result;
    }
    private static string RemoveTrailingSignatures(string? html)
    {
        if (string.IsNullOrWhiteSpace(html))
            return "";

        var s = html.Trim();

        s = Regex.Replace(
            s,
            @"(?is)(<p>\s*)?(<br\s*/?>\s*)*Cordiali\s+saluti\.?\s*(<br\s*/?>|\s|</p>)*Carlo\s+Di\s+Iorio\s*(<br\s*/?>|\s|</p>)*3467081608\s*(<br\s*/?>|\s|</p>)*(<span[^>]*>)?\s*EUROCEREALI\s+SRL\s*(</span>)?\s*(<br\s*/?>|\s|</p>)*$",
            "",
            RegexOptions.IgnoreCase
        );

        return s.Trim();
    }
    private async Task CloseAndSaveDraft()
    {
        if (_isClosing || _isSavingDraft || _isDisposed)
            return;

        _isClosing = true;
        _isSavingDraft = true;

        try
        {
            if (_uploadingAttachments)
            {
                Snackbar.Add("Attendi il completamento del caricamento allegati.", Severity.Warning);
                return;
            }

            await CancelPendingInternal();

            _bodyHtml = _bodyHtml?.Trim() ?? "";

            if (!HasDraftContent())
            {
                await SafeDestroyEditor();
                MudDialog.Close(DialogResult.Ok("draft-empty"));
                return;
            }

            _draftId = await MailSvc.SaveDraftAsync(
                utente: Utente,
                to: string.Join(";", ChipsToEmails(_toList)),
                cc: string.Join(";", ChipsToEmails(_ccList)),
                ccn: string.Join(";", ChipsToEmails(_bccList)),
                subject: _composeSubject,
               bodyHtml: BuildBodyForDraft(),
                draftId: _draftId,
                fromAddress: _selectedCasella,
                threadKey: ThreadKey,
                replyToMessageId: ReplyToMessageId
            );

            await SafeDestroyEditor();
            MudDialog.Close(DialogResult.Ok("draft"));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Errore salvataggio bozza");
            Snackbar.Add("Errore nel salvataggio della bozza ❌", Severity.Error);
            _isClosing = false;
        }
        finally
        {
            _isSavingDraft = false;
        }
    }

    private RecipientChip CreateRecipientFromText(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
            return new RecipientChip("", null);

        raw = raw.Trim().TrimEnd(';', ',');
        return ParseAddressToChip(raw);
    }
