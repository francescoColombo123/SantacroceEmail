@using Microsoft.AspNetCore.Components.Forms
@using SCemail.Components.Data
@inject ISnackbar Snackbar
@inject MailService_NEW MailSvc

<MudDialog>
    <DialogContent>
        <MudTextField Label="A"
                      @bind-Value="_composeTo"
                      FullWidth="true" />

        <MudTextField Label="Oggetto"
                      @bind-Value="_composeSubject"
                      FullWidth="true" />

        <MudTextField Label="Messaggio"
                      @bind-Value="_composeBody"
                      Lines="10"
                      FullWidth="true"
                      Style="font-family: Courier New, monospace; font-size:14px;" />

        <div class="mt-3">
            <InputFile OnChange="OnFileSelected" multiple />
            @if (_attachments.Any())
            {
                <ul class="mt-2">
                    @foreach (var f in _attachments)
                    {
                        <li>@f.Name (@f.Size / 1024) KB</li>
                    }
                </ul>
            }
        </div>
    </DialogContent>

    <DialogActions>
        <MudButton Color="Color.Primary"
                   OnClick="SendCompose"
                   Variant="Variant.Filled">Invia</MudButton>
        <MudButton OnClick="Cancel"
                   Variant="Variant.Text">Chiudi</MudButton>
    </DialogActions>
</MudDialog>

@code {
     [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string Utente { get; set; } = default!;

    private string? _composeTo;
    private string? _composeSubject;
    private string? _composeBody;
    private readonly List<IBrowserFile> _attachments = new();
    private readonly List<MailService_NEW.OutgoingAttachment_NEW> _outgoing = new();

    private void Cancel() => MudDialog.Cancel();

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        foreach (var file in e.GetMultipleFiles())
        {
            _attachments.Add(file);

            using var ms = new MemoryStream();
            await file.OpenReadStream().CopyToAsync(ms);
            _outgoing.Add(new MailService_NEW.OutgoingAttachment_NEW(
                file.Name,
                file.ContentType,
                ms.ToArray()
            ));
        }
    }

    private async Task SendCompose()
    {
        if (string.IsNullOrWhiteSpace(_composeTo))
        {
            Snackbar.Add("⚠️ Destinatario mancante", Severity.Warning);
            return;
        }

        // SOLO testo con <br/> → la firma la aggiunge MailService_NEW
        var htmlBody = (_composeBody ?? string.Empty).Replace("\n", "<br/>");

        await MailSvc.SendEmailAsync(
            Utente!,
            _composeTo!,
            _composeSubject ?? "(nessun oggetto)",
            htmlBody,
            _outgoing
        );

        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Configuration.VisibleStateDuration = 5000;
        Snackbar.Add("✉️ Email inviata con successo!", Severity.Success);

        MudDialog.Close(DialogResult.Ok(true));
    }
}
