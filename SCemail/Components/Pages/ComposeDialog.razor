@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using SCemail.Components.Data
@using MudBlazor
@using System.Text.RegularExpressions
@using System.Net
@inject ISnackbar Snackbar
@inject SCemail.Components.Data.AccessiService AccessiSrv
@inject MailService_NEW MailSvc
@inject ILogger<ComposeDialog> Logger
@inject IJSRuntime JSRuntime

<MudDialog>
    <DialogContent>

        <!-- Mittente -->
        <MudSelect T="string" Label="Da"
                   @bind-Value="_selectedCasella"
                   FullWidth="true"
                   Dense="true"
                   Disabled="_fromLocked">
            @foreach (var mail in _caselleDisponibili)
            {
                <MudSelectItem Value="@mail">@mail</MudSelectItem>
            }
        </MudSelect>

        <!-- ==========================  A  ========================== -->
        <div class="recipient-container" @ref="_toBoxRef">
            <label class="mud-input-label">A</label>
            <div class="recipient-box">
                @foreach (var chip in _toList)
                {
                    <MudChip T="RecipientChip"
                             Color="Color.Primary"
                             Variant="Variant.Filled"
                             OnClick="() => OnChipClick(chip)"
                             OnClose="@(e => RemoveRecipient(_toList, chip))"
                             Closeable="true"
                             Class="chip-pill">
                        <div class="chip-avatar chip-a">@chip.Email.Substring(0, 1).ToUpper()</div>
                        <div class="chip-name">@chip.NameOrEmail</div>
                    </MudChip>
                }

                <MudTextField T="string"
                              @bind-Value="_toInput"
                              Immediate="true"
                              OnInput="@(async (ChangeEventArgs e) =>
                                      await OnRecipientInput(e?.Value?.ToString() ?? string.Empty, RecipientField.To))"
                              @onkeydown="@(async e => await HandleRecipientKey(e, _toList, _toInput ?? "", v => _toInput = v, RecipientField.To))"
                              Placeholder="Aggiungi destinatario..."
                              Class="recipient-input"
                              Variant="Variant.Text" />

            </div>

            @if (_showSuggestionsTo && _suggestionsTo.Any())
            {
                <MudPaper Class="suggestion-panel">
                    @foreach (var s in _suggestionsTo)
                    {
                        <div class="suggestion-item"
                             @onclick="() => SelectSuggestion(s, _toList, RecipientField.To)">
                            <div class="chip-avatar chip-a">@s.Email.Substring(0, 1).ToUpper()</div>
                            <div class="chip-texts">
                                <div class="chip-name">@s.NameOrEmail</div>
                                <div class="chip-email">@s.Email</div>
                            </div>
                        </div>
                    }
                </MudPaper>
            }
        </div>



        <!-- ==========================  CC  ========================== -->
        <div class="recipient-container" @ref="_ccBoxRef">
            <label class="mud-input-label">CC</label>
            <div class="recipient-box">
                @foreach (var chip in _ccList)
                {
                    <MudChip T="RecipientChip"
                             Color="Color.Secondary"
                             Variant="Variant.Filled"
                             OnClick="() => OnChipClick(chip)"
                             OnClose="@(e => RemoveRecipient(_ccList, chip))"
                             Closeable="true"
                             Class="chip-pill">
                        <div class="chip-avatar chip-cc">@chip.Email.Substring(0, 1).ToUpper()</div>
                        <div class="chip-name">@chip.NameOrEmail</div>
                    </MudChip>
                }

                <MudTextField T="string"
                              @bind-Value="_ccInput"
                              Immediate="true"
                              OnInput="@(async (ChangeEventArgs e) =>
                                                          await OnRecipientInput(e?.Value?.ToString() ?? string.Empty, RecipientField.Cc))"
                              @onkeydown="@(async e => await HandleRecipientKey(e, _ccList, _ccInput ?? "", v => _ccInput = v, RecipientField.Cc))"
                              Placeholder="Aggiungi CC..."
                              Class="recipient-input"
                              Variant="Variant.Text" />
            </div>

            @if (_showSuggestionsCc && _suggestionsCc.Any())
            {
                <MudPaper Class="suggestion-panel">
                    @foreach (var s in _suggestionsCc)
                    {
                        <div class="suggestion-item"
                             @onclick="() => SelectSuggestion(s, _ccList, RecipientField.Cc)">
                            <div class="chip-avatar chip-cc">@s.Email.Substring(0, 1).ToUpper()</div>
                            <div class="chip-texts">
                                <div class="chip-name">@s.NameOrEmail</div>
                                <div class="chip-email">@s.Email</div>
                            </div>
                        </div>
                    }
                </MudPaper>
            }
        </div>

        <!-- ==========================  CCN  ========================== -->
        <div class="recipient-container" @ref="_bccBoxRef">
            <label class="mud-input-label">CCN</label>
            <div class="recipient-box">
                @foreach (var chip in _bccList)
                {
                    <MudChip T="RecipientChip"
                             Color="Color.Tertiary"
                             Variant="Variant.Filled"
                             OnClick="() => OnChipClick(chip)"
                             OnClose="@(e => RemoveRecipient(_bccList, chip))"
                             Closeable="true"
                             Class="chip-pill">
                        <div class="chip-avatar chip-bcc">@chip.Email.Substring(0, 1).ToUpper()</div>
                        <div class="chip-name">@chip.NameOrEmail</div>
                    </MudChip>
                }

                <MudTextField T="string"
                              @bind-Value="_bccInput"
                              Immediate="true"
                              OnInput="@(async (ChangeEventArgs e) =>
                                                          await OnRecipientInput(e?.Value?.ToString() ?? string.Empty, RecipientField.Bcc))"
                              @onkeydown="@(async e => await HandleRecipientKey(e, _bccList, _bccInput ?? "", v => _bccInput = v, RecipientField.Bcc))"
                              Placeholder="Aggiungi CCN..."
                              Class="recipient-input"
                              Variant="Variant.Text" />
            </div>

            @if (_showSuggestionsBcc && _suggestionsBcc.Any())
            {
                <MudPaper Class="suggestion-panel">
                    @foreach (var s in _suggestionsBcc)
                    {
                        <div class="suggestion-item"
                             @onclick="() => SelectSuggestion(s, _bccList, RecipientField.Bcc)">
                            <div class="chip-avatar chip-bcc">@s.Email.Substring(0, 1).ToUpper()</div>
                            <div class="chip-texts">
                                <div class="chip-name">@s.NameOrEmail</div>
                                <div class="chip-email">@s.Email</div>
                            </div>
                        </div>
                    }
                </MudPaper>
            }
        </div>



        <!-- Oggetto -->
        <MudTextField T="string" Label="Oggetto"
                      Dense="true"
                      FullWidth="true"
                      @bind-Value="_composeSubject" />

        <!-- Editor -->
        <div style="margin-top: 12px;">
            <label class="mud-input-label">Messaggio</label>
            <div id="editor"></div>
        </div>
      
        <!-- Firma -->
        @if (!string.IsNullOrEmpty(_firmaHtml))
        {
            <div class="firma-container" style="margin-top:10px; font-size:13px; color:#666;">
                <hr style="border:none;border-top:1px solid #ccc;margin:8px 0;" />
                <div>@((MarkupString)_firmaHtml)</div>
            </div>
        }

        <!-- Allegati -->
        <div id="dropZone" class="drop-zone mt-3" @ref="_dropZoneRef">
            <MudIcon Icon="@Icons.Material.Filled.UploadFile" Size="Size.Large" Color="Color.Primary" />
            <div>Trascina qui i file o clicca per selezionarli</div>
            <InputFile OnChange="OnFileSelected" multiple />
        </div>

        @if (_attachments.Any())
        {
            <ul class="mt-2">
                @foreach (var f in _attachments)
                {
                    <li>
                        <MudIcon Icon="@Icons.Material.Filled.AttachFile" Size="Size.Small" />
                        @f.Name (@Math.Round(f.Size / 1024.0)) KB
                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="@(() => RemoveAttachment(f))" />
                    </li>
                }
            </ul>
        }

    </DialogContent>

    <DialogActions>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Send"
                   OnClick="SendCompose">Invia</MudButton>

        <MudButton OnClick="Cancel"
                   Variant="Variant.Text">Chiudi</MudButton>

        <MudButton Color="Color.Secondary"
                   Variant="Variant.Outlined"
                   OnClick="SaveDraft">💾 Salva bozza</MudButton>
    </DialogActions>
</MudDialog>

