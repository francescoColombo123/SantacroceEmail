@using MudBlazor
@using Microsoft.AspNetCore.Components
@inherits ComponentBase

<CascadingValue Value="MudDialog">
    <MudDialog>
        <DialogContent>
            <MudText Typo="Typo.h6">@Title</MudText>
            @if (!string.IsNullOrWhiteSpace(Message))
            {
                <MudText Typo="Typo.body2" Class="mb-2">@Message</MudText>
            }

            <MudTextField T="string"
                          @bind-Value="_text"
                          Lines="3"
                          Variant="Variant.Outlined"
                          Placeholder="Inserisci commento..."
                          Immediate="true" />
        </DialogContent>

        <DialogActions>
            <MudButton Variant="Variant.Text" OnClick="Cancel">Annulla</MudButton>
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       Disabled="@string.IsNullOrWhiteSpace(_text)"
                       OnClick="Ok">
                Conferma
            </MudButton>
        </DialogActions>
    </MudDialog>
</CascadingValue>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string Title { get; set; } = "Commento";
    [Parameter] public string Message { get; set; } = "";

    private string? _text;

    private void Cancel() => MudDialog.Cancel();
    private void Ok() => MudDialog.Close(DialogResult.Ok(_text?.Trim()));
}
