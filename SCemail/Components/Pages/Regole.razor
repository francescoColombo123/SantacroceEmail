@page "/regole"
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.EntityFrameworkCore
@using SCemail.Components.Data
@inject IDbContextFactory<MailDbContext> DbFactory
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IDialogService DialogService

<div class="container my-5">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">📧 Regole di Gestione Email</h5>
            <button class="btn btn-light btn-sm" @onclick="TornaIndietro">⬅️ Indietro</button>
        </div>

        <div class="card-body">
            @if (IsEditing)
            {
                <div class="alert alert-warning d-flex justify-content-between align-items-center">
                    <div>
                        ✏️ <b>Stai modificando una regola esistente</b>
                    </div>
                    <button class="btn btn-sm btn-outline-dark" @onclick="CancelEdit">
                        Annulla modifica
                    </button>
                </div>
            }

            <EditForm Model="@form" OnValidSubmit="@SalvaRegola">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="row g-3 mb-3">
                    <div class="col-md-3">
                        <label class="form-label">Mittente (LIKE)</label>
                        <InputText class="form-control" @bind-Value="form.MittenteLike" />
                        <small class="text-muted">Scrivi "TUTTI" per includere qualsiasi valore</small>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Destinatario (LIKE)</label>
                        <InputText class="form-control" @bind-Value="form.DestLike" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Oggetto (LIKE)</label>
                        <InputText class="form-control" @bind-Value="form.OggettoLike" />
                    </div>

                    <div class="col-md-3">
                        <MudSelect T="string"
                                   Label="Assegnatari"
                                   MultiSelection="true"
                                   SelectedValues="form.AssegnatariSelezionati"
                                   SelectedValuesChanged="@(values => form.AssegnatariSelezionati = values.ToList())"
                                   Dense="true"
                                   Class="w-100">
                            @foreach (var u in _utenti)
                            {
                                <MudSelectItem Value="@u">@u</MudSelectItem>
                            }
                        </MudSelect>
                    </div>
                </div>

                <div class="row g-3 align-items-center mb-3">
                    <div class="col-md-3 form-check ms-3">
                        <InputCheckbox class="form-check-input" @bind-Value="form.SoloInvio" />
                        <label class="form-check-label ms-2">Solo invio (non visionare)</label>
                    </div>

                    <div class="col-md-3 form-check ms-3">
                        <InputCheckbox class="form-check-input" @bind-Value="form.Attiva" />
                        <label class="form-check-label ms-2">Regola attiva</label>
                    </div>

                    <div class="col-md-3 d-flex justify-content-end">
                        <button type="submit"
                                class="btn @(IsEditing ? "btn-primary" : "btn-success") w-100">
                            @(IsEditing ? "💾 Salva modifiche" : "➕ Aggiungi Regola")
                        </button>

                    </div>
                </div>
            </EditForm>

            <hr />

            <h6 class="mb-3 text-secondary">Regole configurate</h6>

            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Mittente</th>
                        <th>Destinatario</th>
                        <th>Oggetto</th>
                        <th>Assegnatari</th>
                        <th>Solo Invio</th>
                        <th>Attiva</th>
                        <th class="text-end">Azioni</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in _regole)
                    {
                        <tr class="@(r.Id == _editingId ? "table-warning" : "")">
                            <td>@r.MittenteLike</td>
                            <td>@r.DestLike</td>
                            <td>@r.OggettoLike</td>
                            <td>@r.AssegnaA</td>
                            <td>@(r.SoloInvio ? "✅" : "❌")</td>
                            <td>@(r.Attiva ? "🟢" : "🔴")</td>
                            <td class="text-end">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Color="Color.Primary"
                                               OnClick="@(() => EditRegola(r))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               OnClick="@(() => DeleteRegola(r))" />
                            </td>
                        </tr>
                    }

                </tbody>

            </table>
        </div>
    </div>
</div>

@code {
    private List<EmailRegola> _regole = new();
    private RegolaForm form = new();
    private List<string> _utenti = new();
    private string? _cp;
    private int? _editingId = null;
    private bool IsEditing => _editingId.HasValue;


    protected override async Task OnInitializedAsync()
    {
        await using var db = DbFactory.CreateDbContext();

        // ✅ carica solo utenti validi (iniziano con lettera + punto)
        _utenti = await db.Database
            .SqlQueryRaw<string>("SELECT UTENTE FROM INFOUSER ORDER BY UTENTE")
            .ToListAsync();

        _regole = await db.EmailRegole.AsNoTracking()
            .OrderByDescending(r => r.Id)
            .ToListAsync();
        var q = QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        _cp = q.TryGetValue("cp", out var v) && !string.IsNullOrWhiteSpace(v)
            ? v.ToString()
            : null;
    }

    private void EditRegola(EmailRegola r)
    {
        form = new RegolaForm
        {
            MittenteLike = r.MittenteLike,
            DestLike = r.DestLike,
            OggettoLike = r.OggettoLike,
            SoloInvio = r.SoloInvio,
            Attiva = r.Attiva,
            AssegnatariSelezionati = r.AssegnaA?
                .Split(';', StringSplitOptions.RemoveEmptyEntries)
                .ToList() ?? new()
        };

        _editingId = r.Id;
    }

    private async Task SalvaRegola()
    {
        if (form.AssegnatariSelezionati.Count == 0)
        {
            Snackbar.Add("⚠️ Seleziona almeno un assegnatario.", Severity.Warning);
            return;
        }

        await using var db = DbFactory.CreateDbContext();

        EmailRegola entity;

        if (_editingId.HasValue)
        {
            entity = await db.EmailRegole.FindAsync(_editingId.Value);
            if (entity == null) return;
        }
        else
        {
            entity = new EmailRegola
            {
                CreatedAt = DateTime.Now,
                CreatedBy = "admin"
            };
            db.EmailRegole.Add(entity);
        }

        entity.MittenteLike = form.MittenteLike;
        entity.DestLike = form.DestLike;
        entity.OggettoLike = form.OggettoLike;
        entity.AssegnaA = string.Join(';', form.AssegnatariSelezionati);
        entity.SoloInvio = form.SoloInvio;
        entity.Attiva = form.Attiva;

        await db.SaveChangesAsync();

        _regole = await db.EmailRegole
            .AsNoTracking()
            .OrderByDescending(r => r.Id)
            .ToListAsync();

        form = new();
        _editingId = null;

        Snackbar.Add("✅ Regola salvata.", Severity.Success);
    }
    
    private async Task DeleteRegola(EmailRegola r)
    {
        bool? confirm = await DialogService.ShowMessageBox(
            title: "Conferma eliminazione",
            message: "⚠️ Vuoi davvero eliminare definitivamente questa regola?",
            yesText: "Elimina",
            cancelText: "Annulla",
            options: new DialogOptions
            {
                MaxWidth = MaxWidth.Small,
                FullWidth = true,
                CloseButton = true
            });

        if (confirm != true)
            return;

        await using var db = DbFactory.CreateDbContext();
        var entity = await db.EmailRegole.FindAsync(r.Id);
        if (entity == null)
            return;

        db.EmailRegole.Remove(entity);
        await db.SaveChangesAsync();

        _regole.Remove(r);

        Snackbar.Add("🗑️ Regola eliminata definitivamente.", Severity.Success);
    }

    private void CancelEdit()
    {
        form = new RegolaForm();
        _editingId = null;
    }

    private void TornaIndietro()
    {
        if (!string.IsNullOrWhiteSpace(_cp))
            Nav.NavigateTo($"/?cp={Uri.EscapeDataString(_cp)}");
        else
            Nav.NavigateTo("/");
    }

    private class RegolaForm
    {
        public string? MittenteLike { get; set; }
        public string? DestLike { get; set; }
        public string? OggettoLike { get; set; }
        public string AssegnaA { get; set; } = "";
        public bool SoloInvio { get; set; }
        public bool Attiva { get; set; } = true;
        public List<string> AssegnatariSelezionati { get; set; } = new(); // ✅ aggiunta per la multiselect
    }
}
