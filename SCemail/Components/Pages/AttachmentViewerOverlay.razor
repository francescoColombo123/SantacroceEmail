@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.JSInterop
@inject HttpClient Http
@inject IJSRuntime JS

@if (_visible)
{
    <div class="attov-backdrop" @onclick="Close">
        <div class="attov-modal" @onclick:stopPropagation="true">
            <div class="attov-header">
                <div class="attov-head-left">
                    <div class="attov-kicker">Visualizzatore allegati</div>
                    <div class="attov-title">Anteprima allegato</div>

                    @if (_currentMeta is not null)
                    {
                        <div class="attov-filename" title="@_currentMeta.Filename">
                            @_currentMeta.Filename
                        </div>
                    }
                </div>

                <div class="attov-head-right">
                    @if (_attachments.Count > 1 && _currentMeta is not null)
                    {
                        <div class="attov-nav">
                            <button @onclick="GoPrevious"
                                    disabled="@(!_hasPrevious)"
                                    class="attov-nav-btn">
                                ←
                            </button>

                            <span class="attov-counter">
                                @(_currentIndex + 1) / @_attachments.Count
                            </span>

                            <button @onclick="GoNext"
                                    disabled="@(!_hasNext)"
                                    class="attov-nav-btn">
                                →
                            </button>
                        </div>
                    }

                    @if (_currentMeta is not null)
                    {
                        <a href="@_downloadUrl"
                           target="_blank"
                           rel="noopener"
                           class="attov-download">
                            Scarica
                        </a>
                    }

                    <button class="attov-close" @onclick="Close">✕</button>
                </div>
            </div>

            <div class="attov-body">
                @if (_loading)
                {
                    <div class="attov-initial-loader">

                        <div class="attov-initial-loader-ring">
                            <div class="attov-initial-loader-inner"></div>
                        </div>

                        <div class="attov-initial-loader-title">
                            Apertura allegato
                        </div>

                        <div class="attov-initial-loader-subtitle">
                            Recupero delle informazioni in corso...
                        </div>

                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(_error))
                {
                    <div class="attov-error">
                        <div style="font-weight:700; margin-bottom:6px;">Impossibile aprire l’allegato</div>
                        <div>@_error</div>
                    </div>
                }
                else if (_currentMeta is null)
                {
                    <div class="attov-state">
                        Allegato non disponibile.
                    </div>
                }
                else if (_isOffice && !_officePreviewAvailable)
                {
                    <div class="attov-office-unavailable">

                        <div class="attov-office-unavailable-card">

                            <div class="attov-office-unavailable-icon">
                                <svg viewBox="0 0 24 24"
                                     width="32"
                                     height="32"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.7"
                                     stroke-linecap="round"
                                     stroke-linejoin="round">

                                    <path d="M6 2h8l4 4v16H6z" />
                                    <path d="M14 2v5h5" />
                                    <path d="M9 13h6" />
                                    <path d="M9 17h4" />
                                </svg>
                            </div>

                            <div class="attov-office-unavailable-title">
                                Anteprima non disponibile
                            </div>

                            <div class="attov-office-unavailable-text">
                                Questo documento non può essere visualizzato
                                direttamente al momento.
                            </div>

                            <div class="attov-office-unavailable-hint">
                                Puoi comunque scaricarlo e aprirlo normalmente.
                            </div>

                            <a href="@_downloadUrl"
                               target="_blank"
                               rel="noopener"
                               class="attov-office-unavailable-download">
                                Scarica documento
                            </a>

                        </div>

                    </div>
                }
                else if (_isPreviewable)
                {
                    @if (_isImage)
                    {
                        <div class="attov-preview-wrap">
                            <img src="@_inlineUrl"
                                 alt="@_currentMeta.Filename"
                                 class="attov-image" />
                        </div>
                    }
                    else if (_isPdf || _isOffice)
                    {
                        <div class="attov-preview-wrap attov-pdf-wrap">
                            <div id="pdfPagesContainerOverlay"
                                 class="attov-pdf-pages">
                            </div>
                        </div>
                    }
                    else
                    {
                        <iframe src="@_inlineUrl"
                                title="Anteprima allegato"
                                class="attov-frame"
                                loading="lazy">
                        </iframe>
                    }
                }
                else
                {
                    <div class="attov-state">
                        Questo file (<b>@_effectiveMime</b>)
                        non è visualizzabile direttamente nel browser.
                        Puoi comunque scaricarlo.
                    </div>
                }
                else
                {
                    <div class="attov-state">
                        Questo file (<b>@_effectiveMime</b>) non è visualizzabile direttamente nel browser.
                        Puoi comunque scaricarlo.
                    </div>
                }
            </div>
        </div>
    </div>
}

<style>
