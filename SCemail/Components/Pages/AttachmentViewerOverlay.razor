        background: linear-gradient( 225deg, #eef4ff 50%, transparent 51% );
    }

    .document-preview-file-line {
        position: absolute;
        left: 14px;
        height: 4px;
        border-radius: 10px;
        background: #cbd5e1;
    }

        .document-preview-file-line.line-1 {
