        border-radius: 50%;
        background: conic-gradient( #2563eb, #93c5fd, #dbeafe, #2563eb );
        animation: attov-initial-spin 1s linear infinite;
        margin-bottom: 18px;
    }

    .attov-initial-loader-inner {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        background: #fff;
    }

    .attov-initial-loader-title {
        font-size: 17px;
        font-weight: 700;
        color: #0f172a;
