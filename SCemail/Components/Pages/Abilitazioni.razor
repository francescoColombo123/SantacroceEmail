@page "/abilitazioni"
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@using SCemail.Components.Data
@inject IDbContextFactory<MailDbContext> DbFactory
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Nav

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h5>🔑 Abilitazioni Utenti alle Caselle</h5>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Home"
                   OnClick="@TornaHome">
            Home
        </MudButton>
    </div>

    <MudExpansionPanels Multiple="true" Elevation="1">
        @foreach (var casella in _caselle)
        {
            <MudExpansionPanel>
                <TitleContent>
                    <span class="fw-bold">@casella.Email</span>
                    <small class="text-muted">(@casella.Provider)</small>
                </TitleContent>

                <ChildContent>
                    <div class="mb-2 d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted">
                                IMAP: @casella.ImapHost:@casella.ImapPort (SSL: @casella.UseSsl)
                            </small>
                        </div>
                        <MudButton Variant="Variant.Text" Color="Color.Warning" Size="Size.Small"
                                   OnClick="@(() => ModificaPassword(casella))">
                            🔐 Password
                        </MudButton>
                    </div>

                    <h6 class="mt-3 text-secondary">➕ Aggiungi utente</h6>
                    <div class="input-group mb-2">
                        <select class="form-select form-select-sm" @bind="_selezioneUtente[casella.Id]">
                            <option value="">-- Seleziona utente --</option>
                            @foreach (var u in GetUtentiDisponibili(casella.Id))
                            {
                                <option value="@u">@u</option>
                            }
                        </select>
                        <button class="btn btn-sm btn-success"
                                disabled="@string.IsNullOrWhiteSpace(GetSelected(casella.Id))"
                                @onclick="() => AssociaUtente(casella.Id)">
                            Aggiungi
                        </button>
                    </div>

                    <h6 class="text-secondary mt-3">👥 Utenti abilitati</h6>
                    <table class="table table-sm table-striped align-middle">
                        <thead>
                            <tr>
                                <th>Username</th>
                                <th>Firma</th>
                                <th style="width:150px;">Azioni</th>
                                <th>Admin</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var abil in _abilitazioni.Where(a => a.CasellaId == casella.Id))
                            {
                                <tr>
                                    <td>@abil.Username</td>
                                    <td>
                                        <pre class="bg-light p-2 rounded firma-preview">
        Cordiali saluti.
        <b>@abil.Nome</b>
        @abil.Titolo
        <small>@abil.Recapito</small>
        </pre>
                                    </td>
                                    <td>
                                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                                   OnClick="@(() => ModificaFirma(abil))">
                                            ✏️ Modifica
                                        </MudButton>
                                        <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small"
                                                   OnClick="@(() => Rimuovi(abil))">
                                            ❌ Rimuovi
                                        </MudButton>
                                    </td>
                                    <td>
                                        <MudSwitch Value="abil.IsAdmin"
                                                   T="bool"
                                                   Color="Color.Primary"
                                                   ValueChanged="@(value => CambiaAdmin(abil, value))" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </ChildContent>
            </MudExpansionPanel>
        }
    </MudExpansionPanels>
</div>

<style>
    .container {
        font-size: 0.85rem;
    }

    h5, h6 {
        margin-bottom: 0.3rem;
        font-weight: 600;
    }

    .table th, .table td {
        padding: 0.25rem 0.4rem !important;
        vertical-align: middle;
    }

    .firma-preview {
        font-size: 0.8rem;
        line-height: 1.1rem;
        margin: 0;
        white-space: pre-wrap;
    }

    .mud-button-root {
        font-size: 0.75rem !important;
        min-height: 26px !important;
        padding: 2px 6px !important;
    }

    .input-group .form-select,
    .input-group .btn {
        font-size: 0.8rem;
        height: 28px;
    }

    .mud-expansion-panel {
        margin-bottom: 0.25rem;
    }
</style>

@code {
    private List<CasellaPosta> _caselle = new();
    private List<CasellaAbilitazione> _abilitazioni = new();
    private List<string> _utenti = new();
    private Dictionary<int, string?> _selezioneUtente = new();
    private string? _cp;

    protected override void OnInitialized()
    {
        var uri = new Uri(Nav.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("cp", out var cp))
            _cp = cp;
    }

    private void TornaHome()
    {
        if (!string.IsNullOrEmpty(_cp))
            Nav.NavigateTo($"/?cp={_cp}");
        else
            Nav.NavigateTo("/");
    }

    protected override async Task OnInitializedAsync()
    {
        await using var db = DbFactory.CreateDbContext();
        _caselle = await db.CasellePosta.AsNoTracking().OrderBy(c => c.Email).ToListAsync();
        _abilitazioni = await db.CasellaAbilitazioni.AsNoTracking()
            .OrderBy(a => a.CasellaId).ThenBy(a => a.Username).ToListAsync();
        _utenti = await db.InfoUsers.AsNoTracking().Select(i => i.Utente).OrderBy(x => x).ToListAsync();

        foreach (var c in _caselle)
            _selezioneUtente[c.Id] = null;
    }

    private IEnumerable<string> GetUtentiDisponibili(int casellaId)
    {
        var gia = _abilitazioni.Where(a => a.CasellaId == casellaId)
                               .Select(a => a.Username)
                               .ToHashSet(StringComparer.OrdinalIgnoreCase);
        return _utenti.Where(u => !gia.Contains(u));
    }

    private string? GetSelected(int casellaId)
        => _selezioneUtente.TryGetValue(casellaId, out var v) ? v : null;

    private async Task AssociaUtente(int casellaId)
    {
        var user = GetSelected(casellaId);
        if (string.IsNullOrWhiteSpace(user)) return;

        try
        {
            await using var db = DbFactory.CreateDbContext();

            // Controllo se già abilitato
            var count = await db.CasellaAbilitazioni
                .CountAsync(a => a.CasellaId == casellaId && a.Username == user);

            if (count > 0)
            {
                Snackbar.Add($"'{user}' è già abilitato.", Severity.Info);
                return;
            }

            // 🔹 Chiedi subito la firma
            var parameters = new DialogParameters
            {
                ["Title"] = $"Dati firma per {user}"
            };
            var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small };
            var dialog = DialogService.Show<FirmaUtenteDialog>(
                "Firma utente",
                parameters,
                new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small }
            );
            var result = await dialog.Result;

            if (result.Canceled || result.Data is not FirmaUtenteDialog.FirmaUtenteResult fr)
            {
                Snackbar.Add("Operazione annullata", Severity.Info);
                return;
            }

            var a = new CasellaAbilitazione
            {
                CasellaId = casellaId,
                Username = user,
                Nome = fr.Nome,
                Titolo = fr.Titolo,
                Recapito = fr.Recapito,
                IsAdmin = fr.IsAdmin,
                CreatedAt = DateTime.Now
            };

            db.CasellaAbilitazioni.Add(a);
            await db.SaveChangesAsync();

            _abilitazioni.Add(a);
            _selezioneUtente[casellaId] = null;
            Snackbar.Add($"Utente '{user}' abilitato con firma ✅", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore abilitazione: {ex.Message}", Severity.Error);
        }
    }

    private async Task ModificaFirma(CasellaAbilitazione abil)
    {
        var parameters = new DialogParameters
        {
            ["Nome"] = abil.Nome,
            ["Titolo"] = abil.Titolo,
            ["Recapito"] = abil.Recapito
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small };
        var dialog = DialogService.Show<FirmaUtenteDialog>("Modifica Firma", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is FirmaUtenteDialog.FirmaUtenteResult fr)
        {
            try
            {
                await using var db = DbFactory.CreateDbContext();
                var item = await db.CasellaAbilitazioni.FirstOrDefaultAsync(x => x.Id == abil.Id);
                if (item != null)
                {
                    item.Nome = fr.Nome;
                    item.Titolo = fr.Titolo;
                    item.Recapito = fr.Recapito;
                    await db.SaveChangesAsync();

                    abil.Nome = fr.Nome;
                    abil.Titolo = fr.Titolo;
                    abil.Recapito = fr.Recapito;
                    Snackbar.Add("Firma aggiornata ✅", Severity.Success);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Errore modifica firma: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task ModificaPassword(CasellaPosta casella)
    {
        var parameters = new DialogParameters
        {
            ["Title"] = $"Modifica password per {casella.Email}"
        };

        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small
        };

        var dialog = DialogService.Show<ModificaPasswordDialog>("Modifica Password", parameters, options);
        var result = await dialog.Result;

        if (result.Canceled || string.IsNullOrWhiteSpace(result.Data?.ToString()))
            return;

        var nuovaPassword = result.Data!.ToString()!;

        try
        {
            await using var db = DbFactory.CreateDbContext();
            var entity = await db.CasellePosta.FirstOrDefaultAsync(x => x.Id == casella.Id);
            if (entity != null)
            {
                entity.Password = nuovaPassword;
                await db.SaveChangesAsync();

                casella.Password = nuovaPassword;
                Snackbar.Add("Password aggiornata ✅", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore aggiornamento password: {ex.Message}", Severity.Error);
        }
    }

    private async Task Rimuovi(CasellaAbilitazione abil)
    {
        try
        {
            await using var db = DbFactory.CreateDbContext();
            var found = await db.CasellaAbilitazioni.FirstOrDefaultAsync(x => x.Id == abil.Id);
            if (found != null)
            {
                db.CasellaAbilitazioni.Remove(found);
                await db.SaveChangesAsync();
                _abilitazioni.RemoveAll(x => x.Id == abil.Id);
                Snackbar.Add("Abilitazione rimossa ✅", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore rimozione: {ex.Message}", Severity.Error);
        }
    }

    private async Task CambiaAdmin(CasellaAbilitazione abil, bool nuovoValore)
    {
        try
        {
            await using var db = DbFactory.CreateDbContext();

            var entity = await db.CasellaAbilitazioni.FirstOrDefaultAsync(x => x.Id == abil.Id);

            if (entity != null)
            {
                entity.IsAdmin = nuovoValore;
                await db.SaveChangesAsync();

                abil.IsAdmin = nuovoValore;

                Snackbar.Add(
                    nuovoValore
                    ? $"{abil.Username} ora è amministratore della casella."
                    : $"{abil.Username} non è più amministratore.",
                    Severity.Success
                );
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore aggiornamento admin: {ex.Message}", Severity.Error);
        }
    }
}
