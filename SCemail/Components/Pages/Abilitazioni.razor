@page "/abilitazioni"
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@using SCemail.Components.Data
@inject IDbContextFactory<MailDbContext> DbFactory
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Nav

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">🔑 Abilitazioni Utenti alle Caselle</h5>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Home"
                   OnClick="@TornaHome">
            Home
        </MudButton>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-body py-2">
            <div class="row g-2 align-items-end">
                <div class="col-md-8">
                    <label class="form-label mb-1">Cerca</label>
                    <input class="form-control form-control-sm"
                           placeholder="Cerca per email, nome o id utente..."
                           @bind="searchText"
                           @bind:event="oninput" />
                </div>
                <div class="col-md-4 text-md-end">
                    <small class="text-muted">
                        Caselle trovate: @CaselleFiltrate.Count()
                    </small>
                </div>
            </div>
        </div>
    </div>

    @if (CaselleFiltrate.Any())
    {
        @foreach (var casella in CaselleFiltrate)
        {
            var utentiCasella = GetAbilitazioniFiltratePerCasella(casella.Id).ToList();

            <div class="card shadow-sm mb-3">
                <div class="card-header py-2 px-3 bg-light d-flex justify-content-between align-items-start">
                    <div>
                        <div class="fw-bold">@casella.Email</div>
                        <small class="text-muted d-block mb-1">
                            @casella.Provider · IMAP: @casella.ImapHost:@casella.ImapPort (SSL: @casella.UseSsl)
                        </small>
                    </div>

                    <div class="d-flex align-items-center justify-content-end flex-wrap gap-2">
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Info"
                                   Size="Size.Small"
                                   OnClick="@(() => ModificaFirmaDefault(casella))">
                            📝 Firma
                        </MudButton>

                        @if (!string.IsNullOrWhiteSpace(casella.FirmaDefault))
                        {
                            <span class="firma-badge" title="@casella.FirmaDefault">
                                @GetFirmaPreview(casella.FirmaDefault)
                            </span>
                        }
                        else
                        {
                            <span class="firma-badge-empty">
                                Nessuna firma
                            </span>
                        }

                        <MudButton Variant="Variant.Text"
                                   Color="Color.Warning"
                                   Size="Size.Small"
                                   OnClick="@(() => ModificaPassword(casella))">
                            🔐 Password
                        </MudButton>

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Success"
                                   Size="Size.Small"
                                   OnClick="@(() => ApriDialogAggiungiUtente(casella))">
                            ➕
                        </MudButton>
                    </div>
                </div>

                <div class="card-body py-2 px-3">
                    @if (utentiCasella.Any())
                    {
                        <table class="table table-sm table-striped table-hover align-middle compact-table mb-0">
                            <thead>
                                <tr>
                                    <th style="width: 180px;">Username</th>
                                    <th style="width: 220px;">Nome</th>
                                    <th>Firma</th>
                                    <th class="admin-col text-center">Admin</th>
                                    <th style="width: 170px;">Azioni</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var abil in utentiCasella)
                                {
                                    <tr>
                                        <td class="py-1">@abil.Username</td>
                                        <td class="py-1">@abil.Nome</td>
                                        <td class="py-1">
                                            <div class="firma-mini">
                                                <div>Cordiali saluti.</div>
                                                <div><strong>@abil.Nome</strong></div>
                                                <div>@abil.Titolo</div>
                                                <div>@abil.Recapito</div>
                                            </div>
                                        </td>
                                        <td class="py-1 admin-cell">
                                            <input type="checkbox"
                                                   class="admin-checkbox"
                                                   checked="@abil.IsAdmin"
                                                   @onchange="@(async e => await CambiaAdmin(abil, e.Value is bool b && b))" />
                                        </td>
                                        <td class="py-1">
                                            <div class="d-flex gap-1">
                                                <MudButton Variant="Variant.Text"
                                                           Color="Color.Primary"
                                                           Size="Size.Small"
                                                           OnClick="@(() => ModificaFirma(abil))">
                                                    ✏️
                                                </MudButton>

                                                <MudButton Variant="Variant.Text"
                                                           Color="Color.Error"
                                                           Size="Size.Small"
                                                           OnClick="@(() => Rimuovi(abil))">
                                                    ❌
                                                </MudButton>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="text-muted small py-1">
                            Nessun utente abilitato.
                        </div>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-light border text-muted">
            Nessun risultato trovato.
        </div>
    }
</div>

<style>
    .container {
        font-size: 0.85rem;
    }

    h5, h6 {
        margin-bottom: 0.2rem;
        font-weight: 600;
    }

    .compact-table th,
    .compact-table td {
        padding: 0.2rem 0.4rem !important;
        vertical-align: middle;
        font-size: 0.8rem;
    }

    .firma-mini {
        line-height: 1.05rem;
        font-size: 0.76rem;
        white-space: normal;
    }

    .mud-button-root {
        font-size: 0.75rem !important;
        min-height: 26px !important;
        padding: 2px 6px !important;
    }

    .mud-switch {
        margin: 0 !important;
    }

    .card-header small {
        font-size: 0.76rem;
    }

    .admin-col {
        width: 70px;
        text-align: center;
    }

    .admin-cell {
        text-align: center;
        vertical-align: middle !important;
        padding: 0.15rem 0.25rem !important;
    }

    .admin-checkbox {
        width: 16px;
        height: 16px;
        margin: 0;
        vertical-align: middle;
        cursor: pointer;
    }

    .firma-badge {
        display: inline-block;
        max-width: 240px;
        padding: 3px 8px;
        font-size: 0.72rem;
        line-height: 1rem;
        color: #0f5132;
        background: #d1e7dd;
        border: 1px solid #badbcc;
        border-radius: 999px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        vertical-align: middle;
    }

    .firma-badge-empty {
        display: inline-block;
        padding: 3px 8px;
        font-size: 0.72rem;
        line-height: 1rem;
        color: #6c757d;
        background: #f1f3f5;
        border: 1px solid #dee2e6;
        border-radius: 999px;
        vertical-align: middle;
    }
</style>

@code {
    private List<CasellaPosta> _caselle = new();
    private List<CasellaAbilitazione> _abilitazioni = new();
    private List<string> _utenti = new();
    private string? _cp;
    private string searchText = "";

    protected override void OnInitialized()
    {
        var uri = new Uri(Nav.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("cp", out var cp))
            _cp = cp;
    }

    private void TornaHome()
    {
        if (!string.IsNullOrEmpty(_cp))
            Nav.NavigateTo($"/?cp={_cp}");
        else
            Nav.NavigateTo("/");
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        await using var db = DbFactory.CreateDbContext();

        _caselle = await db.CasellePosta
    .AsNoTracking()
    .Where(c => c.Attiva == "Y")
    .OrderBy(c => c.Email)
    .ToListAsync();

        _abilitazioni = await db.CasellaAbilitazioni
            .AsNoTracking()
            .OrderBy(a => a.CasellaId)
            .ThenBy(a => a.Username)
            .ToListAsync();

        _utenti = await db.InfoUsers
            .AsNoTracking()
            .Select(i => i.Utente)
            .OrderBy(x => x)
            .ToListAsync();
    }

    private IEnumerable<CasellaPosta> CaselleFiltrate =>
        _caselle.Where(c =>
        {
            if (string.IsNullOrWhiteSpace(searchText))
                return true;

            var term = searchText.Trim();

            if (!string.IsNullOrWhiteSpace(c.Email) &&
                c.Email.Contains(term, StringComparison.OrdinalIgnoreCase))
                return true;

            return _abilitazioni.Any(a =>
                a.CasellaId == c.Id &&
                (
                    (!string.IsNullOrWhiteSpace(a.Nome) &&
                     a.Nome.Contains(term, StringComparison.OrdinalIgnoreCase))
                    ||
                    (!string.IsNullOrWhiteSpace(a.Username) &&
                     a.Username.Contains(term, StringComparison.OrdinalIgnoreCase))
                ));
        });

    private IEnumerable<CasellaAbilitazione> GetAbilitazioniFiltratePerCasella(int casellaId)
    {
        var query = _abilitazioni.Where(a => a.CasellaId == casellaId);

        if (string.IsNullOrWhiteSpace(searchText))
            return query.OrderBy(a => a.Username);

        var term = searchText.Trim();

        return query
            .Where(a =>
                (!string.IsNullOrWhiteSpace(a.Username) &&
                 a.Username.Contains(term, StringComparison.OrdinalIgnoreCase))
                ||
                (!string.IsNullOrWhiteSpace(a.Nome) &&
                 a.Nome.Contains(term, StringComparison.OrdinalIgnoreCase))
                ||
                (_caselle.FirstOrDefault(c => c.Id == casellaId)?.Email?
                    .Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
            )
            .OrderBy(a => a.Username);
    }

    private IEnumerable<string> GetUtentiDisponibili(int casellaId)
    {
        var gia = _abilitazioni
            .Where(a => a.CasellaId == casellaId)
            .Select(a => a.Username)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        return _utenti.Where(u => !gia.Contains(u));
    }

    private async Task ApriDialogAggiungiUtente(CasellaPosta casella)
    {
        var utentiDisponibili = GetUtentiDisponibili(casella.Id).ToList();

        if (!utentiDisponibili.Any())
        {
            Snackbar.Add("Non ci sono altri utenti disponibili per questa casella.", Severity.Info);
            return;
        }

        var parameters = new DialogParameters
        {
            ["CasellaId"] = casella.Id,
            ["CasellaEmail"] = casella.Email,
            ["UtentiDisponibili"] = utentiDisponibili
        };

        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialog = DialogService.Show<AggiungiAbilitazioneDialog>(
            "Aggiungi utente",
            parameters,
            options);

        var result = await dialog.Result;

        if (result.Canceled || result.Data is not AggiungiAbilitazioneDialog.AggiungiAbilitazioneResult dto)
            return;

        try
        {
            await using var db = DbFactory.CreateDbContext();

            var alreadyExists = await db.CasellaAbilitazioni
                .CountAsync(a => a.CasellaId == casella.Id && a.Username == dto.Username) > 0;

            if (alreadyExists)
            {
                Snackbar.Add($"'{dto.Username}' è già abilitato.", Severity.Info);
                return;
            }

            var entity = new CasellaAbilitazione
            {
                CasellaId = casella.Id,
                Username = dto.Username,
                Nome = dto.Nome,
                Titolo = dto.Titolo,
                Recapito = dto.Recapito,
                IsAdmin = dto.IsAdmin,
                CreatedAt = DateTime.Now
            };

            db.CasellaAbilitazioni.Add(entity);
            await db.SaveChangesAsync();

            _abilitazioni.Add(entity);
            _abilitazioni = _abilitazioni
                .OrderBy(a => a.CasellaId)
                .ThenBy(a => a.Username)
                .ToList();

            Snackbar.Add($"Utente '{dto.Username}' abilitato con firma ✅", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore abilitazione: {ex.Message}", Severity.Error);
        }
    }

    private async Task ModificaFirma(CasellaAbilitazione abil)
    {
        var parameters = new DialogParameters
        {
            ["Nome"] = abil.Nome,
            ["Titolo"] = abil.Titolo,
            ["Recapito"] = abil.Recapito
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small };
        var dialog = DialogService.Show<FirmaUtenteDialog>("Modifica Firma", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is FirmaUtenteDialog.FirmaUtenteResult fr)
        {
            try
            {
                await using var db = DbFactory.CreateDbContext();
                var item = await db.CasellaAbilitazioni.FirstOrDefaultAsync(x => x.Id == abil.Id);
                if (item != null)
                {
                    item.Nome = fr.Nome;
                    item.Titolo = fr.Titolo;
                    item.Recapito = fr.Recapito;
                    item.IsAdmin = fr.IsAdmin;
                    await db.SaveChangesAsync();

                    abil.Nome = fr.Nome;
                    abil.Titolo = fr.Titolo;
                    abil.Recapito = fr.Recapito;
                    abil.IsAdmin = fr.IsAdmin;

                    Snackbar.Add("Firma aggiornata ✅", Severity.Success);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Errore modifica firma: {ex.Message}", Severity.Error);
            }
        }
    }

    private string GetFirmaPreview(string? firma, int maxLen = 50)
    {
        if (string.IsNullOrWhiteSpace(firma))
            return "Nessuna firma";

        var oneLine = firma
            .Replace("\r\n", " ")
            .Replace("\n", " ")
            .Replace("\r", " ")
            .Trim();

        return oneLine.Length <= maxLen
            ? oneLine
            : oneLine.Substring(0, maxLen) + "...";
    }

    private async Task ModificaPassword(CasellaPosta casella)
    {
        var parameters = new DialogParameters
        {
            ["Title"] = $"Modifica password per {casella.Email}"
        };

        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small
        };

        var dialog = DialogService.Show<ModificaPasswordDialog>("Modifica Password", parameters, options);
        var result = await dialog.Result;

        if (result.Canceled || string.IsNullOrWhiteSpace(result.Data?.ToString()))
            return;

        var nuovaPassword = result.Data!.ToString()!;

        try
        {
            await using var db = DbFactory.CreateDbContext();
            var entity = await db.CasellePosta.FirstOrDefaultAsync(x => x.Id == casella.Id);
            if (entity != null)
            {
                entity.Password = nuovaPassword;
                await db.SaveChangesAsync();

                casella.Password = nuovaPassword;
                Snackbar.Add("Password aggiornata ✅", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore aggiornamento password: {ex.Message}", Severity.Error);
        }
    }

    private async Task Rimuovi(CasellaAbilitazione abil)
    {
        try
        {
            await using var db = DbFactory.CreateDbContext();
            var found = await db.CasellaAbilitazioni.FirstOrDefaultAsync(x => x.Id == abil.Id);
            if (found != null)
            {
                db.CasellaAbilitazioni.Remove(found);
                await db.SaveChangesAsync();

                _abilitazioni.RemoveAll(x => x.Id == abil.Id);
                Snackbar.Add("Abilitazione rimossa ✅", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore rimozione: {ex.Message}", Severity.Error);
        }
    }

    private async Task CambiaAdmin(CasellaAbilitazione abil, bool nuovoValore)
    {
        try
        {
            await using var db = DbFactory.CreateDbContext();

            var entity = await db.CasellaAbilitazioni.FirstOrDefaultAsync(x => x.Id == abil.Id);

            if (entity != null)
            {
                entity.IsAdmin = nuovoValore;
                await db.SaveChangesAsync();

                abil.IsAdmin = nuovoValore;

                Snackbar.Add(
                    nuovoValore
                        ? $"{abil.Username} ora è amministratore della casella."
                        : $"{abil.Username} non è più amministratore.",
                    Severity.Success
                );
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore aggiornamento admin: {ex.Message}", Severity.Error);
        }
    }

    private async Task ModificaFirmaDefault(CasellaPosta casella)
    {
        var parameters = new DialogParameters
        {
            ["Title"] = $"Firma - {casella.Email}",
            ["Value"] = casella.FirmaDefault
        };

        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var dialog = DialogService.Show<ModificaFirmaDefaultDialog>(
            "Firma",
            parameters,
            options);

        var result = await dialog.Result;

        if (result.Canceled)
            return;

        var nuovaFirma = result.Data?.ToString();

        try
        {
            await using var db = DbFactory.CreateDbContext();
            var entity = await db.CasellePosta.FirstOrDefaultAsync(x => x.Id == casella.Id);

            if (entity == null)
                return;

            entity.FirmaDefault = string.IsNullOrWhiteSpace(nuovaFirma)
                ? null
                : nuovaFirma;

            await db.SaveChangesAsync();

            casella.FirmaDefault = entity.FirmaDefault;

            Snackbar.Add("Firma salvata ✅", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore salvataggio firma: {ex.Message}", Severity.Error);
        }
    }
}