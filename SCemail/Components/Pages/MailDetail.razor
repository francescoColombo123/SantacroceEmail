    private async Task AddComment()
    {
        if (_savingComment)
            return;

        _savingComment = true;

        try
        {
            // ❌ Niente testo e niente allegati
            if (string.IsNullOrWhiteSpace(_newComment) && _selectedFiles.Count == 0)
            {
                Snackbar.Add("Scrivi un commento o allega almeno un file.", Severity.Info);
                return;
            }

            int commentId;

            // =========================
            // 1️⃣ COMMENTO PRINCIPALE
            // =========================
            byte[]? bytes = null;
            string? name = null;

            if (_selectedFiles.Count == 1)
            {
                var f = _selectedFiles.First();
                using var s = f.OpenReadStream(12 * 1024 * 1024);
                using var ms = new MemoryStream();
                await s.CopyToAsync(ms);
                bytes = ms.ToArray();
                name = f.Name;
            }

            commentId = await MailSvc.AddCommentAsync(
                emailId: Id,
                autore: _utente!,
                testo: _newComment ?? "",
                fileBytes: bytes,
                fileName: name
            );
            await MailSvc.MarkEmailSeguiteAsUnreadAsync(
                emailId: Id,
                commentId: commentId,
                autore: _utente!
            );

            // =========================
            // 2️⃣ ALLEGATI MULTIPLI
            // =========================
            if (_selectedFiles.Count > 1)
            {
                foreach (var f in _selectedFiles)
                {
                    using var s = f.OpenReadStream(12 * 1024 * 1024);
                    using var ms = new MemoryStream();
                    await s.CopyToAsync(ms);

                    await MailSvc.AddCommentAsync(
                        emailId: Id,
                        autore: _utente!,
                        testo: "(allegato)",
                        fileBytes: ms.ToArray(),
                        fileName: f.Name
                    );
                }
            }

            // =========================
            // 3️⃣ MENZIONI (@utente)
            // =========================
            var mentionedUsers = Regex.Matches(
                     _newComment ?? "",
                     @"(?<![a-zA-Z0-9._-])@([a-zA-Z0-9._-]+)",
                     RegexOptions.IgnoreCase)
                 .Select(m => m.Groups[1].Value.Trim().ToLowerInvariant())
                 .Where(x => !string.IsNullOrWhiteSpace(x))
                 .Distinct(StringComparer.OrdinalIgnoreCase)
                 .ToList();

            // =========================
            // 4️⃣ PARTECIPANTI EMAIL
            // =========================
            var partecipanti = (await MailSvc.GetPartecipantiEmailAsync(Id))
     .Distinct(StringComparer.OrdinalIgnoreCase)
     .ToList();

            var proprietariEmail = await MailSvc.GetProprietariEmailAsync(Id);

            // UNION partecipanti + menzionati
            var utentiDaNotificare = partecipanti
    .Union(mentionedUsers, StringComparer.OrdinalIgnoreCase)
    .Union(proprietariEmail, StringComparer.OrdinalIgnoreCase)
    .Distinct(StringComparer.OrdinalIgnoreCase)
    .ToList();
            foreach (var u in utentiDaNotificare)
            {
                if (u.Equals(_utente, StringComparison.OrdinalIgnoreCase))
                    continue;

                bool isMention = mentionedUsers.Contains(u, StringComparer.OrdinalIgnoreCase);

                await MailSvc.RegistraEventoChatAsync(
                    emailId: Id,
                    utente: u,
                    isMention: isMention,
                    commentoId: commentId,
                    autore: _utente!
                );
            }


            // =========================
            // 5️⃣ RESET UI
            // =========================
            _newComment = "";
            _selectedFiles.Clear();
            _mentionOpen = false;
            _mentionSuggestions.Clear();

            _comments = await MailSvc.GetCommentsByEmailAsync(Id);
            Nav.NavigateTo(Nav.Uri, true);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Errore AddComment: {ex.Message}");
            Snackbar.Add("Errore durante l'invio del commento", Severity.Error);
        }
        finally
        {
            _savingComment = false;
            StateHasChanged();
        }
    }


