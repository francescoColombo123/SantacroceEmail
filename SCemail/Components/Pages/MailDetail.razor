@page "/mail-detail/{id:int}/{cp?}"
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.JSInterop
@using Oracle.ManagedDataAccess.Client
@using SCemail.Components.Data
@using System.Text.RegularExpressions
@using static System.Net.WebRequestMethods
@inject MailService MailSvc
@inject MailService_NEW MailSvc1
@inject NavigationManager Nav
@inject SCemail.Components.Data.AccessiService AccessiSrv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject HttpClient Http
@inject IJSRuntime JS
<div class="detail-shell">
    @if (_loading)
    {
        <div class="loading">Caricamento email...</div>
    }
    else if (_thread != null && _thread.Any())
    {
        <!-- SINISTRA: THREAD EMAIL -->
        <section class="left-pane">
            <header class="email-head">
                <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                               Color="Color.Primary"
                               OnClick="@GoBack" />

                <div class="head-texts">
                    <h3 class="subj">@_email?.Oggetto</h3>

                    <div class="head-subrow">
                        <div class="meta">Thread di @_thread.Count messaggi</div>

                        <div class="head-actions">
                            <MudIconButton Icon="@Icons.Material.Filled.MarkEmailUnread"
                                           Title="Segna da leggere"
                                           Color="Color.Default"
                                           OnClick="@MarkUnreadThread" />

                            <MudIconButton Icon="@Icons.Material.Filled.Archive"
                                           Title="Archivia"
                                           Color="Color.Primary"
                                           OnClick="@ArchiveThread" />

                            <MudIconButton Icon="@Icons.Material.Filled.ForwardToInbox"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           Title="Assegna"
                                           OnClick="@(() => AssignThread())" />

                            <MudSelect T="long?"
                                       Dense="true"
                                       Variant="Variant.Outlined"
                                       Label="Sposta in..."
                                       Value="_sezioneSelezionata"
                                       ValueChanged="OnSpostaInChanged"
                                       Disabled="@_moving"
                                       Style="min-width:220px">
                                @foreach (var s in _sezioni)
                                {
                                    <MudSelectItem T="long?" Value="@(s.Id)">
                                        @s.Nome
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        </div>
                    </div>
                </div>
            </header>


            @if (_readFromIndex > 0)
            {
                <MudButton Variant="Variant.Text"
                           StartIcon="@Icons.Material.Filled.UnfoldMore"
                           OnClick="@ShowAllThread">
                    Mostra tutto
                </MudButton>
            }


            @{
                var ordered = _thread.OrderBy(m => m.Data).ToList();
            }

            <div class="email-thread">
                @for (int i = _readFromIndex; i < ordered.Count; i++)
                {
                    var mail = ordered[i];

                    <div class="gmail-msg">
                        <div class="gmail-head">
                            <div class="avatar" style="background:@GetAvatarColor(mail.Mittente)">
                                @GetInitials(mail.Mittente)
                            </div>

                            <div class="meta">
                                <div class="from">@ExtractEmailOnly(mail.Mittente)</div>
                                <div class="time">@mail.Data?.ToString("ddd d MMM yyyy HH:mm")</div>
                            </div>

                            <!-- ✅ AZIONI PER SINGOLO MESSAGGIO (a destra) -->
                            <div class="msg-actions">
                                <MudIconButton Icon="@Icons.Material.Filled.Reply"
                                               Title="Rispondi"
                                               OnClick="@(() => Reply(mail))" />

                                <MudIconButton Icon="@Icons.Material.Filled.ReplyAll"
                                               Title="Rispondi a tutti"
                                               OnClick="@(() => ReplyAll(mail))" />

                                <MudIconButton Icon="@Icons.Material.Filled.Send"
               Title="Inoltra (esterno)"
               OnClick="@(() => ForwardExternalFrom(mail))" />

                                <MudIconButton Icon="@Icons.Material.Filled.MenuBook"
                                               Title="Leggi da qui"
                                               OnClick="@(() => ReadFromHere(mail))" />
                            </div>
                        </div>

                        <div class="gmail-body">
                            @{
                                if (!string.IsNullOrWhiteSpace(mail.CorpoHtml))
                                {
                                    var safe = StripActiveContent(mail.CorpoHtml); // no CleanQuotedPartHtml qui
                                                                                   <iframe class="mail-iframe" sandbox="" srcdoc="@safe"></iframe>
                                }
                                else
                                {
                                    var txt = mail.CorpoTesto ?? "";
                                    @((MarkupString)$"<pre style='white-space:pre-wrap;margin:0;font-family:inherit'>{System.Net.WebUtility.HtmlEncode(txt)}</pre>")
                                }
                            }
                        </div>


                        @if (mail.Allegati?.Any() == true)
                        {
                            <div class="gmail-attachments">
                                <div class="attach-title">📎 Allegati:</div>

                                <div class="attach-grid">
                                    @foreach (var a in mail.Allegati)
                                    {
                                        var mime = NormalizeMime(a.MimeType, a.NomeFile);

                                        <a class="attach-chip"
                                           href="#"
                                           @onclick="@(async () => await OpenAttachmentAsync(a.Id, mime, mail.Allegati.Select(x => x.Id).ToList()))"
                                           @onclick:preventDefault="true"
                                           @onclick:stopPropagation="true">
                                            <MudIcon Icon="@GetAttachmentIcon(a.NomeFile)" />
                                            <span>@a.NomeFile</span>
                                        </a>
                                    }
                                </div>
                            </div>
                        }

                    </div>
                }


            </div>


        </section>

        <!-- DESTRA: COMMENTI -->
        <aside class="right-pane">
            <h4 class="comments-title">💬 Commenti interni</h4>

            <div class="comments-list">
                @if (_comments == null)
                {
                    <div class="muted">Caricamento…</div>
                }
                else if (_comments.Count == 0)
                {
                    <div class="muted">Nessun commento</div>
                }
                else
                {
                    @foreach (var c in _comments.OrderBy(x => x.DataCreazione))
                    {
                        if (IsActivity(c))
                        {
                            <div class="activity-line">
                                <span class="activity-text">@((MarkupString)ActivityText(c))</span>
                                <span class="activity-time">@c.DataCreazione.ToString("dd MMM yyyy HH:mm")</span>
                            </div>
                        }
                        else
                        {
                            <div class="comment-box">
                                <!-- AVATAR TEAM STYLE -->
                                <div class="avatar2" style="background:@GetAvatarColor(c.Autore)">
                                    @GetInitials(c.Autore)
                                </div>

                                <div class="comment-content">
                                    <div class="comment-header">
                                        <span class="author">@c.Autore</span>
                                        <span class="time">@c.DataCreazione.ToString("dd MMM yyyy HH:mm")</span>
                                    </div>

                                    <div class="comment-text">
                                        @((MarkupString)HighlightMentions(c.Testo))
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(c.AllegatoNome))
                                    {
                                        <div class="comment-attachment">
                                            <MudIcon Icon="@GetAttachmentIcon(c.AllegatoNome)" />
                                            <a href="@GetCommentAttachmentUrl(c.Id)" target="_blank">@c.AllegatoNome</a>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                }
            </div>

            <!-- EDITOR COMMENTI -->
            <div class="editor">
                <div class="mention-wrapper">
                    <MudTextField T="string"
                                  Value="_newComment"
                                  ValueChanged="@(v => OnTextChanged(v))"
                                  Lines="4"
                                  Variant="Variant.Outlined"
                                  Placeholder=@("Scrivi un commento… usa @ per menzionare")
                                  Immediate="true"
                                  OnKeyDown="@((KeyboardEventArgs e) => HandleKeyNav(e))"
                                  Class="editor-text" />

                    @if (_mentionOpen && _mentionSuggestions.Count > 0)
                    {
                        <div class="mention-popup top">
                            @foreach (var u in _mentionSuggestions)
                            {
                                <div class="mention-item" @onclick="@(() => SelectMention(u))">@u</div>
                            }
                        </div>
                    }
                </div>

                <!-- PULSANTE + FILE -->
                <div class="editor-files">
                    <label class="file-plus">
                        <MudIcon Icon="@Icons.Material.Filled.AttachFile" Size="Size.Medium" />
                        <InputFile OnChange="OnFilesSelected" multiple style="display:none" />
                    </label>

                    @if (_selectedFiles.Count > 0)
                    {
                        <div class="file-list">
                            @foreach (var f in _selectedFiles)
                            {
                                <div class="file-chip">
                                    <MudIcon Icon="@GetAttachmentIcon(f.Name)" />
                                    @f.Name
                                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                   Size="Size.Small"
                                                   Color="Color.Error"
                                                   OnClick="@(() => RemoveFile(f))" />
                                </div>
                            }
                        </div>
                    }

                </div>

                <MudButton Color="Color.Primary"
                           Variant="Variant.Filled"
                           OnClick="AddComment"
                           Disabled="@_savingComment"
                           Loading="@_savingComment">
                    INVIA
                </MudButton>
            </div>

        </aside>
    }

    @if (_showAttachmentViewer)
    {
        <AttachmentViewerOverlay Id="@_attachmentViewerId"
                                 Src="@_attachmentViewerSrc"
                                 Ids="@_attachmentViewerIds"
                                 OnClose="@CloseAttachmentViewer" />
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public string? Cp { get; set; }

    private EmailDetail_NEW? _email;
    private List<EmailDetail_NEW> _thread = new();
    private List<CommentoEmail>? _comments;
    private bool _loading = true;
    private string? _utente;

    private string? _newComment;
    private List<IBrowserFile> _selectedFiles = new();

    private List<string> _allUsers = new();
    private List<string> _mentionSuggestions = new();
    private bool _mentionOpen;
    private int _mentionIndex = 0;
    private bool _savingComment = false;
    private List<EmailInboxSezione> _sezioni = new();
    private long? _sezioneSelezionata;
    private bool _moving = false;
    public class EmailReplyInfo
    {
        public string CasellaMittente { get; set; } = "";
        public string Destinatari { get; set; } = "";
        public string? Cc { get; set; }
        public string? Bcc { get; set; }
    }
    private string? _fromFolder;
    private string? _fromSection;


    protected override async Task OnInitializedAsync()
    {
        _utente = await AccessiSrv.GetUtenteFromCpAsync(Cp);
        _email = await MailSvc1.GetEmailDetailAsync(Id, onlyMeta: false);
        _sezioni = await MailSvc1.GetSezioniInboxAsync(soloAttive: true);

        if (!string.IsNullOrWhiteSpace(_utente))
        {
            await MailSvc1.SegnaNotificheVisteAsync(Id, _utente);
        }
        if (_email != null)
        {
            _sezioneSelezionata = await MailSvc1.GetSezioneCorrenteAsync(_email.Id, _utente);

            _thread = await MailSvc1.GetConversationByThreadAsync(_email.Id);

            _thread = _thread
                .GroupBy(t => t.MessageId)
                .Select(g => g.First())
                .ToList();
        }

        _comments = await MailSvc.GetCommentsByEmailAsync(Id);

        _comments = _comments?
            .GroupBy(c => c.Id)
            .Select(g => g.First())
            .ToList();

        _allUsers = await AccessiSrv.GetUserListAsync();
        _loading = false;

        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var q = QueryHelpers.ParseQuery(uri.Query);

        if (q.TryGetValue("fromFolder", out var f)) _fromFolder = f.ToString();
        if (q.TryGetValue("fromSection", out var s)) _fromSection = s.ToString();
    }
    private async Task Reply(EmailDetail_NEW msg)
    {
        if (msg is null) return;

        var replyInfo = await MailSvc1.GetReplyInfoAsync(msg.ThreadKey, msg.InReplyTo);

        var quoteText = BuildGmailReplyAsText(msg);
        var quoteHtml = ToQuoteHtmlForQuill(quoteText);

        var replyTo = ExtractEmailOnly(msg.Mittente); // ✅ mittente vero

        var parameters = new DialogParameters
        {
            ["Utente"] = _utente,
            ["Oggetto"] = msg.Oggetto?.StartsWith("Re:", StringComparison.OrdinalIgnoreCase) == true
                ? msg.Oggetto
                : "Re: " + (msg.Oggetto ?? ""),
            ["CorpoIniziale"] = quoteHtml,
            ["ReplyToMessageId"] = msg.MessageId,
            ["References"] = BuildReferencesChain(msg),
            ["ThreadKey"] = msg.ThreadKey,

            // ✅ qui metti SEMPRE il mittente, non replyInfo.Destinatari
            ["Destinatari"] = replyTo,

            // Reply semplice: CC/BCC vuoti
            ["Cc"] = null,
            ["Bcc"] = null
        };

        if (replyInfo != null && !string.IsNullOrWhiteSpace(replyInfo.CasellaMittente))
            parameters["CasellaMittente"] = replyInfo.CasellaMittente;

        var dialog = await DialogService.ShowAsync<ComposeDialog>(
            "Rispondi",
            parameters,
            new DialogOptions
            {
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                BackdropClick = false,
                CloseOnEscapeKey = false
            });

        var result = await dialog.Result;
        if (result.Data is true)
            Snackbar.Add("Risposta inviata ✅", Severity.Success);
    }




    private EmailDetail_NEW? GetThreadLast()
    {
        if (_thread == null || _thread.Count == 0) return null;
        return _thread.OrderBy(x => x.Data).LastOrDefault();
    }

    private async Task ArchiveThread()
    {
        var last = GetThreadLast();
        if (last == null || string.IsNullOrWhiteSpace(_utente)) return;

        await MailSvc1.ArchiveEmailAsync(last.Id, _utente);
        Snackbar.Add("Conversazione archiviata ✔", Severity.Success);

        // torna alla lista (o ricarica)
        GoBack();
    }

    private async Task MoveToInboxThread()
    {
        var last = GetThreadLast();
        if (last == null || string.IsNullOrWhiteSpace(_utente)) return;

        await MailSvc1.UnarchiveEmailAsync(last.Id, _utente);

        Snackbar.Add("Spostata in Posta in arrivo ✔", Severity.Success);
        GoBack();
    }

    private async Task MarkUnreadThread()
    {
        var last = GetThreadLast();
        if (last == null || string.IsNullOrWhiteSpace(_utente)) return;

        // ✅ qui serve un metodo che marca NON letto (Aperto='N' o equivalente)
        await MailSvc1.MarkUnreadAsync(last.Id);

        Snackbar.Add("Segnata da leggere ✔", Severity.Success);
        GoBack();
    }

    private async Task ReplyThread()
    {
        var last = GetThreadLast();
        if (last == null) return;

        await Reply(last);
    }

    private async Task ReplyAllThread()
    {
        var last = GetThreadLast();
        if (last == null) return;

        // se hai già ReplyAll in mail-new, replica qui o richiama quello
        await ReplyAll(last); // <- implementalo come hai fatto nell’altra pagina (usa GetReplyInfoAsync)
    }

    private async Task AssignThread()
    {
        var last = GetThreadLast();
        if (last == null) return;

        var requireComment = true;

        // se admin globale ok
        if (await AccessiSrv.IsAdminAsync(_utente))
            requireComment = false;

        var parameters = new DialogParameters
        {
            ["Users"] = await MailSvc1.GetUserListAsync(),
            ["RequireComment"] = requireComment,
            ["Title"] = "Assegna internamente"
        };

        var dialog = DialogService.Show<ForwardDialog>(
            "Assegna email",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true }
        );

        var result = await dialog.Result;

        if (result.Canceled || result.Data is not ForwardDialog.ForwardResult fr)
            return;

        if (requireComment && string.IsNullOrWhiteSpace(fr.Comment))
        {
            Snackbar.Add("Per assegnare è obbligatorio inserire un commento.", Severity.Warning);
            return;
        }

        await MailSvc1.AssignEmailAsync(
            last.Id,
            fr.User,
            soloInvio: false,
            fr.Comment,
            _utente
        );

        Snackbar.Add($"Assegnata a {fr.User} ✅", Severity.Success);
    }

   private async Task ForwardExternalThread()
{
    var last = GetThreadLast();
    if (last == null) return;
    await ForwardExternalFrom(last);
}

    private async Task ReplyAll(EmailDetail_NEW msg)
    {
        if (msg is null) return;

        // 0) ✅ assicurati di avere IL MESSAGGIO GIUSTO e COMPLETO (body non vuoto)
        async Task<EmailDetail_NEW> EnsureLoadedAsync(EmailDetail_NEW m)
        {
            bool hasBody = !string.IsNullOrWhiteSpace(m.CorpoHtml) || !string.IsNullOrWhiteSpace(m.CorpoTesto);
            if (m.IsLoaded && hasBody) return m;

            var full = await MailSvc1.GetEmailDetailAsync(m.Id, onlyMeta: false);
            return full ?? m;
        }

        msg = await EnsureLoadedAsync(msg);

        // 1) replyInfo può essere null (normale su mail ricevute): usalo se c'è, altrimenti vai di fallback
        var replyInfo = await MailSvc1.GetReplyInfoAsync(msg.ThreadKey, msg.InReplyTo);

        // ✅ FROM: preferisci SEMPRE la casella che ha ricevuto la mail (msg.CasellaEmail)
        //    replyInfo.CasellaMittente esiste solo se trovi una tua inviata in EMAIL_INVIATE
        var fromCasella = (msg.CasellaEmail ?? replyInfo?.CasellaMittente ?? "").Trim();

        // "self" = la casella da cui invii (NON deve finire in TO/CC)
        var self = ExtractEmailOnly(fromCasella);

        // 2) TO/CC
        var toList = new List<string>();
        var ccList = new List<string>();

        // Reply-All: include sempre il mittente del messaggio a cui stai rispondendo
        var fromEmail = ExtractEmailOnly(msg.Mittente);
        if (!string.IsNullOrWhiteSpace(fromEmail))
            toList.Add(fromEmail);

        // Aggiungi i destinatari originali (se presenti)
        toList.AddRange(ParseEmailsSafe(msg.Destinatari));

        // Se ho replyInfo (preso da EMAIL_INVIATE) posso aggiungere TO/CC “veri”
        toList.AddRange(ParseEmailsSafe(replyInfo?.Destinatari));
        ccList.AddRange(ParseEmailsSafe(replyInfo?.Cc));

        // pulizia: rimuovi me stesso
        RemoveEmail(toList, self);
        RemoveEmail(ccList, self);

        // normalizza + distinct
        toList = NormalizeDistinct(toList);
        ccList = NormalizeDistinct(ccList);

        // niente in CC se già in TO
        ccList.RemoveAll(x => toList.Any(t => string.Equals(t, x, StringComparison.OrdinalIgnoreCase)));

        // safety: se TO è rimasto vuoto, fallback al mittente
        if (toList.Count == 0 && !string.IsNullOrWhiteSpace(fromEmail) &&
            !string.Equals(fromEmail, self, StringComparison.OrdinalIgnoreCase))
        {
            toList.Add(fromEmail);
        }

        // 3) ✅ QUOTA SEMPRE POPOLATA (safe per Quill): testo -> <pre>
        //    Così vedi SEMPRE il contenuto del messaggio a cui stai rispondendo.
        var quoteText = BuildGmailReplyAsText(msg);     // usa il body di msg (ora caricato)
        var quoteHtml = ToQuoteHtmlForQuill(quoteText);

        // 4) ✅ Reply headers: stai rispondendo a QUESTO msg
        var parameters = new DialogParameters
        {
            ["Utente"] = _utente,

            ["Oggetto"] = msg.Oggetto?.StartsWith("Re:", StringComparison.OrdinalIgnoreCase) == true
                ? msg.Oggetto
                : "Re: " + (msg.Oggetto ?? ""),

            ["CorpoIniziale"] = quoteHtml,

            // importantissimo: Reply-All al messaggio cliccato
            ["ReplyToMessageId"] = msg.MessageId,
            ["References"] = BuildReferencesChain(msg),
            ["ThreadKey"] = msg.ThreadKey,

            // invio
            ["CasellaMittente"] = fromCasella,
            ["Destinatari"] = JoinEmails(toList),
            ["Cc"] = JoinEmails(ccList),
            ["Bcc"] = replyInfo?.Bcc
        };

        var dialog = DialogService.Show<ComposeDialog>(
            "Rispondi a tutti",
            parameters,
             new DialogOptions
             {
                 MaxWidth = MaxWidth.Medium,
                 FullWidth = true,
                 BackdropClick = false,     
                 CloseOnEscapeKey = false   
             });

        var result = await dialog.Result;
        if (result.Data is true)
            Snackbar.Add("Risposta a tutti inviata ✅", Severity.Success);
    }


    private static List<string> NormalizeDistinct(IEnumerable<string> xs)
    {
        return xs
            .Select(x => (x ?? "").Trim())
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }


    // ======================
    // FORWARD "GMAIL-LIKE" FULL CHAIN
    // ======================

    private static string Html(string? s) => System.Net.WebUtility.HtmlEncode(s ?? "");

    private static string FormatDateLikeGmail(DateTime? dt)
    {
        if (dt == null) return "";
        var it = new System.Globalization.CultureInfo("it-IT");
        // ven 12 dic 2025 alle ore 20:39
        return dt.Value.ToString("ddd d MMM yyyy", it) + " alle ore " + dt.Value.ToString("HH:mm", it);
    }
    private static string CleanQuotedPartHtml(string html)
    {
        if (string.IsNullOrWhiteSpace(html)) return html;

        // markers (come nel tuo CleanQuotedPart)
        string[] markers = { "---- Messaggio originale ----", "Da:", "Inviato:", "Oggetto:" };

        var idx = -1;
        foreach (var m in markers)
        {
            var i = html.IndexOf(m, StringComparison.OrdinalIgnoreCase);
            if (i > 0 && (idx < 0 || i < idx)) idx = i;
        }

        if (idx > 0)
            return html[..idx].Trim();

        return html.Trim();
    }
    private string GetBodyVisibleAsHtml(EmailDetail_NEW mail)
    {
        // ✅ se hai HTML, usalo
        if (!string.IsNullOrWhiteSpace(mail.CorpoHtml))
            return CleanQuotedPartHtml(mail.CorpoHtml);

        // fallback testo -> html
        var txt = CleanQuotedPart(mail.CorpoTesto ?? "").Trim();
        return $"<div style='white-space:pre-wrap;font-family:inherit;line-height:1.5'>{Html(txt)}</div>";
    }
    private static string FormatGmailReplyHeader(DateTime? dt, string? fromRaw)
    {
        var it = new System.Globalization.CultureInfo("it-IT");
        var d = dt?.ToString("ddd d MMM yyyy", it) ?? "";
        var t = dt?.ToString("HH:mm", it) ?? "";
        var from = FormatNameEmailLikeGmail(fromRaw);
        return $"Il giorno {d} alle ore {t} {from} ha scritto:";
    }

    private static string TextToHtmlLines(string text)
    {
        // encode + \n -> <br>
        return Html(text).Replace("\r\n", "\n").Replace("\r", "\n").Replace("\n", "<br>");
    }
    private string BuildGmailQuoteBlockHtml(EmailDetail_NEW original)
    {
        var header = FormatGmailReplyHeader(original.Data, original.Mittente);
        var bodyHtml = GetBodyVisibleAsHtml(original);

        return $@"
<br><br>
{header}<br><br>
<div style='margin-left:1ex;border-left:1px solid #ccc;padding-left:1ex;'>
  {bodyHtml}
</div>";
    }
    // Prende il corpo "come lo vedi" (taglia i quote già presenti)
    private string GetBodyVisibleAsPlainText(EmailDetail_NEW mail)
    {
        var body = mail.CorpoTesto;

        if (string.IsNullOrWhiteSpace(body) && !string.IsNullOrWhiteSpace(mail.CorpoHtml))
            body = HtmlToText(mail.CorpoHtml);

        body ??= "";
        body = CleanQuotedPart(body);
        return body.Trim();
    }

    private async Task OnSpostaInChanged(long? idSezione)
    {
        if (_email == null || string.IsNullOrWhiteSpace(_utente) || idSezione == null)
            return;

        if (_sezioneSelezionata == idSezione)
            return;

        _moving = true;
        try
        {
            await MailSvc1.SpostaEmailInSezioneAsync(_email.Id, idSezione.Value, _utente, updatedBy: _utente);
            _sezioneSelezionata = idSezione;

            Snackbar.Add("Spostata ✅", Severity.Success);

            // opzionale: torna alla lista (dipende dal tuo flusso)
            // GoBack();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            Snackbar.Add("Errore nello spostamento", Severity.Error);
        }
        finally
        {
            _moving = false;
            StateHasChanged();
        }
    }

    private static string FormatDateSimple(DateTime? dt)
    {
        if (dt == null) return "";
        var it = new System.Globalization.CultureInfo("it-IT");
        // ven 12 dic 2025 19:37
        return dt.Value.ToString("ddd d MMM yyyy HH:mm", it);
    }

    private static string FormatNameEmailLikeGmail(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return "";
        var r = raw.Trim();

        var m = Regex.Match(r, "\"?(?<name>[^\"]+?)\"?\\s*<(?<mail>[^>]+)>");
        if (m.Success)
            return $"{Html(m.Groups["name"].Value.Trim())} &lt;{Html(m.Groups["mail"].Value.Trim())}&gt;";

        if (r.Contains("@") && !r.Contains("<")) return Html(r);
        return Html(r);
    }

    private static string FormatToLikeGmail(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return "";

        var r = raw.Trim();

        // già contiene < >
        if (r.Contains("<") && r.Contains(">"))
            return FormatNameEmailLikeGmail(r);

        // mail nuda -> <mail>
        if (r.Contains("@"))
            return $"<{r}>";

        return r;
    }
    private static string HtmlToText(string html)
    {
        if (string.IsNullOrWhiteSpace(html)) return "";
        var noTags = Regex.Replace(html, "<br\\s*/?>", "\n", RegexOptions.IgnoreCase);
        noTags = Regex.Replace(noTags, "</p\\s*>", "\n\n", RegexOptions.IgnoreCase);
        noTags = Regex.Replace(noTags, "<.*?>", " ");
        noTags = System.Net.WebUtility.HtmlDecode(noTags);
        return noTags;
    }

    private static string NormalizeMime(string? mime, string? filename)
    {
        if (!string.IsNullOrWhiteSpace(mime) &&
            !mime.Equals("application/octet-stream", StringComparison.OrdinalIgnoreCase))
            return mime;

        var ext = Path.GetExtension(filename ?? "").ToLowerInvariant();
        return ext switch
        {
            ".pdf" => "application/pdf",
            ".jpg" or ".jpeg" => "image/jpeg",
            ".png" => "image/png",
            ".gif" => "image/gif",
            ".txt" => "text/plain",
            ".html" or ".htm" => "text/html",
            ".doc" => "application/msword",
            ".docx" => "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            ".xls" => "application/vnd.ms-excel",
            ".xlsx" => "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            _ => mime ?? "application/octet-stream"
        };
    }

