    private static string StripActiveContent(string html)
    {
        if (string.IsNullOrWhiteSpace(html)) return html;

        // via script (solo script!)
        html = Regex.Replace(
            html,
            @"<\s*script\b[^>]*>.*?<\s*/\s*script\s*>",
            "",
            RegexOptions.IgnoreCase | RegexOptions.Singleline);

        // via handler tipo onclick=
        html = Regex.Replace(
            html,
            @"\son\w+\s*=\s*(""[^""]*""|'[^']*'|[^\s>]+)",
            "",
            RegexOptions.IgnoreCase);

        return html;
    }
    private static bool IsActivity(CommentoEmail c)
    => c != null
       && !string.IsNullOrWhiteSpace(c.Testo)
       && c.Testo.StartsWith("[[ASSIGN]]", StringComparison.OrdinalIgnoreCase);

    private static string ActivityText(CommentoEmail c)
    {
        var t = c?.Testo ?? "";
        if (t.StartsWith("[[ASSIGN]]", StringComparison.OrdinalIgnoreCase))
            t = t.Substring("[[ASSIGN]]".Length).Trim();

        return System.Net.WebUtility.HtmlEncode(t);
    }



}


