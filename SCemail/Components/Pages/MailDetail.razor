    private static string CleanQuotedPartHtml(string html)
    {
        if (string.IsNullOrWhiteSpace(html)) return html;

        // markers (come nel tuo CleanQuotedPart)
        string[] markers = { "---- Messaggio originale ----", "Da:", "Inviato:", "Oggetto:" };

        var idx = -1;
        foreach (var m in markers)
        {
            var i = html.IndexOf(m, StringComparison.OrdinalIgnoreCase);
            if (i > 0 && (idx < 0 || i < idx)) idx = i;
        }

        if (idx > 0)
            return html[..idx].Trim();

        return html.Trim();
    }
