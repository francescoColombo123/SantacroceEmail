@page "/mail-detail/{id:int}/{cp?}"
@using Oracle.ManagedDataAccess.Client
@using SCemail.Components.Data
@using System.Text.RegularExpressions
@inject MailService MailSvc
@inject MailService_NEW MailSvc1
@inject NavigationManager Nav
@inject SCemail.Components.Data.AccessiService AccessiSrv
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<div class="detail-shell">
    @if (_loading)
    {
        <div class="loading">Caricamento email...</div>
    }
    else if (_thread != null && _thread.Any())
    {
        <!-- SINISTRA: THREAD EMAIL -->
        <section class="left-pane">
            <header class="email-head">
                <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Primary" OnClick="@GoBack" />
                <div class="head-texts">
                    <h3 class="subj">@_email?.Oggetto</h3>
                    <div class="meta">Thread di @_thread.Count messaggi</div>
                </div>
            </header>

            <div class="email-thread">
                @foreach (var mail in _thread.OrderBy(m => m.Data))
                {
                    <div class="gmail-msg">

                        <!-- AVATAR STILE TEAMS -->
                        <div class="gmail-head">
                            <div class="avatar" style="background:@GetAvatarColor(mail.Mittente)">
                                @GetInitials(mail.Mittente)
                            </div>

                            <div class="meta">
                                <div class="from">@ExtractEmailOnly(mail.Mittente)</div>
                                <div class="time">@mail.Data?.ToString("ddd d MMM yyyy HH:mm")</div>
                            </div>
                        </div>

                        <div class="gmail-body">
                            @((MarkupString)CleanQuotedPart(mail.CorpoHtml ?? mail.CorpoTesto ?? ""))
                        </div>

                        @if (mail.Allegati?.Any() == true)
                        {
                            <div class="gmail-attachments">
                                <div class="attach-title">📎 Allegati:</div>

                                @foreach (var a in mail.Allegati)
                                {
                                    <a href="@GetDownloadUrl(a.Id)" target="_blank" class="attach-link">
                                        <MudIcon Icon="@GetAttachmentIcon(a.NomeFile)" />
                                        @a.NomeFile
                                    </a>
                                }
                            </div>
                        }

                        <div class="gmail-actions">
                            <MudButton Variant="Variant.Text"
                                       StartIcon="@Icons.Material.Filled.Reply"
                                       OnClick="@(() => Reply(mail))">
                                Rispondi
                            </MudButton>
                        </div>
                    </div>
                }
            </div>

        </section>

        <!-- DESTRA: COMMENTI -->
        <aside class="right-pane">
            <h4 class="comments-title">💬 Commenti interni</h4>

            <div class="comments-list">
                @if (_comments == null)
                {
                    <div class="muted">Caricamento…</div>
                }
                else if (_comments.Count == 0)
                {
                    <div class="muted">Nessun commento</div>
                }
                else
                {
                    @foreach (var c in _comments)
                    {
                        <div class="comment-box">

                            <!-- AVATAR TEAM STYLE -->
                            <div class="avatar2" style="background:@GetAvatarColor(c.Autore)">
                                @GetInitials(c.Autore)
                            </div>

                            <div class="comment-content">
                                <div class="comment-header">
                                    <span class="author">@c.Autore</span>
                                    <span class="time">@c.DataCreazione.ToString("dd MMM yyyy HH:mm")</span>
                                </div>

                                <div class="comment-text">
                                    @((MarkupString)HighlightMentions(c.Testo))
                                </div>

                                @if (!string.IsNullOrWhiteSpace(c.AllegatoNome))
                                {
                                    <div class="comment-attachment">
                                        <MudIcon Icon="@GetAttachmentIcon(c.AllegatoNome)" />
                                        <a href="@GetCommentAttachmentUrl(c.Id)" target="_blank">@c.AllegatoNome</a>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- EDITOR COMMENTI -->
            <div class="editor">
                <div class="mention-wrapper">
                    <MudTextField T="string"
                                  Value="_newComment"
                                  ValueChanged="@(v => OnTextChanged(v))"
                                  Lines="4"
                                  Variant="Variant.Outlined"
                                  Placeholder=@("Scrivi un commento… usa @ per menzionare")
                                  Immediate="true"
                                  OnKeyDown="@((KeyboardEventArgs e) => HandleKeyNav(e))"
                                  Class="editor-text" />

                    @if (_mentionOpen && _mentionSuggestions.Count > 0)
                    {
                        <div class="mention-popup top">
                            @foreach (var u in _mentionSuggestions)
                            {
                                <div class="mention-item" @onclick="@(() => SelectMention(u))">@u</div>
                            }
                        </div>
                    }
                </div>

                <!-- PULSANTE + FILE -->
                <div class="editor-files">
                    <label class="file-plus">
                        <MudIcon Icon="@Icons.Material.Filled.AttachFile" Size="Size.Medium" />
                        <InputFile OnChange="OnFilesSelected" multiple style="display:none" />
                    </label>

                    @if (_selectedFiles.Count > 0)
                    {
                        <div class="file-list">
                            @foreach (var f in _selectedFiles)
                            {
                                <div class="file-chip">
                                    <MudIcon Icon="@GetAttachmentIcon(f.Name)" />
                                    @f.Name
                                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                   Size="Size.Small"
                                                   Color="Color.Error"
                                                   OnClick="@(() => RemoveFile(f))" />
                                </div>
                            }
                        </div>
                    }

                </div>

                <MudButton Color="Color.Primary"
                           Variant="Variant.Filled"
                           OnClick="AddComment"
                           Disabled="@_savingComment"
                           Loading="@_savingComment">
                    INVIA
                </MudButton>
            </div>

        </aside>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public string? Cp { get; set; }

    private EmailDetail_NEW? _email;
    private List<EmailDetail_NEW> _thread = new();
    private List<CommentoEmail>? _comments;
    private bool _loading = true;
    private string? _utente;

    private string? _newComment;
    private List<IBrowserFile> _selectedFiles = new();

    private List<string> _allUsers = new();
    private List<string> _mentionSuggestions = new();
    private bool _mentionOpen;
    private int _mentionIndex = 0;
    private bool _savingComment = false;

    public class EmailReplyInfo
    {
        public string CasellaMittente { get; set; } = "";
        public string Destinatari { get; set; } = "";
        public string? Cc { get; set; }
        public string? Bcc { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        _utente = await AccessiSrv.GetUtenteFromCpAsync(Cp);
        _email = await MailSvc1.GetEmailDetailAsync(Id, onlyMeta: false);
        if (!string.IsNullOrWhiteSpace(_utente))
        {
            await MailSvc1.SegnaNotificheVisteAsync(Id, _utente);
        }
        if (_email != null)
        {
            _thread = await MailSvc1.GetConversationByThreadAsync(_email.Id);

            _thread = _thread
                .GroupBy(t => t.MessageId)
                .Select(g => g.First())
                .ToList();
        }

        _comments = await MailSvc.GetCommentsByEmailAsync(Id);

        _comments = _comments?
            .GroupBy(c => c.Id)
            .Select(g => g.First())
            .ToList();

        _allUsers = await AccessiSrv.GetUserListAsync();
        _loading = false;
    }
    private async Task Reply(EmailDetail_NEW msg)
    {
        if (msg is null) return;

        var replyInfo = await MailSvc1.GetReplyInfoAsync(
            msg.ThreadKey,
            msg.InReplyTo
        );

        var parameters = new DialogParameters
        {
            ["Utente"] = _utente,
            ["Oggetto"] = msg.Oggetto?.StartsWith("Re:", StringComparison.OrdinalIgnoreCase) == true
                ? msg.Oggetto
                : "Re: " + msg.Oggetto,

            ["CorpoIniziale"] = $@"
<br><br>
---- Messaggio originale ----<br>
<b>Da:</b> {msg.Mittente}<br>
<b>Inviato:</b> {msg.Data}<br>
<b>Oggetto:</b> {msg.Oggetto}<br><br>
<blockquote style='border-left:3px solid #ccc; margin-left:10px; padding-left:10px; color:#555;'>
{msg.CorpoHtml ?? msg.CorpoTesto}
</blockquote>",

            ["ReplyToMessageId"] = msg.MessageId,
            ["References"] = BuildReferencesChain(msg),
            ["ThreadKey"] = msg.ThreadKey
        };

        if (replyInfo != null)
        {
            parameters["CasellaMittente"] = replyInfo.CasellaMittente;
            parameters["Destinatari"] = replyInfo.Destinatari;
            parameters["Cc"] = replyInfo.Cc;
            parameters["Bcc"] = replyInfo.Bcc;
        }
        else
        {
            parameters["Destinatari"] = ExtractEmailOnly(msg.Mittente);
        }

        var dialog = DialogService.Show<ComposeDialog>(
            "Rispondi",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true }
        );

        var result = await dialog.Result;
        if (result.Data is true)
            Snackbar.Add("Risposta inviata ✅", Severity.Success);
    }


  

    private static string BuildReferencesChain(EmailDetail_NEW msg)
    {
        if (string.IsNullOrWhiteSpace(msg.References))
            return msg.MessageId ?? "";

        var refs = msg.References.Split(' ', StringSplitOptions.RemoveEmptyEntries).ToList();

        if (!string.IsNullOrWhiteSpace(msg.MessageId) && !refs.Contains(msg.MessageId))
            refs.Add(msg.MessageId);

        return string.Join(" ", refs);
    }
    private void RemoveFile(IBrowserFile file)
    {
        _selectedFiles.Remove(file);
    }


    private void GoBack() => Nav.NavigateTo($"/mail-new?cp={Cp}");
    private string GetDownloadUrl(int id) => $"/api/attachments/{id}";
    private string GetCommentAttachmentUrl(int id) => $"/api/comments/{id}/attachment";

    private string GetAttachmentIcon(string? name)
    {
        var s = (name ?? "").ToLowerInvariant();
        if (s.EndsWith(".pdf")) return Icons.Material.Filled.PictureAsPdf;
        if (s.EndsWith(".jpg") || s.EndsWith(".png")) return Icons.Material.Filled.Image;
        if (s.EndsWith(".doc") || s.EndsWith(".docx")) return Icons.Material.Filled.Description;
        if (s.EndsWith(".xls") || s.EndsWith(".xlsx")) return Icons.Material.Filled.TableChart;
        return Icons.Material.Filled.AttachFile;
    }

    private static string CleanQuotedPart(string body)
    {
        if (string.IsNullOrWhiteSpace(body)) return body;

        var normalized = body.Replace("\r", "");
        string[] markers = { "---- Messaggio originale ----", "Da:", "Inviato:", "Oggetto:" };

        foreach (var marker in markers)
        {
            var idx = normalized.IndexOf(marker, StringComparison.OrdinalIgnoreCase);
            if (idx > 0)
            {
                normalized = normalized[..idx];
                break;
            }
        }

        return normalized.Trim();
    }

    private string GetInitials(string autore)
    {
        if (string.IsNullOrWhiteSpace(autore))
            return "?";

        var email = ExtractEmail(autore);

        if (email.Contains('.') && !email.Contains("@"))
        {
            var p = email.Split('.');
            if (p.Length >= 2)
                return $"{char.ToUpper(p[0][0])}{char.ToUpper(p[1][0])}";
        }

        if (email.Contains("@"))
            return email[0].ToString().ToUpper();

        return email[0].ToString().ToUpper();
    }

    private string GetAvatarColor(string autore)
    {
        string[] colors = { "#5A78FF", "#34A853", "#F4B400", "#EA4335", "#A142F4", "#00ACC1" };
        int hash = Math.Abs(autore.GetHashCode());
        return colors[hash % colors.Length];
    }
    private void OnFilesSelected(InputFileChangeEventArgs e)
    {
        foreach (var file in e.GetMultipleFiles())
        {
            _selectedFiles.Add(file);
        }
    }


    private void OnTextChanged(string value)
    {
        _newComment = value;
        if (string.IsNullOrWhiteSpace(_newComment))
        {
            _mentionOpen = false;
            _mentionSuggestions.Clear();
            return;
        }

        var last = _newComment.Split(' ', '\n', '\t').LastOrDefault() ?? "";

        if (last == "@")
        {
            _mentionSuggestions = _allUsers.Take(8).ToList();
            _mentionOpen = true;
            _mentionIndex = 0;
            return;
        }

        if (!last.StartsWith("@"))
        {
            _mentionOpen = false;
            _mentionSuggestions.Clear();
            return;
        }

        var query = last[1..].ToLowerInvariant();
        _mentionSuggestions = _allUsers
            .Where(u => u.Contains(query))
            .Take(8)
            .ToList();

        _mentionOpen = _mentionSuggestions.Any();
        _mentionIndex = 0;
    }

    private void HandleKeyNav(KeyboardEventArgs e)
    {
        if (!_mentionOpen || _mentionSuggestions.Count == 0) return;

        if (e.Key == "ArrowDown")
            _mentionIndex = (_mentionIndex + 1) % _mentionSuggestions.Count;
        else if (e.Key == "ArrowUp")
            _mentionIndex = (_mentionIndex - 1 + _mentionSuggestions.Count) % _mentionSuggestions.Count;
        else if (e.Key == "Enter")
            SelectMention(_mentionSuggestions[_mentionIndex]);
        else if (e.Key == "Escape")
            _mentionOpen = false;
    }

    private void SelectMention(string user)
    {
        if (string.IsNullOrWhiteSpace(_newComment)) return;

        var parts = _newComment.Split(' ', '\n', '\t').ToList();
        for (int i = parts.Count - 1; i >= 0; i--)
            if (parts[i].StartsWith("@")) { parts[i] = "@" + user; break; }

        _newComment = string.Join(" ", parts);
        _mentionOpen = false;
        _mentionSuggestions.Clear();
    }
    private static string ExtractEmail(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return "?";

        var m = Regex.Match(raw, @"<(?<mail>[^>]+)>");
        return m.Success ? m.Groups["mail"].Value : raw;
    }

    private static string ExtractEmailOnly(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
            return "";


        var match = Regex.Match(raw, "<([^>]+)>");
        if (match.Success)
            return match.Groups[1].Value;


        if (raw.Contains("@"))
            return raw.Trim();

        return raw;
    }

    private async Task AddComment()
    {
        if (_savingComment)
            return;

        _savingComment = true;

        try
        {
            // ❌ Niente testo e niente allegati
            if (string.IsNullOrWhiteSpace(_newComment) && _selectedFiles.Count == 0)
            {
                Snackbar.Add("Scrivi un commento o allega almeno un file.", Severity.Info);
                return;
            }

            int commentId;

            // =========================
            // 1️⃣ COMMENTO PRINCIPALE
            // =========================
            byte[]? bytes = null;
            string? name = null;

            if (_selectedFiles.Count == 1)
            {
                var f = _selectedFiles.First();
                using var s = f.OpenReadStream(12 * 1024 * 1024);
                using var ms = new MemoryStream();
                await s.CopyToAsync(ms);
                bytes = ms.ToArray();
                name = f.Name;
            }

            commentId = await MailSvc.AddCommentAsync(
                emailId: Id,
                autore: _utente!,
                testo: _newComment ?? "",
                fileBytes: bytes,
                fileName: name
            );

            // =========================
            // 2️⃣ ALLEGATI MULTIPLI
            // =========================
            if (_selectedFiles.Count > 1)
            {
                foreach (var f in _selectedFiles)
                {
                    using var s = f.OpenReadStream(12 * 1024 * 1024);
                    using var ms = new MemoryStream();
                    await s.CopyToAsync(ms);

                    await MailSvc.AddCommentAsync(
                        emailId: Id,
                        autore: _utente!,
                        testo: "(allegato)",
                        fileBytes: ms.ToArray(),
                        fileName: f.Name
                    );
                }
            }

            // =========================
            // 3️⃣ MENZIONI (@utente)
            // =========================
            var mentionedUsers = Regex.Matches(
                    _newComment ?? "",
                    @"@([a-z]\.[a-z0-9]+)",
                    RegexOptions.IgnoreCase)
                .Select(m => m.Groups[1].Value.ToLowerInvariant())
                .Distinct()
                .ToList();

            // =========================
            // 4️⃣ PARTECIPANTI EMAIL
            // =========================
            var partecipanti = (await MailSvc.GetPartecipantiEmailAsync(Id))
     .Distinct(StringComparer.OrdinalIgnoreCase)
     .ToList();

            var proprietariEmail = await MailSvc.GetProprietariEmailAsync(Id);

            // UNION partecipanti + menzionati
            var utentiDaNotificare = partecipanti
    .Union(mentionedUsers, StringComparer.OrdinalIgnoreCase)
    .Union(proprietariEmail, StringComparer.OrdinalIgnoreCase) 
    .Distinct(StringComparer.OrdinalIgnoreCase)
    .ToList();
            foreach (var u in utentiDaNotificare)
            {
                if (u.Equals(_utente, StringComparison.OrdinalIgnoreCase))
                    continue;

                bool isMention =
      mentionedUsers.Contains(u, StringComparer.OrdinalIgnoreCase)
      || proprietariEmail.Contains(u, StringComparer.OrdinalIgnoreCase);


                await MailSvc.RegistraEventoChatAsync(
                    emailId: Id,
                    utente: u,
                    isMention: isMention,
                    commentoId: commentId,
                    autore: _utente!
                );
            }



            // =========================
            // 5️⃣ RESET UI
            // =========================
            _newComment = "";
            _selectedFiles.Clear();
            _mentionOpen = false;
            _mentionSuggestions.Clear();

            _comments = await MailSvc.GetCommentsByEmailAsync(Id);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Errore AddComment: {ex.Message}");
            Snackbar.Add("Errore durante l'invio del commento", Severity.Error);
        }
        finally
        {
            _savingComment = false;
            StateHasChanged();
        }
    }




    private static readonly Regex _mentionRegex =
        new(@"@([a-z]\.[a-z0-9]+)", RegexOptions.IgnoreCase | RegexOptions.Compiled);

    private static string HighlightMentions(string? text)
    {
        if (string.IsNullOrEmpty(text))
            return string.Empty;

        return _mentionRegex.Replace(
            text,
            "<span class=\"mention-tag\">@$1</span>"
        );
    }
}


