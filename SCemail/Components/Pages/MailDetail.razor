@page "/mail-detail/{id:int}/{cp?}"
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.JSInterop
@using Oracle.ManagedDataAccess.Client
@using SCemail.Components.Data
@using System.Text.RegularExpressions
@using static System.Net.WebRequestMethods
@inject MailService MailSvc
@inject MailService_NEW MailSvc1
@inject NavigationManager Nav
@inject SCemail.Components.Data.AccessiService AccessiSrv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject HttpClient Http
@inject IJSRuntime JS
<div class="detail-shell">
    @if (_loading)
    {
        <div class="loading">Caricamento email...</div>
    }
    else if (_thread != null && _thread.Any())
    {
        <!-- SINISTRA: THREAD EMAIL -->
        <section class="left-pane">
            <header class="email-head">
                <div class="head-left">
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                                   Color="Color.Primary"
                                   OnClick="@GoBack" />

                    @if (_navIds.Count > 0)
                    {
                        <div class="nav-mail-arrows">
                            <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp"
                                           Title="Mail precedente"
                                           Disabled="@(!HasPrevious)"
                                           OnClick="@GoPreviousMail" />

                            <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown"
                                           Title="Mail successiva"
                                           Disabled="@(!HasNext)"
                                           OnClick="@GoNextMail" />
                        </div>
                    }

                    <div class="head-texts">
                        <MudTooltip Text="@(_email?.Oggetto ?? "")" Placement="Placement.Bottom">
                            <h3 class="subj">@_email?.Oggetto</h3>
                        </MudTooltip>

                        <div class="head-meta-row">
                            <div class="meta">
                                Thread di @_thread.Count messaggi
                                @if (_navIds.Count > 0 && _currentNavIndex >= 0)
                                {
                                    <span> • mail @(_currentNavIndex + 1) di @_navIds.Count</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="head-actions">

                    @if (!string.IsNullOrWhiteSpace(_assegnatoA))
                    {
                        <div class="assigned-badge" title="@_assegnatoA">
                            <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                            <span>@_assegnatoA</span>
                        </div>
                    }
                    @if (_canDeleteEmail)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Title="Elimina definitivamente email"
                                       Color="Color.Error"
                                       Class="head-action-btn"
                                       OnClick="@DeleteCurrentEmail" />
                    }
                    <MudIconButton Icon="@Icons.Material.Filled.Report"
                                   Title="Metti mittente in blacklist"
                                   Color="Color.Error"
                                   Class="head-action-btn"
                                   OnClick="@AddCurrentSenderToBlacklist" />

                    <MudIconButton Icon="@Icons.Material.Filled.MarkEmailUnread"
                                   Title="Segna da leggere"
                                   Color="Color.Default"
                                   Class="head-action-btn"
                                   OnClick="@MarkUnreadThread" />

                    <MudIconButton Icon="@Icons.Material.Filled.Archive"
                                   Title="Archivia"
                                   Color="Color.Primary"
                                   Class="head-action-btn"
                                   OnClick="@ArchiveThread" />

                    <MudIconButton Icon="@Icons.Material.Filled.ForwardToInbox"
                                   Color="Color.Primary"
                                   Title="Assegna"
                                   Class="head-action-btn"
                                   OnClick="@(() => AssignThread())" />

                    <div class="move-select-wrap">
                        <MudSelect T="long?"
                                   Dense="true"
                                   Variant="Variant.Outlined"
                                   Label="Sposta in..."
                                   Value="_sezioneSelezionata"
                                   ValueChanged="OnSpostaInChanged"
                                   Disabled="@_moving"
                                   Class="move-select">
                            @foreach (var s in _sezioni)
                            {
                                <MudSelectItem T="long?" Value="@(s.Id)">
                                    @s.Nome
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </div>
                </div>
            </header>


            @if (_readFromIndex > 0)
            {
                <MudButton Variant="Variant.Text"
                           StartIcon="@Icons.Material.Filled.UnfoldMore"
                           OnClick="@ShowAllThread">
                    Mostra tutto
                </MudButton>
            }


            @{
                var ordered = _thread.OrderBy(m => m.Data).ToList();
            }

            <div class="email-thread">
                @for (int i = _readFromIndex; i < ordered.Count; i++)
                {
                    var mail = ordered[i];
                    <div class="gmail-msg">
                        <div class="gmail-head2">
                            <div class="gmail-left2">
                                @{
                                    var senderDisplay = GetMailHeaderSender(mail);
                                }

                                <div class="avatar" style="background:@GetAvatarColor(senderDisplay)">
                                    @GetInitials(senderDisplay)
                                </div>

                                <div class="gmail-meta2">
                                    <div class="from2">
                                        <span class="from-email">@senderDisplay</span>
                                        @if (IsSentMail(mail))
                                        {
                                            <span class="sent-badge">Inviata</span>
                                        }
                                    </div>
                                    <div class="recips2" title="@BuildThreadRecipientsTooltip(mail)">
                                        @BuildThreadRecipientsInline(mail)
                                    </div>
                                </div>
                            </div>

                            <div class="gmail-right2">
                                <div class="date2">
                                    @mail.Data?.ToString("dd/MM/yyyy HH:mm")
                                </div>

                                <div class="msg-actions">
                                    <MudIconButton Icon="@Icons.Material.Filled.Reply"
                                                   Title="Rispondi"
                                                   OnClick="@(() => Reply(mail))" />

                                    <MudIconButton Icon="@Icons.Material.Filled.ReplyAll"
                                                   Title="Rispondi a tutti"
                                                   OnClick="@(() => ReplyAll(mail))" />

                                    <MudIconButton Icon="@Icons.Material.Filled.Send"
                                                   Title="Inoltra (esterno)"
                                                   OnClick="@(() => ForwardExternalFrom(mail))" />

                                    <MudIconButton Icon="@Icons.Material.Filled.MenuBook"
                                                   Title="Leggi da qui"
                                                   OnClick="@(() => ReadFromHere(mail))" />
                                </div>
                            </div>
                        </div>

                        <div class="gmail-body">
                            @{
                                var safe = PrepareHtmlForDisplay(mail);
                            }

                            <div class="mail-clean-body">
                                @((MarkupString)safe)
                            </div>
                        </div>
                        @if (mail.Allegati?.Any() == true)
                        {
                            <div class="gmail-attachments">
                                <div class="attach-title">📎 Allegati:</div>

                                <div class="attach-grid">
                                    @foreach (var a in mail.Allegati)
                                    {
                                        var mime = NormalizeMime(a.MimeType, a.NomeFile);

                                        <a class="attach-chip @(a.IsEmailEml ? "attach-chip-eml" : "")"
                                           href="javascript:void(0)"
                                           title="@a.NomeFile"
                                           @onclick="@(async () => await OpenAttachmentOrEmailAsync(
                                           a,
                                                                                  NormalizeMime(a.MimeType, a.NomeFile),
                                                                                  mail.Allegati.Select(x => x.Id).ToList()
                                                                              ))" @onclick:stopPropagation="true">

                            <MudIcon Icon="@(a.IsEmailEml? Icons.Material.Filled.Email : GetAttachmentIcon(a.NomeFile))"
                                     Size="Size.Small"
                                     Class="attach-icon" />

                            <span class="attach-name">@a.NomeFile</span>
                            @if (a.IsEmailEml)
                                {
                                    <span class="eml-badge">Apri email</span>
                                    <MudIcon Icon="@Icons.Material.Filled.OpenInNew"
                                             Size="Size.Small"
                                             Class="attach-open-icon" />
                                }
                            </a>
                        }
                    </div>
                </div>
                                }
            </div>
                        }


        </div>


    </section>

    <!-- DESTRA: COMMENTI -->
    <aside class="right-pane">
        <h4 class="comments-title">💬 Commenti interni</h4>

        <div class="comments-list">
            @if (_comments == null)
            {
                <div class="muted">Caricamento…</div>
            }
            else if (_comments.Count == 0)
            {
                <div class="muted">Nessun commento</div>
            }
            else
            {
                @foreach (var c in _comments.OrderBy(x => x.DataCreazione))
                {
                    if (IsActivity(c))
                    {
                        <div class="activity-line">
                            <span class="activity-text">@((MarkupString)ActivityText(c))</span>
                            <span class="activity-time">@c.DataCreazione.ToString("dd MMM yyyy HH:mm")</span>
                        </div>
                    }
                    else
                    {
                        <div class="comment-box">
                            <!-- AVATAR TEAM STYLE -->
                            <div class="avatar2" style="background:@GetAvatarColor(c.Autore)">
                                @GetInitials(c.Autore)
                            </div>

                            <div class="comment-content">
                                <div class="comment-header">
                                    <span class="author">@c.Autore</span>
                                    <span class="time">@c.DataCreazione.ToString("dd MMM yyyy HH:mm")</span>
                                </div>

                                <div class="comment-text">
                                    @((MarkupString)HighlightMentions(c.Testo))
                                </div>

                                @if (!string.IsNullOrWhiteSpace(c.AllegatoNome))
                                {
                                    <div class="comment-attachment">
                                        <MudIcon Icon="@GetAttachmentIcon(c.AllegatoNome)" />
                                        <a href="@GetCommentAttachmentUrl(c.Id)" target="_blank">@c.AllegatoNome</a>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            }
        </div>

        <!-- EDITOR COMMENTI -->
        <div class="editor">
            <div class="mention-wrapper">
                <MudTextField T="string"
                              Value="_newComment"
                              ValueChanged="@(v => OnTextChanged(v))"
                              Lines="4"
                              Variant="Variant.Outlined"
                              Placeholder=@("Scrivi un commento… usa @ per menzionare")
                              Immediate="true"
                              OnKeyDown="@((KeyboardEventArgs e) => HandleKeyNav(e))"
                              Class="editor-text" />

                @if (_mentionOpen && _mentionSuggestions.Count > 0)
                {
                    <div class="mention-popup top">
                        @foreach (var u in _mentionSuggestions)
                        {
                            <div class="mention-item" @onclick="@(() => SelectMention(u))">@u</div>
                        }
                    </div>
                }
            </div>

            <!-- PULSANTE + FILE -->
            <div class="editor-files">
                <label class="file-plus">
                    <MudIcon Icon="@Icons.Material.Filled.AttachFile" Size="Size.Medium" />
                    <InputFile OnChange="OnFilesSelected" multiple style="display:none" />
                </label>

                @if (_selectedFiles.Count > 0)
                {
                    <div class="file-list">
                        @foreach (var f in _selectedFiles)
                        {
                            <div class="file-chip">
                                <MudIcon Icon="@GetAttachmentIcon(f.Name)" />
                                @f.Name
                                <MudIconButton Icon="@Icons.Material.Filled.Close"
                                               Size="Size.Small"
                                               Color="Color.Error"
                                               OnClick="@(() => RemoveFile(f))" />
                            </div>
                        }
                    </div>
                }

            </div>

            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       OnClick="AddComment"
                       Disabled="@_savingComment"
                       Loading="@_savingComment">
                INVIA
            </MudButton>
        </div>

    </aside>
        }

    @if (_showAttachmentViewer)
    {
        <AttachmentViewerOverlay Id="@_attachmentViewerId"
                                 Src="@_attachmentViewerSrc"
                                 Ids="@_attachmentViewerIds"
                                 OnClose="@CloseAttachmentViewer" />
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public string? Cp { get; set; }

    private EmailDetail_NEW? _email;
    private List<EmailDetail_NEW> _thread = new();
    private List<CommentoEmail>? _comments;
    private bool _loading = true;
    private string? _utente;
    private string? _utenteSele;

    private string? _newComment;
    private List<IBrowserFile> _selectedFiles = new();

    private List<string> _allUsers = new();
    private List<string> _mentionSuggestions = new();
    private bool _mentionOpen;
    private int _mentionIndex = 0;
    private bool _savingComment = false;
    private List<EmailInboxSezione> _sezioni = new();
    private long? _sezioneSelezionata;
    private bool _moving = false;
    private string? _assegnatoA;
    private bool _canDeleteEmail;
    public class EmailReplyInfo
    {
        public string CasellaMittente { get; set; } = "";
        public string Destinatari { get; set; } = "";
        public string? Cc { get; set; }
        public string? Bcc { get; set; }
    }
    private string? _fromFolder;
    private string? _fromSection;

    private List<int> _navIds = new();
    private int _currentNavIndex = -1;

    private bool HasPrevious => _currentNavIndex > 0;
    private bool HasNext => _currentNavIndex >= 0 && _currentNavIndex < _navIds.Count - 1;

    private int? PreviousId => HasPrevious ? _navIds[_currentNavIndex - 1] : null;
    private int? NextId => HasNext ? _navIds[_currentNavIndex + 1] : null;

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrWhiteSpace(_utente))
            _utente = await AccessiSrv.GetUtenteFromCpAsync(Cp);

        await LoadPageAsync();
    }

    private async Task Reply(EmailDetail_NEW msg)
    {
        if (msg is null) return;
        var quoteHtml = await BuildReplyQuoteHtml(msg);
        var replyTo = ExtractEmailOnly(msg.Mittente);

        var fromCasella = (msg.CasellaEmail ?? "").Trim();

        if (string.IsNullOrWhiteSpace(fromCasella))
        {
            Snackbar.Add("Casella mittente non trovata per questa email.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            ["Utente"] = _utente,
            ["Oggetto"] = msg.Oggetto?.StartsWith("Re:", StringComparison.OrdinalIgnoreCase) == true
                ? msg.Oggetto
                : "Re: " + (msg.Oggetto ?? ""),
            ["CorpoIniziale"] = quoteHtml,
            ["ReplyToMessageId"] = msg.MessageId,
            ["References"] = BuildReferencesChain(msg),
            ["ThreadKey"] = msg.ThreadKey,
            ["CasellaMittente"] = fromCasella,
            ["Destinatari"] = replyTo,
            ["Cc"] = null,
            ["Bcc"] = null
        };

        var dialog = await DialogService.ShowAsync<ComposeDialog>(
            "Rispondi",
            parameters,
            new DialogOptions
            {
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                BackdropClick = false,
                CloseOnEscapeKey = false
            });

        var result = await dialog.Result;

        if (!result.Canceled && result.Data?.ToString() == "sent")
        {
            Snackbar.Add("Risposta inviata ✅", Severity.Success);
            await Task.Delay(600);
            Nav.NavigateTo(Nav.Uri, forceLoad: true);
        }
    }
    private string PrepareHtmlForDisplay(EmailDetail_NEW mail)
    {
        var html = StripActiveContent(mail.CorpoHtml ?? "");

        if (mail.Allegati == null || !mail.Allegati.Any())
            return RemoveUnresolvedCidImages(html);

        foreach (var a in mail.Allegati)
        {
            var nome = a.NomeFile ?? "";
            if (string.IsNullOrWhiteSpace(nome))
                continue;

            var url = $"/api/attachments/{a.Id}/download";

            html = Regex.Replace(
                html,
                $@"cid:{Regex.Escape(nome)}",
                url,
                RegexOptions.IgnoreCase
            );
        }

        return RemoveUnresolvedCidImages(html);
    }

    private static string RemoveUnresolvedCidImages(string html)
    {
        return Regex.Replace(
            html,
            @"<img\b[^>]*src\s*=\s*[""']?cid:[^>]*>",
            "",
            RegexOptions.IgnoreCase
        );
    }


    private EmailDetail_NEW? GetThreadLast()
    {
        if (_thread == null || _thread.Count == 0) return null;
        return _thread.OrderBy(x => x.Data).LastOrDefault();
    }

    private async Task ArchiveThread()
    {
        if (_email == null || string.IsNullOrWhiteSpace(_utente))
            return;

        if (_fromFolder == "mentions" && !_email.CanArchive)
        {
            Snackbar.Add("Puoi archiviare questa menzione solo dopo aver risposto.", Severity.Warning);
            return;
        }

        var archivedId = _email.Id;

        var currentIndex = _currentNavIndex;
        int? nextId = null;
        int? previousId = null;

        if (_navIds.Count > 0 && currentIndex >= 0)
        {
            if (currentIndex < _navIds.Count - 1)
                nextId = _navIds[currentIndex + 1];

            if (currentIndex > 0)
                previousId = _navIds[currentIndex - 1];
        }

        await MailSvc1.ArchiveEmailAsync(archivedId, _utente);

        Snackbar.Add("Conversazione archiviata ✔", Severity.Success);

        _navIds = _navIds.Where(x => x != archivedId).ToList();

        if (nextId.HasValue)
        {
            NavigateToMail(nextId.Value);
            return;
        }

        if (previousId.HasValue)
        {
            NavigateToMail(previousId.Value);
            return;
        }

        GoBack();
    }

    private async Task MoveToInboxThread()
    {
        var last = GetThreadLast();
        if (last == null || string.IsNullOrWhiteSpace(_utente)) return;

        await MailSvc1.UnarchiveEmailAsync(last.Id, _utente);

        Snackbar.Add("Spostata in Posta in arrivo ✔", Severity.Success);
        GoBack();
    }

    private async Task<string> BuildReplyQuoteHtml(EmailDetail_NEW original)
    {
        var from = await ResolveDisplayEmailAsync(original);
        var it = new System.Globalization.CultureInfo("it-IT");

        var d = original.Data?.ToString("ddd d MMM yyyy", it) ?? "";
        var t = original.Data?.ToString("HH:mm", it) ?? "";

        var bodyHtml = PrepareHtmlForDisplay(original);

        return $@"
<div style=""font-family:'Courier New',monospace;font-size:14px;line-height:1.45;color:#222;"">
    <div>
        Il giorno {Html(d)} alle ore {Html(t)} {Html(from)} ha scritto:
    </div>
    <br>
    <div>
        {bodyHtml}
    </div>
</div>";
    }
    private string GetBodyVisibleAsTextOnlyCurrent(EmailDetail_NEW mail)
    {
        var text = !string.IsNullOrWhiteSpace(mail.CorpoHtml)
            ? HtmlToText(mail.CorpoHtml)
            : mail.CorpoTesto ?? "";

        text = Regex.Replace(
            text,
            @"(?im)^\s*Il giorno .+? ha scritto:\s*$[\s\S]*$",
            ""
        );

        text = Regex.Replace(
            text,
            @"(?im)^\s*Messaggio precedente:\s*$[\s\S]*$",
            ""
        );

        text = Regex.Replace(text, @"\n{3,}", "\n\n");

        return text.Trim();
    }
    private static string TextToHtmlPreserve(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return "";

        var safe = Html(text)
            .Replace("\r\n", "\n")
            .Replace("\r", "\n")
            .Replace("\n", "<br>");

        return safe;
    }

    private string ResolveDisplayEmail(EmailDetail_NEW mail)
    {
        var from = ExtractEmailOnly(mail.Mittente);

        if (!string.IsNullOrWhiteSpace(from) && from.Contains("@"))
            return from;

        if (!string.IsNullOrWhiteSpace(mail.CasellaEmail) && mail.CasellaEmail.Contains("@"))
            return mail.CasellaEmail.Trim();

        return from;
    }

    private async Task<string> ResolveDisplayEmailAsync(EmailDetail_NEW mail)
    {
        var raw = ExtractEmailOnly(mail.Mittente);

        if (!string.IsNullOrWhiteSpace(raw) && raw.Contains("@"))
            return raw;

        if (!string.IsNullOrWhiteSpace(raw))
        {
            var resolved = await MailSvc1.GetEmailAddressByUsernameAsync(raw);

            if (!string.IsNullOrWhiteSpace(resolved) && resolved.Contains("@"))
                return resolved;
        }

        return raw;
    }
    private async Task MarkUnreadThread()
    {
        var last = GetThreadLast();
        if (last == null || string.IsNullOrWhiteSpace(_utente)) return;

        // ✅ qui serve un metodo che marca NON letto (Aperto='N' o equivalente)
        await MailSvc1.MarkUnreadAsync(last.Id);

        Snackbar.Add("Segnata da leggere ✔", Severity.Success);
        GoBack();
    }

    private async Task ReplyThread()
    {
        var last = GetThreadLast();
        if (last == null) return;

        await Reply(last);
    }

    private async Task ReplyAllThread()
    {
        var last = GetThreadLast();
        if (last == null) return;

        // se hai già ReplyAll in mail-new, replica qui o richiama quello
        await ReplyAll(last); // <- implementalo come hai fatto nell’altra pagina (usa GetReplyInfoAsync)
    }

    private bool IsSentMail(EmailDetail_NEW mail)
    {
        return string.Equals(mail.Tipo, "SENT", StringComparison.OrdinalIgnoreCase)
            || string.Equals(mail.Tipo, "INVIATA", StringComparison.OrdinalIgnoreCase)
            || (!string.IsNullOrWhiteSpace(mail.Mittente)
                && !mail.Mittente.Contains("@")
                && !string.IsNullOrWhiteSpace(mail.CasellaEmail)
                && mail.CasellaEmail.Contains("@"));
    }

    private string GetMailHeaderSender(EmailDetail_NEW mail)
    {
        if (IsSentMail(mail))
        {
            if (!string.IsNullOrWhiteSpace(mail.CasellaEmail))
                return mail.CasellaEmail.Trim();

            return "Io";
        }
        var mittente = ExtractEmailOnly(mail.Mittente);
        if (!string.IsNullOrWhiteSpace(mittente))
            return mittente.Trim();
        return "(mittente sconosciuto)";
    }

    private string PrepareHtmlForDisplayOnlyCurrent(EmailDetail_NEW mail)
    {
        var text = !string.IsNullOrWhiteSpace(mail.CorpoHtml)
            ? HtmlToText(mail.CorpoHtml)
            : mail.CorpoTesto ?? "";

        text = Regex.Replace(text, @"(?im)^\s*Messaggio precedente:\s*$[\s\S]*$", "");
        text = Regex.Replace(text, @"(?im)^\s*Il giorno .+? ha scritto:\s*$[\s\S]*$", "");

        text = Regex.Replace(text, @"[ \t]{2,}", " ");
        text = Regex.Replace(text, @" *\n *", "\n");
        text = Regex.Replace(text, @"\n{3,}", "\n\n");

        return System.Net.WebUtility.HtmlEncode(text.Trim())
            .Replace("\r\n", "\n")
            .Replace("\r", "\n")
            .Replace("\n", "<br>");
    }
    private async Task AssignThread()
    {
        var emailIdToAssign = Id;

        try
        {
            var requireComment = true;

            if (await AccessiSrv.IsAdminAsync(_utente))
                requireComment = false;

            var parameters = new DialogParameters
            {
                ["Users"] = await MailSvc1.GetUserListAsync(),
                ["RequireComment"] = requireComment,
                ["Title"] = "Assegna internamente"
            };

            var dialog = DialogService.Show<ForwardDialog>(
                "Assegna email",
                parameters,
                new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true }
            );

            var result = await dialog.Result;

            if (result.Canceled || result.Data is not ForwardDialog.ForwardResult fr)
                return;

            if (requireComment && string.IsNullOrWhiteSpace(fr.AssignedComment))
            {
                Snackbar.Add("Per assegnare è obbligatorio inserire un commento.", Severity.Warning);
                return;
            }

            int? commentId = null;

            if (!string.IsNullOrWhiteSpace(fr.MentionsComment))
            {
                commentId = await MailSvc.AddCommentAsync(
                    emailId: emailIdToAssign,
                    autore: _utente!,
                    testo: fr.MentionsComment
                );

                await MailSvc.MarkEmailSeguiteAsUnreadAsync(
                    emailId: emailIdToAssign,
                    commentId: commentId.Value,
                    autore: _utente!
                );
            }

            await MailSvc1.AssignEmailAsync(
                emailId: emailIdToAssign,
                utente: fr.User,
                soloInvio: false,
                commento: fr.AssignedComment,
                eseguitoDa: _utente,
                keepExecutorUnarchived: fr.FollowMe
            );

            foreach (var u in fr.MentionedUsers
                         .Where(u => !string.IsNullOrWhiteSpace(u))
                         .Select(u => u.Trim().ToLowerInvariant())
                         .Distinct(StringComparer.OrdinalIgnoreCase))
            {
                if (commentId.HasValue && !u.Equals(_utente, StringComparison.OrdinalIgnoreCase))
                {
                    await MailSvc.RegistraEventoChatAsync(
                        emailId: emailIdToAssign,
                        utente: u,
                        isMention: true,
                        commentoId: commentId.Value,
                        autore: _utente!
                    );
                }
            }

            Snackbar.Add(
       fr.FollowMe
           ? $"Email assegnata a {fr.User} e aggiunta ai seguiti ✅"
           : $"Email assegnata a {fr.User} ✅",
       Severity.Success
   );

            _navIds = _navIds.Where(x => x != emailIdToAssign).ToList();

            int? nextId = null;

            if (_currentNavIndex >= 0)
            {
                if (_currentNavIndex < _navIds.Count)
