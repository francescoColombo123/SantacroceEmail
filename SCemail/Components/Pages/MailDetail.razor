    private static string CleanQuotedPart(string body)
    {
        if (string.IsNullOrWhiteSpace(body))
            return body;

        var normalized = body.Replace("\r", "");

        var patterns = new[]
        {
        @"(?im)^\s*-{2,}\s*Messaggio originale\s*-{2,}\s*$",
        @"(?im)^\s*Da:\s+.+$",
        @"(?im)^\s*Inviato:\s+.+$",
        @"(?im)^\s*Oggetto:\s+.+$"
    };

        foreach (var pattern in patterns)
        {
            var m = Regex.Match(normalized, pattern);
            if (m.Success && m.Index > 0)
            {
                normalized = normalized[..m.Index];
                break;
            }
        }

        return normalized.Trim();
    }


    private async Task<List<MailService_NEW.OutgoingAttachment_NEW>> BuildForwardAttachmentsAsync(EmailDetail_NEW msg)
    {
        var result = new List<MailService_NEW.OutgoingAttachment_NEW>();

        if (msg.Allegati == null || !msg.Allegati.Any())
            return result;

        foreach (var a in msg.Allegati)
        {
            if (a.IsEmailEml)
                continue;

            try
            {
                var bytes = await Http.GetByteArrayAsync($"/api/attachments/{a.Id}/download");

                if (bytes == null || bytes.Length == 0)
                    continue;

                result.Add(new MailService_NEW.OutgoingAttachment_NEW(
                    a.NomeFile,
                    NormalizeMime(a.MimeType, a.NomeFile),
                    bytes
                ));
            }
            catch
            {
                Snackbar.Add($"Impossibile allegare automaticamente: {a.NomeFile}", Severity.Warning);
            }
        }

        return result;
    }

