    private void SelectMention(string user)
    {
        if (string.IsNullOrWhiteSpace(_newComment)) return;

        var parts = _newComment.Split(' ', '\n', '\t').ToList();
        for (int i = parts.Count - 1; i >= 0; i--)
            if (parts[i].StartsWith("@")) { parts[i] = "@" + user; break; }

        _newComment = string.Join(" ", parts);
        _mentionOpen = false;
        _mentionSuggestions.Clear();
    }
    private static string ExtractEmail(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return "?";

        var m = Regex.Match(raw, @"<(?<mail>[^>]+)>");
        return m.Success ? m.Groups["mail"].Value : raw;
    }
    private string BuildGmailForwardUntil(EmailDetail_NEW target)
    {
        var ordered = GetThreadOrdered(); // tu già ce l’hai
        var idx = ordered.FindIndex(x =>
            (!string.IsNullOrWhiteSpace(x.MessageId) && x.MessageId == target.MessageId) || x.Id == target.Id);

        if (idx < 0) idx = ordered.Count - 1;

        // prendo dall'inizio fino a idx (in ordine cronologico)
        var slice = ordered.Take(idx + 1).ToList();

        var sb = new System.Text.StringBuilder();
        sb.Append("<br><br>");

        foreach (var m in slice)
        {
            var date = m.Data?.ToString("ddd d MMM yyyy HH:mm") ?? "";
            var from = m.Mittente ?? "";

            // se nel DTO hai To/Cc, usali; se non li hai, lascia vuoto
            var to = (m.Destinatari ?? "").Trim();

            sb.AppendLine("---------- Forwarded message ---------<br>");
            sb.AppendLine($"<b>Da:</b> {System.Net.WebUtility.HtmlEncode(from)}<br>");
            sb.AppendLine($"<b>Date:</b> {System.Net.WebUtility.HtmlEncode(date)}<br>");
            sb.AppendLine($"<b>Subject:</b> {System.Net.WebUtility.HtmlEncode(m.Oggetto ?? "")}<br>");

            if (!string.IsNullOrWhiteSpace(to))
                sb.AppendLine($"<b>To:</b> {System.Net.WebUtility.HtmlEncode(to)}<br>");



            sb.AppendLine("<br>");

            // corpo originale (NON clean)
            var bodyHtml = ToSafeHtmlBody(m);

            sb.AppendLine("<blockquote style='border-left:3px solid #ccc; margin:0 0 16px 10px; padding-left:10px; color:#555;'>");
            sb.AppendLine(bodyHtml);
            sb.AppendLine("</blockquote>");
            sb.AppendLine("<br>");
        }

        return sb.ToString();
    }

    private string ToSafeHtmlBody(EmailDetail_NEW msg)
    {
        if (!string.IsNullOrWhiteSpace(msg.CorpoHtml))
            return msg.CorpoHtml;

        var txt = msg.CorpoTesto ?? "";
        return $"<pre style='white-space:pre-wrap;font-family:inherit;margin:0'>{System.Net.WebUtility.HtmlEncode(txt)}</pre>";
    }
    private static List<string> ParseEmailsSafe(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return new();

        try
        {
            // MimeKit è già referenziato nel progetto (lo usi in mail-new)
            var list = MimeKit.InternetAddressList.Parse(raw);
            return list.Mailboxes
                .Select(m => (m.Address ?? "").Trim().ToLowerInvariant())
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .ToList();
        }
        catch
        {
            // fallback: separatori comuni
            return raw.Split(';', ',', '\n', '\r')
                      .Select(x => x.Trim().Trim('<', '>', ' '))
                      .Where(x => x.Contains("@"))
                      .Select(x => x.ToLowerInvariant())
                      .ToList();
        }
    }

