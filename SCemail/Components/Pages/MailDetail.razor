    private string BuildForwardChainAsText(EmailDetail_NEW selected)
    {
        var ordered = _thread?.OrderBy(x => x.Data).ToList() ?? new List<EmailDetail_NEW>();

        // trova indice del messaggio selezionato in lista
        var idx = ordered.FindIndex(x =>
            (!string.IsNullOrWhiteSpace(selected.MessageId) && x.MessageId == selected.MessageId) || x.Id == selected.Id);

        if (idx < 0) idx = ordered.Count - 1;

        // da sopra fino a lì (incluso)
        var chain = ordered.Take(idx + 1).ToList();
        if (chain.Count == 0) chain.Add(selected);

        var msg = chain.Last();

        var sb = new System.Text.StringBuilder();

        // HEADER forward (solo UNA volta)
        sb.AppendLine("---------- Forwarded message ---------");
        sb.AppendLine($"Da: {FormatNameEmailLikeGmail(msg.Mittente)}");
        sb.AppendLine($"Date: {FormatDateLikeGmail(msg.Data)}");
        sb.AppendLine($"Subject: {msg.Oggetto}");
        sb.AppendLine($"To: {FormatToLikeGmail(ExtractEmailOnly(msg.Destinatari))}");
        sb.AppendLine();
        sb.AppendLine(GetBodyVisibleAsText(msg).Trim());
        sb.AppendLine();

        // catena precedente (stile gmail: "---- Messaggio originale ----")
        for (int i = chain.Count - 2; i >= 0; i--)
        {
            var prev = chain[i];

            sb.AppendLine("---- Messaggio originale ----");
            sb.AppendLine($"Da: {FormatNameEmailLikeGmail(prev.Mittente)}");
            sb.AppendLine($"Inviato: {FormatDateSimple(prev.Data)}");
            sb.AppendLine($"Oggetto: {prev.Oggetto}");
            sb.AppendLine($"A: {FormatToLikeGmail(ExtractEmailOnly(prev.Destinatari))}");
            sb.AppendLine();
            sb.AppendLine(GetBodyVisibleAsText(prev).Trim());
            sb.AppendLine();
        }

        return sb.ToString().TrimEnd();
    }
    private string BuildForwardChainHtml(EmailDetail_NEW selected)
    {
        var ordered = _thread?.OrderBy(x => x.Data).ToList() ?? new List<EmailDetail_NEW>();
        var idx = ordered.FindIndex(x => x.MessageId == selected.MessageId);
        if (idx < 0) idx = ordered.FindIndex(x => x.Id == selected.Id);
        if (idx < 0) idx = ordered.Count - 1;

        // "da sopra fino a lì" (incluso)
        var chain = ordered.Take(idx + 1).ToList();
        if (chain.Count == 0) chain.Add(selected);

        // header "Forwarded message" (gmail-like) sul messaggio selezionato
        var msg = chain.Last();

        var from = FormatNameEmailLikeGmail(msg.Mittente);
        var date = Html(FormatDateLikeGmail(msg.Data));
        var subject = Html(msg.Oggetto);
        var to = FormatToLikeGmail(ExtractEmailOnly(msg.Destinatari));

        var html =
            "<br><br>" +
            "---------- Forwarded message ---------<br>" +
            "<b>Da:</b> " + from + "<br>" +
            "<b>Date:</b> " + date + "<br>" +
            "<b>Subject:</b> " + subject + "<br>" +
            "<b>To:</b> " + to + "<br><br>";

        // corpo del messaggio selezionato (come in UI)
        html += GetBodyHtmlVisible(msg);

        // catena precedente (a cascata) -> "---- Messaggio originale ----"
        for (int i = chain.Count - 2; i >= 0; i--)
        {
            var prev = chain[i];

            var prevFrom = FormatNameEmailLikeGmail(prev.Mittente);
            var prevDate = Html(prev.Data?.ToString("ddd d MMM yyyy HH:mm", new System.Globalization.CultureInfo("it-IT")) ?? "");
            var prevSubj = Html(prev.Oggetto);
            var prevTo = FormatToLikeGmail(ExtractEmailOnly(prev.Destinatari));

            html +=
                "<br><br>" +
                "---- Messaggio originale ----<br>" +
                "<b>Da:</b> " + prevFrom + "<br>" +
                "<b>Inviato:</b> " + prevDate + "<br>" +
                "<b>Oggetto:</b> " + prevSubj + "<br>" +
                "<b>A:</b> " + prevTo + "<br><br>" +
                "<blockquote style='border-left:3px solid #ccc;margin:0 0 0 10px;padding-left:10px;color:#555;'>" +
                GetBodyHtmlVisible(prev) +
                "</blockquote>";
        }

        return html;
    }

    private async Task ForwardExternalFrom(EmailDetail_NEW msg)
    {
        if (msg is null) return;

        if (string.IsNullOrWhiteSpace(_utente))
        {
            Snackbar.Add("Utente non valorizzato (cp mancante).", Severity.Error);
            return;
        }

        // testo Gmail-like
        var forwardText = BuildForwardChainAsText(msg);

        // lo impacchetto in <pre> così NON ti si impasta mai
        var forwardHtml = ToForwardHtmlForQuill(forwardText);
        var parameters = new DialogParameters
        {
            ["Utente"] = _utente,
            ["Oggetto"] = (msg.Oggetto?.StartsWith("Fwd:", StringComparison.OrdinalIgnoreCase) == true)
                ? msg.Oggetto
                : "Fwd: " + (msg.Oggetto ?? ""),
            ["CorpoIniziale"] = forwardHtml,
            ["Destinatari"] = ""
        };

        var dialog = DialogService.Show<ComposeDialog>(
            "Inoltra (esterno)",
            parameters,
             new DialogOptions
             {
                 MaxWidth = MaxWidth.Medium,
                 FullWidth = true,
                 BackdropClick = false,    
                 CloseOnEscapeKey = false  
             });

        var result = await dialog.Result;
        if (result.Data is true)
            Snackbar.Add("Inoltro esterno inviato ✅", Severity.Success);
    }

   

