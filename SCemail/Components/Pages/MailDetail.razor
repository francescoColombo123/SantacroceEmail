    private static readonly Regex _mentionRegex =
        new(@"@([a-z]\.[a-z0-9]+)", RegexOptions.IgnoreCase | RegexOptions.Compiled);

    private static string HighlightMentions(string? text)
    {
        if (string.IsNullOrEmpty(text))
            return string.Empty;

        return _mentionRegex.Replace(
