        var forwardAttachments = await BuildForwardAttachmentsAsync(msg);

        var parameters = new DialogParameters
        {
            ["Utente"] = _utente,
            ["Oggetto"] = msg.Oggetto?.StartsWith("Fwd:", StringComparison.OrdinalIgnoreCase) == true
                ? msg.Oggetto
                : "Fwd: " + (msg.Oggetto ?? ""),

            ["CorpoIniziale"] = forwardHtml,
            ["Destinatari"] = "",

            ["IsForward"] = true,
            ["ForwardAttachments"] = forwardAttachments,

            ["ReplyToMessageId"] = null,
            ["References"] = null,
            ["ThreadKey"] = null
        };

        var dialog = DialogService.Show<ComposeDialog>(
            "Inoltra (esterno)",
            parameters,
            new DialogOptions
            {
