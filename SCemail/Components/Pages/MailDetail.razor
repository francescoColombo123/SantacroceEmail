    private string GetInitials(string autore)
    {
        if (string.IsNullOrWhiteSpace(autore))
            return "?";

        var email = ExtractEmail(autore);

        if (email.Contains('.') && !email.Contains("@"))
        {
            var p = email.Split('.');
            if (p.Length >= 2)
                return $"{char.ToUpper(p[0][0])}{char.ToUpper(p[1][0])}";
        }

        if (email.Contains("@"))
            return email[0].ToString().ToUpper();

        return email[0].ToString().ToUpper();
    }

