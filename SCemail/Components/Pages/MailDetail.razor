    private void OnTextChanged(string value)
    {
        _newComment = value;
        if (string.IsNullOrWhiteSpace(_newComment))
        {
            _mentionOpen = false;
            _mentionSuggestions.Clear();
            return;
        }

        var last = _newComment.Split(' ', '\n', '\t').LastOrDefault() ?? "";

        if (last == "@")
        {
            _mentionSuggestions = _allUsers.Take(8).ToList();
            _mentionOpen = true;
            _mentionIndex = 0;
            return;
        }

        if (!last.StartsWith("@"))
        {
            _mentionOpen = false;
            _mentionSuggestions.Clear();
            return;
        }

        var query = last[1..].ToLowerInvariant();
        _mentionSuggestions = _allUsers
            .Where(u => u.Contains(query))
            .Take(8)
            .ToList();

        _mentionOpen = _mentionSuggestions.Any();
        _mentionIndex = 0;
    }

    private void HandleKeyNav(KeyboardEventArgs e)
    {
        if (!_mentionOpen || _mentionSuggestions.Count == 0) return;

        if (e.Key == "ArrowDown")
            _mentionIndex = (_mentionIndex + 1) % _mentionSuggestions.Count;
        else if (e.Key == "ArrowUp")
            _mentionIndex = (_mentionIndex - 1 + _mentionSuggestions.Count) % _mentionSuggestions.Count;
        else if (e.Key == "Enter")
            SelectMention(_mentionSuggestions[_mentionIndex]);
        else if (e.Key == "Escape")
            _mentionOpen = false;
    }
