    private static string ExtractEmailOnly(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
            return "";


        var match = Regex.Match(raw, "<([^>]+)>");
        if (match.Success)
            return match.Groups[1].Value;


        if (raw.Contains("@"))
            return raw.Trim();

        return raw;
    }
