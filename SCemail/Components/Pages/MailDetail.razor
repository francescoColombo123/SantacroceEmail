    private static string FormatNameEmailLikeGmail(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return "";
        var r = raw.Trim();

        var m = Regex.Match(r, "\"?(?<name>[^\"]+?)\"?\\s*<(?<mail>[^>]+)>");
        if (m.Success)
            return $"{Html(m.Groups["name"].Value.Trim())} &lt;{Html(m.Groups["mail"].Value.Trim())}&gt;";

        if (r.Contains("@") && !r.Contains("<")) return Html(r);
        return Html(r);
    }

    private static string FormatToLikeGmail(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return "";

        var r = raw.Trim();

        // già contiene < >
        if (r.Contains("<") && r.Contains(">"))
            return FormatNameEmailLikeGmail(r);

        // mail nuda -> <mail>
        if (r.Contains("@"))
            return $"<{r}>";

        return r;
    }
    private static string HtmlToText(string html)
    {
        if (string.IsNullOrWhiteSpace(html)) return "";
        // Decode first so encoded HTML comments/tags (e.g. &lt;!-- ... --&gt;) can be removed.
        var noTags = System.Net.WebUtility.HtmlDecode(html);

        noTags = Regex.Replace(noTags, "<!--.*?-->", "", RegexOptions.Singleline);
        noTags = Regex.Replace(noTags, "<style\\b[^>]*>.*?</style>", "", RegexOptions.IgnoreCase | RegexOptions.Singleline);
        noTags = Regex.Replace(noTags, "<script\\b[^>]*>.*?</script>", "", RegexOptions.IgnoreCase | RegexOptions.Singleline);

        noTags = Regex.Replace(noTags, "<br\\s*/?>", "\n", RegexOptions.IgnoreCase);
        noTags = Regex.Replace(noTags, "</p\\s*>", "\n\n", RegexOptions.IgnoreCase);
        noTags = Regex.Replace(noTags, "<.*?>", " ");
        return noTags;
    }

