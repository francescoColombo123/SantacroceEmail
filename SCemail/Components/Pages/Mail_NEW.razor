    private static string ToPlainText(string? html)
    {
        if (string.IsNullOrWhiteSpace(html)) return "";

        // rimuove tag HTML (semplice ma efficace per preview)
        var s = System.Text.RegularExpressions.Regex.Replace(html, "<.*?>", " ");
        s = WebUtility.HtmlDecode(s);
        s = System.Text.RegularExpressions.Regex.Replace(s, @"\s+", " ").Trim();
        return s;
    }

    private static string Truncate(string s, int max)
    {
        if (string.IsNullOrWhiteSpace(s)) return "";
        if (s.Length <= max) return s;
        return s.Substring(0, max).Trim() + "…";
    }

    private static string BuildTooltip(string? title, string? desc, int maxDesc)
    {
        title ??= "";
        desc ??= "";
        desc = Truncate(desc, maxDesc);

        if (string.IsNullOrWhiteSpace(desc))
            return title;

        // newline nel tooltip (MudTooltip lo supporta come testo)
        return $"{title}\n\n{desc}";
    }

    private async Task<IEnumerable<RecipientChip>> SearchRecipientsHybrid(string value, CancellationToken token)
    {
        var query = (value ?? "").Trim();
        if (string.IsNullOrEmpty(query))
            return _allRecipients.Take(10);

        var locali = _allRecipients
            .Where(c => c.Email.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                        (c.NameOrEmail?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false))
            .ToList();

        locali = locali
            .OrderByDescending(c => UsernamePattern.IsMatch(c.Email.Split('@')[0]))
            .ThenBy(c => c.Email)
            .Take(10)
            .ToList();

        if (locali.Count >= 5)
            return locali;

        var found = await MailSvc.SearchRecipientsAsync(_utente!, query, 10, token) ?? new List<string>();
        var nuovi = found
            .Select(ParseAddressToChip)
            .DistinctBy(c => c.Email, StringComparer.OrdinalIgnoreCase)
            .ToList();

        _allRecipients.AddRange(nuovi);
        _allRecipients = _allRecipients
            .GroupBy(c => c.Email, StringComparer.OrdinalIgnoreCase)
            .Select(g => g.First())
            .ToList();

        return locali.Concat(nuovi)
                     .DistinctBy(c => c.Email, StringComparer.OrdinalIgnoreCase)
                     .Take(10);
    }

    private async Task OnAddressInput(string value)
    {
        var q = (value ?? "").Trim();

        if (string.IsNullOrWhiteSpace(q) || q.Length < 2)
