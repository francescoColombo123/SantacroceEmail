        _ctsAddr?.Cancel();
        _ctsAddr = new CancellationTokenSource();

        try
        {


            var res = (await SearchRecipientsHybrid(q, _ctsAddr.Token)).ToList();
            _addrSuggestions = res;
            _showAddrSuggestions = res.Any();
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }
