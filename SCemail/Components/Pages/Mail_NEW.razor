    private string ExtractEmail(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
            return "";

        raw = raw.Trim();

        // 1️⃣ Se contiene <email>, estrai quella
        int start = raw.IndexOf('<');
        int end = raw.IndexOf('>');
        if (start >= 0 && end > start)
        {
            var inside = raw.Substring(start + 1, end - start - 1).Trim();
            if (IsValidEmail(inside))
                return inside;
        }

        // 2️⃣ Se la stringa contiene già un indirizzo email senza < >
        var match = Regex.Match(raw, @"[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}");
        if (match.Success)
            return match.Value.ToLower();

        // 3️⃣ fallback: restituisci tutto
        return raw;
    }

    private bool IsValidEmail(string email)
    {
        return Regex.IsMatch(email,
            @"^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$");
    }



