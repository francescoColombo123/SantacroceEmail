        catch (Exception ex)
        {
            Console.WriteLine($"❌ Errore in OpenEmailAndMarkRead: {ex.Message}");
            Snackbar.Add("Errore durante apertura email", Severity.Error);
        }
    }

    private async Task ModificaTitolo(long id, string titolo)
    {
        await postItService.UpdateTitleAsync(id, titolo);
    }

    private void ApriNuovoPostIt()
    {
        _isEditMode = false;
        _editingPostItId = null;
        _popupTitle = "";
        _popupText = "";
        _showPostItPopup = true;
    }
    

    private void ApriPostIt(PostItDto p)
    {
        _isEditMode = true;
        _editingPostItId = p.Id;
        _popupTitle = p.Titolo;
        _popupText = p.Testo;
        _showPostItPopup = true;
    }

    private async Task SalvaPostIt()
    {
        if (string.IsNullOrWhiteSpace(_popupText))
            return;

        if (_isEditMode && _editingPostItId.HasValue)
        {
            await postItService.UpdateTitleAsync(_editingPostItId.Value, _popupTitle);
            await postItService.UpdateAsync(_editingPostItId.Value, _popupText);
        }
        else
        {
            await postItService.AddAsync(_utente!, _popupTitle, _popupText);
        }

        _postIts = await postItService.GetByUtenteAsync(_utente!);
        ChiudiPopup();
    }

    private void ChiudiPopup()
    {
        _showPostItPopup = false;
        _editingPostItId = null;
    }

    private async Task NewEmail()
    {
        var parameters = new DialogParameters { ["Utente"] = _utente };
        var dialog = DialogService.Show<ComposeDialog>("Nuova email", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result.Data is true)
            Snackbar.Add("Email inviata ✅", Severity.Success);
    }

    private string GetAttachmentIcon(string? name)
    {
        var s = (name ?? "").ToLowerInvariant();
        if (s.EndsWith(".pdf")) return Icons.Material.Filled.PictureAsPdf;
        if (s.EndsWith(".jpg") || s.EndsWith(".png")) return Icons.Material.Filled.Image;
        if (s.EndsWith(".doc") || s.EndsWith(".docx")) return Icons.Material.Filled.Description;
        if (s.EndsWith(".xls") || s.EndsWith(".xlsx")) return Icons.Material.Filled.TableChart;
        return Icons.Material.Filled.AttachFile;
    }

    private string GetDownloadUrl(int id) => $"/api/attachments/{id}";
    private string GetInlineUrl(int id) => $"/api/attachments/{id}/inline";

    private void Reload() => Nav.NavigateTo(Nav.Uri, true);
    private void GoHome()
    {
        Nav.NavigateTo($"/?cp={Uri.EscapeDataString(_cp ?? "")}");
    }

    private void GoToTasks()
    {
        Nav.NavigateTo($"/tasks-new?cp={Uri.EscapeDataString(_cp ?? "")}");
    }

