        try
        {
            var (page, total) = await MailSvc.GetDraftsPagedAsync(
                utente: _utente!,
                start: _draftIndex,
                pageSize: _pageSize,
                searchText: filtro ?? _searchText
            );

            _draftTotal = total;

            if (_draftIndex == 0) _drafts = page;
            else _drafts.AddRange(page.Where(x => !_drafts.Any(d => d.Id == x.Id)));

            _draftIndex += _pageSize;
            _hasMoreDrafts = _drafts.Count < _draftTotal;
