        // per esempio:
        //_isAdmin = await AccessiSrv.IsAdminAsync(_utente);
        // oppure lascialo se lo gestisci altrove

        if (_folder == "admin" && _isAdmin)
        {
            Nav.NavigateTo($"/admin-dashboard?cp={_cp}", true);
            return;
        }

        if (!string.IsNullOrWhiteSpace(_utente))
        {
            _caselleIds = await AccessiSrv.GetCaselleAbilitateAsync(_utente);

            var unreadInbox = await MailSvc.CountUnreadAsync(_utente!);
            var unreadArchive = 0;
            var unreadAll = 0;

            _folders = new()
    {
        new FolderItem_NEW("inbox",     "Posta in arrivo", Icons.Material.Filled.Inbox,   1, unreadInbox),
        new FolderItem_NEW("sent",      "Inviate",         Icons.Material.Filled.Send,    2, 0),
        new FolderItem_NEW("myarchive", "Mio archivio",    Icons.Material.Filled.Archive, 2, unreadArchive),
        new FolderItem_NEW("all",       "Tutti i messaggi", Icons.Material.Filled.AllInbox, 3, unreadAll),
        new FolderItem_NEW("drafts",    "Bozze",           Icons.Material.Filled.Drafts, 4, _draftsUnreadCount)
    };

            _adminCaselleIds.Clear();
            _unassignedCount = 0;

            using (var db = DbFactory.CreateDbContext())
            {
                _adminCaselleIds = await db.Database
                    .SqlQuery<int>($@"
                SELECT DISTINCT CASELLA_ID
                FROM SGAPP.CASELLA_ABILITAZIONI
                WHERE USERNAME = {_utente}
                  AND NVL(IS_ADMIN,0) = 1
            ")
                    .ToListAsync();
            }

            if (_adminCaselleIds.Count > 0 && _caselleIds?.Any() == true)
                _adminCaselleIds = _adminCaselleIds.Intersect(_caselleIds).ToList();

            if (_adminCaselleIds.Count > 0)
                _unassignedCount = await MailSvc.CountUnassignedForAdminAsync(_adminCaselleIds);

            // ✅ carico SOLO la cartella giusta
