    private async Task OpenEmailAndMarkRead(EmailListItem_NEW item, string? fromSection)
    {
        try
        {
            // UI: marca letta
            if (_folder == "mailfollowed")
            {
                if (item.LettoSeguita != "Y")
                {
                    var updated = item with { LettoSeguita = "Y", LettoSeguitaIl = DateTime.Now };
                    var idx = _emails.FindIndex(e => e.Id == item.Id);
                    if (idx >= 0) _emails[idx] = updated;
                    StateHasChanged();
                }
            }
            else
            {
                if (item.Aperto != "Y")
                {
                    var updated = item with { Aperto = "Y" };
                    var idx = _emails.FindIndex(e => e.Id == item.Id);
                    if (idx >= 0) _emails[idx] = updated;
                    StateHasChanged();
                }
            }

            // DB: fire-and-forget
            _ = SafeForget(async () =>
            {
                if (_folder == "mailfollowed")
                {
                    await MailSvc.MarkEmailSeguitaAsReadAsync(item.Id, _utente!);
                }

                await MailSvc.SegnaLettaAsync(item.Id, item.AssegnatoA);
                await MailSvc.MarkOpenedAsync(item.Id);
                await MailSvc.SegnaNotificheVisteAsync(item.Id, _utente!);
            });

            var query = new Dictionary<string, string?>
            {
                ["fromFolder"] = _folder,
                ["fromSection"] = fromSection
            };

            // PASSA GLI IDS PER TUTTE LE LISTE NORMALI
            // NON passarli solo se stai aprendo da una sezione
            if (string.IsNullOrWhiteSpace(fromSection))
            {
                var idsCorrenti = _emails
                    .Select(x => x.Id)
                    .Distinct()
                    .ToList();

                if (idsCorrenti.Count > 0)
                {
                    query["ids"] = string.Join(",", idsCorrenti);
                }
            }

            var url = QueryHelpers.AddQueryString(
                $"/mail-detail/{item.Id}/{_cp}",
                query);

            Nav.NavigateTo(url);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Errore in OpenEmailAndMarkRead: {ex.Message}");
            Snackbar.Add("Errore durante apertura email", Severity.Error);
        }
    }

    private static async Task SafeForget(Func<Task> work)
    {
        try { await work(); }
        catch (Exception ex) { Console.WriteLine("❌ BG error: " + ex); }
    }

