                    <MudTextField T="string"
                                  @ref="_postItTextRef"
                                  Lines="4"
                                  Placeholder="Scrivi il post-it…"
                                  Variant="Variant.Outlined"
                                  Dense="true"
                                  Value="@_popupText"
                                  ValueChanged="v => _popupText = v"
                                  OnKeyDown="HandlePostItTextKeyDown" />
                </div>

                <div class="composer-actions">
                    <MudButton Variant="Variant.Text"
                               OnClick="ChiudiPopup">
                        Annulla
                    </MudButton>

                    <MudButton @ref="_postItSaveRef"
                               Color="Color.Primary"
                               Variant="Variant.Filled"
                               Disabled="@string.IsNullOrWhiteSpace(_popupText)"
                               OnClick="SalvaPostIt">
                        Salva
                    </MudButton>
                </div>

            </div>
        }

        <aside class="tasks-panel">
            <div class="tasks-header">
                <div class="th-title">Attività</div>

                <div class="th-actions">
                    <MudIconButton Icon="@Icons.Material.Filled.Add"
                                   Size="Size.Small"
                                   Color="Color.Primary"
                                   Title="Crea task per me"
                                   OnClick="@OpenCreateMyTaskDialog" />

                    <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                   Size="Size.Small"
                                   Title="Ricarica"
                                   OnClick="@ReloadMyTasks" />
                </div>
            </div>

            @if (_loadingTasks)
            {
                <div class="tasks-empty">Caricamento…</div>
            }
            else
            {
                var items = MyTodosSorted().Take(30).ToList();

                if (items.Count == 0)
                {
                    <div class="tasks-empty">Nessuna attività</div>
                }
                else
                {
                    <div class="tasks-list">
                        @foreach (var t in items)
                        {
                            var descPlain = ToPlainText(t.DescrizioneMarkdown);
                            var descPreview = Truncate(descPlain, 90);

                            <div class="task-mini" @key="t.Id">
                                <div class="task-mini-left">
                                    <MudIconButton Icon="@Icons.Material.Filled.RadioButtonUnchecked"
                                                   Size="Size.Small"
                                                   Title="Chiudi / Fatto"
                                                   OnClick="@(() => CloseFromPanel(t))" />
                                </div>

                                <MudTooltip Placement="Placement.Right" Delay="250">
                                    <ChildContent>
                                        <div class="task-mini-body" @onclick="@(() => GoToTask(t.Id))">
                                            <div class="task-mini-title">@t.Titolo</div>

                                            @if (!string.IsNullOrWhiteSpace(descPlain))
                                            {
                                                <div class="task-mini-desc">@descPreview</div>
                                            }

                                            <div class="task-mini-meta">
                                                @if (t.DataScadenza is not null)
                                                {
                                                    <span class="due">Scad: @t.DataScadenza.Value.ToString("dd/MM HH:mm")</span>
                                                }
                                                else
                                                {
                                                    <span class="nodue">Senza scadenza</span>
                                                }

                                                @if (IsMeCreator(t))
                                                {
                                                    <span> • (mio)</span>
                                                }
                                                else
                                                {
                                                    <span> • (assegnato)</span>
                                                }
                                            </div>
                                        </div>
                                    </ChildContent>

                                    <TooltipContent>
                                        <div class="tt-title">@t.Titolo</div>
                                        @if (!string.IsNullOrWhiteSpace(descPlain))
                                        {
                                            <div class="tt-body">@descPlain</div>
                                        }
                                    </TooltipContent>
                                </MudTooltip>
                            </div>
                        }
                    </div>

                }
            }
        </aside>

        @if (_showAttachmentViewer)
        {
            <AttachmentViewerOverlay Id="@_attachmentViewerId"
                                     Src="@_attachmentViewerSrc"
                                     Ids="@_attachmentViewerIds"
                                     OnClose="@CloseAttachmentViewer" />
        }
    </div>

}
