@code {
    private string _folder = "inbox";
    private string? _cp, _utente;
    private bool _isLoading = true, _loadingList, _loadingDetail, _sidebarOpen = true;
    private List<FolderItem_NEW> _folders = new();
    private List<EmailListItem_NEW> _emails = new();
    private List<EmailDetail_NEW> _thread = new();
    private int _pageSize = 20;  // carica 20 email per volta
    private int _currentIndex = 0;
    private bool _hasMore = true;
    private int? _selectedId;
    private List<MailService_NEW.CommentoEmail> _comments = new();
    private string? _newCommentText;
    private List<string> _mentionSuggestions = new();
    private List<string> _allUsers = new();
    private List<AdminEmailDto> _emailInLavorazione = new();
    private bool _isAdmin;
    private int _mentionsCount = 0;

    private List<AdminEmailDto> _emailConcluse = new();
    private List<AdminEmailDto> _emailInLavorazioneFiltrate = new();
    private List<AdminEmailDto> _emailConcluseFiltrate = new();
    private bool _loadingDashboard = false;
    private string Title => _folder switch
    {
        "inbox" => "Posta in arrivo (assegnate a me)",
        "myarchive" => "Mio archivio",
        "all" => "Tutti i messaggi",
        "drafts" => "Bozze",
        _ => "Posta"
    };
    private string? _searchText;
    private List<int>? _caselleIds;
    private string? _filtroUtente = "";
    private DateRange _filtroDate = new();
    private List<string> utenti = new();

    private string? _filtroStato = "";
    private List<string> utentiFiltrati = new();

    private List<string> _chartLabels = new();
    private List<double[]> _chartData = new();

    // modal
    private bool _dialogOpen = false;
    private string _dialogTitle = "";
    private List<AdminEmailDto> _dialogList = new();
    private List<PostItDto> _postIts = new();
    private bool _showNewPostIt = false;
    private string _newTitle = "";
    private string _newText = "";
    private bool _showPostItPopup = false;
    private bool _isEditMode = false;

    private long? _editingPostItId = null;
    private string _popupTitle = "";
    private string _popupText = "";
    private List<DraftListItem> _drafts = new();
    private bool _loadingDrafts = false;
    private int _draftIndex = 0;
    private bool _hasMoreDrafts = true;
    private int _draftTotal = 0;

    private void ApplicaFiltri()
    {
        IEnumerable<AdminEmailDto> aperte = _emailInLavorazione;
        IEnumerable<AdminEmailDto> chiuse = _emailConcluse;

        // --------------------------
        // FILTRO UTENTE
        // --------------------------
        if (!string.IsNullOrWhiteSpace(_filtroUtente))
        {
            aperte = aperte.Where(x => x.AssegnatoA == _filtroUtente);
            chiuse = chiuse.Where(x => x.AssegnatoA == _filtroUtente);
        }

        // --------------------------
        // FILTRO STATO
        // --------------------------
        if (_filtroStato == "open")
            chiuse = Enumerable.Empty<AdminEmailDto>();
        else if (_filtroStato == "closed")
            aperte = Enumerable.Empty<AdminEmailDto>();

        // --------------------------
        // FILTRO DATE
        // --------------------------
        if (_filtroDate?.Start != null && _filtroDate?.End != null)
        {
            var da = _filtroDate.Start.Value.Date;
            var a = _filtroDate.End.Value.Date.AddDays(1).AddTicks(-1);

            aperte = aperte.Where(x => x.Data >= da && x.Data <= a);
            chiuse = chiuse.Where(x => x.Data >= da && x.Data <= a);
        }

        // --------------------------
        // AGGIORNA LISTE FILTRATE
        // --------------------------
        _emailInLavorazioneFiltrate = aperte.ToList();
        _emailConcluseFiltrate = chiuse.ToList();

        // --------------------------
        // AGGIORNA NOMI UTENTI DA MOSTRARE
        // --------------------------
        utentiFiltrati = aperte
            .Concat(chiuse)
            .Select(x => x.AssegnatoA)
            .Distinct()
            .OrderBy(x => x)
            .ToList();

        StateHasChanged();
    }

    private void ResetFiltri()
    {
        _filtroUtente = "";
        _filtroStato = "";
        _filtroDate = new DateRange();

        _emailInLavorazioneFiltrate = _emailInLavorazione;
        _emailConcluseFiltrate = _emailConcluse;

        utentiFiltrati = utenti;

        StateHasChanged();
    }


    private string BuildRecipientsTooltip(EmailListItem_NEW item)
    {
        var main = ExtractEmail(item.CasellaEmail);

        var to = ParseAddressList(item.Destinatari)
            .Select(ExtractEmail)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        var cc = ParseAddressList(item.Cc)
            .Select(ExtractEmail)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        var ccn = ParseAddressList(item.Ccn)
            .Select(ExtractEmail)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        // assicurati che la nostra casella compaia in A:
        if (!string.IsNullOrWhiteSpace(main) &&
            !to.Any(x => string.Equals(x, main, StringComparison.OrdinalIgnoreCase)))
            to.Insert(0, main);

        string fmt(string label, List<string> xs)
            => xs.Count == 0 ? "" : $"{label} {string.Join(", ", xs)}";

        var lines = new List<string>();
        var aLine = fmt("A:", to);
        var ccLine = fmt("CC:", cc);
        var ccnLine = fmt("CCN:", ccn);

        if (!string.IsNullOrWhiteSpace(aLine)) lines.Add(aLine);
        if (!string.IsNullOrWhiteSpace(ccLine)) lines.Add(ccLine);
        if (!string.IsNullOrWhiteSpace(ccnLine)) lines.Add(ccnLine);

        return lines.Count == 0 ? $"A: {main}" : string.Join("\n", lines);
    }

    private static string StripHtml(string? html)
    {
        if (string.IsNullOrWhiteSpace(html)) return "";
        return Regex.Replace(html, "<.*?>", " ").Trim();
    }
    private async Task OpenDraft(long draftId)
    {
        var d = await MailSvc.GetDraftByIdAsync(draftId, _utente!);
        if (d == null)
        {
            Snackbar.Add("Bozza non trovata", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            ["Utente"] = _utente,
            ["Destinatari"] = d.Destinatari,
            ["Cc"] = d.Cc,
            ["Bcc"] = d.Ccn,
            ["Oggetto"] = d.Oggetto,
            ["CorpoIniziale"] = d.CorpoHtml,
            ["DraftId"] = (long)d.Id
        };


        var dialog = DialogService.Show<ComposeDialog>(
            "Modifica bozza",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true }
        );

        var result = await dialog.Result;

        // opzionale: se inviata, puoi eliminare la bozza
        if (result.Data is true)
        {
            try
            {
                await MailSvc.DeleteDraftAsync(d.Id, _utente!);
                _draftIndex = 0;
                _drafts.Clear();
                _hasMoreDrafts = true;
                await LoadMoreDrafts(_searchText);
            }
            catch { /* non bloccare */ }
        }
    }
    private async Task DeleteDraft(long id)
    {
        await MailSvc.DeleteDraftAsync(id, _utente!);
        _drafts.RemoveAll(x => x.Id == id);
        Snackbar.Add("Bozza eliminata", Severity.Success);
    }


    // --- DESTINATARI (solo UI) ---
    // NOTA: qui assumo che EmailListItem_NEW possa avere stringhe tipo Destinatari / Cc / Ccn.
    // Se nel tuo DTO hanno nomi diversi, dimmelo e li riallineo in 2 minuti.
    // Intanto: se sono null/non esistono, gestiamo tutto "safe".


    private int GetRecipientsExtraCount(EmailListItem_NEW item)
    {
        var main = ExtractEmail(item.CasellaEmail);

        var all = ParseAddressList(item.Destinatari)
            .Concat(ParseAddressList(item.Cc))
            .Concat(ParseAddressList(item.Ccn))
            .Select(ExtractEmail)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        // non contare la casella principale come “extra”
        all.RemoveAll(x => string.Equals(x, main, StringComparison.OrdinalIgnoreCase));

        return all.Count;
    }

    /// <summary>
    /// Parsing robusto per stringhe stile MimeKit:
    /// `"Nome" <a@b.it>, "Cognome, Nome" <c@d.it>`
    /// </summary>
    private List<string> ParseAddressList(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
            return new();

        try
        {
            // MimeKit gestisce virgole, quote, display-name, ecc.
            var list = InternetAddressList.Parse(raw);

            return list
                .Mailboxes
                .Select(m => !string.IsNullOrWhiteSpace(m.Address)
                    ? m.Address
                    : m.ToString())
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .ToList();
        }
        catch
        {
            // fallback “safe” se arriva roba sporca
            return raw.Split(';', '\n')
                      .Select(x => x.Trim())
                      .Where(x => x.Length > 0)
                      .ToList();
        }
    }


    private List<string> SplitEmails(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return new();
        return raw.Split(';', ',', '\n')
                  .Select(x => x.Trim())
                  .Where(x => x.Length > 0)
                  .ToList();
    }

