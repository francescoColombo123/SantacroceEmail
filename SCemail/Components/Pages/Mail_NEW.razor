    private string MeNorm => (_utente ?? "").Trim().ToLowerInvariant();

    private bool IsMeCreator(TaskDto t)
        => string.Equals(t.CreatoDa?.Trim(), MeNorm, StringComparison.OrdinalIgnoreCase);

    private bool IsMeAssignee(TaskDto t)
        => t.AssegnatiA?.Any(a => string.Equals(a?.Trim(), MeNorm, StringComparison.OrdinalIgnoreCase)) == true;

    private bool IsOpen(TaskDto t)
        => !string.Equals(t.Stato, TaskStati.Chiuso, StringComparison.OrdinalIgnoreCase);

    private IEnumerable<TaskDto> MyTodosSorted()
    {
        if (string.IsNullOrWhiteSpace(_utente)) return Enumerable.Empty<TaskDto>();

        var q = _myTasks.Where(t => (IsMeAssignee(t) || IsMeCreator(t)) && IsOpen(t));

        q = q.OrderBy(t => t.DataScadenza.HasValue ? 0 : 1)
             .ThenBy(t => t.DataScadenza ?? DateTime.MaxValue)
             .ThenByDescending(t => t.DataCreazione);

        return q;
    }

    private async Task ReloadMyTasks()
    {
        if (string.IsNullOrWhiteSpace(_utente)) return;

        _loadingTasks = true;
        StateHasChanged();
        try
        {
            // ✅ NON MeNorm qui
            _myTasks = await TaskClient.GetForUserAsync(_utente!) ?? new();
        }
        finally
        {
            _loadingTasks = false;
            StateHasChanged();
        }
    }


    private async Task OpenCreateMyTaskDialog()
    {
        if (string.IsNullOrWhiteSpace(_utente)) return;

        var dlg = DialogService.Show<CreateMyTaskDialog>(
            "Nuovo task",
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true }
        );

        var res = await dlg.Result;
        if (res.Canceled || res.Data is not CreateMyTaskDialog.Result r) return;

        // ✅ creato da me, assegnato a me (auto-task)
        var req = new CreateTaskRequest(
              CreatoDa: _utente!,                 // ✅ non MeNorm
              Titolo: r.Titolo,
              DescrizioneMarkdown: r.DescrizioneHtml ?? "",
              DataScadenza: r.Scadenza,
              AssegnatiA: new List<string> { _utente! }, // ✅ non MeNorm
              EmailId: null
          );

        await TaskClient.CreateAsync(req);

        await ReloadMyTasks();
    }

    private async Task CloseFromPanel(TaskDto t)
    {
        if (string.IsNullOrWhiteSpace(_utente)) return;

        var me = _utente!;
        var creator = t.CreatoDa?.Trim();

        if (IsMeCreator(t))
        {
            // ✅ chiusura diretta
            await TaskClient.CloseAsync(t.Id, new CloseTaskRequest(Utente: me, Commento: null));

            await ReloadMyTasks();
            return;
        }

        // ✅ non sono creatore: metto "Fatto" + mention creatore
        var text = string.IsNullOrWhiteSpace(creator)
            ? "Fatto"
            : $"Fatto @{creator}";

        await TaskClient.AddCommentAsync(t.Id, me, text);
        await ReloadMyTasks();
    }
