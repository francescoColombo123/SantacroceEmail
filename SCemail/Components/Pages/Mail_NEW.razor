    private bool _loadingEmails = false;


    public async Task LoadMoreEmails(List<int>? casellaIds = null, string? filtro = null)
    {
        if (_loadingEmails)
            return;

        _loadingEmails = true;
        _loadingList = true;
        StateHasChanged();

        try
        {
            if (string.IsNullOrWhiteSpace(_utente))
                return;

            casellaIds ??= _caselleIds ?? await AccessiSrv.GetCaselleAbilitateAsync(_utente);
            casellaIds = casellaIds.Distinct().ToList();

            string? filtroEffettivo = (filtro ?? _searchWord ?? _searchText)?.Trim();

            // 🔔 MENTIONS
            if (_folder == "mentions")
            {
                var (page, total) = await MailSvc.GetMentionedEmailsPagedSafeAsync(
                    _utente!,
                    _currentIndex,
                    _pageSize
                );

                page = await ApplyThreadCountsToPageAsync(page);

                if (_currentIndex == 0)
                    _emails = page;
                else
                    _emails.AddRange(page.Where(x => !_emails.Any(e => e.Id == x.Id)));

                _currentIndex += page.Count;
                _hasMore = page.Count == _pageSize;

                _mentionsCount = _emails.Count(x => x.Aperto == "N");
                return;
            }

            // 👀 MAIL SEGUITE
            if (_folder == "mailfollowed")
            {
                var (pageFollowed, totalFollowed) = await MailSvc.GetFollowedEmailsPagedAsync(
                    utente: _utente!,
                    start: _currentIndex,
                    pageSize: _pageSize,
                    word: filtroEffettivo,
                    address: _selectedAddressChip?.Email
                );

                pageFollowed = await ApplyThreadCountsToPageAsync(pageFollowed);

                if (_currentIndex == 0)
                    _emails = pageFollowed;
                else
                    _emails.AddRange(pageFollowed.Where(x => !_emails.Any(e => e.Id == x.Id)));

                _currentIndex += pageFollowed.Count;
                _hasMore = _emails.Count < totalFollowed;

                return;
            }



            // 📭 NON ASSEGNATE

            if (_folder == "unassigned")
            {
                var wordUnassigned = filtroEffettivo;
                var addrUnassigned = _selectedAddressChip?.Email;

                var (pageUnassigned, totalUnassigned) = await MailSvc.GetUnassignedForAdminPagedAsync(
                    utente: _utente!,
                    start: _currentIndex,
                    pageSize: _pageSize,
                    word: wordUnassigned,
                    address: addrUnassigned
                );

                pageUnassigned = await ApplyThreadCountsToPageAsync(pageUnassigned);

                if (_currentIndex == 0)
                    _emails = pageUnassigned;
                else
                    _emails.AddRange(pageUnassigned.Where(x => !_emails.Any(e => e.Id == x.Id)));

                _currentIndex += pageUnassigned.Count;
                _hasMore = _emails.Count < totalUnassigned;

                _unassignedCount = totalUnassigned;
                return;
            }

            // 📝 BOZZE
            if (_folder == "drafts")
            {
                await LoadMoreDrafts(filtroEffettivo);
                return;
            }

            var word = filtroEffettivo;
            var addr = _selectedAddressChip?.Email;

            // 🔎 RICERCA AVANZATA
            // 🔎 RICERCA AVANZATA
            if ((!string.IsNullOrWhiteSpace(word) && word.Length >= 2) || !string.IsNullOrWhiteSpace(addr))
            {
                var useFastBodySearch = !string.IsNullOrWhiteSpace(word) && word.Length >= 2;

                if (useFastBodySearch)
                {
                    var fastPage = await MailSvc.SearchEmailsAdvancedFastAsync(
                        casellaIds: casellaIds,
                        start: _currentIndex,
                        pageSize: _pageSize,
                        word: word,
                        address: addr,
                        folderUi: _folder,
                        utente: _utente
                    );

                    var visiblePage = fastPage.Take(_pageSize).ToList();
                    visiblePage = await ApplyThreadCountsToPageAsync(visiblePage);

                    var hasMore = fastPage.Count > _pageSize;

                    if (_currentIndex == 0)
                        _emails = visiblePage;
                    else
                        _emails.AddRange(visiblePage.Where(x => !_emails.Any(e => e.Id == x.Id)));

                    _currentIndex += visiblePage.Count;
                    _hasMore = hasMore;

                    return;
                }

                var (page, total) = await MailSvc.SearchEmailsAdvancedAsync(
      casellaIds: casellaIds,
      start: _currentIndex,
      pageSize: _pageSize,
      word: word,
      address: addr,
      folderUi: _folder,
      utente: _utente
  );

                page = await ApplyThreadCountsToPageAsync(page);

                if (_currentIndex == 0)
                    _emails = page;
                else
                    _emails.AddRange(page.Where(x => !_emails.Any(e => e.Id == x.Id)));

                _currentIndex += page.Count;

                if (_folder == "all")
                    _hasMore = page.Count == _pageSize;
                else
                    _hasMore = _emails.Count < total;

                return;
            }
            // 📬 CARICAMENTO NORMALE
            var (normalPage, totalCount) = await MailSvc.GetEmailPageAsync(
    casellaIds,
    _currentIndex,
    _pageSize,
    folderUi: _folder,
    utente: _utente!,
    filtro: null
);

            normalPage = await ApplyThreadCountsToPageAsync(normalPage);

            if (_currentIndex == 0)
                _emails = normalPage;
            else
                _emails.AddRange(normalPage.Where(x => !_emails.Any(e => e.Id == x.Id)));

            _currentIndex += normalPage.Count;

            if (_folder == "all")
                _hasMore = normalPage.Count == _pageSize;
            else
                _hasMore = _emails.Count < totalCount;
        }
        finally
        {
            _loadingEmails = false;
            _loadingList = false;
            StateHasChanged();
        }
    }

