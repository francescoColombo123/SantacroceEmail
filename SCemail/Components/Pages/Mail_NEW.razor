    private bool _loadingEmails = false;

    public async Task LoadMoreEmails(List<int>? casellaIds = null, string? filtro = null)
    {
        if (_loadingEmails)
            return;

        _loadingEmails = true;
        _loadingList = true;
        StateHasChanged();

        try
        {
            if (string.IsNullOrWhiteSpace(_utente))
                return;

            casellaIds ??= _caselleIds ?? await AccessiSrv.GetCaselleAbilitateAsync(_utente);
            string? filtroEffettivo = filtro ?? _searchText?.Trim();

            // 🔔 MENTIONS (intoccato)
            if (_folder == "mentions")
            {
                var (page, total) =
                    await MailSvc.GetMentionedEmailsPagedSafeAsync(
                        _utente!,
                        _currentIndex,
                        _pageSize
                    );

                if (_currentIndex == 0)
                    _emails = page;
                else
                    _emails.AddRange(page.Where(x => !_emails.Any(e => e.Id == x.Id)));

                _currentIndex += _pageSize;
                _hasMore = _emails.Count < total;

                _mentionsCount = _emails.Count(x => x.Aperto == "N");
                return;
            }
            if (_folder == "drafts")
            {
                await LoadMoreDrafts(filtroEffettivo);
                return;
            }

            // 🔍 RICERCA VELOCE (MITTENTE + OGGETTO)
            if (!string.IsNullOrWhiteSpace(filtroEffettivo) && filtroEffettivo.Length >= 2)
            {
                var (page, total) = await MailSvc.SearchEmailsAsync(
                    casellaIds: casellaIds,
                    start: _currentIndex,
                    pageSize: _pageSize,
                    searchText: filtroEffettivo
                );

                if (_currentIndex == 0)
                    _emails = page;
                else
                    _emails.AddRange(page.Where(x => !_emails.Any(e => e.Id == x.Id)));

                _currentIndex += _pageSize;
                _hasMore = _emails.Count < total;
                return;
            }

            // 📥 CARICAMENTO NORMALE
            var (normalPage, totalCount) = await MailSvc.GetEmailPageAsync(
                casellaIds,
                _currentIndex,
                _pageSize,
                folderUi: _folder,
                utente: _utente!,
                filtro: null
            );

            if (_currentIndex == 0)
                _emails = normalPage;
            else
                _emails.AddRange(normalPage.Where(x => !_emails.Any(e => e.Id == x.Id)));

            _currentIndex += _pageSize;
            _hasMore = _emails.Count < totalCount;
        }
        finally
        {
            _loadingEmails = false;
            _loadingList = false;
            StateHasChanged();
        }
    }
