@page "/mail-new"
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using Oracle.ManagedDataAccess.Client
@using SCemail.Components.Data
@using MudBlazor
@using System.Text.RegularExpressions
@using static SCemail.Components.Data.MailService_NEW
@inject NavigationManager Nav
@inject MailService_NEW MailSvc
@inject SCemail.Components.Data.AccessiService AccessiSrv
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject SCemail.Components.Shared.IEmailTasksClient TaskClient
@inject IDbContextFactory<MailDbContext> DbFactory
@if (_isLoading)
{
    <div class="loading-screen">
        <div class="dots-loader">
            <span class="dot"></span><span class="dot"></span><span class="dot"></span>
        </div>
        <div class="loading-text">Caricamento email in corso…</div>
    </div>
}
else
{
    <div class="workspace">
        <!-- ===== SIDEBAR ===== -->
        <aside class="sidebar @( _sidebarOpen ? "open" : "closed")"
               @onmouseenter="() => _sidebarOpen = true"
               @onmouseleave="() => _sidebarOpen = false">
            <div class="sidebar-inner">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Edit"
                           OnClick="NewEmail"
                           Class="sidebar-btn">
                    @if (_sidebarOpen)
                    {
                        <span>Nuova email</span>
                    }
                </MudButton>

                <ul class="folder-list">

                    @* Se admin → aggiunge la cartella Amministrazione *@
                    @if (_isAdmin)
                    {
                        <li @onclick="@(() => ChangeFolder("admin"))"
                            class="@IsActive("admin")">
                            <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" />
                            @if (_sidebarOpen)
                            {
                                <span class="label">Amministrazione</span>
                            }
                        </li>
                    }

                    @* Cartelle normali *@
                    @foreach (var f in _folders)
                    {
                        <li @onclick="@(() => ChangeFolder(f.UiName))"
                            class="@IsActive(f.UiName)">
                            <MudIcon Icon="@f.IconClass" />

                            @if (_sidebarOpen)
                            {
                                <span class="label">@f.Label</span>
                                @* <span class="bubble">@f.Count</span> *@
                            }
                        </li>
                    }
                    <li @onclick="@(() => ChangeFolder("mentions"))"
                        class="@IsActive("mentions")">

                        <MudIcon Icon="@Icons.Material.Filled.Campaign" />

                        @if (_sidebarOpen)
                        {
                            <span class="label">Menzioni</span>

                            @if (_mentionsCount > 0)
                            {
                                <span class="bubble">@_mentionsCount</span>
                            }
                        }
                    </li>



                </ul>

            </div>
        </aside>

        <!-- ===== MAIN ===== -->
        <main class="mail-container">
            @if (_folder != "admin")
            {
                <div class="mail-header-top">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Home"
                               OnClick="@GoHome">
                        Home
                    </MudButton>

                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.TaskAlt"
                               OnClick="@GoToTasks">
                        Vai ai Task
                    </MudButton>
                </div>
            }
            @if (_folder == "admin" && _isAdmin)
            {
        <MudPaper Class="redirect-admin">
            <MudText Typo="Typo.h6">Reindirizzamento alla dashboard amministrativa…</MudText>
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        </MudPaper>
    }

    else
    {
            <section class="mail-grid @( _selectedId != null ? "detail-view" : "full-list")">

        @* ============================
           LISTA NORMALE
           ============================ *@
        <div class="mail-list">
            <div class="list-header">
                <div class="title">
                    <MudIcon Icon="@Icons.Material.Filled.Mail" />
                    <span>@Title</span>
                </div>

                <MudTextField T="string"
                              Value="_searchText"
                              ValueChanged="async v => await OnSearchChanged(v)"
                              Placeholder="Cerca..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              DebounceInterval="400"
                              Immediate="true"
                              Class="search-box" />

                <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                               OnClick="Reload"
                               Color="Color.Primary" />
            </div>

            <div id="mailScroll" class="list-scroll" @ref="_scrollDiv">
                <ul class="mail-ul">
                    @foreach (var item in _emails)
                    {
                        <li @key="item.Id"
                            class="mail-row @(item.Aperto == "Y" ? "read" : "unread")"
                            @onclick="@(() => OpenEmailAndMarkRead(item))">

                            <div class="status-strip"></div>

                            <div class="left">
                                <MudTooltip Text="@item.Mittente">
                                    <div class="from">@ExtractEmail(item.Mittente)</div>
                                </MudTooltip>

                                <div class="subject">@item.Oggetto</div>
                                <div class="preview">@item.Preview</div>
                                <div class="casella">@item.CasellaEmail</div>
                            </div>

                            <div class="right">
                                @{
                                    var assList = GetAssignedList(item.AssegnatoA).Distinct().ToList();
                                    var shortList = assList.Take(2).ToList();
                                    var extra = assList.Count - shortList.Count;
                                }

                                <MudTooltip Text="@string.Join("\n", assList)">
                                    <div class="assigned">
                                        @foreach (var a in shortList)
                                        {
                                            <span class="chip">@a</span>
                                        }
                                        @if (extra > 0)
                                        {
                                            <span class="chip more">+@extra</span>
                                        }
                                    </div>
                                </MudTooltip>

                                @if (item.Allegati?.Any() == true)
                                {
                                    <div class="attach">
                                        @foreach (var icon in GetAttachmentGroupIcons(item))
                                        {
                                            var files = item.Allegati
                                            .Where(a => MatchesIcon(a.NomeFile, icon))
                                            .Select(a => a.NomeFile)
                                            .ToList();

                                            <MudTooltip Text="@string.Join("\n", files)">
                                                <MudIcon Icon="@icon" Class="att-icon" />
                                            </MudTooltip>
                                        }
                                    </div>
                                }

                                <div class="date">@item.Data?.ToString("dd/MM/yyyy HH:mm")</div>

                                <div class="actions" style="display:flex; gap:6px; margin-top:4px;">
                                    <MudIconButton Icon="@Icons.Material.Filled.ForwardToInbox"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   OnClick="@(() => Forward(item))"
                                                   OnClick:stopPropagation="true"
                                                   Title="Inoltra" />

                                    @if (_folder == "inbox")
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Archive"
                                                       Color="Color.Success"
                                                       Size="Size.Small"
                                                       OnClick="@(() => Archive(item))"
                                                       OnClick:stopPropagation="true"
                                                       Title="Archivia" />
                                    }
                                </div>
                            </div>
                        </li>
                    }
                </ul>

                @if (_loadingList)
                {
                    <div class="load-more">
                        <div class="dots-loader small">
                            <span class="dot"></span><span class="dot"></span><span class="dot"></span>
                        </div>
                        <span class="load-text">Carico…</span>
                    </div>
                }
            </div>
        </div>

        @* ============================
           DETTAGLIO EMAIL
           ============================ *@
        <div class="mail-detail">
            @if (_loadingDetail)
            {
                <div class="detail-loader">
                    <div class="dots-loader small">
                        <span class="dot"></span><span class="dot"></span><span class="dot"></span>
                    </div>
                    <span class="load-text">Carico email…</span>
                </div>
            }
            else if (_thread?.Any() == true)
            {
                var msg = _thread.Last();

                <div class="detail-header">
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                                   Color="Color.Primary"
                                   OnClick="@BackToList"
                                   Title="Torna alla lista" />
                    <div class="head-titles">
                        <div class="head-subject">@msg.Oggetto</div>
                        <div class="head-meta">@msg.Mittente • @msg.Data?.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                </div>

                <div class="mail-actions" style="margin: 10px 16px; display:flex; gap:10px;">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Reply"
                               OnClick="@(() => Reply(msg))">
                        Rispondi
                    </MudButton>

                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.ReplyAll"
                               OnClick="@(() => ReplyAll(msg))">
                        Rispondi a tutti
                    </MudButton>
                </div>

                <div class="mail-body">
                    @((MarkupString)(msg.CorpoHtml ?? msg.CorpoTesto ?? ""))

                    @if (msg.Allegati?.Any() == true)
                    {
                        <div class="attachments-grid">
                            @foreach (var a in msg.Allegati)
                            {
                                <a class="attach-chip" href="@GetDownloadUrl(a.Id)" target="_blank">
                                    <MudIcon Icon="@GetAttachmentIcon(a.NomeFile)" />
                                    <span>@a.NomeFile</span>
                                </a>
                            }
                        </div>
                    }
                </div>
            }
        </div>
                </section>

    }


           
        </main>
    </div>
    }
}

@code {
    private string _folder = "inbox";
    private string? _cp, _utente;
    private bool _isLoading = true, _loadingList, _loadingDetail, _sidebarOpen = true;
    private List<FolderItem_NEW> _folders = new();
    private List<EmailListItem_NEW> _emails = new();
    private List<EmailDetail_NEW> _thread = new();
    private int _pageSize = 20;  // carica 20 email per volta
    private int _currentIndex = 0;
    private bool _hasMore = true;
    private int? _selectedId;
    private List<MailService_NEW.CommentoEmail> _comments = new();
    private string? _newCommentText;
    private List<string> _mentionSuggestions = new();
    private List<string> _allUsers = new();
    private List<AdminEmailDto> _emailInLavorazione = new();
    private bool _isAdmin;
    private int _mentionsCount = 0;

    private List<AdminEmailDto> _emailConcluse = new();
    private List<AdminEmailDto> _emailInLavorazioneFiltrate = new();
    private List<AdminEmailDto> _emailConcluseFiltrate = new();
    private bool _loadingDashboard = false;
    private string Title => _folder switch
    {
        "inbox" => "Posta in arrivo (assegnate a me)",
        "myarchive" => "Mio archivio",
        "all" => "Tutti i messaggi",
        _ => "Posta"
    };
    private string? _searchText;
    private List<int>? _caselleIds;
    private string? _filtroUtente = "";
    private DateRange _filtroDate = new();
    private List<string> utenti = new();

    private string? _filtroStato = "";
    private List<string> utentiFiltrati = new();

    private List<string> _chartLabels = new();
    private List<double[]> _chartData = new();

    // modal
    private bool _dialogOpen = false;
    private string _dialogTitle = "";
    private List<AdminEmailDto> _dialogList = new();


    private void ApplicaFiltri()
    {
        IEnumerable<AdminEmailDto> aperte = _emailInLavorazione;
        IEnumerable<AdminEmailDto> chiuse = _emailConcluse;

        // --------------------------
        // FILTRO UTENTE
        // --------------------------
        if (!string.IsNullOrWhiteSpace(_filtroUtente))
        {
            aperte = aperte.Where(x => x.AssegnatoA == _filtroUtente);
            chiuse = chiuse.Where(x => x.AssegnatoA == _filtroUtente);
        }

        // --------------------------
        // FILTRO STATO
        // --------------------------
        if (_filtroStato == "open")
            chiuse = Enumerable.Empty<AdminEmailDto>();
        else if (_filtroStato == "closed")
            aperte = Enumerable.Empty<AdminEmailDto>();

        // --------------------------
        // FILTRO DATE
        // --------------------------
        if (_filtroDate?.Start != null && _filtroDate?.End != null)
        {
            var da = _filtroDate.Start.Value.Date;
            var a = _filtroDate.End.Value.Date.AddDays(1).AddTicks(-1);

            aperte = aperte.Where(x => x.Data >= da && x.Data <= a);
            chiuse = chiuse.Where(x => x.Data >= da && x.Data <= a);
        }

        // --------------------------
        // AGGIORNA LISTE FILTRATE
        // --------------------------
        _emailInLavorazioneFiltrate = aperte.ToList();
        _emailConcluseFiltrate = chiuse.ToList();

        // --------------------------
        // AGGIORNA NOMI UTENTI DA MOSTRARE
        // --------------------------
        utentiFiltrati = aperte
            .Concat(chiuse)
            .Select(x => x.AssegnatoA)
            .Distinct()
            .OrderBy(x => x)
            .ToList();

        StateHasChanged();
    }

    private void ResetFiltri()
    {
        _filtroUtente = "";
        _filtroStato = "";
        _filtroDate = new DateRange();

        _emailInLavorazioneFiltrate = _emailInLavorazione;
        _emailConcluseFiltrate = _emailConcluse;

        utentiFiltrati = utenti;

        StateHasChanged();
    }


    private void MostraListaCompleta(string utente, bool concluse)
    {
        _dialogOpen = true;
        _dialogTitle = concluse ? $"Email concluse di {utente}" : $"Email da svolgere di {utente}";

        _dialogList = concluse
            ? _emailConcluse.Where(x => x.AssegnatoA == utente).OrderByDescending(x => x.Data).ToList()
            : _emailInLavorazione.Where(x => x.AssegnatoA == utente).OrderByDescending(x => x.Data).ToList();
    }

    private void ApriEmail(int id)
    {
        Nav.NavigateTo($"/mail-detail/{id}/{_cp}");
    }

    private async Task OnSearchChanged(string? value)
    {
        _searchText = value?.Trim();
        _currentIndex = 0;
        _emails.Clear();
        _hasMore = true;

        _caselleIds ??= await AccessiSrv.GetCaselleAbilitateAsync(_utente!);

        await LoadMoreEmails(_caselleIds, _searchText);
    }





    private bool MatchesIcon(string? fileName, string icon)
    {
        if (string.IsNullOrWhiteSpace(fileName)) return false;
        var f = fileName.ToLowerInvariant();

        return icon switch
        {
            Icons.Material.Filled.PictureAsPdf => f.EndsWith(".pdf"),
            Icons.Material.Filled.Image => f.EndsWith(".jpg") || f.EndsWith(".jpeg") || f.EndsWith(".png"),
            Icons.Material.Filled.Description => f.EndsWith(".doc") || f.EndsWith(".docx"),
            Icons.Material.Filled.TableChart => f.EndsWith(".xls") || f.EndsWith(".xlsx"),
            _ => true
        };
    }


    private async Task ApplyFilter()
    {
        _currentIndex = 0;
        _emails.Clear();
        _hasMore = true;
        await LoadMoreEmails();
    }

    private async Task LoadCommentsAsync(int emailId)
    {
        _comments = await MailSvc.GetCommentsByEmailAsync(emailId);
        StateHasChanged();
    }

    private void BackToList()
    {
        _selectedId = null;
        _thread.Clear();
        _comments.Clear();
    }

    private ElementReference _scrollDiv;
    private bool _listenerAttached;
    private DotNetObjectReference<Mail_NEW>? _dotNetRef;
    protected override void OnInitialized()
    {
        _dotNetRef = DotNetObjectReference.Create(this);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_isLoading && !_listenerAttached && _scrollDiv.Context != null)
        {
            await JS.InvokeVoidAsync("initMailScrollListener", _dotNetRef, _scrollDiv);
            _listenerAttached = true;
            Console.WriteLine("🟢 Scroll listener JS inizializzato");
        }
    }
    public void Dispose()
    {
        _dotNetRef?.Dispose();
    }

    [JSInvokable]
    public async Task OnMailScrolledToBottom()
    {
        if (_loadingEmails || !_hasMore) return;
        await LoadMoreEmails();
    }

    protected override async Task OnParametersSetAsync()
    {
        
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var q = QueryHelpers.ParseQuery(uri.Query);
        _cp = q.TryGetValue("cp", out var c) ? c.ToString() : null;
        _folder = q.TryGetValue("folder", out var f) ? f.ToString().ToLower() : "inbox";
        _allUsers = await MailSvc.GetUserListAsync();

        _utente = await AccessiSrv.GetUtenteFromCpAsync(_cp);
        _isAdmin = await AccessiSrv.IsAdminAsync(_utente);

        // ⬇️ se hai un modo per capire se è admin, usalo qui
        // per esempio:
        //_isAdmin = await AccessiSrv.IsAdminAsync(_utente);
        // oppure lascialo se lo gestisci altrove
        if (_folder == "admin" && _isAdmin)
        {
            Nav.NavigateTo($"/admin-dashboard?cp={_cp}", true);
            return;
        }

        if (!string.IsNullOrWhiteSpace(_utente))
        {
            _caselleIds = await AccessiSrv.GetCaselleAbilitateAsync(_utente);

            var unreadInbox = await MailSvc.CountUnreadAsync(_utente!);
            var unreadArchive = 0;
            var unreadAll = 0;

            _folders = new()
        {
            new FolderItem_NEW("inbox",     "Posta in arrivo", Icons.Material.Filled.Inbox,   1, unreadInbox),
            new FolderItem_NEW("myarchive", "Mio archivio",    Icons.Material.Filled.Archive, 2, unreadArchive),
            new FolderItem_NEW("all",       "Tutti i messaggi", Icons.Material.Filled.AllInbox, 3, unreadAll)
        };

            // ⬇️ IMPORTANTE: se sono in admin NON carico le mail normali
            if (_folder != "admin")
            {
                // Carica la lista normale di email
                await LoadMoreEmails(_caselleIds);
            }
            else
            {
                if (_isAdmin)
                {
                    // Carica la dashboard admin
                    _loadingDashboard = true;
                    _emailInLavorazione = await GetEmailInLavorazioneAsync();
                    _emailConcluse = await GetEmailCompletateAsync();

                    _emailInLavorazioneFiltrate = _emailInLavorazione;
                    _emailConcluseFiltrate = _emailConcluse;

                    utenti = _emailInLavorazione
                       .Concat(_emailConcluse)
                       .Select(x => x.AssegnatoA)
                       .Where(x => !string.IsNullOrWhiteSpace(x))
                       .Distinct()
                       .OrderBy(x => x)
                       .ToList();

                    utentiFiltrati = utenti;
                    _loadingDashboard = false;
                }
            }

        }

        _isLoading = false;
    }



    private string GetAttachmentCss(string icon)
    {
        if (icon == Icons.Material.Filled.PictureAsPdf) return "att-ico pdf";
        return "att-ico";
    }
    private string ExtractEmail(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
            return "";

        raw = raw.Trim();

        // 1️⃣ Se contiene <email>, estrai quella
        int start = raw.IndexOf('<');
        int end = raw.IndexOf('>');
        if (start >= 0 && end > start)
        {
            var inside = raw.Substring(start + 1, end - start - 1).Trim();
            if (IsValidEmail(inside))
                return inside;
        }

        // 2️⃣ Se la stringa contiene già un indirizzo email senza < >
        var match = Regex.Match(raw, @"[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}");
        if (match.Success)
            return match.Value.ToLower();

        // 3️⃣ fallback: restituisci tutto
        return raw;
    }

    private bool IsValidEmail(string email)
    {
        return Regex.IsMatch(email,
            @"^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$");
    }



    private List<string> GetAttachmentGroupIcons(EmailListItem_NEW item)
    {
        return item.Allegati?
            .Select(a => a.NomeFile?.ToLowerInvariant() ?? "")
            .Select(n =>
            {
                if (n.EndsWith(".pdf")) return Icons.Material.Filled.PictureAsPdf;
                if (n.EndsWith(".jpg") || n.EndsWith(".jpeg") || n.EndsWith(".png"))
                    return Icons.Material.Filled.Image;
                if (n.EndsWith(".doc") || n.EndsWith(".docx"))
                    return Icons.Material.Filled.Description;
                if (n.EndsWith(".xls") || n.EndsWith(".xlsx"))
                    return Icons.Material.Filled.TableChart;
                return Icons.Material.Filled.AttachFile;
            })
            .Distinct()
            .ToList() ?? new List<string>();
    }


    private string IsActive(string f) => _folder == f ? "active" : "";
    private void ChangeFolder(string folder) => Nav.NavigateTo($"/mail-new?cp={_cp}&folder={folder}", true);

    private async Task Reply(EmailDetail_NEW msg)
    {
        var parameters = new DialogParameters
        {
            ["Utente"] = _utente,
            ["Destinatari"] = msg.Mittente,
            ["Oggetto"] = "Re: " + (msg.Oggetto ?? ""),
            ["CorpoIniziale"] = "",
            ["ReplyToMessageId"] = msg.MessageId,
            ["CasellaMittente"] = msg.CasellaEmail
        };

        var dialog = DialogService.Show<ComposeDialog>(
        "Rispondi",
        parameters,
        new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true }
    );

        var result = await dialog.Result;
        if (result.Data is true)
            Snackbar.Add("Risposta inviata ✅", Severity.Success);
    }

    private List<string> GetAssignedList(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
            return new List<string>();
        return raw.Split(';', ',')
                  .Select(s => s.Trim())
                  .Where(s => s.Length > 0)
                  .ToList();
    }


    private async Task ReplyAll(EmailDetail_NEW msg)
    {
        // Mittente + tutti i destinatari (escludendo duplicati e il proprio indirizzo)
        var destinatariTutti = string.Join("; ",
            new[] { msg.Mittente }
            .Concat((msg.Destinatari ?? "").Split(';', ',').Select(x => x.Trim()))
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct());

        var parameters = new DialogParameters
        {
            ["Utente"] = _utente,
            ["Destinatari"] = msg.Mittente,
            ["Oggetto"] = "Re: " + (msg.Oggetto ?? ""),
            ["CorpoIniziale"] = "",
            ["ReplyToMessageId"] = msg.MessageId,
            ["CasellaMittente"] = msg.CasellaEmail
        };
        var dialog = DialogService.Show<ComposeDialog>(
            "Rispondi a tutti",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true }
        );

        var result = await dialog.Result;
        if (result.Data is true)
            Snackbar.Add("Risposta a tutti inviata ✅", Severity.Success);
    }
    private async Task Archive(EmailListItem_NEW item)
    {
        await MailSvc.ArchiveEmailAsync(item.Id, _utente!);
        Snackbar.Add("Email archiviata ✔", Severity.Success);

        if (_folder == "inbox")
            _emails.Remove(item);

        StateHasChanged();
    }
    public async Task<List<AdminEmailDto>> GetEmailInLavorazioneAsync()
    {
        using var db = DbFactory.CreateDbContext();

        var query =
            from a in db.EmailAssegnazione
            join e in db.EmailRicevute on a.EmailId equals e.Id
            where !db.EmailArchivio.Any(ar => ar.IdEmail == e.Id)
            select new
            {
                e.Id,
                e.Oggetto,
                e.Mittente,
                e.DataRicezione,
                a.Utente
            };

        var raw = await query.OrderByDescending(x => x.DataRicezione).ToListAsync();

        // 👉 Qui aggiungiamo la proprietà Completata *in memoria* (NO SQL)
        return raw.Select(x => new AdminEmailDto
        {
            EmailId = x.Id,
            Oggetto = x.Oggetto,
            Mittente = x.Mittente,
            Data = x.DataRicezione,
            AssegnatoA = x.Utente,
            Completata = false   // ← questo ora NON finisce in SQL
        }).ToList();
    }



    public async Task<List<AdminEmailDto>> GetEmailCompletateAsync()
    {
        using var db = DbFactory.CreateDbContext();

        var query =
            from ar in db.EmailArchivio
            join e in db.EmailRicevute on ar.IdEmail equals e.Id
            select new
            {
                e.Id,
                e.Oggetto,
                e.Mittente,
                ar.DataArchiviazione,
                ar.Utente
            };

        var raw = await query.OrderByDescending(x => x.DataArchiviazione).ToListAsync();

        return raw.Select(x => new AdminEmailDto
        {
            EmailId = x.Id,
            Oggetto = x.Oggetto,
            Mittente = x.Mittente,
            Data = x.DataArchiviazione,
            AssegnatoA = x.Utente,
            Completata = true
        }).ToList();
    }



