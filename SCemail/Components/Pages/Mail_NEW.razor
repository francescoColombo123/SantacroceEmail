            else if (_folder == "drafts")
            {
                await LoadMoreDrafts();
            }
            else if (_folder != "admin")
            {
                await LoadMoreEmails(_caselleIds);
            }

            if (_folder == "inbox")
            {
                _sezioni = await MailSvc.GetSezioniInboxAsync(soloAttive: true);

                _sezioniVm = _sezioni
                    .Select(s => new SezioneVm
                    {
                        IdSezione = s.Id,
