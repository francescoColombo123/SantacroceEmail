@page "/mail-new"
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using Oracle.ManagedDataAccess.Client
@using SCemail.Components.Data
@using MudBlazor
@using MimeKit;
@using System.Text.RegularExpressions
@using System.Net
@using static SCemail.Components.Data.MailService_NEW
@inject NavigationManager Nav
@inject MailService_NEW MailSvc
@inject MailService MailSvc1
@inject SCemail.Components.Data.AccessiService AccessiSrv
@inject PostItService postItService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject SCemail.Components.Shared.IEmailTasksClient TaskClient
@inject IDbContextFactory<MailDbContext> DbFactory
@inject HttpClient Http

@if (_isLoading)
{
    <div class="loading-screen">
        <div class="dots-loader">
            <span class="dot"></span><span class="dot"></span><span class="dot"></span>
        </div>
        <div class="loading-text">Caricamento email in corso…</div>
    </div>
}
else
{
    <div class="workspace">
        <!-- ===== SIDEBAR ===== -->
        <aside class="sidebar">
            <div class="sidebar-inner">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Edit"
                           OnClick="NewEmail"
                           Class="sidebar-btn">

                </MudButton>

                <ul class="folder-list folder-icons">
                    @if (_isAdmin)
                    {
                        <li @onclick="@(() => ChangeFolder("admin"))"
                            class="@IsActive("admin")">
                            <MudTooltip Text="Amministrazione" Placement="Placement.Right">
                                <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" />
                            </MudTooltip>
                        </li>
                    }

                    @if (_hasAdminCaselle)
                    {
                        <li @onclick="@(() => ChangeFolder("unassigned"))"
                            class="@IsActive("unassigned")">

                            <MudTooltip Text="Email non assegnate (caselle admin)" Placement="Placement.Right">
                                <div class="unassigned-icon-wrap @(_unassignedCount > 0 ? "active" : "")">
                                    <MudIcon Icon="@Icons.Material.Filled.AssignmentLate" />
                                </div>
                            </MudTooltip>

                        </li>

                        <li @onclick="@(() => ChangeFolder("mailfollowed"))"
                            class="@IsActive("mailfollowed")">
                            <MudTooltip Text="Mail seguite" Placement="Placement.Right">
                                <MudIcon Icon="@Icons.Material.Filled.Visibility" />
                            </MudTooltip>
                        </li>
                    }

                    @foreach (var f in _folders)
                    {
                        <li @onclick="@(() => ChangeFolder(f.UiName))"
                            class="@IsActive(f.UiName)">

                            <MudTooltip Text="@f.Label" Placement="Placement.Right">
                                @if (f.UiName == "drafts")
                                {
                                    <div class="drafts-icon-wrap @(_hasUnreadDrafts ? "has-unread" : "")">
                                        <MudIcon Icon="@f.IconClass" />
                                    </div>
                                }
                                else
                                {
                                    <MudIcon Icon="@f.IconClass" />
                                }
                            </MudTooltip>
                        </li>
                    }

                    <li @onclick="@(() => ChangeFolder("mentions"))"
                        class="@IsActive("mentions")">
                        <MudTooltip Text="Menzioni" Placement="Placement.Right">
                            <MudIcon Icon="@Icons.Material.Filled.Campaign" />
                        </MudTooltip>
                    </li>
                </ul>

            </div>
        </aside>

        <!-- ===== MAIN ===== -->
        <main class="mail-container">
            <div class="postit-wrapper">
                <div class="postit-board">

                    <div class="postit-create" @onclick="ApriNuovoPostIt">
                        <MudIcon Icon="@Icons.Material.Filled.Add" />
                        <span>Nuovo post-it</span>
                    </div>

                    @foreach (var p in _postIts)
                    {
                        <div class="postit-card" @onclick="() => ApriPostIt(p)">
                            <div class="postit-actions" @onclick:stopPropagation="true">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Size="Size.Small"
                                               OnClick="@(() => ApriPostIt(p))" />

                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Size="Size.Small"
                                               Color="Color.Error"
                                               OnClick="@(() => ConfermaEliminaPostIt(p.Id))" />
                            </div>

                            <div class="postit-title">@p.Titolo</div>
                            <div class="postit-text">@p.Testo</div>
                        </div>
                    }
                </div>
            </div>


            @if (_folder != "admin")
            {
                <div class="top-toolbar">
                    <div class="top-toolbar-left">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Home"
                                   OnClick="@GoHome">
                            Home
                        </MudButton>

                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Secondary"
                                   StartIcon="@Icons.Material.Filled.TaskAlt"
                                   OnClick="@GoToTasks">
                            Vai ai Task
                        </MudButton>
                    </div>

                    <div class="top-toolbar-right">
                        @if (_folder == "sent")
                        {
                            <MudTextField T="string"
                                          Value="_sentSearch"
                                          ValueChanged="async v => { _sentSearch = v?.Trim(); await LoadMoreSentAsync(reset:true); }"
                                          Placeholder="Cerca (oggetto/destinatari)..."
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                          DebounceInterval="400"
                                          Immediate="true"
                                          Class="toolbar-search" />
                        }
                        else
                        {
                            <MudTextField T="string"
                                          Value="_searchWord"
                                          ValueChanged="async v => await OnWordSearchChanged(v)"
                                          Placeholder="Cerca nella posta..."
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                          DebounceInterval="400"
                                          Immediate="true"
                                          Class="toolbar-search" />

                            <div class="addr-search-wrap toolbar-address">
                                <MudTextField T="string"
                                              Value="_addrInput"
                                              TextChanged="@(async (string v) => await OnAddressInput(v))"
                                              Immediate="true"
                                              DebounceInterval="250"
                                              Placeholder="Cerca indirizzo..."
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.AlternateEmail"
                                              Class="toolbar-search" />

                                @if (_showAddrSuggestions && _addrSuggestions.Any())
                                {
                                    <MudPaper Class="suggestion-panel">
                                        @foreach (var s in _addrSuggestions)
                                        {
                                            <div class="suggestion-item"
                                                 @onclick="async () => await SelectAddressSuggestion(s)">
                                                <div class="chip-avatar chip-a">@s.Email.Substring(0, 1).ToUpper()</div>
                                                <div class="chip-texts">
                                                    <div class="chip-name">@s.NameOrEmail</div>
                                                    <div class="chip-email">@s.Email</div>
                                                </div>
                                            </div>
                                        }
                                    </MudPaper>
                                }
                            </div>

                            <MudIconButton Icon="@Icons.Material.Filled.FilterAlt"
                                           Title="Applica filtro indirizzo"
                                           OnClick="ApplyAddressFilter"
                                           Color="Color.Primary" />
                        }
                    </div>
                </div>
            }
            @if (_folder == "admin" && _isAdmin)
            {
                <MudPaper Class="redirect-admin">
                    <MudText Typo="Typo.h6">Reindirizzamento alla dashboard amministrativa…</MudText>
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                </MudPaper>
            }

            else
            {
                <section class="mail-grid @GetMailGridClass()">
                    @* ============================
           LISTA NORMALE
           ============================ *@
                    <div class="mail-list">
                        <div id="mailScroll" class="list-scroll" @ref="_scrollDiv">
                            @if (_folder == "sent")
                            {
                                <ul class="mail-ul">
                                    @foreach (var item in _sent)
                                    {
                                        <li class="sent-row @(item.Id == _sentSelectedId ? "selected" : "")"
                                            @onclick="@(() => SelectSentAsync(item.Id))">

                                            <div class="sent-strip"></div>

                                            <!-- LEFT: destinatari + oggetto + preview -->
                                            <div class="sent-main">
                                                <div class="sent-top">
                                                    <MudTooltip Text="@SentList_ToTooltip(item)">
                                                        <div class="sent-to">
                                                            <span class="sent-to-main">@SentList_ToMain(item)</span>
                                                            @if (SentList_ToExtra(item) > 0)
                                                            {
                                                                <span class="sent-to-more">+@SentList_ToExtra(item)</span>
                                                            }
                                                        </div>
                                                    </MudTooltip>

                                                    <div class="sent-date">@item.DataInvio.ToString("dd/MM/yyyy HH:mm")</div>
                                                </div>

                                                <!-- ✅ NUOVO: da quale casella proviene -->
                                                <div class="sent-from">
                                                    <span class="sent-from-lab">Da:</span>
                                                    <span class="sent-from-val">@ExtractEmail(item.CasellaMittente)</span>
                                                </div>

                                                <div class="sent-mid" title="@item.Oggetto">
                                                    <span class="sent-subject">
                                                        @(string.IsNullOrWhiteSpace(item.Oggetto) ? "(nessun oggetto)" : item.Oggetto)
                                                    </span>
                                                </div>

                                                <div class="sent-bot">
                                                    <span class="sent-preview" title="@SentList_PreviewPlain(item)">
                                                        @SentList_PreviewPlain(item)
                                                    </span>
                                                    @if (item.Allegati?.Any() == true)
                                                    {
                                                        <div class="sent-att" @onclick:stopPropagation="true">
                                                            @foreach (var a in item.Allegati)
                                                            {
                                                                <MudTooltip Text="@a.NomeFile">
                                                                    <MudIconButton Icon="@GetAttachmentIcon(a.NomeFile)"
                                                                                   Class="@GetAttachmentCss(GetAttachmentIcon(a.NomeFile))"
                                                                                   Size="Size.Small"
                                                                                   OnClick="@(async () => await OpenAttachmentAsync_Sent(a.Id, a.MimeType, item.Allegati.Select(x => x.Id).ToList()))" />
                                                                </MudTooltip>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </li>
                                    }
                                </ul>

                                @if (_sentLoading)
                                {
                                    <div class="load-more">
                                        <div class="dots-loader small">
                                            <span class="dot"></span><span class="dot"></span><span class="dot"></span>
                                        </div>
                                        <span class="load-text">Carico…</span>
                                    </div>
                                }

                                
                            }
                            else if (_folder == "drafts")
                            {
                                <ul class="mail-ul">
                                    @foreach (var d in _drafts)
                                    {
                                        <li class="mail-row2 @(d.Letto ? "read" : "unread")"
                                            @onclick="@(() => OpenDraft(d.Id))">

                                            <div class="status-strip"></div>

                                            <div class="ml-left">
                                                <div class="ml-from">Bozza</div>

                                                <div class="ml-to">
                                                    <span class="ml-to-label">@GetMainRecipientType(d)</span>
                                                    <span class="ml-to-main">@GetMainRecipientLabel(d)</span>
                                                </div>
                                            </div>

                                            <div class="ml-center">
                                                <div class="ml-line1">
                                                    <div class="ml-subject">
                                                        <strong>
                                                            @(string.IsNullOrWhiteSpace(d.Oggetto)
                                                                                                        ? "(nessun oggetto)"
                                                                                                        : d.Oggetto)
                                        </strong>
                                    </div>

                                                    <div></div>
                                                    <div class="ml-date">
                                                        @(d.LastSaved?.ToString("dd/MM/yyyy HH:mm") ?? "")
                                                    </div>
                                                </div>

                                                <div class="ml-line2">
                                                    <div class="ml-preview">
                                                        @StripHtml(d.Preview)
                                                    </div>

                                                    <div class="ml-right" @onclick:stopPropagation="true">
                                                        <div class="ml-tools">
                                                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                                           Color="Color.Error"
                                                                           Size="Size.Small"
                                                                           Title="Elimina bozza"
                                                                           OnClick="@(() => DeleteDraft(d.Id))" />
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </li>
                                                }
                                </ul>

                                @if (_loadingDrafts)
                                {
                                    <div class="load-more">
                                        <div class="dots-loader small">
                                            <span class="dot"></span><span class="dot"></span><span class="dot"></span>
                                        </div>
                                        <span class="load-text">Carico bozze…</span>
                                    </div>
                                }
                            }
                            else
                            {
                                
                                @if (_folder == "inbox")
                                {
                                    <!-- BLOCCO TOP: MAIL RICEVUTE -->
                                    <div class="inbox-block">
                                        <div class="inbox-block-head">EMAIL ASSEGNATE (Posta in Arrivo)</div>

                                        <div id="inboxScroll" class="inbox-block-body">
                                            <ul class="mail-ul">
                                                @foreach (var item in _emails)
                                                {
                                                    <li @key="item.Id"
                                                        class="mail-row2 @GetRowClass(item)"
                                                        @onclick="@(() => OpenEmailAndMarkRead(item, null))">

                                                        <div class="status-strip"></div>

                                                        <!-- LEFT: mittente + destinatari -->
                                                        <div class="ml-left">
                                                            <MudTooltip Text="@item.Mittente">
                                                                <div class="ml-from">@ExtractEmail(item.Mittente)</div>
                                                            </MudTooltip>

                                                            @* destinatari: nostra casella + eventuali extra *@
                                                            <MudTooltip Text="@BuildRecipientsTooltip(item)">
                                                                <div class="ml-to">
                                                                    <span class="ml-to-label">@GetMainRecipientType(item)</span>
                                                                    <span class="ml-to-main">@GetMainRecipientLabel(item)</span>
                                                                    @if (GetRecipientsExtraCount(item) > 0)
                                                                    {
                                                                        <span class="ml-to-more">+@GetRecipientsExtraCount(item)</span>
                                                                    }
                                                                </div>
                                                            </MudTooltip>
                                                        </div>

                                                        <!-- CENTER: 2 righe -->
                                                        <div class="ml-center">
                                                            <!-- Riga 1: Oggetto bold + chip assegnatari + data -->
                                                            <div class="ml-line1">
                                                                <div class="ml-subject" title="@item.Oggetto">

                                                                    @if (item.ThreadLen > 0)
                                                                    {
                                                                        <span class="thread-badge">@item.ThreadLen</span>
                                                                    }

                                                                    <strong>@(item.Oggetto ?? "")</strong>

                                                                </div>
                                                                @{
                                                                    var assList = GetAssignedList(item.AssegnatoA).Distinct().ToList();
                                                                    var shortList = assList.Take(2).ToList();
                                                                    var extra = assList.Count - shortList.Count;
                                                                }

                                                                <MudTooltip Text="@string.Join("\n", assList)">
                                                                    <div class="ml-assigned">
                                                                        @foreach (var a in shortList)
                                                                        {
                                                                            <span class="chip">@a</span>
                                                                        }
                                                                        @if (extra > 0)
                                                                        {
                                                                            <span class="chip more">+@extra</span>
                                                                        }
                                                                    </div>
                                                                </MudTooltip>

                                                                <div class="ml-date">@item.Data?.ToString("dd/MM/yyyy HH:mm")</div>
                                                            </div>

                                                            <!-- Riga 2: preview + pulsanti + allegati -->
                                                            <div class="ml-line2">

                                                                <div class="ml-preview" title="@item.Preview">
                                                                    @item.Preview
                                                                </div>

                                                                <div class="ml-right">

                                                                    @if (item.Allegati?.Any() == true)
                                                                    {
                                                                        <div class="ml-att">
                                                                            @foreach (var a in item.Allegati)
                                                                            {
                                                                                <MudTooltip Text="@a.NomeFile">
                                                                                    <MudIconButton Icon="@GetAttachmentIcon(a.NomeFile)"
                                                                                                   Class="@GetAttachmentCss(GetAttachmentIcon(a.NomeFile))"
                                                                                                   Size="Size.Small"
                                                                                                   OnClick="@(async () => await OpenAttachmentAsync(a.Id, a.MimeType, item.Allegati.Select(x => x.Id).ToList()))" />
                                                                                </MudTooltip>
                                                                            }
                                                                        </div>
                                                                    }

                                                                    <div class="ml-tools" @onclick:stopPropagation="true">

                                                                        @if (CanAssignInCurrentFolder())
                                                                        {
                                                                            <MudIconButton Icon="@Icons.Material.Filled.ForwardToInbox"
                                                                                           Color="Color.Primary"
                                                                                           Size="Size.Small"
                                                                                           Title="Assegna"
                                                                                           OnClick="@(() => Forward(item))" />
                                                                        }

                                                                        @if (CanArchiveInCurrentFolder())
                                                                        {
                                                                            <MudIconButton Icon="@Icons.Material.Filled.Archive"
                                                                                           Color="Color.Success"
                                                                                           Size="Size.Small"
                                                                                           Title="Archivia"
                                                                                           OnClick="@(() => Archive(item))" />
                                                                        }
                                                                        else if (_folder == "mentions" && item.CanArchive)
                                                                        {
                                                                            <MudIconButton Icon="@Icons.Material.Filled.Archive"
                                                                                           Color="Color.Success"
                                                                                           Size="Size.Small"
                                                                                           Title="Archivia"
                                                                                           OnClick="@(() => Archive(item))" />
                                                                        }
                                                                        else if (_folder == "mentions")
                                                                        {
                                                                            <MudIconButton Icon="@Icons.Material.Filled.Archive"
                                                                                           Color="Color.Default"
                                                                                           Size="Size.Small"
                                                                                           Title="Puoi archiviare solo dopo aver risposto alla menzione"
                                                                                           Disabled="true" />
                                                                        }

                                                                        @if (CanUnarchiveInCurrentFolder())
                                                                        {
                                                                            <MudIconButton Icon="@Icons.Material.Filled.Unarchive"
                                                                                           Color="Color.Primary"
                                                                                           Size="Size.Small"
                                                                                           Title="Ripristina"
                                                                                           OnClick="@(() => Unarchive(item))" />
                                                                        }

                                                                    </div>

                                                                </div>

                                                            </div>
                                                        </div>
                                                    </li>

                                                }
                                            </ul>

                                            @if (_loadingList)
                                            {
                                                <div class="load-more">
                                                    <div class="dots-loader small">
                                                        <span class="dot"></span><span class="dot"></span><span class="dot"></span>
                                                    </div>
                                                    <span class="load-text">Carico…</span>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <!-- SEZIONI -->
                                    <div class="sections-wrap">
                                        @foreach (var sec in _sezioniVm)
                                        {
                                            <div class="sec-card">
                                                <div class="sec-head">@sec.Nome</div>

                                                <div id="@sec.ScrollDivId" class="sec-body">
                                                    <ul class="mail-ul">
                                                        @foreach (var item in sec.Emails)
                                                        {
                                                            <li @key="item.Id"
                                                                class="mail-row2 @GetRowClass(item)"
                                                                @onclick="@(() => OpenEmailAndMarkRead(item, sec.Nome))">

                                                                <div class="status-strip"></div>

                                                                <!-- LEFT: mittente + destinatari -->
                                                                <div class="ml-left">
                                                                    <MudTooltip Text="@item.Mittente">
                                                                        <div class="ml-from">@ExtractEmail(item.Mittente)</div>
                                                                    </MudTooltip>

                                                                    @* destinatari: nostra casella + eventuali extra *@
                                                                    <MudTooltip Text="@BuildRecipientsTooltip(item)">
                                                                        <div class="ml-to">
                                                                            <span class="ml-to-label">@GetMainRecipientType(item)</span>
                                                                            <span class="ml-to-main">@GetMainRecipientLabel(item)</span>
                                                                            @if (GetRecipientsExtraCount(item) > 0)
                                                                            {
                                                                                <span class="ml-to-more">+@GetRecipientsExtraCount(item)</span>
                                                                            }
                                                                        </div>
                                                                    </MudTooltip>
                                                                </div>

                                                                <!-- CENTER: 2 righe -->
                                                                <div class="ml-center">
                                                                    <!-- Riga 1: Oggetto bold + chip assegnatari + data -->
                                                                    <div class="ml-line1">
                                                                        <div class="ml-subject" title="@item.Oggetto">
                                                                            <strong>@(item.Oggetto ?? "")</strong>
                                                                        </div>

                                                                        @{
                                                                            var assList = GetAssignedList(item.AssegnatoA).Distinct().ToList();
                                                                            var shortList = assList.Take(2).ToList();
                                                                            var extra = assList.Count - shortList.Count;
                                                                        }

                                                                        <MudTooltip Text="@string.Join("\n", assList)">
                                                                            <div class="ml-assigned">
                                                                                @foreach (var a in shortList)
                                                                                {
                                                                                    <span class="chip">@a</span>
                                                                                }
                                                                                @if (extra > 0)
                                                                                {
                                                                                    <span class="chip more">+@extra</span>
                                                                                }
                                                                            </div>
                                                                        </MudTooltip>

                                                                        <div class="ml-date">@item.Data?.ToString("dd/MM/yyyy HH:mm")</div>
                                                                    </div>

                                                                    <!-- Riga 2: preview + pulsanti + allegati -->
                                                                    <div class="ml-line2">
                                                                        <div class="ml-preview" title="@item.Preview">
                                                                            @item.Preview
                                                                        </div>

                                                                        <div class="ml-right" @onclick:stopPropagation="true">

                                                                            @if (item.Allegati?.Any() == true)
                                                                            {
                                                                                <div class="ml-att">
                                                                                    @foreach (var a in item.Allegati)
                                                                                    {
                                                                                        <MudTooltip Text="@a.NomeFile">
                                                                                            <MudIconButton Icon="@GetAttachmentIcon(a.NomeFile)"
                                                                                                           Class="@GetAttachmentCss(GetAttachmentIcon(a.NomeFile))"
                                                                                                           Size="Size.Small"
                                                                                                           OnClick="@(async () => await OpenAttachmentAsync(a.Id, a.MimeType, item.Allegati.Select(x => x.Id).ToList()))" />
                                                                                        </MudTooltip>
                                                                                    }
                                                                                </div>
                                                                            }

                                                                            <div class="ml-tools">
                                                                                @if (CanAssignInCurrentFolder())
                                                                                {
                                                                                    <MudIconButton Icon="@Icons.Material.Filled.ForwardToInbox"
                                                                                                   Color="Color.Primary"
                                                                                                   Size="Size.Small"
                                                                                                   Title="Assegna"
                                                                                                   OnClick="@(() => Forward(item))" />
                                                                                }

                                                                                @if (CanArchiveInCurrentFolder())
                                                                                {
                                                                                    <MudIconButton Icon="@Icons.Material.Filled.Archive"
                                                                                                   Color="Color.Success"
                                                                                                   Size="Size.Small"
                                                                                                   Title="Archivia"
                                                                                                   OnClick="@(() => Archive(item))" />
                                                                                }

                                                                                @if (CanUnarchiveInCurrentFolder())
                                                                                {
                                                                                    <MudIconButton Icon="@Icons.Material.Filled.Unarchive"
                                                                                                   Color="Color.Primary"
                                                                                                   Size="Size.Small"
                                                                                                   Title="Ripristina in Posta in arrivo"
                                                                                                   OnClick="@(() => Unarchive(item))" />
                                                                                }
                                                                            </div>

                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </li>
                                                        }
                                                    </ul>

                                                    @if (sec.Loading)
                                                    {
                                                        <div class="load-more">
                                                            <div class="dots-loader small">
                                                                <span class="dot"></span><span class="dot"></span><span class="dot"></span>
                                                            </div>
                                                            <span class="load-text">Carico sezione…</span>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else{
                                <ul class="mail-ul">
                                    @foreach (var item in _emails)
                                    {
                                        <li @key="item.Id"
                                                class="mail-row2 @GetRowClass(item)"
                                                @onclick="@(() => OpenEmailAndMarkRead(item, null))">

                                            <div class="status-strip"></div>

                                            <!-- LEFT: mittente + destinatari -->
                                            <div class="ml-left">
                                                <MudTooltip Text="@item.Mittente">
                                                    <div class="ml-from">@ExtractEmail(item.Mittente)</div>
                                                </MudTooltip>

                                                @* destinatari: nostra casella + eventuali extra *@
