    private bool _loadingEmails = false;

    public async Task LoadMoreEmails(List<int>? casellaIds = null, string? filtro = null)
    {
        if (_loadingEmails)
            return;

        _loadingEmails = true;
        _loadingList = true;
        StateHasChanged();

        try
        {
            if (string.IsNullOrWhiteSpace(_utente))
                return;

            casellaIds ??= _caselleIds ?? await AccessiSrv.GetCaselleAbilitateAsync(_utente);
            string? filtroEffettivo = filtro ?? _searchText?.Trim();

            // 🔔 MENTIONS (intoccato)
            if (_folder == "mentions")
            {
                var (page, total) =
                    await MailSvc.GetMentionedEmailsPagedSafeAsync(
                        _utente!,
                        _currentIndex,
                        _pageSize
                    );

                if (_currentIndex == 0)
                    _emails = page;
                else
                    _emails.AddRange(page.Where(x => !_emails.Any(e => e.Id == x.Id)));

                _currentIndex += _pageSize;
                _hasMore = _emails.Count < total;

                _mentionsCount = _emails.Count(x => x.Aperto == "N");
                return;
            }


            // 🔍 RICERCA VELOCE (MITTENTE + OGGETTO)
            if (!string.IsNullOrWhiteSpace(filtroEffettivo) && filtroEffettivo.Length >= 2)
            {
                var (page, total) = await MailSvc.SearchEmailsAsync(
                    casellaIds: casellaIds,
                    start: _currentIndex,
                    pageSize: _pageSize,
                    searchText: filtroEffettivo
                );

                if (_currentIndex == 0)
                    _emails = page;
                else
                    _emails.AddRange(page.Where(x => !_emails.Any(e => e.Id == x.Id)));

                _currentIndex += _pageSize;
                _hasMore = _emails.Count < total;
                return;
            }

            // 📥 CARICAMENTO NORMALE
            var (normalPage, totalCount) = await MailSvc.GetEmailPageAsync(
                casellaIds,
                _currentIndex,
                _pageSize,
                folderUi: _folder,
                utente: _utente!,
                filtro: null
            );

            if (_currentIndex == 0)
                _emails = normalPage;
            else
                _emails.AddRange(normalPage.Where(x => !_emails.Any(e => e.Id == x.Id)));

            _currentIndex += _pageSize;
            _hasMore = _emails.Count < totalCount;
        }
        finally
        {
            _loadingEmails = false;
            _loadingList = false;
            StateHasChanged();
        }
    }





    private async Task SelectEmail(int id)
    {
        _selectedId = id;
        _loadingDetail = true;
        _thread.Clear();
        var full = await MailSvc.GetEmailDetailAsync(id, onlyMeta: false);
        if (full != null)
            _thread.Add(full);

        _loadingDetail = false;
        await MailSvc.MarkOpenedAsync(id);
        var opened = _emails.FirstOrDefault(e => e.Id == id);
        if (opened != null)
        {
            opened = opened with { Aperto = "Y" };
            var idx = _emails.FindIndex(e => e.Id == id);
            if (idx >= 0)
                _emails[idx] = opened;
            StateHasChanged();
        }
        _ = Task.Run(async () =>
        {
            var conv = await MailSvc.GetConversationByThreadAsync(id);
            if (conv != null && conv.Count > 1)
            {
                await InvokeAsync(() =>
                {
                    // evita duplicato della mail già caricata
                    foreach (var c in conv)
                        if (!_thread.Any(t => t.Id == c.Id))
                            _thread.Insert(0, c);

                    StateHasChanged();
                });
            }
        });
    }

    private async Task Forward(EmailDetail_NEW msg)
    {
        try
        {
            // 1️⃣ Mostra il dialog con lista utenti
            var parameters = new DialogParameters
            {
                ["Users"] = await MailSvc.GetUserListAsync()
            };

            var dialog = DialogService.Show<ForwardDialog>(
                "Inoltra a utente",
                parameters,
                new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true }
            );

            var result = await dialog.Result;

            if (!result.Canceled && result.Data is ForwardDialog.ForwardResult fr)
            {

                await MailSvc.AssignEmailAsync(
                    msg.Id,
                    fr.User,
                    fr.SoloInvio,
                    fr.Comment
                );
                Snackbar.Add($"Email {(fr.SoloInvio ? "inoltrata" : "assegnata")} a {fr.User} ✅", Severity.Success);

                var action = fr.SoloInvio ? "inoltrata" : "assegnata per tracciamento";
                Snackbar.Add($"Email {action} a {fr.User} ✅", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Errore in Forward: {ex.Message}");
            Snackbar.Add($"Errore nell'inoltro: {ex.Message}", Severity.Error);
        }
    }

    private async Task Forward(EmailListItem_NEW item)
    {
        try
        {
            var full = await MailSvc.GetEmailDetailAsync(item.Id, onlyMeta: false);

            if (full == null)
            {
                Snackbar.Add("Impossibile caricare il dettaglio dell'email per l'inoltro.", Severity.Error);
                return;
            }

            // 2️⃣ Chiama la versione originale del metodo
            await Forward(full);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Errore durante l'inoltro: {ex.Message}");
            Snackbar.Add($"Errore durante l'inoltro: {ex.Message}", Severity.Error);
        }
    }

    private async Task OpenEmailAndMarkRead(EmailListItem_NEW item)
    {
        try
        {
            // 🔸 Marca come letta a livello grafico
            if (item.Aperto != "Y")
            {
                var updated = item with { Aperto = "Y" };
                var idx = _emails.FindIndex(e => e.Id == item.Id);
                if (idx >= 0)
                    _emails[idx] = updated;

                StateHasChanged();
            }

            // 🔸 Aggiorna in background (DB)
            _ = Task.Run(async () =>
            {
                await MailSvc.SegnaLettaAsync(item.Id, item.AssegnatoA);
                await MailSvc.MarkOpenedAsync(item.Id);

                // ⬅️ NUOVO: marca la menzione come VISTA
                await MailSvc.SegnaNotificheVisteAsync(item.Id, _utente!);
            });

            // 🔸 Vai al dettaglio
            Nav.NavigateTo($"/mail-detail/{item.Id}/{_cp}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Errore in OpenEmailAndMarkRead: {ex.Message}");
            Snackbar.Add("Errore durante apertura email", Severity.Error);
        }
    }



    private async Task NewEmail()
    {
        var parameters = new DialogParameters { ["Utente"] = _utente };
        var dialog = DialogService.Show<ComposeDialog>("Nuova email", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result.Data is true)
            Snackbar.Add("Email inviata ✅", Severity.Success);
    }

    private string GetAttachmentIcon(string? name)
    {
        var s = (name ?? "").ToLowerInvariant();
        if (s.EndsWith(".pdf")) return Icons.Material.Filled.PictureAsPdf;
        if (s.EndsWith(".jpg") || s.EndsWith(".png")) return Icons.Material.Filled.Image;
        if (s.EndsWith(".doc") || s.EndsWith(".docx")) return Icons.Material.Filled.Description;
        if (s.EndsWith(".xls") || s.EndsWith(".xlsx")) return Icons.Material.Filled.TableChart;
        return Icons.Material.Filled.AttachFile;
    }

