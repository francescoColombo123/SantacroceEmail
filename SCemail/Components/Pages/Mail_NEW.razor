    private List<string> SentList_ToAll(SentEmailListItemDto item)
    {
        return ParseAddressList(item.Destinatari)
            .Select(ExtractEmail)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private string SentList_ToMain(SentEmailListItemDto item)
    {
        var to = SentList_ToAll(item);
        return to.FirstOrDefault() ?? "(nessun destinatario)";
    }

    private int SentList_ToExtra(SentEmailListItemDto item)
    {
        var to = SentList_ToAll(item);
        return Math.Max(0, to.Count - 1);
    }

    private string SentList_ToTooltip(SentEmailListItemDto item)
    {
        var to = SentList_ToAll(item);
        return to.Count == 0 ? "A: (nessun destinatario)" : $"A: {string.Join(", ", to)}";
    }

  

    private (List<string> To, List<string> Cc, List<string> Bcc) SentDetail_Recipients(SentEmailDetailDto d)
    {
        var to = ParseAddressList(d.Destinatari)
            .Select(ExtractEmail)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        var cc = ParseAddressList(d.Cc)
            .Select(ExtractEmail)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        var bcc = ParseAddressList(d.Ccn)
            .Select(ExtractEmail)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        return (to, cc, bcc);
    }

    

    private string GetAttachmentIcon(string? name)
    {
        var s = (name ?? "").ToLowerInvariant();
        if (s.EndsWith(".pdf")) return Icons.Material.Filled.PictureAsPdf;
        if (s.EndsWith(".jpg") || s.EndsWith(".png")) return Icons.Material.Filled.Image;
        if (s.EndsWith(".doc") || s.EndsWith(".docx")) return Icons.Material.Filled.Description;
        if (s.EndsWith(".xls") || s.EndsWith(".xlsx")) return Icons.Material.Filled.TableChart;
        return Icons.Material.Filled.AttachFile;
    }

