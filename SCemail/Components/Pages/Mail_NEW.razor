    private async Task<List<EmailListItem_NEW>> ApplyThreadCountsToPageAsync(List<EmailListItem_NEW> page)
    {
        if (page == null || page.Count == 0)
            return page;

        var result = new List<EmailListItem_NEW>(page.Count);

        foreach (var item in page)
        {
            var realThreadLen = await MailSvc.GetConversationCountByThreadFromRicevuteAsync(item.Id);
            if (realThreadLen <= 0)
                realThreadLen = 1;

            result.Add(item with
            {
                ThreadLen = realThreadLen,
                Replies = Math.Max(0, realThreadLen - 1)
            });
        }

        return result;
    }
