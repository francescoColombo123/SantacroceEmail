    private async Task SelectEmail(int id)
    {
        _selectedId = id;
        _loadingDetail = true;
        _thread.Clear();
        var full = await MailSvc.GetEmailDetailAsync(id, onlyMeta: false);
        if (full != null)
            _thread.Add(full);

        _loadingDetail = false;
        await MailSvc.MarkOpenedAsync(id);
        var opened = _emails.FirstOrDefault(e => e.Id == id);
        if (opened != null)
        {
            opened = opened with { Aperto = "Y" };
            var idx = _emails.FindIndex(e => e.Id == id);
            if (idx >= 0)
                _emails[idx] = opened;
            StateHasChanged();
        }
        _ = Task.Run(async () =>
        {
            var conv = await MailSvc.GetConversationByThreadAsync(id);
            if (conv != null && conv.Count > 1)
            {
                await InvokeAsync(() =>
                {
                    // evita duplicato della mail già caricata
                    foreach (var c in conv)
                        if (!_thread.Any(t => t.Id == c.Id))
                            _thread.Insert(0, c);

                    StateHasChanged();
                });
            }
        });
    }

   private async Task Forward(EmailDetail_NEW msg)
{
    try
    {
        var requireComment = true;

        if (_isAdmin) requireComment = false;
        if (_folder == "unassigned") requireComment = false;

        var parameters = new DialogParameters
        {
            ["Users"] = await MailSvc.GetUserListAsync(),
            ["RequireComment"] = requireComment,
            ["Title"] = "Assegna internamente"
        };

        var dialog = DialogService.Show<ForwardDialog>(
            "Assegna internamente",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true }
        );

        var result = await dialog.Result;

        if (result.Canceled || result.Data is not ForwardDialog.ForwardResult fr)
            return;

        if (requireComment && string.IsNullOrWhiteSpace(fr.AssignedComment))
        {
            Snackbar.Add("Per assegnare è obbligatorio inserire un commento.", Severity.Warning);
            return;
        }

        // =========================
        // 1️⃣ ASSEGNAZIONE
        // =========================
        await MailSvc.AssignEmailAsync(
            msg.Id,
            fr.User,
            soloInvio: false,
            fr.AssignedComment,
            eseguitoDa: _utente,
            keepExecutorUnarchived: fr.FollowMe
        );

        // =========================
        // 2️⃣ COMMENTO MENZIONI
        // =========================
        int? commentId = null;

        if (!string.IsNullOrWhiteSpace(fr.MentionsComment))
        {
            commentId = await MailSvc1.AddCommentAsync(
                emailId: msg.Id,
                autore: _utente!,
                testo: fr.MentionsComment
            );

            await MailSvc1.MarkEmailSeguiteAsUnreadAsync(
                emailId: msg.Id,
                commentId: commentId.Value,
                autore: _utente!
            );
        }

        // =========================
        // 3️⃣ MENZIONATI
        // =========================
        var mentionedUsers = fr.MentionedUsers
            .Where(u => !string.IsNullOrWhiteSpace(u))
            .Select(u => u.Trim().ToLowerInvariant())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        // =========================
        // 4️⃣ UTENTI DA NOTIFICARE
        // =========================
        // qui puoi scegliere se notificare solo i menzionati
        // oppure anche assegnato/proprietari/partecipanti.
        // Ti lascio una versione molto vicina alla logica di AddComment.

        var utentiDaNotificare = mentionedUsers
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (commentId.HasValue)
        {
            foreach (var u in utentiDaNotificare)
            {
                if (u.Equals(_utente, StringComparison.OrdinalIgnoreCase))
                    continue;

                bool isMention = mentionedUsers.Contains(u, StringComparer.OrdinalIgnoreCase);

                await MailSvc1.RegistraEventoChatAsync(
                    emailId: msg.Id,
                    utente: u,
                    isMention: isMention,
                    commentoId: commentId.Value,
                    autore: _utente!
                );
            }
        }

        // =========================
        // 5️⃣ ASSEGNA E SEGUI
        // =========================
        // solo chi assegna viene aggiunto ai seguiti
        if (fr.FollowMe)
        {
            await MailSvc1.EnsureEmailSeguitaAsync(
                msg.Id,
                _utente!,
                commentId
            );
        }

        // =========================
        // 6️⃣ UI
        // =========================
        if (_folder == "unassigned")
        {
            _emails.RemoveAll(x => x.Id == msg.Id);
            _unassignedCount = Math.Max(0, _unassignedCount - 1);
            StateHasChanged();
        }

        Snackbar.Add(
            fr.FollowMe
                ? $"Email assegnata a {fr.User} e aggiunta ai tuoi seguiti ✅"
                : $"Email assegnata a {fr.User} ✅",
            Severity.Success
        );

        Nav.NavigateTo(Nav.Uri, true);
    }
    catch (Exception ex)
    {
        Console.WriteLine($"❌ Errore in Assegna: {ex.Message}");
        Snackbar.Add($"Errore nell'assegnazione: {ex.Message}", Severity.Error);
    }
}
