    private string GetMainRecipientLabel(EmailListItem_NEW item)
    {
        if (!string.IsNullOrWhiteSpace(item.Destinatari))
            return ExtractEmail(item.Destinatari);

        if (!string.IsNullOrWhiteSpace(item.Cc))
            return ExtractEmail(item.Cc);

