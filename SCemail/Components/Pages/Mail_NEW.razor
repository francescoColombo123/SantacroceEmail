    private async Task LoadMoreSezione(SezioneVm sec)
    {
        if (sec.Loading || !sec.HasMore) return;
        if (string.IsNullOrWhiteSpace(_utente)) return;

        sec.Loading = true;
        StateHasChanged();

        try
        {
            _caselleIds ??= await AccessiSrv.GetCaselleAbilitateAsync(_utente!);

            var word = _searchWord;
            var addr = _selectedAddressChip?.Email;

            var (page, total) = await MailSvc.GetEmailPageInSezioneAsync(
                idSezione: sec.IdSezione,
                utente: _utente!,
                casellaIds: _caselleIds!,
                start: sec.Start,
                pageSize: sec.PageSize,
                word: word,
                address: addr
            );

            page = await ApplyThreadCountsToPageAsync(page);

            if (sec.Start == 0)
            {
                sec.Emails = page;
            }
            else
            {
                foreach (var m in page)
                {
                    if (!sec.Emails.Any(x => x.Id == m.Id))
                        sec.Emails.Add(m);
                }
            }

            sec.Start += page.Count;
            sec.HasMore = sec.Emails.Count < total;
        }
        finally
        {
            sec.Loading = false;
            StateHasChanged();
        }
    }

