    private void ApriNuovoPostIt()
    {
        _isEditMode = false;
        _editingPostItId = null;
        _popupTitle = "";
        _popupText = "";
        _showPostItPopup = true;
        _focusPostItTitle = true;
    }

    private void ApriPostIt(PostItDto p)
    {
        _isEditMode = true;
        _editingPostItId = p.Id;
        _popupTitle = p.Titolo;
        _popupText = p.Testo;
        _showPostItPopup = true;
        _focusPostItTitle = true;
    }

    private async Task HandlePostItKeyDown(KeyboardEventArgs e)
    {
        if (!_showPostItPopup)
            return;

        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_popupText))
        {
            await SalvaPostIt();
        }
    }

    private async Task HandlePostItTextKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Tab" && !string.IsNullOrWhiteSpace(_popupText) && _postItSaveRef is not null)
        {
            await _postItSaveRef.FocusAsync();
        }
    }
    private async Task SalvaPostIt()
    {
        if (string.IsNullOrWhiteSpace(_popupText))
            return;

        if (_isEditMode && _editingPostItId.HasValue)
        {
            await postItService.UpdateTitleAsync(_editingPostItId.Value, _popupTitle);
            await postItService.UpdateAsync(_editingPostItId.Value, _popupText);
        }
        else
        {
            await postItService.AddAsync(_utente!, _popupTitle, _popupText);
        }

        _postIts = await postItService.GetByUtenteAsync(_utente!);
        ChiudiPopup();
    }

    private void ChiudiPopup()
    {
        _showPostItPopup = false;
        _editingPostItId = null;
        _focusPostItTitle = false;
    }

