    private async Task LoadMoreSentAsync(bool reset = false)
    {
        if (_sentLoading) return;

        if (reset)
        {
            _sentStart = 0;
            _sentHasMore = true;
            _sentSelectedId = null;
            _sentDetail = null;
            _sent.Clear();
        }

        if (!_sentHasMore) return;
        if (string.IsNullOrWhiteSpace(_utente)) return;

        _sentLoading = true;
        StateHasChanged();

        try
        {
            var res = await MailSvc.GetSentPagedAsync(
                utente: _utente!,
                start: _sentStart,
                pageSize: _pageSize,
                searchText: _sentSearch
            );

            if (_sentStart == 0) _sent = res.Page;
            else _sent.AddRange(res.Page.Where(x => !_sent.Any(s => s.Id == x.Id)));

            _sentStart += _pageSize;
            _sentHasMore = _sent.Count < res.Total;
        }
        finally
        {
            _sentLoading = false;
            StateHasChanged();
        }
    }

