    private static RecipientChip ParseAddressToChip(string raw)
    {
        var m = Regex.Match(raw ?? "", @"^(?<name>.+?)\s*<(?<mail>[^>]+)>\s*$");
        return m.Success
            ? new RecipientChip(m.Groups["mail"].Value.Trim(), m.Groups["name"].Value.Trim())
            : new RecipientChip((raw ?? "").Trim(), null);
    }

    private static string StripHtml(string? html)
    {
        if (string.IsNullOrWhiteSpace(html)) return "";
        return Regex.Replace(html, "<.*?>", " ").Trim();
    }
