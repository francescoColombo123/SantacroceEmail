    private async Task OpenDraft(long draftId)
    {
        var d = await MailSvc.GetDraftByIdAsync(draftId, _utente!);
        await MailSvc.MarkDraftAsReadAsync(d.Id, _utente!);
        if (_draftsUnreadCount > 0)
            _draftsUnreadCount--;
        if (d == null)
        {
            Snackbar.Add("Bozza non trovata", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            ["Utente"] = _utente,
            ["Destinatari"] = d.Destinatari,
            ["Cc"] = d.Cc,
            ["Bcc"] = d.Ccn,
            ["Oggetto"] = d.Oggetto,
            ["CorpoIniziale"] = d.CorpoHtml,
            ["DraftId"] = (long)d.Id
        };


        var dialog = DialogService.Show<ComposeDialog>(
            "Modifica bozza",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true }
        );

        var result = await dialog.Result;

        // opzionale: se inviata, puoi eliminare la bozza
        if (result.Data is true)
        {
            try
            {
                await MailSvc.DeleteDraftAsync(d.Id, _utente!);
                _draftIndex = 0;
                _drafts.Clear();
                _hasMoreDrafts = true;
                await LoadMoreDrafts(_searchText);
            }
            catch { /* non bloccare */ }
        }
    }
