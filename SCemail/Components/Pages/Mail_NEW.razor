    [JSInvokable]
    public async Task OnAnyScrollBottom(string elementId)
    {
        Console.WriteLine($"SCROLL BOTTOM da: {elementId} | folder={_folder}");

        if (_scrollLoadLocks.Contains(elementId))
            return;

        _scrollLoadLocks.Add(elementId);

        try
        {
            if (elementId == "mailScroll")
            {
                Console.WriteLine("👉 mailScroll triggerato");

                if (_folder == "sent")
                {
                    if (!_sentLoading && _sentHasMore)
                        await LoadMoreSentAsync();
                    return;
                }

                if (_folder == "drafts")
                {
                    if (!_loadingDrafts && _hasMoreDrafts)
                        await LoadMoreDrafts(_searchText);
                    return;
                }

                if (!_loadingEmails && _hasMore)
                    await LoadMoreEmails(_caselleIds, filtro: _searchWord);

                return;
            }

            if (elementId == "inboxScroll")
            {
                Console.WriteLine("👉 inboxScroll triggerato");

                if (!_loadingEmails && _hasMore)
                    await LoadMoreEmails(_caselleIds, filtro: _searchWord);

                return;
            }

            var sec = _sezioniVm.FirstOrDefault(s => s.ScrollDivId == elementId);
            if (sec != null)
            {
                Console.WriteLine($"👉 sezione triggerata: {sec.Nome}");
                await LoadMoreSezione(sec);
            }
        }
        finally
        {
            _scrollLoadLocks.Remove(elementId);
        }
    }

