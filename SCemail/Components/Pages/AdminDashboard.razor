@page "/admin-dashboard"
@using MudBlazor
@using SCemail.Components.Data
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.JSInterop

@inject NavigationManager Nav
@inject MailService_NEW MailSvc
@inject AccessiService AccessiSrv
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>Dashboard Amministrazione</PageTitle>

@if (_loading)
{
    <div class="admin-loading">
        <div class="dots-loader">
            <span class="dot"></span>
            <span class="dot"></span>
            <span class="dot"></span>
        </div>

        <span>Caricamento dashboard…</span>
    </div>
}
else
{
    <div class="admin-wrapper">

        <!-- HEADER -->
        <div class="admin-header">

            <div class="title-wrap">
                <MudIcon Icon="@Icons.Material.Filled.ManageAccounts"
                         Class="header-icon" />

                <div>
                    <h1>Dashboard Amministrazione</h1>

                    <div class="subtitle">
                        panoramica utenti e sezioni inbox
                    </div>
                </div>
            </div>

            <div class="header-actions">

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.Home"
                           OnClick="ReturnToHome">
                    Home
                </MudButton>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.ArrowBack"
                           OnClick="@ReturnToMail">
                    Torna alla Posta
                </MudButton>

            </div>

        </div>

        <!-- FILTRI -->
        <MudPaper Class="filter-bar"
                  Elevation="1"
                  @key="_filtersKey">

            <MudSelect T="string"
                       Label="Filtra per utente"
                       Value="_filtroUtente"
                       ValueChanged="@(v => { _filtroUtente = v; ApplicaFiltri(); })">

                <MudSelectItem T="string"
                               Value="@null">
                    Tutti
                </MudSelectItem>

                @foreach (var u in _utenti)
                {
                    <MudSelectItem T="string"
                                   Value="@u">
                        @u
                    </MudSelectItem>
                }

            </MudSelect>

            <div class="filter-buttons">

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.FilterList"
                           OnClick="ApplicaFiltri">
                    Applica
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="ResetFiltri">
                    Reset
                </MudButton>

            </div>

        </MudPaper>

        <!-- CARDS -->
        <div class="user-cards">

            @foreach (var u in _usersHomeFiltrati)
            {
                <MudPaper Class="user-card"
                          Elevation="3">

                    <!-- TESTATA -->
                    <div class="user-head">

                        <div class="avatar">
                            @GetInitial(u.Utente)
                        </div>

                        <div class="uh-info">
                            <div class="uh-name">
                                @u.Utente
                            </div>
                        </div>

                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   Disabled="@string.IsNullOrWhiteSpace(u.Cp)"
                                   OnClick="@(() => ApriWorkspaceUtente(u))">
                            Apri
                        </MudButton>

                    </div>

                    <!-- COUNTERS -->
                    <div class="mini-board">

                        <div class="mini-stat c-open">
                            <span>Assegnate</span>
                            <strong>@u.InboxCount</strong>
                        </div>

                        <div class="mini-stat c-new">
                            <span>Nuove</span>
                            <strong>@u.UnreadCount</strong>
                        </div>

                        <div class="mini-stat c-follow">
                            <span>Seguite</span>
                            <strong>@u.SeguiteCount</strong>
                        </div>

                        <div class="mini-stat c-mention">
                            <span>Menzioni</span>
                            <strong>@u.MentionsCount</strong>
                        </div>

                    </div>

                    <!-- SEZIONI -->
                    @if (u.Sezioni.Any())
                    {
                        <div class="uc-section">

                            <div class="sec-title">
                                Sezioni inbox
                            </div>

                            @foreach (var s in u.Sezioni)
                            {
                                <div class="section-row"
                                     @onclick="@(() => ApriSezioneUtente(u, s))">

                                    <span>@s.Nome</span>

                                    <strong>@s.Count</strong>

                                </div>
                            }

                        </div>
                    }

                </MudPaper>
            }

        </div>

    </div>
}

@code {

    private bool _loading = true;

    private string? _cp;
    private string? _utente;

    private string? _filtroUtente;

    private int _filtersKey = 0;

    private List<string> _utenti = new();

    private List<AdminUserHomeDto> _usersHome = new();

    private List<AdminUserHomeDto> _usersHomeFiltrati = new();

    // =========================================================
    // DTO
    // =========================================================

    private sealed class AdminUserHomeDto
    {
        public string Utente { get; set; } = "";

        public string? Cp { get; set; }

        public int InboxCount { get; set; }

        public int UnreadCount { get; set; }

        public int SeguiteCount { get; set; }

        public int MentionsCount { get; set; }

        public List<AdminUserSectionDto> Sezioni { get; set; } = new();
    }

    private sealed class AdminUserSectionDto
    {
        public long Id { get; set; }

        public string Codice { get; set; } = "";

        public string Nome { get; set; } = "";

        public int Count { get; set; }
    }

    // =========================================================
    // INIT
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        _loading = true;

        try
        {
            var uri = Nav.ToAbsoluteUri(Nav.Uri);

            var q = QueryHelpers.ParseQuery(uri.Query);

            _cp = q.TryGetValue("cp", out var v)
                && !string.IsNullOrWhiteSpace(v)
                    ? v.ToString()
                    : null;

            _utente = await AccessiSrv.GetUtenteFromCpAsync(_cp);

            _utenti = (await AccessiSrv.GetUserListAsync())
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(x => x)
                .ToList();

            await LoadUsersHomeAsync();

            _usersHomeFiltrati =
                new List<AdminUserHomeDto>(_usersHome);
        }
        catch (Exception ex)
        {
            Console.WriteLine("❌ Errore dashboard admin: " + ex);

            Snackbar.Add(
                "Errore durante il caricamento della dashboard",
                Severity.Error);
        }
        finally
        {
            _loading = false;

            StateHasChanged();
        }
    }

    // =========================================================
    // LOAD USERS
    // =========================================================

    private async Task LoadUsersHomeAsync()
    {
        var result = new List<AdminUserHomeDto>();

        using var semaphore = new SemaphoreSlim(8);

        var tasks = _utenti.Select(async u =>
        {
            await semaphore.WaitAsync();

            try
            {
                var utenteNorm =
                    u.Trim().ToLowerInvariant();

                var item = new AdminUserHomeDto
                {
                    Utente = u,

                    Cp = await MailSvc
                        .GetLatestCpByUserAsync(utenteNorm)
                };

                // =========================================
                // INBOX
                // =========================================

                try
                {
                    var inbox =
                        await MailSvc
                            .GetInboxHomeCountsAsync(utenteNorm);

                    item.InboxCount =
                        inbox.TotalInbox;

                    item.UnreadCount =
                        inbox.UnreadInbox;
                }
                catch
                {
                    item.InboxCount = 0;
                    item.UnreadCount = 0;
                }

                // =========================================
                // SEGUITE
                // =========================================

                try
                {
                    var (_, totalSeguite) =
                        await MailSvc
                            .GetFollowedEmailsPagedAsync(
                                utenteNorm,
                                0,
                                1,
                                null,
                                null);

                    item.SeguiteCount =
                        totalSeguite;
                }
                catch
                {
                    item.SeguiteCount = 0;
                }

                // =========================================
                // MENZIONI
                // =========================================

                try
                {
                    item.MentionsCount =
                        await MailSvc
                            .GetUnreadMentionsCountAsync(
                                utenteNorm);
                }
                catch
                {
                    item.MentionsCount = 0;
                }

                // =========================================
                // SEZIONI
                // =========================================

                try
                {
                    var sezioni = await MailSvc.GetAdminSectionsForUserAsync(utenteNorm);

                    item.Sezioni = sezioni
                        .Select(x => new AdminUserSectionDto
                        {
                            Id = x.Id,
                            Codice = x.Codice,
                            Nome = x.Nome,
                            Count = x.Count
                        })
                        .Where(x => x.Count > 0)
                        .OrderByDescending(x => x.Count)
                        .ToList();
                }
                catch
                {
                    item.Sezioni = new();
                }

                lock (result)
                {
                    result.Add(item);
                }
            }
            finally
            {
                semaphore.Release();
            }
        });

        await Task.WhenAll(tasks);

        _usersHome = result
            .Where(x =>
                x.InboxCount > 0
                || x.UnreadCount > 0
                || x.SeguiteCount > 0
                || x.MentionsCount > 0
                || x.Sezioni.Any())
            .OrderBy(x => x.Utente)
            .ToList();
    }

    // =========================================================
    // FILTRI
    // =========================================================

    private void ApplicaFiltri()
    {
        IEnumerable<AdminUserHomeDto> users =
            _usersHome;

        if (!string.IsNullOrWhiteSpace(_filtroUtente))
        {
            users = users.Where(x =>
                x.Utente.Equals(
                    _filtroUtente,
                    StringComparison.OrdinalIgnoreCase));
        }

        _usersHomeFiltrati = users
            .OrderBy(x => x.Utente)
            .ToList();

        StateHasChanged();
    }

    private void ResetFiltri()
    {
        _filtroUtente = null;

        _usersHomeFiltrati =
            new List<AdminUserHomeDto>(_usersHome);

        _filtersKey++;

        StateHasChanged();
    }

    // =========================================================
    // NAVIGAZIONE
    // =========================================================

    private async Task ApriWorkspaceUtente(
        AdminUserHomeDto u)
    {
        if (string.IsNullOrWhiteSpace(u.Cp))
        {
            Snackbar.Add(
                "CP utente non trovato.",
                Severity.Warning);

            return;
        }

        var url =
            $"/mail-new?cp={Uri.EscapeDataString(u.Cp)}&folder=inbox";

        await JS.InvokeVoidAsync(
            "open",
            url,
            "_blank");
    }

    private async Task ApriSezioneUtente(
        AdminUserHomeDto u,
        AdminUserSectionDto s)
    {
        if (string.IsNullOrWhiteSpace(u.Cp))
        {
            Snackbar.Add(
                "CP utente non trovato.",
                Severity.Warning);

            return;
        }

        var url =
            $"/mail-new?cp={Uri.EscapeDataString(u.Cp)}&folder=inbox&section={s.Id}";

        await JS.InvokeVoidAsync(
            "open",
            url,
            "_blank");
    }

    private void ReturnToHome()
    {
        Nav.NavigateTo(
            string.IsNullOrWhiteSpace(_cp)
                ? "/"
                : $"/?cp={Uri.EscapeDataString(_cp)}");
    }

    private void ReturnToMail()
    {
        Nav.NavigateTo(
            string.IsNullOrWhiteSpace(_cp)
                ? "/mail-new"
                : $"/mail-new?cp={Uri.EscapeDataString(_cp)}");
    }

    // =========================================================
    // HELPERS
    // =========================================================

    private static string GetInitial(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "?";

        return value
            .Trim()[0]
            .ToString()
            .ToUpperInvariant();
    }
}

<style>

    .admin-wrapper {
        padding: 28px;
        background: #f5f8ff;
        min-height: 100vh;
    }

    .admin-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        margin-bottom: 24px;
        padding: 16px 18px;
        border-radius: 18px;
        background: linear-gradient(135deg, #eaf2ff, #ffffff);
        border: 1px solid #d9e6ff;
    }

    .title-wrap {
        display: flex;
        align-items: center;
        gap: 14px;
    }

        .title-wrap h1 {
            margin: 0;
            font-size: 25px;
            color: #163a72;
        }

    .subtitle {
        margin-top: 3px;
        color: #607090;
        font-size: 13px;
        font-weight: 600;
    }

    .header-icon {
        font-size: 38px;
        color: #1a73e8;
    }

    .header-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .filter-bar {
        padding: 18px;
        border-radius: 16px;
        margin-bottom: 18px;
        border: 1px solid #e0e7f5;
    }

    .filter-buttons {
        margin-top: 14px;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }

    .user-cards {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(390px, 1fr));
        gap: 22px;
    }

    .user-card {
        border-radius: 18px;
        padding: 18px;
        background: white;
        border: 1px solid #e0e7f5;
    }

    .user-head {
        display: flex;
        gap: 14px;
        align-items: center;
        margin-bottom: 14px;
    }

    .avatar {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: #1a73e8;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        font-weight: 800;
        flex-shrink: 0;
    }

    .uh-info {
        flex: 1;
        min-width: 0;
    }

    .uh-name {
        font-size: 18px;
        font-weight: 800;
        color: #1f2937;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .mini-board {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 8px;
        margin-bottom: 14px;
    }

    .mini-stat {
        border-radius: 13px;
        padding: 10px;
        background: #f8fbff;
        border: 1px solid #e1eaf8;
    }

        .mini-stat span {
            display: block;
            font-size: 11px;
            font-weight: 800;
            color: #667085;
        }

        .mini-stat strong {
            display: block;
            margin-top: 4px;
            font-size: 20px;
            font-weight: 900;
        }

    .c-open strong {
        color: #1a73e8;
    }

    .c-new strong {
        color: #d62828;
    }

    .c-follow strong {
        color: #7c3aed;
    }

    .c-mention strong {
        color: #f59e0b;
    }

    .uc-section {
        margin-top: 14px;
        padding-top: 12px;
        border-top: 1px solid #edf2fb;
    }

    .sec-title {
        font-weight: 800;
        margin-bottom: 8px;
        color: #263b63;
    }

    .section-row {
        display: flex;
        gap: 10px;
        align-items: center;
        padding: 8px 7px;
        border-bottom: 1px solid #edf2fb;
        cursor: pointer;
        border-radius: 8px;
    }

        .section-row:hover {
            background: #eef4ff;
        }

        .section-row span {
            flex: 1;
            color: #344767;
            font-weight: 600;
        }

        .section-row strong {
            color: #166aee;
            font-weight: 900;
        }

    .admin-loading {
        min-height: 100vh;
        display: flex;
        gap: 12px;
        align-items: center;
        justify-content: center;
        color: #607090;
        font-weight: 700;
        background: #f5f8ff;
    }

    .dots-loader {
        display: inline-flex;
        gap: 5px;
    }

    .dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #1a73e8;
        animation: bounce 1s infinite alternate;
    }

        .dot:nth-child(2) {
            animation-delay: .15s;
        }

        .dot:nth-child(3) {
            animation-delay: .3s;
        }

    @@keyframes bounce {

        from {
            transform: translateY(0);
            opacity: .5;
        }

        to {
            transform: translateY(-7px);
            opacity: 1;
        }
    }

    @@media (max-width: 900px) {

        .admin-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .mini-board {
            grid-template-columns: repeat(2, 1fr);
        }
    }
</style>