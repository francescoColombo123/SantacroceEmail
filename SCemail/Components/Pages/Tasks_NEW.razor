@code {

    private bool _showMention;
    private ElementReference _anchorRef;
    private List<string> _mentionOptions = new();
    private string? _mentionActive;

    private List<string> _allUsers = new();

    [Parameter, SupplyParameterFromQuery] public string? Cp { get; set; }
    [Parameter, SupplyParameterFromQuery] public int? OpenTaskId { get; set; }
    [Parameter, SupplyParameterFromQuery] public string? View { get; set; } // toClose | waiting
    private string? _utente;

    private List<TaskDto> _items = new();
    private TaskDto? _sel;
    private string? _q;

    private List<TaskCommentDto> _comments = new();
    private Dictionary<int, int> _commentCounts = new();
    private HashSet<int> _taggedTaskIds = new();

    private string? _filter;
    private bool _onlyMentions;
    private string? _newText;
    private bool _loaded;
    private string _scope = "mine";
    private int _tabIndex = 0;

    private string? _homeView;
    private HashSet<int> _canCloseById = new();
    private HashSet<int> _iMarkedDone = new();
    private enum TaskView
    {
        Open,       // aperti che mi riguardano (assegnati a me OR creati da me)
        Closed,     // chiusi che mi riguardano (assegnati a me OR creati da me)
        Mentioned,  // task dove sono menzionato (indipendente da creatore/assegnatari)
        OpenByMe    // aperti creati da me
    }

    private TaskView _view = TaskView.Open;
    private void OnTabChanged(int idx)
    {
        _tabIndex = idx;

        _filter = idx switch
        {
            1 => TaskStati.Aperto,
            2 => TaskStati.Chiuso,
            _ => null
        };
    }
    private void OnCommentChanged(string value)
    {
        _newText = value;
        UpdateMentionState();
    }

    private void SetView(TaskView v)
    {
        _view = v;
        _sel = null;
        _comments.Clear();

        StateHasChanged();
    }

    protected override async Task OnParametersSetAsync()
    {
        _loaded = false;

        _items.Clear();
        _commentCounts.Clear();
        _taggedTaskIds.Clear();
        _canCloseById.Clear();
        _iMarkedDone.Clear();

        _sel = null;
        _comments.Clear();

        _homeView = string.IsNullOrWhiteSpace(View) ? null : View.Trim(); // toClose | waiting

        if (!string.IsNullOrWhiteSpace(Cp))
        {
            _utente = await AccessiSrv.GetUtenteFromCpAsync(Cp);

            if (!string.IsNullOrWhiteSpace(_utente))
            {
                _allUsers = (await MailSvc.GetUserListAsync()) ?? new List<string>();

                // ✅ IMPORTANT: passa OpenTaskId per aprire subito un task
                await ReloadTasksAndBadgesAsync(selectTaskId: OpenTaskId);
            }
        }

        _loaded = true;
        StateHasChanged();
    }

    private string GetTaskItemClass(bool tagged, TaskDto t)
    {
        var cls = "task-item";
        if (tagged) cls += " tagged";
        if (string.Equals(t.Stato, TaskStati.Chiuso, StringComparison.OrdinalIgnoreCase)) cls += " closed";
        return cls;
    }
    private IEnumerable<TaskDto> Filtered()
    {
        if (string.IsNullOrWhiteSpace(_utente))
            return Enumerable.Empty<TaskDto>();

        var me = _utente.Trim().ToLowerInvariant();
        IEnumerable<TaskDto> q = _items;

        bool IsMeCreator(TaskDto t)
            => string.Equals(t.CreatoDa?.Trim(), me, StringComparison.OrdinalIgnoreCase);

        bool IsMeAssignee(TaskDto t)
            => t.AssegnatiA?.Any(a => string.Equals(a?.Trim(), me, StringComparison.OrdinalIgnoreCase)) == true;

        bool IsOpen(TaskDto t)
            => !string.Equals(t.Stato, TaskStati.Chiuso, StringComparison.OrdinalIgnoreCase);

        bool IsClosed(TaskDto t)
            => string.Equals(t.Stato, TaskStati.Chiuso, StringComparison.OrdinalIgnoreCase);

        // ✅ 1) Applico la VISTA
        q = _view switch
        {
            TaskView.Open =>
                q.Where(t => (IsMeAssignee(t) || IsMeCreator(t)) && IsOpen(t)),

            TaskView.Closed =>
                q.Where(t => (IsMeAssignee(t) || IsMeCreator(t)) && IsClosed(t)),

            TaskView.Mentioned =>
                q.Where(t => _taggedTaskIds.Contains(t.Id)), // menzionati (da commenti)

            TaskView.OpenByMe =>
                q.Where(t => IsMeCreator(t) && IsOpen(t)),

            _ => q
        };
        if (_homeView == "toClose")
        {
            // Creati da me + pronti da chiudere (assegnatario ha scritto "Fatto")
            q = q.Where(t => _canCloseById.Contains(t.Id));
        }
        else if (_homeView == "waiting")
        {
            // Task dove IO ho scritto "Fatto" e attendo la chiusura del creatore
            q = q.Where(t => _iMarkedDone.Contains(t.Id));
        }
        // ✅ 2) Filtro “Solo menzioni” (ha senso SOLO se NON sei già in vista Mentioned)
        if (_onlyMentions && _view != TaskView.Mentioned)
            q = q.Where(t => _taggedTaskIds.Contains(t.Id));

        // ✅ 3) Ordinamento
        if (_view == TaskView.Closed)
        {
            q = q.OrderByDescending(x => x.DataChiusura ?? DateTime.MinValue)
                 .ThenByDescending(x => x.DataCreazione);
        }
        else
        {
            q = q.OrderBy(x => x.DataScadenza.HasValue ? 0 : 1)
                 .ThenBy(x => x.DataScadenza ?? DateTime.MaxValue)
                 .ThenByDescending(x => x.DataCreazione);
        }
        if (!string.IsNullOrWhiteSpace(_q))
        {
            var term = _q.Trim();
            q = q.Where(t =>
                (!string.IsNullOrWhiteSpace(t.Titolo) && t.Titolo.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrWhiteSpace(t.DescrizioneMarkdown) && t.DescrizioneMarkdown.Contains(term, StringComparison.OrdinalIgnoreCase))
            );
        }
        return q;
    }

    private MarkupString RenderCommentPretty(string? txt)
    {
        if (string.IsNullOrWhiteSpace(txt)) return (MarkupString)"";

        var safe = System.Net.WebUtility.HtmlEncode(txt);

        // evidenzia @user (anche se arrivasse come &#64;)
        safe = Regex.Replace(
            safe,
            @"(?:&#64;|@)([a-zA-Z0-9_.-]+)",
            m => $"<span class=\"mention\">@{m.Groups[1].Value}</span>"
        );

        if (IsDoneComment(txt))
        {
            var cleaned = Regex.Replace(safe, @"\b(fatto|done|completato|completata)\b", "", RegexOptions.IgnoreCase).Trim();
            safe = $"<span class=\"done-badge\">✅ FATTO</span> {(string.IsNullOrWhiteSpace(cleaned) ? "" : cleaned)}";
        }

        return (MarkupString)safe;
    }

    private void SetFilter(string? s) => _filter = s;

    private async Task SelectTask(TaskDto t)
    {
        // ✅ segna visto (azzera UNREAD_COUNT)
        if (!string.IsNullOrWhiteSpace(_utente))
            await TaskClient.MarkTaskSeenAsync(t.Id, _utente.Trim().ToLowerInvariant());
        _sel = t;

        var cs = await TaskClient.GetCommentsAsync(t.Id);
        _comments = cs ?? new();

        // ricalcolo permesso chiusura creatore in base ai commenti
        _canCloseCreator = _sel is not null && IsCreator(_sel) && CreatorHasAssigneeDoneComment(_sel);
    }

    private async Task TryCloseTask()
    {
        if (_sel is null || string.IsNullOrWhiteSpace(_utente))
            return;

        if (!IsCreator(_sel))
            return; // solo creatore

        // se è assegnato a qualcuno, richiedo che ci sia almeno 1 commento di un assegnatario
        if (!CreatorHasAssigneeDoneComment(_sel))
            return;

        var me = _utente.Trim().ToLowerInvariant();

        await TaskClient.CloseAsync(_sel.Id, new CloseTaskRequest(Utente: me, Commento: null));
        ApplyLocalClosed(me);
    }
    private void QuickDoneComment()
    {
        if (_sel is null) return;

        var creator = _sel.CreatoDa?.Trim();
        _newText = string.IsNullOrWhiteSpace(creator)
            ? "Fatto ✅"
            : $"Fatto ✅ @{creator}";

        UpdateMentionState();
        StateHasChanged();
    }

    private void ApplyLocalClosed(string chiusoDa)
    {
        if (_sel is null) return;

        _sel = _sel with { Stato = TaskStati.Chiuso, DataChiusura = DateTime.Now, ChiusoDa = chiusoDa };

        var idx = _items.FindIndex(x => x.Id == _sel.Id);
        if (idx >= 0) _items[idx] = _sel;

        StateHasChanged();
    }

    private async Task<string?> PromptCloseCommentAsync()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = DialogService.Show<CloseCommentDialog>("Chiudi task", options);
        var res = await dialog.Result;
        if (res.Canceled) return null;
        return res.Data as string;
    }

    private async Task PostComment()
    {
        if (_sel is null || string.IsNullOrWhiteSpace(_newText) || string.IsNullOrWhiteSpace(_utente))
            return;

        var me = _utente.Trim().ToLowerInvariant();

        var id = await TaskClient.AddCommentAsync(_sel.Id, me, _newText);
        _comments.Add(new TaskCommentDto(id, _sel.Id, me, _newText!, DateTime.Now, null));
        _newText = "";

        _commentCounts[_sel.Id] = (_commentCounts.TryGetValue(_sel.Id, out var ct) ? ct : 0) + 1;

        var meRx = new Regex(@$"(?<=^|\s)@{Regex.Escape(me)}\b", RegexOptions.IgnoreCase);
        if (meRx.IsMatch((_comments.LastOrDefault()?.Testo) ?? "")) _taggedTaskIds.Add(_sel.Id);
        if (_sel is not null)
            _canCloseCreator = IsCreator(_sel) && CreatorHasAssigneeDoneComment(_sel);

        StateHasChanged();
    }

    private MarkupString RenderMentionsHtml(string? txt)
    {
        if (string.IsNullOrEmpty(txt)) return (MarkupString)"";
        var safe = System.Net.WebUtility.HtmlEncode(txt);
        var html = Regex.Replace(safe, @"&#64;([a-zA-Z0-9_.-]+)", m => $"<span class=\"mention\">@{m.Groups[1].Value}</span>");
        return (MarkupString)html;
    }

    private void UpdateMentionState()
    {
        var txt = _newText ?? string.Empty;
        if (string.IsNullOrWhiteSpace(txt)) { _showMention = false; StateHasChanged(); return; }

        var last = txt.Split(' ').LastOrDefault() ?? string.Empty;
        if (!last.StartsWith("@")) { _showMention = false; StateHasChanged(); return; }

        var term = last.Length > 1 ? last[1..] : string.Empty;
        _mentionOptions = string.IsNullOrWhiteSpace(term)
            ? _allUsers.Take(12).ToList()
            : _allUsers.Where(u => u.Contains(term, StringComparison.OrdinalIgnoreCase)).Take(12).ToList();

        _mentionActive = _mentionOptions.FirstOrDefault();
        _showMention = _mentionOptions.Any();
        StateHasChanged();
    }

    private void PickMention(string user)
    {
        var parts = (_newText ?? "").TrimEnd().Split(' ').ToList();
        for (int i = parts.Count - 1; i >= 0; i--)
        {
            if (parts[i].StartsWith("@")) { parts[i] = "@" + user; break; }
        }
        _newText = string.Join(' ', parts) + " ";
        _showMention = false;
        InvokeAsync(StateHasChanged);
    }
    private void SetScope(string s)
    {
        _scope = s;
        _sel = null;
        _comments.Clear();
        StateHasChanged();
    }

    private static string MarkdownToHtml(string md)
    {
        if (string.IsNullOrWhiteSpace(md)) return "";
        var html = System.Net.WebUtility.HtmlEncode(md);
        html = Regex.Replace(html, @"\*\*(.+?)\*\*", "<b>$1</b>");
        html = html.Replace("\r\n", "\n").Replace("\n", "<br>");
        return html;
    }
    private async Task OpenCreateTask()
    {
        if (string.IsNullOrWhiteSpace(_utente))
            return;

        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        // NIENTE parameters (come il tuo dialog "Firma")
        var dialog = DialogService.Show<CreateTaskDialog>("", options);
        var res = await dialog.Result;

        if (res.Canceled || res.Data is null)
            return;

        // il dialog ritorna CreateTaskDialogResult, NON CreateTaskRequest
        var data = (CreateTaskDialog.CreateTaskDialogResult)res.Data;

        var req = new CreateTaskRequest(
            CreatoDa: _utente.Trim().ToLowerInvariant(),
            Titolo: data.Titolo,
            DescrizioneMarkdown: data.DescrizioneHtml,
            DataScadenza: data.DataScadenza,
            AssegnatiA: data.AssegnatiA ?? new List<string>(),
            EmailId: null
        );

        var newId = await TaskClient.CreateAsync(req);

        await ReloadTasksAndBadgesAsync(selectTaskId: newId);
    }


    private async Task ReloadTasksAndBadgesAsync(int? selectTaskId = null)
    {
        _loaded = false;

        _items = await TaskClient.GetForUserAsync(_utente!) ?? new();

        _commentCounts.Clear();
        _taggedTaskIds.Clear();
        _canCloseById.Clear();
        _iMarkedDone.Clear();
        _comments.Clear();
        _sel = null;

        var me = _utente!.Trim().ToLowerInvariant();

        foreach (var t in _items)
        {
            var cs = await TaskClient.GetCommentsAsync(t.Id) ?? new List<TaskCommentDto>();
            _commentCounts[t.Id] = cs.Count;

            // menzioni
            var rx = new Regex(@$"(?<=^|\s)@{Regex.Escape(_utente!)}\b", RegexOptions.IgnoreCase);
            if (cs.Any(c => rx.IsMatch(c.Testo ?? "")))
                _taggedTaskIds.Add(t.Id);

            // ✅ set per filtri HOME (toClose / waiting)
            bool isOpen = !string.Equals(t.Stato, TaskStati.Chiuso, StringComparison.OrdinalIgnoreCase);

            if (isOpen)
            {
                var creator = (t.CreatoDa ?? "").Trim().ToLowerInvariant();

                var assignees = new HashSet<string>(
                    (t.AssegnatiA ?? new List<string>())
                        .Where(x => !string.IsNullOrWhiteSpace(x))
                        .Select(x => x.Trim().ToLowerInvariant()),
                    StringComparer.OrdinalIgnoreCase
                );

                bool anyAssigneeDone = assignees.Count > 0 && cs.Any(c =>
                    !string.IsNullOrWhiteSpace(c.Utente) &&
                    assignees.Contains(c.Utente.Trim().ToLowerInvariant()) &&
                    IsDoneComment(c.Testo)
                );

                bool iDone = cs.Any(c =>
                    !string.IsNullOrWhiteSpace(c.Utente) &&
                    string.Equals(c.Utente.Trim().ToLowerInvariant(), me, StringComparison.OrdinalIgnoreCase) &&
                    IsDoneComment(c.Testo)
                );

                // toClose: creato da me + un assegnatario ha fatto
                if (creator == me && anyAssigneeDone)
                    _canCloseById.Add(t.Id);

                // waiting: assegnato a me + io ho fatto + creato da altri
                bool isAssignedToMe = assignees.Contains(me);
                if (creator != me && isAssignedToMe && iDone)
                    _iMarkedDone.Add(t.Id);
            }
        }

        // ✅ apri task se richiesto
        if (selectTaskId is int id && id > 0)
        {
            var found = _items.FirstOrDefault(x => x.Id == id);
            if (found is not null)
                await SelectTask(found);
        }

        _loaded = true;
        StateHasChanged();
    }

    private bool _canCloseCreator;

    private bool IsCreator(TaskDto t)
    {
        if (string.IsNullOrWhiteSpace(_utente)) return false;
        var me = _utente.Trim();
        return string.Equals(t.CreatoDa?.Trim(), me, StringComparison.OrdinalIgnoreCase);
    }

    private bool IsAssigned(TaskDto t)
    {
        if (string.IsNullOrWhiteSpace(_utente)) return false;
        var me = _utente.Trim();
        return t.AssegnatiA?.Any(a => string.Equals(a?.Trim(), me, StringComparison.OrdinalIgnoreCase)) == true;
    }

    // il creatore può chiudere SOLO se almeno un assegnatario ha commentato
    private bool CreatorHasAssigneeDoneComment(TaskDto t)
    {
        if (t.AssegnatiA?.Any() != true) return true; // se non è assegnato a nessuno, può chiudere liberamente

        var assignees = new HashSet<string>(
            t.AssegnatiA.Where(x => !string.IsNullOrWhiteSpace(x)).Select(x => x.Trim().ToLowerInvariant()), 
            StringComparer.OrdinalIgnoreCase
        );

        return _comments.Any(c =>
                !string.IsNullOrWhiteSpace(c.Utente) &&
                assignees.Contains(c.Utente.Trim().ToLowerInvariant()) &&
                IsDoneComment(c.Testo)
            );
    }

