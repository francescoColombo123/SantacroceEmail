@page "/tasks-new"
@using System.Text.RegularExpressions
@using MudBlazor
@using SCemail.Components.Data
@using SCemail.Components.Pages

@inject IEmailTasksClient TaskClient
@inject NavigationManager Nav
@inject SCemail.Components.Data.AccessiService AccessiSrv
@inject IDialogService DialogService
@inject MailService_NEW MailSvc

<PageTitle>GS – Task (NEW)</PageTitle>

<div class="page-wrapper">
    <div class="task-topbar">
        <MudButton Variant="Variant.Filled" Color="Color.Info" StartIcon="@Icons.Material.Filled.Home" OnClick="@GoHome">
            Home
        </MudButton>

        <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Mail" OnClick="@GoToMail">
            Vai alle Mail
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.AddTask"
                   OnClick="@OpenCreateTask"
                   Disabled="@(!_loaded || string.IsNullOrWhiteSpace(_utente))">
            Nuovo task
        </MudButton>
    </div>

    <div class="task-layout">
        <!-- LISTA -->
        <MudPaper Class="task-panel">
            <div class="panel-header">
                <MudIcon Icon="@Icons.Material.Filled.ListAlt" />
                <span>Task di @_utente</span>
            </div>

            <div class="filters">
                <MudTextField T="string"
                              @bind-Value="_q"
                              Placeholder="Cerca titolo / descrizione…"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Dense="true"
                              Class="filter-search" />

                <MudToggleGroup T="TaskView"
                                @bind-Value="_view"
                                Exclusive="true"
                                Color="Color.Primary"
                                Dense="true"
                                Class="filter-toggle"
                                Size="Size.Small">
                    <MudToggleItem Value="TaskView.Open" Text="Aperti" />
                    <MudToggleItem Value="TaskView.Closed" Text="Chiusi" />
                    <MudToggleItem Value="TaskView.Mentioned" Text="Menzionati" />
                    <MudToggleItem Value="TaskView.OpenByMe" Text="Aperti da me" />
                </MudToggleGroup>

                <div class="filter-right">
                    <MudSwitch T="bool" @bind-Checked="_onlyMentions" Color="Color.Primary" Dense="true" />
                    <MudText Typo="Typo.caption" Class="filter-right-text">Solo menzioni</MudText>
                </div>
            </div>


            <div class="task-list">
                @if (!_loaded)
                {
                    <MudProgressCircular Indeterminate />
                }
                else if (!Filtered().Any())
                {
                    <MudText Typo="Typo.caption">Nessun task.</MudText>
                }
                else
                {
                    @foreach (var t in Filtered())
{
    var tagged = _taggedTaskIds.Contains(t.Id);
    var selected = _sel?.Id == t.Id;

    <MudPaper Class="@($"task-row {(selected ? "sel" : "")} {(tagged ? "tag" : "")}")"
              Elevation="0"
              @onclick="@(() => SelectTask(t))">

        <div class="row-main">
            <div class="row-title" title="@t.Titolo">@t.Titolo</div>

            <div class="row-badges">
                @if (tagged)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" Class="chip">
                        &#64;@_utente
                    </MudChip>
                }

                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Chat" Class="chip">
                    @(_commentCounts.TryGetValue(t.Id, out var c) ? c : 0)
                </MudChip>

                <MudChip T="string" Size="Size.Small"
                            Color="@(t.Stato == TaskStati.Chiuso ? Color.Success : Color.Info)"
                            Variant="Variant.Filled"
                            Class="chip">
                    @t.Stato
                </MudChip>
            </div>
        </div>

        <div class="row-meta">
            <span>@t.DataCreazione.ToString("dd/MM/yyyy HH:mm")</span>
            @if (t.DataScadenza is not null)
            {
                <span class="due"> • Scad: @t.DataScadenza.Value.ToString("dd/MM/yyyy HH:mm")</span>
            }
            @if (string.Equals(t.CreatoDa?.Trim(), _utente?.Trim(), StringComparison.OrdinalIgnoreCase))
            {
                <span> • Creato da te</span>
            }
            else if (t.AssegnatiA?.Any(a => string.Equals(a?.Trim(), _utente?.Trim(), StringComparison.OrdinalIgnoreCase)) == true)
            {
                <span> • Assegnato a te</span>
            }
        </div>
    </MudPaper>
}

                }
            </div>
        </MudPaper>

        <!-- DETTAGLIO -->
        <MudPaper Class="task-panel">
            <div class="panel-header">Dettaglio</div>
            <div class="panel-body">
                @if (_sel is null)
                {
                    <MudText Typo="Typo.caption">Seleziona un task</MudText>
                }
                else
                {
                    <div class="detail-header">
                        <MudText Typo="Typo.h6">@(_sel.Titolo ?? "(senza titolo)")</MudText>
                        <MudSpacer />

                        @if (_sel.Stato != TaskStati.Chiuso)
                        {
                            var doneBy = GetAssigneeWhoMarkedDone(_sel);

                            @if (IsCreator(_sel))
                            {
                                @if (!string.IsNullOrWhiteSpace(doneBy))
                                {
                                    <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Class="me-2">
                                        ✅ Completato da @doneBy
                                    </MudChip>
                                }

                                <MudButton Color="Color.Success"
                                           StartIcon="@Icons.Material.Filled.DoneAll"
                                           OnClick="@TryCloseTask"
                                           Disabled="@(!_canCloseCreator)">
                                    Chiudi task
                                </MudButton>
                            }
                            else if (IsAssigned(_sel))
                            {
                                if (string.IsNullOrWhiteSpace(doneBy))
                                {
                                    <MudButton Color="Color.Success"
                                               Variant="Variant.Filled"
                                               StartIcon="@Icons.Material.Filled.CheckCircle"
                                               OnClick="@OpenDoneDialog">
                                        Fatto ✅
                                    </MudButton>
                                }
                                else
                                {
                                    <MudChip T="string" Color="Color.Info" Variant="Variant.Filled" Class="me-2">
                                        ⏳ In attesa di chiusura
                                    </MudChip>
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Info"
                                               StartIcon="@Icons.Material.Filled.NotificationsActive"
                                               OnClick="@OpenNudgeCreatorDialog">
                                        Avvisa creatore
                                    </MudButton>
                                }
                            }
                        }
                    </div>

                    @if (_sel.Stato != TaskStati.Chiuso && IsAssigned(_sel) && !IsCreator(_sel))
                    {
                        <MudText Typo="Typo.caption" Class="mt-1" Style="color:#6a82b7;">
                            Premi <b>Fatto ✅</b> quando hai completato: il creatore potrà chiudere il task.
                        </MudText>
                    }
                    <MudText Typo="Typo.caption">
                        Creato da: @_sel.CreatoDa • Creato: @_sel.DataCreazione.ToString("dd/MM/yyyy HH:mm")
                        @if (_sel.DataScadenza is not null)
                        {
                            <span> • Scadenza: @_sel.DataScadenza.Value.ToString("dd/MM/yyyy HH:mm")</span>
                        }
                    </MudText>

                    @if (_sel.Stato == TaskStati.Chiuso && _sel.DataChiusura is not null)
                    {
                        <MudText Typo="Typo.caption" Class="mt-1">
                            Completato da: @_sel.ChiusoDa • alle: @_sel.DataChiusura.Value.ToString("dd/MM/yyyy HH:mm")
                        </MudText>
                    }


                    @if (_sel.AssegnatiA?.Any() == true)
                    {
                        <MudText Typo="Typo.caption" Class="mt-1">
                            Assegnato a: @string.Join(", ", _sel.AssegnatiA)
                        </MudText>
                    }

                    @if (_sel.EmailId is int emailId && emailId > 0)
                    {
                        <MudText Typo="Typo.caption" Class="mt-1">
                            EmailId: @emailId
                            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => GoToMailWithEmail(emailId))">
                                Apri mail
                            </MudButton>
                        </MudText>
                    }

                    <MudDivider Class="my-2" />
                    @if (!string.IsNullOrWhiteSpace(_sel.DescrizioneMarkdown))
                    {
                        <div class="task-desc rte">
                            @RenderTaskHtml(_sel.DescrizioneMarkdown)
                        </div>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption">Nessuna descrizione.</MudText>
                    }
                }
            </div>
        </MudPaper>

        <!-- COMMENTI -->
        <MudPaper Class="task-panel comments-panel">
            <div class="panel-header">Commenti</div>
            <div class="panel-body">
                @if (_sel is null)
                {
                    <MudText Typo="Typo.caption">Apri un task per vedere i commenti</MudText>
                }
                else
                {
                    <div class="comment-list">
                        @if (_comments.Count == 0)
                        {
                            <MudText Typo="Typo.caption">Nessun commento</MudText>
                        }
                        else
                        {
                            @foreach (var c in _comments)
                            {
                                <div class="comment">
                                    <div class="meta"><b>@c.Utente</b> • @c.DataCreazione.ToString("dd/MM HH:mm")</div>
                                    <div>@RenderCommentPretty(c.Testo)</div>
                                </div>
                            }
                        }
                    </div>

                    <MudDivider Class="my-2" />

                    <div class="mention-anchor" @ref="_anchorRef">
                        <MudTextField T="string"
                                      Value="@_newText"
                                      ValueChanged="OnCommentChanged"
                                      Lines="3"
                                      Variant="Variant.Outlined"
                                      Placeholder=@("Scrivi un commento… usa @ per menzionare")
                                      Immediate="true" />
                    </div>

                    <MudPopover Open="@_showMention"
                                AnchorEl="_anchorRef"
                                AnchorOrigin="Origin.TopCenter"
                                TransformOrigin="Origin.BottomCenter">
                        <div style="min-width:260px; max-height:220px; overflow-y:auto;">
                            <MudList T="string">
                                @foreach (var u in _mentionOptions)
                                {
                                    <MudListItem T="string"
                                                 Class="@(u == _mentionActive ? "active" : "")"
                                                 @onclick="@(() => PickMention(u))">
                                        @u
                                    </MudListItem>
                                }
                            </MudList>
                        </div>
                    </MudPopover>

                    <MudButton ButtonType="ButtonType.Button"
                               OnClick="@PostComment"
                               Color="Color.Primary"
                               Variant="Variant.Filled"
                               StartIcon="@Icons.Material.Filled.Send"
                               Disabled="@(_sel is null || string.IsNullOrWhiteSpace(_newText) || string.IsNullOrWhiteSpace(_utente))">
                        Invia
                    </MudButton>
                }
            </div>
        </MudPaper>
    </div>
</div>

