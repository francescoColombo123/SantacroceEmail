    private static MarkupString RenderTaskHtml(string? html)
    {
        if (string.IsNullOrWhiteSpace(html)) return (MarkupString)"";
        return (MarkupString)html;
    }

    private static bool IsDoneComment(string? txt)
    {
        if (string.IsNullOrWhiteSpace(txt)) return false;

        var t = txt.Trim();

        // NON dipendere dalla ✅ (spesso si rompe nel DB e diventa un carattere strano)
        if (t.StartsWith("Fatto", StringComparison.OrdinalIgnoreCase)) return true;
        if (t.StartsWith("Done", StringComparison.OrdinalIgnoreCase)) return true;

        return Regex.IsMatch(t, @"\b(fatto|done|completato|completata)\b", RegexOptions.IgnoreCase);
    }

    private string? GetAssigneeWhoMarkedDone(TaskDto task)
    {
        if (task.AssegnatiA?.Any() != true) return null;

        var ass = new HashSet<string>(
            task.AssegnatiA.Where(x => !string.IsNullOrWhiteSpace(x))
                           .Select(x => x.Trim().ToLowerInvariant()),
            StringComparer.OrdinalIgnoreCase
        );

        var done = _comments
            .Where(c => c is not null
                && !string.IsNullOrWhiteSpace(c.Utente)
                && ass.Contains(c.Utente.Trim().ToLowerInvariant())
                && IsDoneComment(c.Testo))
            .OrderByDescending(c => c.DataCreazione)
            .FirstOrDefault();

        return done?.Utente?.Trim();
    }

    private async Task OpenDoneDialog()
    {
        if (_sel is null || string.IsNullOrWhiteSpace(_utente)) return;

        var creator = _sel.CreatoDa?.Trim();
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };

        var dialog = DialogService.Show<CloseCommentDialog>("", new DialogParameters
        {
            ["Title"] = "Segna come fatto",
            ["Message"] = string.IsNullOrWhiteSpace(creator)
        ? "Confermi di aver completato? Puoi aggiungere una nota (facoltativa)."
        : $"Confermi di aver completato? (Nota facoltativa: notificherà il creatore {creator}).",
            ["Placeholder"] = "Nota facoltativa…"
        }, options);
        var res = await dialog.Result;
        if (res.Canceled) return;

        var note = (res.Data as string)?.Trim();

        _newText = string.IsNullOrWhiteSpace(note)
            ? "Fatto"
            : $"Fatto — {note}";

        await PostComment();
    }

