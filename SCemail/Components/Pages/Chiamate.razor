@page "/chiamate"
@implements IDisposable
@using Microsoft.JSInterop
@using SCemail.Mobile
@inject MobileRepository Repo
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject SCemail.Components.Data.AccessiService AccessiSrv
@inject IJSRuntime JS

@* Consultazione delle chiamate rilevate dai telefoni aziendali + gestione dispositivi. Solo admin. *@

<PageTitle>Chiamate – SCemail</PageTitle>

<div class="ch-page">
    <div class="ch-wrap">

        @* ------------------------------------------------------------ intestazione *@
        <header class="ch-hero">
            <div class="ch-hero-icon">📞</div>
            <div class="flex-grow-1">
                <div class="ch-hero-kicker">SCemail</div>
                <h1 class="ch-hero-title">Chiamate telefoni aziendali</h1>
                <div class="ch-hero-sub">
                    Chiamate rilevate dai telefoni, orari in ora italiana
                    @if (_ultimoAggiornamento is { } ua)
                    {
                        <span class="ch-dot-live"></span><span>aggiornato alle @ua.ToString("HH:mm:ss")</span>
                    }
                </div>
            </div>
            <button class="btn ch-btn-ghost" @onclick="TornaHome">← Home</button>
        </header>

        @* ------------------------------------------------------------ indicatori *@
        <section class="ch-kpis">
            <button class="ch-kpi ch-kpi-red @(_tipo == "perse" ? "is-active" : "")" @onclick='() => CambiaTipo("perse")'>
                <span class="ch-kpi-icon">↙</span>
                <span class="ch-kpi-value">@_dispositivi.Sum(d => d.Perse)</span>
                <span class="ch-kpi-label">Perse · @EtichettaPeriodo</span>
            </button>
            <button class="ch-kpi ch-kpi-green @(_tipo == "risposte" ? "is-active" : "")" @onclick='() => CambiaTipo("risposte")'>
                <span class="ch-kpi-icon">✓</span>
                <span class="ch-kpi-value">@_dispositivi.Sum(d => d.Risposte)</span>
                <span class="ch-kpi-label">Risposte · @EtichettaPeriodo</span>
            </button>
            <button class="ch-kpi ch-kpi-blue @(_tipo == "uscita" ? "is-active" : "")" @onclick='() => CambiaTipo("uscita")'>
                <span class="ch-kpi-icon">↗</span>
                <span class="ch-kpi-value">@_dispositivi.Sum(d => d.Uscita)</span>
                <span class="ch-kpi-label">In uscita · @EtichettaPeriodo</span>
            </button>
            <div class="ch-kpi @(Silenziosi > 0 ? "ch-kpi-amber" : "ch-kpi-gray") ch-kpi-static">
                <span class="ch-kpi-icon">📱</span>
                <span class="ch-kpi-value">@_dispositivi.Count(d => d.IsActive)<small> / @_dispositivi.Count</small></span>
                <span class="ch-kpi-label">
                    Telefoni attivi@(Silenziosi > 0 ? $" · {Silenziosi} silenziosi" : "")
                </span>
            </div>
        </section>

        @* ------------------------------------------------------------ filtri *@
        <section class="ch-card ch-filters">
            <div class="ch-chips" role="tablist">
                @foreach (var (val, lbl) in Tipi)
                {
                    <button class="ch-chip @(_tipo == val ? "is-active" : "") ch-chip-@val" @onclick="() => CambiaTipo(val)">@lbl</button>
                }
            </div>
            <div class="ch-filter-row">
                <div class="ch-field">
                    <label>Periodo</label>
                    <select class="form-select" @bind="_periodo" @bind:after="CaricaTutto">
                        <option value="oggi">Oggi</option>
                        <option value="ieri">Ieri</option>
                        <option value="7">Ultimi 7 giorni</option>
                        <option value="30">Ultimi 30 giorni</option>
                        <option value="90">Ultimi 90 giorni</option>
                    </select>
                </div>
                <div class="ch-field ch-field-wide">
                    <label>Telefono</label>
                    <select class="form-select" @bind="_dispositivoId" @bind:after="CaricaTutto">
                        <option value="">Tutti i telefoni</option>
                        @foreach (var d in _dispositivi)
                        {
                            <option value="@d.Id">@d.Nome – @d.Proprietario</option>
                        }
                    </select>
                </div>
                <div class="ch-field ch-field-wide">
                    <label>Numero</label>
                    <input class="form-control" placeholder="Cerca un numero, es. 333123" @bind="_numero" @bind:after="CaricaTutto" />
                </div>
                <div class="ch-field ch-field-btn">
                    <button class="btn btn-primary w-100" @onclick="CaricaTutto" disabled="@_loading">
                        @(_loading ? "Caricamento…" : "↻ Aggiorna")
                    </button>
                </div>
            </div>
        </section>

        @* ------------------------------------------------------------ codice di attivazione *@
        @if (_codiceGenerato is not null)
        {
            <section class="ch-code">
                <div class="flex-grow-1">
                    <div class="ch-code-title">
                        Codice di attivazione @(_codicePer is null ? "per un nuovo telefono" : $"per riassociare «{_codicePer}»")
                    </div>
                    <div class="ch-code-value">@_codiceGenerato</div>
                    <div class="ch-code-note">
                        Valido fino al @_codiceScadenza.ToString("dd/MM/yyyy HH:mm"), una sola volta.
                        Inseriscilo nell'app del telefono. Dopo la chiusura non sarà più visibile.
                    </div>
                </div>
                <div class="d-flex flex-column gap-2">
                    <button class="btn btn-success" @onclick="CopiaCodice">⧉ Copia</button>
                    <button class="btn btn-outline-secondary" @onclick="() => _codiceGenerato = null">Chiudi</button>
                </div>
            </section>
        }

        @* ------------------------------------------------------------ telefoni *@
        <section>
            <div class="ch-section-head">
                <h2>Telefoni</h2>
                <div class="d-flex gap-2 align-items-center">
                    <input class="form-control form-control-sm ch-note-input" placeholder="Nota (es. Magazzino)" @bind="_notaCodice" />
                    <button class="btn btn-success btn-sm text-nowrap" @onclick="() => GeneraCodice(null)">＋ Nuovo telefono</button>
                </div>
            </div>

            @if (!_dispositivi.Any())
            {
                <div class="ch-card ch-empty">
                    @(_loading ? "Caricamento…" : "Nessun telefono registrato. Usa «Nuovo telefono» per generare il codice di attivazione.")
                </div>
            }
            <div class="ch-devices">
                @foreach (var d in _dispositivi)
                {
                    var silenzioso = d.IsActive && d.UltimoContatto is { } u0 && DateTime.UtcNow - u0 > TimeSpan.FromHours(24);
                    var selezionato = _dispositivoId == d.Id.ToString();
                    <article class="ch-device @(d.IsActive ? "" : "is-off") @(selezionato ? "is-selected" : "")">
                        <div class="ch-device-head">
                            <div class="ch-device-avatar">@Iniziali(d.Nome)</div>
                            <div class="flex-grow-1 min-w-0">
                                <div class="ch-device-name">@d.Nome</div>
                                <div class="ch-device-owner">@d.Proprietario@(d.NumeroSim is null ? "" : $" · {d.NumeroSim}")</div>
                            </div>
                            @if (!d.IsActive) { <span class="ch-badge ch-badge-gray">Disattivato</span> }
                            else if (silenzioso) { <span class="ch-badge ch-badge-amber" title="Nessun contatto da oltre 24 ore: controllare telefono, rete o VPN">Silenzioso</span> }
                            else { <span class="ch-badge ch-badge-green">Attivo</span> }
                        </div>

                        <div class="ch-device-stats">
                            <div class="@(d.Perse > 0 ? "is-red" : "")"><b>@d.Perse</b><span>perse</span></div>
                            <div><b>@d.Risposte</b><span>risposte</span></div>
                            <div><b>@d.Rifiutate</b><span>rifiutate</span></div>
                            <div><b>@d.Uscita</b><span>uscita</span></div>
                        </div>

                        <div class="ch-device-meta">
                            <span>@(d.Modello ?? "Modello n.d.")@(d.AndroidVersion is null ? "" : $" · Android {d.AndroidVersion}")</span>
                            <span>Ultimo contatto: <b>@(d.UltimoContatto is { } uc ? Relativo(uc) : "mai")</b></span>
                        </div>

                        <div class="ch-device-actions">
                            <button class="btn btn-sm @(selezionato ? "btn-primary" : "btn-outline-primary")" @onclick="() => FiltraDispositivo(d)">
                                @(selezionato ? "✓ Filtrato" : "Vedi chiamate")
                            </button>
                            <button class="btn btn-sm btn-outline-secondary" title="Codice per riassociare il telefono (es. app reinstallata)"
                                    @onclick="() => GeneraCodice(d)">Riassocia</button>
                            @if (d.IsActive)
                            {
                                <button class="btn btn-sm btn-outline-danger ms-auto" @onclick="() => CambiaStato(d, false)">Disattiva</button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-success ms-auto" @onclick="() => CambiaStato(d, true)">Riattiva</button>
                            }
                        </div>
                    </article>
                }
            </div>
        </section>

        @* ------------------------------------------------------------ chiamate *@
        <section>
            <div class="ch-section-head">
                <h2>@TitoloElenco</h2>
                <span class="ch-muted">
                    @_chiamate.Count risultati@(_chiamate.Count >= Limite ? $" (mostrate le prime {Limite})" : "")
                    @if (!string.IsNullOrWhiteSpace(_numero) || !string.IsNullOrEmpty(_dispositivoId))
                    {
                        <button class="btn btn-link btn-sm p-0 ms-2" @onclick="AzzeraFiltri">azzera filtri</button>
                    }
                </span>
            </div>

            <div class="ch-card p-0 overflow-hidden">
                @if (!_chiamate.Any())
                {
                    <div class="ch-empty">
                        @(_loading ? "Caricamento…" : _tipo == "perse" ? "Nessuna chiamata persa nel periodo. 🎉" : "Nessuna chiamata nel periodo selezionato.")
                    </div>
                }
                @foreach (var gruppo in _chiamate.GroupBy(c => MobileTime.ToLocal(c.DataInizio).Date))
                {
                    <div class="ch-day">@EtichettaGiorno(gruppo.Key) <span>@gruppo.Count()</span></div>
                    @foreach (var c in gruppo)
                    {
                        var (icona, classe, etichetta) = Aspetto(c);
                        <div class="ch-call">
                            <div class="ch-call-icon @classe">@icona</div>
                            <div class="ch-call-main">
                                <div class="ch-call-number">
                                    @if (c.NumeroChiamante is null)
                                    {
                                        <i class="ch-muted">@EtichettaPresentazione(c.Presentazione)</i>
                                    }
                                    else
                                    {
                                        <a href="tel:@c.NumeroChiamante">@c.NumeroChiamante</a>
                                        <button class="ch-link" title="Mostra tutte le chiamate di questo numero" @onclick="() => FiltraNumero(c.NumeroChiamante)">filtra</button>
                                    }
                                </div>
                                <div class="ch-call-sub">
                                    <span class="ch-tag @classe">@etichetta</span>
                                    <span>📱 @c.Nome <span class="ch-muted">(@c.Proprietario)</span></span>
                                </div>
                            </div>
                            <div class="ch-call-right">
                                <div class="ch-call-time">@MobileTime.ToLocal(c.DataInizio).ToString("HH:mm")</div>
                                <div class="ch-muted small">@FormatDurata(c.DurataSecondi)</div>
                            </div>
                        </div>
                    }
                }
            </div>
        </section>
    </div>
</div>

@code {
    private const int Limite = 1000;

    private static readonly (string Val, string Lbl)[] Tipi =
    {
        ("perse", "Perse"), ("risposte", "Risposte"), ("rifiutate", "Rifiutate"), ("uscita", "In uscita"), ("tutte", "Tutte"),
    };

    private string? _cp;
    private string? _utente;
    private bool _loading = true;
    private DateTime? _ultimoAggiornamento;

    private string _periodo = "7";
    private string _dispositivoId = "";
    private string _tipo = "perse";
    private string? _numero;

    private List<MobileDeviceStats> _dispositivi = new();
    private List<MobileCallRow> _chiamate = new();

    private string? _notaCodice;
    private string? _codiceGenerato;
    private string? _codicePer;
    private DateTime _codiceScadenza;

    private readonly CancellationTokenSource _cts = new();

    private int Silenziosi => _dispositivi.Count(d =>
        d.IsActive && d.UltimoContatto is { } u && DateTime.UtcNow - u > TimeSpan.FromHours(24));

    private string EtichettaPeriodo => _periodo switch
    {
        "oggi" => "oggi", "ieri" => "ieri", _ => $"{_periodo} gg",
    };

    private string TitoloElenco => _tipo switch
    {
        "perse" => "Chiamate perse",
        "risposte" => "Chiamate risposte",
        "rifiutate" => "Chiamate rifiutate",
        "uscita" => "Chiamate in uscita",
        _ => "Tutte le chiamate",
    };

    protected override async Task OnInitializedAsync()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var q = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        _cp = q.TryGetValue("cp", out var c) ? c.ToString() : null;

        _utente = await AccessiSrv.GetUtenteFromCpAsync(_cp);
        if (string.IsNullOrWhiteSpace(_utente) || !await AccessiSrv.IsAdminAsync(_utente))
        {
            Snackbar.Add("Accesso consentito solo agli admin.", Severity.Warning);
            Nav.NavigateTo(string.IsNullOrWhiteSpace(_cp) ? "/" : $"/?cp={Uri.EscapeDataString(_cp)}");
            return;
        }

        await CaricaTutto();
        _ = AggiornamentoAutomatico(_cts.Token);
    }

    /** Ricarica ogni minuto finché la pagina è aperta: le nuove chiamate perse compaiono da sole. */
    private async Task AggiornamentoAutomatico(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(60));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                if (_loading) continue;
                await InvokeAsync(async () =>
                {
                    await CaricaTutto();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

    private (DateTime FromUtc, DateTime ToUtc) Intervallo()
    {
        var oggi = MobileTime.TodayLocal;
        var (da, a) = _periodo switch
        {
            "oggi" => (oggi, oggi.AddDays(1)),
            "ieri" => (oggi.AddDays(-1), oggi),
            _ => (oggi.AddDays(-int.Parse(_periodo) + 1), oggi.AddDays(1)),
        };
        return (MobileTime.ToUtc(da), MobileTime.ToUtc(a));
    }

    private async Task CaricaTutto()
    {
        _loading = true;
        try
        {
            var (from, to) = Intervallo();
            _dispositivi = await Repo.ListDevicesWithStatsAsync(from, to, CancellationToken.None);

            var (status, direction) = _tipo switch
            {
                "perse" => ("MISSED", (string?)null),
                "risposte" => ("ANSWERED", "INCOMING"),
                "rifiutate" => ("REJECTED", null),
                "uscita" => (null, "OUTGOING"),
                _ => ((string?)null, (string?)null),
            };
            long? deviceId = long.TryParse(_dispositivoId, out var id) ? id : null;
            _chiamate = await Repo.SearchCallsAsync(
                new CallSearch(from, to, deviceId, status, direction, _numero, Limite), CancellationToken.None);
            _ultimoAggiornamento = MobileTime.ToLocal(DateTime.UtcNow);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore nel caricamento: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CambiaTipo(string tipo)
    {
        _tipo = tipo;
        await CaricaTutto();
    }

    private async Task FiltraDispositivo(MobileDeviceStats d)
    {
        _dispositivoId = _dispositivoId == d.Id.ToString() ? "" : d.Id.ToString();
        await CaricaTutto();
    }

    private async Task FiltraNumero(string numero)
    {
        _numero = numero;
        _tipo = "tutte";
        await CaricaTutto();
    }

    private async Task AzzeraFiltri()
    {
        _numero = null;
        _dispositivoId = "";
        await CaricaTutto();
    }

    private async Task GeneraCodice(MobileDeviceStats? dispositivo)
    {
        if (dispositivo is not null)
        {
            var ok = await JS.InvokeAsync<bool>("confirm",
                $"Generare un codice per riassociare «{dispositivo.Nome}»? Usalo sul telefono dopo una reinstallazione: " +
                "lo storico delle chiamate resterà sullo stesso dispositivo e il vecchio token smetterà di funzionare.");
            if (!ok) return;
        }

        try
        {
            var (code, expires) = await Repo.CreateActivationAsync(
                _utente ?? "?", dispositivo is null ? _notaCodice : $"Riassociazione {dispositivo.Nome}",
                dispositivo?.Id, TimeSpan.FromDays(3), CancellationToken.None);
            _codiceGenerato = code;
            _codicePer = dispositivo?.Nome;
            _codiceScadenza = MobileTime.ToLocal(expires);
            _notaCodice = null;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore nella generazione del codice: {ex.Message}", Severity.Error);
        }
    }

    private async Task CopiaCodice()
    {
        if (_codiceGenerato is null) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _codiceGenerato);
            Snackbar.Add("Codice copiato", Severity.Success);
        }
        catch
        {
            // Gli appunti richiedono HTTPS o localhost: su http://IP il browser può rifiutare.
            Snackbar.Add("Copia non consentita dal browser: selezionare il codice e copiarlo a mano.", Severity.Info);
        }
    }

    private async Task CambiaStato(MobileDeviceStats d, bool attivo)
    {
        var msg = attivo
            ? $"Riattivare «{d.Nome}»? Il telefono potrà di nuovo inviare chiamate."
            : $"Disattivare «{d.Nome}»? Il telefono non potrà più inviare chiamate finché non viene riattivato.";
        if (!await JS.InvokeAsync<bool>("confirm", msg)) return;

        try
        {
            await Repo.SetDeviceActiveAsync(d.Id, attivo, CancellationToken.None);
            Snackbar.Add(attivo ? "Telefono riattivato" : "Telefono disattivato", Severity.Success);
            await CaricaTutto();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore: {ex.Message}", Severity.Error);
        }
    }

    private static (string Icona, string Classe, string Etichetta) Aspetto(MobileCallRow c) => (c.Direzione, c.Esito) switch
    {
        ("OUTGOING", "ANSWERED") => ("↗", "is-blue", "In uscita"),
        ("OUTGOING", _) => ("↗", "is-gray", "In uscita, senza risposta"),
        (_, "ANSWERED") => ("↙", "is-green", "Risposta"),
        (_, "MISSED") => ("↙", "is-red", "Persa"),
        (_, "REJECTED") => ("⦸", "is-amber", "Rifiutata"),
        _ => ("?", "is-gray", "Esito non determinato"),
    };

    private static string EtichettaPresentazione(string p) => p switch
    {
        "PRIVATO" => "Numero privato",
        "PUBBLICO" => "Telefono pubblico",
        _ => "Numero sconosciuto",
    };

    private static string EtichettaGiorno(DateTime giorno)
    {
        var oggi = MobileTime.TodayLocal;
        if (giorno == oggi) return "Oggi";
        if (giorno == oggi.AddDays(-1)) return "Ieri";
        var s = giorno.ToString("dddd d MMMM", new System.Globalization.CultureInfo("it-IT"));
        return char.ToUpper(s[0]) + s[1..];
    }

    private static string Relativo(DateTime utc)
    {
        var diff = DateTime.UtcNow - utc;
        if (diff < TimeSpan.FromMinutes(1)) return "adesso";
        if (diff < TimeSpan.FromHours(1)) return $"{(int)diff.TotalMinutes} min fa";
        if (diff < TimeSpan.FromHours(24)) return $"{(int)diff.TotalHours} h fa";
        return MobileTime.ToLocal(utc).ToString("dd/MM HH:mm");
    }

    private static string Iniziali(string nome)
    {
        var parti = nome.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parti.Length switch
        {
            0 => "?",
            1 => parti[0][..Math.Min(2, parti[0].Length)].ToUpperInvariant(),
            _ => $"{char.ToUpperInvariant(parti[0][0])}{char.ToUpperInvariant(parti[1][0])}",
        };
    }

    private static string FormatDurata(long s) => s <= 0 ? "—" : $"{s / 60}:{s % 60:00}";

    private void TornaHome() =>
        Nav.NavigateTo(string.IsNullOrWhiteSpace(_cp) ? "/" : $"/?cp={Uri.EscapeDataString(_cp)}");
}
