<?xml version="1.0" encoding="utf-8"?>
<!--
    Solo build DEBUG: consente HTTP in chiaro e i certificati installati dall'utente,
    per provare l'app contro un server interno di test. La release usa solo HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
